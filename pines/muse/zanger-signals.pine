//@version=5
indicator("Zanger-signals", shorttitle="Zanger-signals", overlay=true, max_bars_back=500, max_lines_count=30, max_labels_count=50)

// FOCUSED STRIP (2026-10-22): Stage engine, EMA set, YTD row, the merged
// Anchored VWAP section, the Inner base, and the Former/Past TBA stack cut
// from "TBA Patterns + Anchored VWAP" (989 lines, parked verbatim) — ONE main
// TBA only. MAs are the strict Zanger stack 10/21/50/100/150/200 at width 4,
// 21/50/200 shown by default. AVWAPs live in the separate Anchored VWAPs pine.
// Everything else identical.

g1 = "Swings"
pivLen  = input.int(5, "Swing pivot length", minval=2, group=g1)
tolPct  = input.float(3.0, "Ceiling tolerance %", minval=0.5, step=0.5, group=g1) / 100

g2 = "Flat base / Ascending triangle"
maxDepth  = input.float(35.0, "Max base depth %", group=g2) / 100
flatDepth = input.float(15.0, "Flat base max depth %", group=g2) / 100
minBase   = input.int(10, "Min base length (bars)", group=g2)
maxBase   = input.int(120, "Max base lookback (bars)", group=g2)

g3 = "Bull flag"
poleMin    = input.float(12.0, "Min pole gain %", group=g3) / 100
poleMax    = input.int(15, "Max pole length (bars)", group=g3)
flagMin    = input.int(3, "Min flag length (bars)", group=g3)
flagMax    = input.int(12, "Max flag length (bars)", group=g3)
maxRetrace = input.float(50.0, "Max flag retrace of pole %", group=g3) / 100

g4 = "Cup with handle"
cupLen     = input.int(80, "Cup lookback (bars)", group=g4)
minCup     = input.int(20, "Min cup length (bars)", group=g4)
cupMinD    = input.float(12.0, "Min cup depth %", group=g4) / 100
cupMaxD    = input.float(40.0, "Max cup depth %", group=g4) / 100
rimTol     = input.float(5.0, "Right rim within % of left rim", group=g4) / 100
handleMin  = input.int(3, "Min handle length (bars)", group=g4)
handleMax  = input.int(15, "Max handle length (bars)", group=g4)
handleMaxD = input.float(12.0, "Max handle depth %", group=g4) / 100

// ── VCP (Volatility Contraction Pattern — Minervini) ──
// The defining traits my screener validated (and that a flat base / triangle do NOT test):
//   1) a TRAILING run of pullbacks that each tighten (≤ vcpTighten × the prior one),
//   2) those pullbacks sit under a COMMON flat ceiling (highs cluster — kills V-recoveries
//      like RCL where the highs climb 297→325→342),
//   3) RISING lows (coiling up into the pivot),
//   4) a tight FINAL contraction, and
//   5) volume DRYING UP into the apex.
// TBA = the flat ceiling (pivot); stop = the last contraction low.
gVCP = "VCP (volatility contraction)"
useVCP     = input.bool(true, "Detect VCP", group=gVCP)
vcpMinC    = input.int(2, "Min contractions in the run", minval=2, maxval=5, group=gVCP)
vcpTighten = input.float(0.85, "Each contraction ≤ x the prior depth", minval=0.5, maxval=0.98, step=0.05, group=gVCP)
vcpCeilTol = input.float(5.0, "Ceiling cluster tolerance % (flat highs)", minval=1.0, step=0.5, group=gVCP) / 100
vcpLastMax = input.float(8.0, "Final contraction max depth %", minval=1.0, step=0.5, group=gVCP) / 100
vcpZone    = input.float(10.0, "Arm when close within % below the pivot", minval=1.0, step=0.5, group=gVCP) / 100
vcpReqDry  = input.bool(true, "Require volume dry-up (5-bar avg ≤ dry-up threshold)", group=gVCP)

g9 = "Prior-high shelf (Zanger)"
useShelf  = input.bool(true, "Detect prior-high shelf TBA", group=g9)
shelfLook = input.int(120, "Prior-high lookback (bars)", minval=30, maxval=400, group=g9)
shelfZone = input.float(8.0, "Arm when close is within % below the prior high", step=0.5, group=g9) / 100
shelfBars = input.int(8, "Staging window (bars)", minval=5, maxval=30, group=g9)
shelfRng  = input.float(5.0, "Staging max CLOSE range % (tight shelf)", step=0.5, group=g9) / 100

g12 = "TBA breakout webhook (swing feed)"
showHook = input.bool(true, "Send TBA breakout to the swing webhook", group=g12)

g11 = "Market regime tag (QQQ)"
showMkt = input.bool(true, "Show market regime row in HUD", group=g11)
mktSym  = input.symbol("NASDAQ:QQQ", "Regime index", group=g11)

g10 = "RS line + dry-up (Zanger tell)"
showRS    = input.bool(true, "RS-line tell vs SPY", group=g10)
rsLook    = input.int(252, "RS lookback (bars)", minval=60, maxval=500, group=g10)
rsTol     = input.float(2.0, "RS line within % of its high = at high", step=0.5, group=g10) / 100
dryThresh = input.float(0.85, "Dry-up: 5-bar avg volume <= x 50-bar avg", step=0.05, group=g10)

g8 = "Support / resistance"
// Per-line show toggles live in the "Line styles" group (Support / Recent low / Resistance each own one).
srLook  = input.int(120, "S/R lookback (bars)", group=g8)
stopBuf = input.float(2.0, "Stop buffer below support %", step=0.5, group=g8) / 100

g5 = "Volume, trend, stop, display"
volLen   = input.int(50, "Avg volume length", group=g5)
volMult  = input.float(1.5, "Breakout volume multiple", step=0.1, group=g5)
extPct   = input.float(5.0, "Extended above TBA %", group=g5) / 100
holdBars = input.int(5, "Keep showing pattern after breakout (bars)", group=g5)
maxRisk  = input.float(8.0, "Max stop distance below TBA %", group=g5) / 100
reqTrend = input.bool(false, "Only detect above rising 50 SMA", group=g5)
showHUD  = input.bool(true, "Show HUD", group=g5)
showES   = input.bool(true, "Show entry → stop row in HUD", group=g5)
hudPos   = input.string("Top Right", "HUD position", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Bottom Left"], group=g5)
hudSize  = input.string("Large", "HUD text size", options=["Small", "Normal", "Large", "Huge"], group=g5)

gVR = "Volume ratio (Zanger · daily chart only)"
showVR = input.bool(true, "Show volume ratio in HUD", group=gVR)
vrLen  = input.int(20, "Average over (days)", minval=5, maxval=50, group=gVR)
vrLtf  = input.timeframe("5", "Intraday resolution", group=gVR)
vrPace = input.int(3, "Pace lookback (intraday bars)", minval=1, group=gVR)

gS = "SMAs — Zanger stack (10 / 21 / 50 / 100 / 150 / 200)"
showS10  = input.bool(false, "10 SMA",  inline="s",  group=gS)
showS21  = input.bool(true, "21 SMA",  inline="s",  group=gS)
showS50  = input.bool(true, "50 SMA",  inline="s",  group=gS)
showS100 = input.bool(false, "100 SMA", inline="s",  group=gS)
showS150 = input.bool(false, "150 SMA", inline="s",  group=gS)
showS200 = input.bool(true, "200 SMA", inline="s",  group=gS)
colS10   = input.color(#FF0000, "10",  inline="sc", group=gS)
colS21   = input.color(#5E35B1, "21",  inline="sc", group=gS)
colS50   = input.color(#FFEB3B, "50",  inline="sc", group=gS)
colS100  = input.color(#90A4AE, "100", inline="sc", group=gS)
colS150  = input.color(#F9A825, "150", inline="sc", group=gS)
colS200  = input.color(#FF0000, "200", inline="sc", group=gS)
emaLock  = input.bool(false, "Lock SMAs to a timeframe (UNCHECK = follow chart / unlock)", group=gS)
emaTf    = input.timeframe("D", "…lock to this timeframe (only when locked above)", group=gS)

gRg = "Regime background (vs 200 SMA)"
showRg  = input.bool(true, "Shade background by regime", group=gRg)
rgBear  = input.color(color.new(#F23645, 92), "Bear (close < 200 SMA)", inline="rg1", group=gRg)
rgBull  = input.color(color.new(#089981, 95), "Bull (close > 200 SMA, 200 flat/rising)", inline="rg2", group=gRg)
rgFix   = input.color(color.new(#FF9800, 93), "Repair (close > 200 SMA, 200 still falling)", inline="rg3", group=gRg)

gLk = "Lock levels to a timeframe"
lockLevels = input.bool(true, "Lock TBA / stop / support / resistance to a fixed timeframe", group=gLk, tooltip="ON = the pattern levels are computed on the timeframe below and stay put on any chart TF (so a 15m chart still shows the DAILY levels). The current forming HTF bar updates live.")
levelTf    = input.timeframe("D", "…levels timeframe", group=gLk)

// Trend and volume
sma50   = ta.sma(close, 50)
sma200  = ta.sma(close, 200)
trendOK = close > sma50 and sma50 > sma50[5]
avgVol  = ta.sma(volume, volLen)
rvol    = avgVol > 0 ? volume / avgVol : na
rsi0    = ta.rsi(close, 14)
vol5    = ta.sma(volume, 5)

// RS line vs SPY (Zanger/Jack tell): the ratio making its own highs while price is still
// inside a base is the stock "screaming" before the breakout. Computed on the chart series;
// the LOCK pass below re-evaluates it on the levels timeframe like everything else.
spyC    = request.security("AMEX:SPY", timeframe.period, close)
rsLine  = not na(spyC) and spyC > 0 ? close / spyC : na
rsAtHigh = showRS and not na(rsLine) and rsLine >= ta.highest(rsLine, rsLook) * (1 - rsTol)
recLow  = ta.lowest(low, 10)
recHigh = ta.highest(high, 10)

// SMAs — optionally locked to a fixed timeframe (settled [1] + lookahead_on =
// non-repainting, same values on any chart TF). Unlocked = live chart-TF SMA.
f_sma(simple int len) =>
    emaLock ? request.security(syminfo.tickerid, emaTf, ta.sma(close, len)[1], lookahead=barmerge.lookahead_on) : ta.sma(close, len)
sma10v  = f_sma(10)
sma21v  = f_sma(21)
sma50v  = f_sma(50)
sma100v = f_sma(100)
sma150v = f_sma(150)
sma200v = f_sma(200)
// Zanger stack 10 / 21 / 50 / 100 / 150 / 200 — structural levels, locked via emaLock above.
plot(showS10  ? sma10v  : na, "10 SMA",  color=color.new(colS10, 0),  linewidth=4)
plot(showS21  ? sma21v  : na, "21 SMA",  color=color.new(colS21, 0),  linewidth=4)
plot(showS50  ? sma50v  : na, "50 SMA",  color=color.new(colS50, 0),  linewidth=4)
plot(showS100 ? sma100v : na, "100 SMA", color=color.new(colS100, 0), linewidth=4)
plot(showS150 ? sma150v : na, "150 SMA", color=color.new(colS150, 0), linewidth=4)
plot(showS200 ? sma200v : na, "200 SMA", color=color.new(colS200, 0), linewidth=4)
// Regime shade, three states against the same sma200v series the chart plots, judged on
// closes (a wick through the line flips nothing): BEAR = close below the 200; BULL = close
// above it with the 200 flat-to-rising (slope vs 10 bars back); REPAIR = close above it but
// the 200 still falling — a bounce into a declining average, not a bull cycle yet.
rgSlopeDn = not na(sma200v) and not na(sma200v[10]) and sma200v < sma200v[10]
bgcolor(showRg and not na(sma200v) ? (close < sma200v ? rgBear : rgSlopeDn ? rgFix : rgBull) : na, title="Regime vs 200 SMA")

// Confirmed swing highs / lows
var shP = array.new_float()
var shI = array.new_int()
var slP = array.new_float()
var slI = array.new_int()
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    array.push(shP, ph)
    array.push(shI, bar_index - pivLen)
    if array.size(shP) > 30
        array.shift(shP)
        array.shift(shI)
if not na(pl)
    array.push(slP, pl)
    array.push(slI, bar_index - pivLen)
    if array.size(slP) > 30
        array.shift(slP)
        array.shift(slI)

// Flat base / ascending triangle
float ceilLvl    = na
int   touches    = 0
int   firstTouch = na
int   lowsFrom   = na
float baseLow    = na
float firstL     = na
float prevL      = na
float lastL      = na
int   nLows      = 0

nH = array.size(shP)
if nH > 0
    lastH = array.get(shP, nH - 1)
    ceilLvl := lastH
    for i = nH - 1 to 0
        h  = array.get(shP, i)
        ix = array.get(shI, i)
        if bar_index - ix > maxBase
            break
        if h > lastH * (1 + tolPct)
            lowsFrom := ix
            break
        if h >= lastH * (1 - tolPct)
            touches += 1
            ceilLvl := math.max(ceilLvl, h)
            firstTouch := ix
    if na(lowsFrom)
        lowsFrom := firstTouch
    nL = array.size(slP)
    if nL > 0 and not na(lowsFrom)
        for j = 0 to nL - 1
            ix = array.get(slI, j)
            if ix > lowsFrom
                l = array.get(slP, j)
                baseLow := na(baseLow) ? l : math.min(baseLow, l)
                if na(firstL)
                    firstL := l
                prevL := lastL
                lastL := l
                nLows += 1

baseLen    = na(lowsFrom) ? 0 : bar_index - lowsFrom
depth      = not na(baseLow) and ceilLvl > 0 ? (ceilLvl - baseLow) / ceilLvl : na
risingLows = nLows >= 2 and lastL > prevL and lastL > firstL
isTri      = touches >= 2 and risingLows and depth <= maxDepth and baseLen >= minBase
isFlat     = touches >= 2 and not isTri and depth <= flatDepth and baseLen >= minBase

// Bull flag
k        = nz(-ta.highestbars(high, flagMax + 1))
kLen     = math.max(k, 1)
kLen2    = math.max(k - 1, 1)
poleTop  = high[k]
lowPole  = ta.lowest(low, poleMax)
poleBase = lowPole[k]
flagLow  = ta.lowest(low, kLen)
flagHigh = ta.highest(high[1], kLen2)
poleGain = poleBase > 0 ? poleTop / poleBase - 1 : 0.0
retr     = poleTop > poleBase ? (poleTop - flagLow) / (poleTop - poleBase) : 1.0
isFlag   = k >= flagMin and k <= flagMax and poleGain >= poleMin and retr <= maxRetrace

// Cup with handle
lrOff     = nz(-ta.highestbars(high[handleMax], cupLen - handleMax))
lrLen     = math.max(lrOff, 1)
leftAgo   = handleMax + lrOff
leftRim   = high[leftAgo]
cupLow    = ta.lowest(low[handleMax], lrLen)
rOff      = nz(-ta.highestbars(high, handleMax))
rLen      = math.max(rOff, 1)
rightRim  = high[rOff]
handleLow = ta.lowest(low, rLen)
cupDepth  = leftRim > 0 ? (leftRim - cupLow) / leftRim : 0.0
hDepth    = rightRim > 0 ? (rightRim - handleLow) / rightRim : 1.0
cupMid    = cupLow + (leftRim - cupLow) / 2
isCup     = leftAgo - rOff >= minCup and cupDepth >= cupMinD and cupDepth <= cupMaxD and rightRim >= leftRim * (1 - rimTol) and rightRim <= leftRim * (1 + rimTol) and rOff >= handleMin and hDepth <= handleMaxD and handleLow > cupMid

// ── VCP detection — built on the confirmed swing-pivot arrays above ──
// Returns [ok, pivot(ceiling), lastLow(stop), firstHighBar(startBar), nContractions].
// Arrays are passed in (both ascending by bar index). Every array.get is bounds-guarded
// FIRST — Pine's and/or don't short-circuit and ternaries evaluate both arms, so an
// out-of-range get inside a condition would crash the whole script (it wouldn't even load).
f_vcp(hP, hI, lP, lI, ceilTol, tighten, lastMax, minC) =>
    nHh = array.size(hP)
    nLl = array.size(lP)
    bool  ok   = false
    float piv  = na
    float slow = na
    int   fbar = na
    int   ncnt = 0
    if nHh >= 2 and nLl >= 2
        // 1) merge highs & lows into ONE time-ordered pivot list (two-pointer merge).
        pP = array.new_float()
        pK = array.new_int()          // 1 = swing high, -1 = swing low
        pB = array.new_int()
        ih = 0
        il = 0
        while ih < nHh or il < nLl
            int hb = 2147483647
            int lb = 2147483647
            if ih < nHh
                hb := array.get(hI, ih)
            if il < nLl
                lb := array.get(lI, il)
            if hb <= lb
                array.push(pP, array.get(hP, ih))
                array.push(pK, 1)
                array.push(pB, hb)
                ih += 1
            else
                array.push(pP, array.get(lP, il))
                array.push(pK, -1)
                array.push(pB, lb)
                il += 1
        // 2) collapse consecutive same-kind pivots, keeping the extreme (highest H / lowest L).
        cP = array.new_float()
        cK = array.new_int()
        cB = array.new_int()
        np = array.size(pK)
        if np > 0
            for i = 0 to np - 1
                _p = array.get(pP, i)
                _k = array.get(pK, i)
                _b = array.get(pB, i)
                _cn = array.size(cK)
                // Guard the array.get FIRST — Pine's `and` evaluates both sides, so testing
                // `_cn > 0 and array.get(cK, _cn-1)==_k` in one expression reads index -1 when
                // the collapsed list is still empty and crashes the load.
                bool _same = false
                if _cn > 0
                    _same := array.get(cK, _cn - 1) == _k
                if _same
                    _lp = array.get(cP, _cn - 1)
                    if (_k == 1 and _p > _lp) or (_k == -1 and _p < _lp)
                        array.set(cP, _cn - 1, _p)
                        array.set(cB, _cn - 1, _b)
                else
                    array.push(cP, _p)
                    array.push(cK, _k)
                    array.push(cB, _b)
        // 3) contraction depths for adjacent High→Low pairs (oldest→newest).
        dD  = array.new_float()
        dHb = array.new_int()
        dL  = array.new_float()
        dH  = array.new_float()
        nc = array.size(cK)
        if nc > 1
            for i = 0 to nc - 2
                if array.get(cK, i) == 1 and array.get(cK, i + 1) == -1
                    _h = array.get(cP, i)
                    _l = array.get(cP, i + 1)
                    if _h > 0
                        array.push(dD, (_h - _l) / _h)
                        array.push(dHb, array.get(cB, i))
                        array.push(dL, _l)
                        array.push(dH, _h)
        // 4) longest TRAILING tightening run ending at the newest contraction.
        nd = array.size(dD)
        if nd >= 1
            int runStart = nd - 1
            float lastD = array.get(dD, nd - 1)
            if nd >= 2
                for i = nd - 2 to 0
                    // earlier contraction must be meaningfully WIDER: depth[i] ≥ depth[i+1] / tighten
                    if array.get(dD, i) >= array.get(dD, i + 1) / tighten
                        runStart := i
                    else
                        break
            int runLen = nd - runStart
            if runLen >= minC
                // 5) flat ceiling (highs cluster) + rising lows + tight final contraction.
                float hiMax  = na
                float hiMin  = na
                bool  riseLo = true
                float prevLo = na
                for i = runStart to nd - 1
                    _h = array.get(dH, i)
                    _l = array.get(dL, i)
                    hiMax := na(hiMax) ? _h : math.max(hiMax, _h)
                    hiMin := na(hiMin) ? _h : math.min(hiMin, _h)
                    if not na(prevLo) and _l < prevLo * 0.995
                        riseLo := false
                    prevLo := _l
                bool flatCeil = not na(hiMax) and hiMax > 0 and (hiMax - hiMin) / hiMax <= ceilTol
                piv  := hiMax
                slow := array.get(dL, nd - 1)
                fbar := array.get(dHb, runStart)
                ncnt := runLen
                ok   := flatCeil and riseLo and lastD <= lastMax
    [ok, piv, slow, fbar, ncnt]

[vcpRaw, vcpPiv, vcpLow, vcpBar, vcpN] = f_vcp(shP, shI, slP, slI, vcpCeilTol, vcpTighten, vcpLastMax, vcpMinC)
vcpDry = avgVol > 0 and vol5 <= avgVol * dryThresh
// Arm only while price STAGES under the pivot (within vcpZone below it), above the 50 SMA, with
// a sane stop (last low below price). Volume dry-up is required by default (the VCP apex signature).
isVcp = useVCP and vcpRaw and not na(vcpPiv) and close < vcpPiv and close >= vcpPiv * (1 - vcpZone) and close > sma50 and not na(vcpLow) and vcpLow < close and (not vcpReqDry or vcpDry)

// Prior-high shelf (Zanger): Dan draws the TBA at the PRIOR HIGH by hand — no repeated-touch
// requirement. The classic leader shape the base detectors above miss: a rounded recovery /
// staircase of higher lows into a single old high, with a short tight shelf digesting directly
// underneath it (DDOG into its 294 spike high, Oct 2026 — the flat-base engine required two
// ceiling touches within 3% and never armed). Armed only while price STAGES below the high:
// within shelfZone under it, above the 50 SMA, and either tight (shelfRng over shelfBars) or
// rising pivot lows. Stop = the staging low.
shelfLvl  = ta.highest(high[1], shelfLook)
shelfLoW  = ta.lowest(low, shelfBars)
// Tightness is judged on CLOSES, not the high-low range: one vertical bar's wick poisons a
// range test, while Dan's shelf is closes pinching together under the high (DDOG's closes sat
// inside ~2.5% for a week while its wicks ranged ~8%). Either the last 5 closes inside 4% or
// the staging window's closes inside shelfRng counts as tight.
shelfCW5 = ta.lowest(close, 5) > 0 ? ta.highest(close, 5) / ta.lowest(close, 5) - 1 : 1.0
shelfCW  = ta.lowest(close, shelfBars) > 0 ? ta.highest(close, shelfBars) / ta.lowest(close, shelfBars) - 1 : 1.0
shelfTight = shelfCW5 <= 0.04 or shelfCW <= shelfRng
nSL2 = array.size(slP)
shelfRising = false
if nSL2 >= 2
    _ll = array.get(slP, nSL2 - 1)
    _pl = array.get(slP, nSL2 - 2)
    _li = array.get(slI, nSL2 - 1)
    shelfRising := _ll > _pl and bar_index - _li <= shelfBars * 3
isShelf = useShelf and not na(shelfLvl) and close < shelfLvl and close >= shelfLvl * (1 - shelfZone) and close > sma50 and (shelfTight or shelfRising)
shelfStp = shelfTight ? shelfLoW : (nSL2 >= 1 ? array.get(slP, nSL2 - 1) : na)
if not na(shelfStp) and shelfStp >= close
    shelfStp := na

// Pick the pattern
string pat = na
float  tba = na
float  stp = na
int    startBar = na
// VCP first: it is the most specific/highest-quality base and would otherwise be mislabeled
// as an Ascending Triangle (same flat ceiling + rising lows) or a Flat Base.
if isVcp
    pat := "VCP ×" + str.tostring(vcpN)
    tba := vcpPiv
    stp := vcpLow
    startBar := vcpBar
else if isFlag
    pat := "Bull Flag"
    tba := flagHigh
    stp := flagLow
    startBar := bar_index - k
else if isCup
    pat := "Cup w/ Handle"
    tba := rightRim
    stp := handleLow
    startBar := bar_index - leftAgo
else if isTri
    pat := "Ascending Triangle"
    tba := ceilLvl
    stp := lastL
    startBar := lowsFrom
else if isFlat
    pat := "Flat Base"
    tba := ceilLvl
    stp := lastL
    startBar := lowsFrom
else if isShelf
    pat := "Prior-High Shelf"
    tba := shelfLvl
    stp := shelfStp
    startBar := bar_index - shelfBars
if reqTrend and not trendOK
    pat := na

var string mPat   = na
var float  mTba   = na
var float  mStp   = na
var int    mStart = na
var int    mBar   = na
// Only anchor to a CURRENT base — one whose ceiling is still near price. During a fast rally the
// detector keeps re-finding the OLD base (its pivot highs still dominate, no new pivot confirmed
// yet), which refreshed mBar every bar and kept the stale TBA alive forever. Once price has
// extended past `extPct` above the ceiling, that base is played out: stop refreshing it so `active`
// expires (the TBA clears), and let a NEW base take over when one forms (Zanger: new base = new TBA).
patFresh = not na(pat) and not na(tba) and close <= tba * (1 + extPct)
if patFresh
    mPat   := pat
    mTba   := tba
    mStp   := stp
    mStart := startBar
    mBar   := bar_index

// Pattern FAILED once price closes below its stop (the base low broke down) — a TBA ceiling far
// ABOVE price is a dead pattern price fell away from, not a forming base. Drop it so the TBA clears.
active = not na(mBar) and bar_index - mBar <= holdBars and (na(mStp) or close > mStp)

// Main breakout tracking
var float brkLow  = na
var float brkRef  = na
var float brkRvol = na
crossUp = active and close > mTba and close[1] <= mTba
if crossUp
    brkLow  := low
    brkRef  := mTba
    brkRvol := rvol
afterBrk = active and not na(brkRef) and brkRef == mTba

// Pattern stop
capStop = mTba * (1 - maxRisk)
stopF   = afterBrk ? math.max(brkLow, mStp) : math.max(mStp, capStop)
riskRef = mTba

// Status
string status = "No pattern"
color  stCol  = color.gray
if active
    distPct = (close / mTba - 1) * 100
    if close < stopF
        status := "Failed (below stop)"
        stCol  := color.red
    else if close > mTba * (1 + extPct)
        status := "Extended +" + str.tostring(distPct, "#.0") + "%"
        stCol  := color.orange
    else if crossUp
        status := rvol >= volMult ? "BREAKOUT on volume" : "Breakout, light volume"
        stCol  := rvol >= volMult ? color.lime : color.yellow
    else if afterBrk and close > mTba
        status := "Holding above TBA"
        stCol  := color.lime
    else if afterBrk
        status := "Back below TBA"
        stCol  := color.orange
    else
        status := "Forming, " + str.tostring(-distPct, "#.0") + "% below TBA"
        stCol  := color.aqua

// Support / resistance helpers
f_pickSup(v, t, curV, curT) =>
    better = not na(v) and v < close * 0.998 and (na(curV) or v > curV)
    [better ? v : curV, better ? t : curT]

f_pickRes(v, t, curV, curT) =>
    better = not na(v) and v > close * 1.002 and (na(curV) or v < curV)
    [better ? v : curV, better ? t : curT]

f_held(L) =>
    int n = 0
    for i = 0 to 9
        if low[i] <= L * 1.01 and close[i] > L * 0.995
            n += 1
    n

float  supLvl = na
string supTyp = "-"
float  resLvl = na
string resTyp = "-"
if barstate.islast
    nSL = array.size(slP)
    if nSL > 0
        for j = 0 to nSL - 1
            if bar_index - array.get(slI, j) <= srLook
                v = array.get(slP, j)
                [sv, st] = f_pickSup(v, "swing low", supLvl, supTyp)
                supLvl := sv
                supTyp := st
                [rv, rt] = f_pickRes(v, "broken swing low", resLvl, resTyp)
                resLvl := rv
                resTyp := rt
    nSH = array.size(shP)
    if nSH > 0
        for j = 0 to nSH - 1
            if bar_index - array.get(shI, j) <= srLook
                v = array.get(shP, j)
                [sv, st] = f_pickSup(v, "prior high (flipped)", supLvl, supTyp)
                supLvl := sv
                supTyp := st
                [rv, rt] = f_pickRes(v, "swing high", resLvl, resTyp)
                resLvl := rv
                resTyp := rt
    [s1, t1] = f_pickSup(sma50, "50 SMA", supLvl, supTyp)
    supLvl := s1
    supTyp := t1
    [s2, t2] = f_pickSup(sma200, "200 SMA", supLvl, supTyp)
    supLvl := s2
    supTyp := t2
    [r1, u1] = f_pickRes(sma50, "50 SMA", resLvl, resTyp)
    resLvl := r1
    resTyp := u1
    [r2, u2] = f_pickRes(sma200, "200 SMA", resLvl, resTyp)
    resLvl := r2
    resTyp := u2
    [r3, u3] = f_pickRes(recHigh, "10-day high", resLvl, resTyp)
    resLvl := r3
    resTyp := u3

supStop = na(supLvl) ? na : supLvl * (1 - stopBuf)
rrVal   = not na(supStop) and not na(resLvl) and close > supStop ? (resLvl - close) / (close - supStop) : na

// ── LOCK: recompute the whole engine on levelTf (default daily) so lower-TF charts keep the
// daily levels. request.security re-evaluates each expression on levelTf; colours + strings pass
// through. Everything the lines + HUD need is read here as L-prefixed values. ──
heldN0   = na(supLvl) ? 0 : f_held(supLvl)
riskPct0 = active and riskRef > 0 ? (riskRef - stopF) / riskRef * 100 : na
rsTell0  = rsAtHigh and active and not na(mTba) and close < mTba
dryUp0   = active and avgVol > 0 and vol5 <= avgVol * dryThresh
volTxt0  = vol5 < avgVol * 0.8 ? "Drying up" : vol5 > avgVol * 1.2 ? "Heavy" : "Normal"
brkTxt0  = afterBrk ? str.tostring(brkRvol, "#.0") + "x avg" : "-"
brkCol0  = afterBrk and brkRvol >= volMult ? color.lime : color.white
patLen0  = active and not na(mStart) ? bar_index - mStart : na
_ltf = lockLevels ? levelTf : timeframe.period
[La, Lpat, Ltba, Lstop, Lstat, LstC, LrPct, LpatLen, Lrsi, LrsT, Ldry] = request.security(syminfo.tickerid, _ltf, [active, mPat, mTba, stopF, status, stCol, riskPct0, patLen0, rsi0, rsTell0, dryUp0], lookahead=barmerge.lookahead_off)
[LsupL, LsupT, LresL, LresT, LrecL, LheldN, Lrv, LbrkT, LbrkC, LvolT, LtrOK, LsupS, LrrV] = request.security(syminfo.tickerid, _ltf, [supLvl, supTyp, resLvl, resTyp, recLow, heldN0, rvol, brkTxt0, brkCol0, volTxt0, trendOK, supStop, rrVal], lookahead=barmerge.lookahead_off)

// Today's OPEN — the daily open (= 09:30 RTH open on a regular-session chart). lookahead_on is
// safe: a day's open is fixed at the bar's start, so it's known, not future data.
Lopen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)

// Weekly 8 / 20 SMA — pulled from the WEEKLY series so they're identical on any chart TF
// (lookahead_off = non-repainting; the forming week updates the value, like a normal MA overlay).
wSma8  = request.security(syminfo.tickerid, "W", ta.sma(close, 8),  lookahead=barmerge.lookahead_off)
wSma20 = request.security(syminfo.tickerid, "W", ta.sma(close, 20), lookahead=barmerge.lookahead_off)

brk   = crossUp and rvol >= volMult
plotshape(brk, "Breakout on volume", shape.triangleup, location.belowbar, color.lime, size=size.small)
alertcondition(brk, "Pattern breakout on volume", "{{ticker}} broke above its TBA on volume")
plotshape(rsTell0 and not rsTell0[1], "RS line at high in base", shape.diamond, location.abovebar, color.new(#E040FB, 0), size=size.tiny)
alertcondition(rsTell0 and not rsTell0[1], "RS line leading in base", "{{ticker}} RS line at its high while still under the TBA")

// ── Line styles — colour · width · solid/dashed/dotted for every drawn level ──
gLn  = "Line styles"
f_lstyle(string s) => s == "solid" ? line.style_solid : s == "dotted" ? line.style_dotted : line.style_dashed
// Where did it OPEN relative to the 10/21/50/200 SMAs — "above all SMA" / "below all SMA", or the
// nearest SMA above (overhead) + nearest below (support) when the open sits inside the stack.
f_openLoc(float o, float s10, float s21, float s50, float s200) =>
    _v = array.from(s10, s21, s50, s200)
    _n = array.from("10", "21", "50", "200")
    // The open counts as ABOVE a SMA (support) only when it CLEARS it by >0.1% — opening right AT
    // the line means the SMA is still resistance, so it counts as below/overhead.
    _buf = 0.001
    int nAbove = 0
    int nTot   = 0
    // Track the TWO NEAREST SMAs by distance — those are the "neighbors" (e.g. open nestled just
    // under the 8/20 while the 50 is far below → name the 8 & 20, not the distant 50).
    float d1 = na
    int   i1 = -1
    float d2 = na
    int   i2 = -1
    for _i = 0 to 3
        _x = array.get(_v, _i)
        if not na(_x) and not na(o)
            nTot += 1
            if o > _x * (1 + _buf)
                nAbove += 1
            _d = math.abs(o - _x)
            if na(d1) or _d < d1
                d2 := d1
                i2 := i1
                d1 := _d
                i1 := _i
            else if na(d2) or _d < d2
                d2 := _d
                i2 := _i
    string _r = ""
    if nTot == 0
        _r := ""
    else if nAbove == nTot
        _r := "above all SMA"
    else if nAbove == 0
        _r := "below all SMA"
    else if i2 < 0
        _r := ""
    else
        _lo = math.min(i1, i2)
        _hi = math.max(i1, i2)
        _aLo = o > array.get(_v, _lo) * (1 + _buf)
        _aHi = o > array.get(_v, _hi) * (1 + _buf)
        _nlo = array.get(_n, _lo)
        _nhi = array.get(_n, _hi)
        if _aLo == _aHi
            _r := (_aLo ? "above " : "below ") + _nlo + " & " + _nhi + " SMA"
        else
            _r := (_aLo ? "above " : "below ") + _nlo + " SMA, " + (_aHi ? "above " : "below ") + _nhi + " SMA"
    _r
shTba = input.bool(true, "TBA", inline = "L1", group = gLn)
cTba = input.color(color.aqua, "", inline = "L1", group = gLn)
wTba = input.int(4, "w", minval = 1, maxval = 6, inline = "L1", group = gLn)
yTba = input.string("solid",  "", options = ["solid", "dashed", "dotted"], inline = "L1", group = gLn)
shStp = input.bool(false, "Stop", inline = "L2", group = gLn)
cStp = input.color(color.new(color.red, 20), "", inline = "L2", group = gLn)
wStp = input.int(1, "w", minval = 1, maxval = 6, inline = "L2", group = gLn)
yStp = input.string("dashed", "", options = ["solid", "dashed", "dotted"], inline = "L2", group = gLn)
shSup = input.bool(false, "Support", inline = "L3", group = gLn)
cSup = input.color(color.lime, "", inline = "L3", group = gLn)
wSup = input.int(2, "w", minval = 1, maxval = 6, inline = "L3", group = gLn)
ySup = input.string("dashed", "", options = ["solid", "dashed", "dotted"], inline = "L3", group = gLn)
shRec = input.bool(false, "Recent low", inline = "L4", group = gLn)
cRec = input.color(color.new(color.lime, 30), "", inline = "L4", group = gLn)
wRec = input.int(1, "w", minval = 1, maxval = 6, inline = "L4", group = gLn)
yRec = input.string("dotted", "", options = ["solid", "dashed", "dotted"], inline = "L4", group = gLn)
shRes = input.bool(false, "Resistance", inline = "L5", group = gLn)
cRes = input.color(color.new(color.red, 10), "", inline = "L5", group = gLn)
wRes = input.int(2, "w", minval = 1, maxval = 6, inline = "L5", group = gLn)
yRes = input.string("dotted", "", options = ["solid", "dashed", "dotted"], inline = "L5", group = gLn)
shOpn = input.bool(false, "Today's open", inline = "L7", group = gLn)
cOpn = input.color(#FFB300, "", inline = "L7", group = gLn)
wOpn = input.int(1, "w", minval = 1, maxval = 6, inline = "L7", group = gLn)
yOpn = input.string("dotted", "", options = ["solid", "dashed", "dotted"], inline = "L7", group = gLn)
// Shared extent so every level draws the SAME length (left lookback + right extension, in bars).
lnBack = input.int(60, "Line length ← bars", minval = 5, maxval = 300, inline = "LX", group = gLn)
lnFwd  = input.int(3, "→ bars", minval = 0, maxval = 100, inline = "LX", group = gLn)

// ── Weekly SMAs — locked to the WEEKLY timeframe, so they show on any chart TF (catches the
// strong-trend names that ride the weekly 8 and never dip to the 20, e.g. today's SPY). ──
gWk   = "Weekly SMAs"
shW8  = input.bool(false, "Weekly 8 SMA",  inline = "W8", group = gWk)
cW8   = input.color(#AB47BC, "", inline = "W8", group = gWk)
wW8   = input.int(2, "w", minval = 1, maxval = 6, inline = "W8", group = gWk)
shW20 = input.bool(false, "Weekly 20 SMA", inline = "W20", group = gWk)
cW20  = input.color(#42A5F5, "", inline = "W20", group = gWk)
wW20  = input.int(2, "w", minval = 1, maxval = 6, inline = "W20", group = gWk)
plot(shW8  and not na(wSma8)  ? wSma8  : na, "Weekly 8 SMA",  color = cW8,  linewidth = wW8)
plot(shW20 and not na(wSma20) ? wSma20 : na, "Weekly 20 SMA", color = cW20, linewidth = wW20)

// Lines
var line  tbaLn = na
var line  stpLn = na
var line  supLn = na
var line  recLn = na
var line  resLn = na
var line  opnLn = na
var label tbaLb = na
var label stpLb = na
var label supLb = na
var label recLb = na
var label resLb = na
var label opnLb = na
if barstate.islast
    line.delete(tbaLn)
    line.delete(stpLn)
    line.delete(supLn)
    line.delete(recLn)
    line.delete(resLn)
    line.delete(opnLn)
    label.delete(tbaLb)
    label.delete(stpLb)
    label.delete(supLb)
    label.delete(recLb)
    label.delete(resLb)
    label.delete(opnLb)
    // Locked levels are horizontal; every line shares ONE extent so they all draw equal length.
    xL = bar_index - lnBack
    xR = bar_index + lnFwd
    if La and shTba
        tbaLn := line.new(xL, Ltba, xR, Ltba, color=cTba, width=wTba, style=f_lstyle(yTba))
        tbaLb := label.new(xR, Ltba, "TBA " + str.tostring(Ltba, format.mintick) + (LrsT ? " · RS★" : "") + (Ldry ? " · DRY" : ""), style=label.style_label_left, color=cTba, textcolor=color.black, size=size.small)
    if La and shStp
        stpLn := line.new(xL, Lstop, xR, Lstop, color=cStp, width=wStp, style=f_lstyle(yStp))
        stpLb := label.new(xR, Lstop, "Stop " + str.tostring(Lstop, format.mintick), style=label.style_label_left, color=cStp, textcolor=color.white, size=size.small)
    // When support coincides with the TBA (within 0.5%) and the TBA is drawn, show the TBA only.
    _supDup = La and shTba and not na(Ltba) and not na(LsupL) and math.abs(LsupL / Ltba - 1) <= 0.005
    if shSup and not na(LsupL) and not _supDup
        supLn := line.new(xL, LsupL, xR, LsupL, color=cSup, width=wSup, style=f_lstyle(ySup))
        supLb := label.new(xR, LsupL, "Support " + str.tostring(LsupL, format.mintick), style=label.style_label_left, color=cSup, textcolor=color.black, size=size.small)
    if shRec and not na(LrecL) and (na(LsupL) or math.abs(LrecL / LsupL - 1) > 0.005)
        recLn := line.new(xL, LrecL, xR, LrecL, color=cRec, width=wRec, style=f_lstyle(yRec))
        recLb := label.new(xR, LrecL, "Recent low " + str.tostring(LrecL, format.mintick), style=label.style_label_left, color=cRec, textcolor=color.black, size=size.small)
    // When resistance coincides with the TBA (within 0.5%) and the TBA is drawn, show the TBA only.
    _resDup = La and shTba and not na(Ltba) and not na(LresL) and math.abs(LresL / Ltba - 1) <= 0.005
    if shRes and not na(LresL) and not _resDup
        resLn := line.new(xL, LresL, xR, LresL, color=cRes, width=wRes, style=f_lstyle(yRes))
        resLb := label.new(xR, LresL, "Resistance " + str.tostring(LresL, format.mintick), style=label.style_label_left, color=cRes, textcolor=color.white, size=size.small)
    if shOpn and not na(Lopen)
        opnLn := line.new(xL, Lopen, xR, Lopen, color=cOpn, width=wOpn, style=f_lstyle(yOpn))
        _openLoc = f_openLoc(Lopen, sma10v, sma21v, sma50v, sma200v)
        opnLb := label.new(xR, Lopen, "Open " + str.tostring(Lopen, format.mintick) + (_openLoc == "" ? "" : "  · " + _openLoc), style=label.style_label_left, color=cOpn, textcolor=color.black, size=size.small)

// ── Volume ratio (Zanger-style, time-of-day projection) — DAILY CHART ONLY ──
// Same math as the standalone "Vol Ratio" indicator: projects where the day's volume will
// finish from how much has traded by this point vs the average day's cumulative volume by the
// same time. Needs each chart bar to BE a day + intraday sub-bars, so it only computes on a
// daily chart (shows "Daily only" otherwise; request.security_lower_tf returns empty when its
// timeframe isn't lower than the chart, so this stays safe on any TF).
VR_MAXB = 300
vrIsD = timeframe.isdaily
vrIv  = request.security_lower_tf(syminfo.tickerid, vrLtf, volume)
var vrCum   = array.new_float(vrLen * VR_MAXB, 0.0)
var vrDaySz = array.new_int(vrLen, 0)
vrSlot = bar_index % vrLen
vrNn   = math.min(array.size(vrIv), VR_MAXB)
float vrRun = 0.0
if vrIsD and vrNn > 0
    for i = 0 to vrNn - 1
        vrRun += nz(array.get(vrIv, i))
        array.set(vrCum, vrSlot * VR_MAXB + i, vrRun)
if vrIsD
    array.set(vrDaySz, vrSlot, vrNn)

f_vrAvgCum(k, cur) =>
    float sum = 0.0
    int cnt = 0
    for s = 0 to vrLen - 1
        sz = array.get(vrDaySz, s)
        if s != cur and sz > 0
            idx = math.min(k, sz) - 1
            if idx >= 0
                sum += array.get(vrCum, s * VR_MAXB + idx)
                cnt += 1
    cnt > 0 ? sum / cnt : na
f_vrCumToday(k) => k > 0 ? array.get(vrCum, vrSlot * VR_MAXB + k - 1) : na

vrAvgFull = ta.sma(volume[1], vrLen)
vrDayDone = timenow >= time_close
vrAvgNow  = f_vrAvgCum(vrNn, vrSlot)
vrLive    = vrNn > 0 and vrAvgNow > 0 ? f_vrCumToday(vrNn) / vrAvgNow * 100 : na
vrRatio   = not vrIsD ? na : vrDayDone ? (vrAvgFull > 0 ? volume / vrAvgFull * 100 : na) : vrLive
vrKp      = vrNn - vrPace
vrAvgPrev = vrKp > 0 ? f_vrAvgCum(vrKp, vrSlot) : na
vrRatPrev = vrKp > 0 and vrAvgPrev > 0 ? f_vrCumToday(vrKp) / vrAvgPrev * 100 : na
vrProj    = not na(vrRatio) ? vrAvgFull * vrRatio / 100 : na
f_vrCat(r) => na(r) ? "Daily only" : r >= 250 ? "EXTREME" : r >= 150 ? "HIGH" : r >= 85 ? "AVERAGE" : r >= 60 ? "LIGHT" : "DRY-UP"
f_vrCol(r) => na(r) ? color.gray : r >= 250 ? color.fuchsia : r >= 150 ? color.lime : r >= 85 ? color.gray : r >= 60 ? color.yellow : color.aqua
vrPaceTxt = not vrIsD ? "-" : vrDayDone ? "closed" : na(vrRatPrev) or na(vrLive) ? "-" : vrLive > vrRatPrev ? "▲ rising" : vrLive < vrRatPrev ? "▼ fading" : "flat"
vrPaceCol = vrPaceTxt == "▲ rising" ? color.lime : vrPaceTxt == "▼ fading" ? color.red : color.gray

// ── Market regime tag (Zanger gate, display only — never blocks a pattern) ──
// Dan's sequence is market first, stocks second: cash is his #1 position in chop and he only
// presses when the NASDAQ is good. This row puts that context on every chart: the index's
// close vs its rising/falling 50 SMA and its distance from the 52-week high, computed on the
// DAILY series of the regime symbol so it reads the same on any chart timeframe.
[qC, q50, q50up, q200, qOffHi] = request.security(mktSym, "D", [close, ta.sma(close, 50), ta.sma(close, 50) > ta.sma(close, 50)[5], ta.sma(close, 200), (close / ta.highest(high, 252) - 1) * 100], lookahead=barmerge.lookahead_off)
mktTxt = na(qC) ? "-" : str.tostring(qC, "#.##") + " · " + (qOffHi >= -0.05 ? "at 52w high" : str.tostring(qOffHi, "#.0") + "% vs high") + " · " + (qC > q50 ? "abv " : "bel ") + "50" + (q50up ? "▲" : "▼") + (qC < q200 ? " · bel 200" : "")
mktCol = na(qC) ? color.gray : qC > q50 and q50up and qC > q200 ? color.lime : qC > q50 ? color.yellow : color.red

// ── TBA breakout webhook → swing feed + Telegram (Victor, 2026-10-11) ──
// Bind ONE TradingView alert per symbol on a 30m chart (condition: this script,
// "alert() function calls only", webhook URL = the desk's /tv/webhook). The trigger is a
// 30m CLOSE crossing the LOCKED DAILY TBA while the daily pattern is active — the daily
// shelf/base top is the line that fires, never a 30m pattern. Payload mirrors the existing
// swing Pines' JSON (swing_trade.pine f_pqpay shape); rule "swing_tba_breakout" is what
// routes it: the backend maps swing_* → Swing style → the app's SWING feed (not the Day
// tab) with "Trim at daily RSI 70+" guidance. Target_1 = the locked resistance above the
// TBA when one exists. This is the script's ONLY alert() call, so the binding is clean.
f_hookMsg(string pat, float tba, float stp, float t1, string t1lab) =>
    '{"symbol":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","interval":"' + timeframe.period + '","price":"' + str.tostring(close, format.mintick) + '","entry":"' + str.tostring(close, format.mintick) + '","stop":"' + (na(stp) ? "" : str.tostring(stp, format.mintick)) + '","target_1":"' + (na(t1) ? "" : str.tostring(t1, format.mintick)) + '","target_1_label":"' + t1lab + '","rule":"swing_tba_breakout","direction":"BUY","rsi":"' + (na(Lrsi) ? "" : str.tostring(Lrsi, "#.0")) + '","volume_ratio":"' + (na(vrRatio) ? "" : str.tostring(vrRatio, "#")) + '","note":"' + pat + ' breakout over ' + str.tostring(tba, format.mintick) + '"}'
hookT1 = not na(LresL) and not na(Ltba) and LresL > Ltba * 1.005 ? LresL : na
hookFire = showHook and La and not na(Ltba) and ta.crossover(close, Ltba)
if hookFire
    alert(f_hookMsg(Lpat, Ltba, Lstop, hookT1, na(hookT1) ? "" : LresT), alert.freq_once_per_bar_close)

// HUD
posT = hudPos == "Middle Right" ? position.middle_right : hudPos == "Bottom Right" ? position.bottom_right : hudPos == "Top Left" ? position.top_left : hudPos == "Bottom Left" ? position.bottom_left : position.top_right
var table hud = table.new(posT, 2, 7, bgcolor=color.new(#0d1318, 5), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 85), border_width=1)

hudTxt = hudSize == "Small" ? size.small : hudSize == "Large" ? size.large : hudSize == "Huge" ? size.huge : size.normal
f_row(t, r, key, val, c) =>
    table.cell(t, 0, r, key, text_color=color.silver, text_size=hudTxt, text_halign=text.align_left)
    table.cell(t, 1, r, val, text_color=c, text_size=hudTxt, text_halign=text.align_right)

if showHUD and barstate.islast
    // Interpretive context ONLY — the prices (support / resistance / recent low / TBA /
    // inner TBA / pattern stop) are drawn as lines on the chart, so they're not repeated here.
    tfTag   = lockLevels ? " (" + levelTf + ")" : ""
    rsiTxt  = na(Lrsi) ? "-" : str.tostring(Lrsi, "#.0") + (Lrsi >= 70 ? " overbought" : Lrsi <= 30 ? " oversold" : Lrsi >= 50 ? " bullish" : " bearish")
    rsiCol  = na(Lrsi) ? color.gray : Lrsi >= 70 ? color.red : Lrsi <= 30 ? color.lime : Lrsi >= 50 ? color.lime : color.orange
    // Lean HUD (trader directive 2026-10-04): pattern + status + RSI only. Ext·20SMA, the
    // volume row and the Zanger volume-ratio block were cut — prices/levels live on the chart lines.
    f_row(hud, 0, "PATTERN HUD", syminfo.ticker + tfTag, color.white)
    f_row(hud, 1, "Pattern", La ? Lpat : "None", La ? color.white : color.gray)
    f_row(hud, 2, "Status", La ? Lstat : "-", La ? LstC : color.gray)
    f_row(hud, 3, "RSI 14", rsiTxt, rsiCol)
    // Regime row (Victor, 2026-10-18): this name's own cycle vs its 200 SMA — the same three
    // states as the background shade. BEAR = close below the 200; REPAIR = close above it but
    // the 200 still falling; BULL = close above a flat-to-rising 200.
    rgTxt = na(sma200v) ? "-" : close < sma200v ? "BEAR" : rgSlopeDn ? "REPAIR" : "BULL"
    rgCol = na(sma200v) ? color.gray : close < sma200v ? color.red : rgSlopeDn ? color.orange : color.lime
    f_row(hud, 4, "Regime", rgTxt, rgCol)
    // Market row added at Victor's direction 2026-10-11 (supersedes the lean-HUD cut for this row).
    if showMkt
        f_row(hud, 5, "Market", mktTxt, mktCol)
    // Entry → Stop row (trader directive 2026-11-15): when a pattern is active, show the actionable
    // trade — the TBA entry, the stop, and the risk % between them. Gated by showES.
    if showES and La and not na(Ltba) and not na(Lstop)
        esTxt = str.tostring(Ltba, format.mintick) + " → " + str.tostring(Lstop, format.mintick) + (na(LrPct) ? "" : "  (" + str.tostring(LrPct, "#.0") + "% risk)")
        f_row(hud, 6, "Entry → Stop", esTxt, color.white)
    // © bolofbaba
