//@version=5
// htf-candle-overlay-rth v2026.11.16.4 — version is in the indicator title too: if the chart legend
// does not show this exact version, the chart is running an older copy.
// ─────────────────────────────────────────────────────────────────────────────
// HTF CANDLE OVERLAY · REGULAR SESSION — the higher-timeframe candles drawn as a
// mini candlestick series projected to the RIGHT of live price, RTH-ONLY.
//
//   The problem this solves: the usual HTF-candle overlays aggregate the HIGHER
//   timeframe from the 24-HOUR feed, so you get a Saturday candle and daily
//   open/high/low/close that include pre- and post-market prints — candles that
//   don't match what a regular-session trader actually sees.
//
//   The fix: every projected candle's Open / High / Low / Close is read through a
//   REGULAR-SESSION ticker (ticker.new(..., session.regular)). No weekend candle,
//   no extended-hours wick — the daily (or weekly) candle is the RTH candle.
//
//   Draws the last N higher-timeframe candles (default DAILY) as real body+wick
//   candlesticks, offset to the right of the current bar so they sit in clean air:
//     • body  = solid open↔close box, green when up / red when down (regular colours)
//     • wick  = high/low tails ABOVE and BELOW the body only (never a line
//       through the body), matching the body colour — looks like a real candle
//     • the rightmost candle is the CURRENT forming HTF candle (updates live)
//     • per-candle label: weekday (MON…FRI) on the DAILY htf, clock (HH:mm) on
//       intraday; on weekly+ there is no per-candle label (every weekly candle
//       starts Monday), just the timeframe tag
//     • optional dashed line at the current HTF open, projected across to the candles
//
//   NON-REPAINTING: completed candles are SETTLED ([1] + lookahead_on) and never
//   move. The forming candle is live by design (lookahead_off). VISUAL ONLY — no
//   alertcondition. Set the HTF one step ABOVE the chart (Daily on a 1h/4h chart).
// ─────────────────────────────────────────────────────────────────────────────
indicator("HTF Candle Overlay · RTH · v2026.11.16.4", shorttitle = "HTF RTH", overlay = true, max_boxes_count = 120, max_lines_count = 200, max_labels_count = 200)

// ── Inputs ──
gC   = "Higher-timeframe candles"
htf      = input.timeframe("D", "Timeframe", group = gC, tooltip = "The candle to project. Daily on a 1h/4h chart, Weekly on a Daily. Must be ONE STEP UP from the chart timeframe.")
nCandles = input.int(8, "No. of candles (incl. the live one)", minval = 2, maxval = 60, group = gC)
startOffset = input.int(25, "Start offset (bars right of price)", minval = 2, maxval = 300, group = gC, tooltip = "How far to the right of the last bar the projection starts, so it sits clear of live price.")
bodyW    = input.int(3, "Candle body width (bars)", minval = 1, maxval = 12, group = gC)
spacing  = input.int(2, "Candle spacing (bars)", minval = 0, maxval = 12, group = gC)

gV   = "Style"
bodyUp  = input.color(#26A69A, "Body up / down (regular candle colours)", group = gV, inline = "b")
bodyDn  = input.color(#EF5350, "", group = gV, inline = "b")
showTfLbl   = input.bool(true, "Timeframe label", group = gV)
showTimeLbl = input.bool(true, "Per-candle day / time label", group = gV)
tz          = input.string("America/New_York", "Label timezone", options = ["America/New_York", "America/Chicago", "America/Los_Angeles", "UTC", "Europe/London"], group = gV)
lblSize     = input.string("small", "Label size", options = ["tiny", "small", "normal"], group = gV)

gO   = "Open line"
showOpenLine = input.bool(true, "Dashed line at the current HTF open", group = gO)
openCol  = input.color(color.new(#787B86, 0), "Open line colour", group = gO)

_lblSz = lblSize == "normal" ? size.normal : lblSize == "tiny" ? size.tiny : size.small

// ── Regular-session HTF OHLC — the whole point: no weekend candle, RTH range ──
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
// SETTLED prior completed candle (non-repainting), pushed to history on each new HTF period
[po, ph, pl, pc, pt] = request.security(rthTid, htf, [open[1], high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
// LIVE forming candle (updates intraday by design — lookahead_off, no [1])
[co, ch, cl, cc, ct] = request.security(rthTid, htf, [open, high, low, close, time], lookahead = barmerge.lookahead_off)

// ── History of completed HTF candles (last nCandles) ──
var array<float> aO = array.new_float()
var array<float> aH = array.new_float()
var array<float> aL = array.new_float()
var array<float> aC = array.new_float()
var array<int>   aT = array.new_int()

if timeframe.change(htf) and not na(po) and not na(ph)
    array.push(aO, po)
    array.push(aH, ph)
    array.push(aL, pl)
    array.push(aC, pc)
    array.push(aT, pt)
    while array.size(aO) > nCandles
        array.shift(aO)
        array.shift(aH)
        array.shift(aL)
        array.shift(aC)
        array.shift(aT)

// ── day-of-week label (daily+) / clock label (intraday) ──
f_dow(int t) =>
    d = dayofweek(t, tz)
    d == dayofweek.monday ? "MON" : d == dayofweek.tuesday ? "TUE" : d == dayofweek.wednesday ? "WED" : d == dayofweek.thursday ? "THU" : d == dayofweek.friday ? "FRI" : d == dayofweek.saturday ? "SAT" : "SUN"
// label per candle: intraday → clock, daily → weekday, weekly+ → none (every
// weekly candle opens Monday, so a weekday label would just repeat "MON").
f_tlabel(int t) =>
    _secs = timeframe.in_seconds(htf)
    _secs < 86400 ? str.format_time(t, "HH:mm", tz) : _secs < 604800 ? f_dow(t) : ""

// ── drawing objects (rebuilt each last bar) ──
var array<box>   _bx = array.new_box()
var array<line>  _wk = array.new_line()
var array<label> _lb = array.new_label()

f_candle(int slot, float o, float h, float l, float c, int t, bool forming) =>
    cL  = bar_index + startOffset + slot * (bodyW + spacing)
    cR  = cL + bodyW
    ctr = cL + int(math.round(bodyW / 2.0))
    up  = c >= o
    bcol = up ? bodyUp : bodyDn
    top  = math.max(o, c)
    bot  = math.min(o, c)
    // wick as two tails — above and below the body only, so no line crosses the body
    if h > top
        array.push(_wk, line.new(ctr, h, ctr, top, color = bcol, width = 1))
    if l < bot
        array.push(_wk, line.new(ctr, bot, ctr, l, color = bcol, width = 1))
    // solid body (forming candle a touch lighter so you can tell it's still live)
    array.push(_bx, box.new(cL, top, cR, bot, border_color = bcol, border_width = 1, bgcolor = forming ? color.new(bcol, 35) : color.new(bcol, 0)))
    if showTimeLbl
        _txt = f_tlabel(t)
        if _txt != ""
            array.push(_lb, label.new(ctr, l, _txt, style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(#B2B5BE, 0), size = _lblSz))
    ctr

if barstate.islast
    for _b in _bx
        box.delete(_b)
    for _w in _wk
        line.delete(_w)
    for _l in _lb
        label.delete(_l)
    array.clear(_bx)
    array.clear(_wk)
    array.clear(_lb)

    nComp     = array.size(aO)
    nCompShow = math.min(nComp, nCandles - 1)
    startI    = nComp - nCompShow
    slot      = 0
    if nCompShow > 0
        for i = startI to nComp - 1
            f_candle(slot, array.get(aO, i), array.get(aH, i), array.get(aL, i), array.get(aC, i), array.get(aT, i), false)
            slot += 1
    // the forming candle — rightmost, live
    int _ctr = na
    if not na(co)
        _ctr := f_candle(slot, co, ch, cl, cc, ct, true)

    // timeframe tag above the forming candle
    if showTfLbl and not na(_ctr) and not na(ch)
        array.push(_lb, label.new(_ctr, ch, str.upper(htf), style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(#B2B5BE, 0), size = _lblSz))

    // dashed open line at the current HTF open, projected across to the candles
    if showOpenLine and not na(co)
        _xR = bar_index + startOffset + slot * (bodyW + spacing) + bodyW
        array.push(_wk, line.new(bar_index - 2, co, _xR, co, color = openCol, width = 1, style = line.style_dashed))
