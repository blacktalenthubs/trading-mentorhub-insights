//@version=5
// fib-retracement v2026.11.25.3 — version is in the indicator title too: if the chart legend
// does not show this exact version, the chart is running an older copy.
// ─────────────────────────────────────────────────────────────────────────────
// FIB LEVELS — do they act as support / resistance? (Victor, 2026-11-25)
// Rebuilt from the .1/.2 strategy tester at Victor's word: he wants to SEE,
// automatically, how fib levels behave as support and resistance. The tester
// is parked in git history (.2) until the levels prove worth testing.
//
//   • AUTO ANCHOR, no hand-drawing. Three modes: the last confirmed pivot
//     swing (pivots confirm right-bars later — the grid never repaints),
//     yesterday's range (PDH/PDL), or the high/low of the last N bars.
//   • Lines extend BOTH ways across the whole chart, so the grid is always
//     on screen. A level under price is coloured as support, over price as
//     resistance, and the level being tested right now turns orange.
//   • BEHAVIOUR IS COUNTED on completed closes, Victor's doctrine: a level
//     is only support while a close defends it. A touch that closes back on
//     the level's side is a DEFENSE (support holds / resistance rejects);
//     a completed close through it is a BREAK. Counts reset when the anchor
//     moves (a new swing or a new day = a new grid).
//   • Every level's right-edge label says what it is doing in plain words:
//     "61.8% 712.40 — support, held 2 of 3". The HUD names the nearest level
//     above and below, whether price is testing one now, the strongest
//     level on the grid, and whether a near level lines up with the PDH,
//     PDL or a daily 20 / 50 / 200 SMA.
//   • The 50%–61.8% band is shaded — the deep pullback zone to watch.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Fib Levels — support / resistance v2026.11.25.3", overlay = true, max_lines_count = 100, max_labels_count = 200, max_boxes_count = 10, max_bars_back = 5000)

// ── Inputs ──
grpA = "Anchor"
anchorMode = input.string("Auto swing", "Draw fib on", options = ["Auto swing", "Prior day", "Lookback"], group = grpA)
leftLen    = input.int(5,   "Swing pivot bars left",  minval = 2, group = grpA)
rightLen   = input.int(5,   "Swing pivot bars right", minval = 2, group = grpA, tooltip = "Auto swing only. A pivot is used only after this many bars confirm it — no repainting.")
lookLen    = input.int(100, "Lookback bars",          minval = 20, group = grpA, tooltip = "Lookback mode only.")
grpB = "Behaviour"
tolPct     = input.float(0.10, "Test zone (% of price)", minval = 0.01, step = 0.05, group = grpB, tooltip = "How close a bar must come to a level to count as a test of it.")
markEvents = input.bool(true, "Mark holds and breaks on the chart", group = grpB)
grpH = "HUD"
showHud    = input.bool(true, "Show HUD", group = grpH)

// ── Settled daily references (day-signals idiom: [1] + lookahead_on) ──
tid = syminfo.tickerid
pdh = request.security(tid, "D", high[1],  lookahead = barmerge.lookahead_on)
pdl = request.security(tid, "D", low[1],   lookahead = barmerge.lookahead_on)
dSma20  = request.security(tid, "D", ta.sma(close, 20)[1],  lookahead = barmerge.lookahead_on)
dSma50  = request.security(tid, "D", ta.sma(close, 50)[1],  lookahead = barmerge.lookahead_on)
dSma200 = request.security(tid, "D", ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on)

// ── Auto swing: last two confirmed pivots, by occurrence bar ──
ph = ta.pivothigh(high, leftLen, rightLen)
pl = ta.pivotlow(low, leftLen, rightLen)
var int   p1Type  = 0
var float p1Price = na
var int   p1Bar   = na
var int   p2Type  = 0
var float p2Price = na
var int   p2Bar   = na
int   newType  = 0
float newPrice = na
int   newBar   = na
if not na(ph)
    newType  := 1
    newPrice := ph
    newBar   := bar_index - rightLen
else if not na(pl)
    newType  := -1
    newPrice := pl
    newBar   := bar_index - rightLen
if newType != 0
    if p2Type == 0
        p2Type  := newType
        p2Price := newPrice
        p2Bar   := newBar
    else if newType == p2Type
        if (newType == 1 and newPrice > p2Price) or (newType == -1 and newPrice < p2Price)
            p2Price := newPrice
            p2Bar   := newBar
    else
        p1Type  := p2Type
        p1Price := p2Price
        p1Bar   := p2Bar
        p2Type  := newType
        p2Price := newPrice
        p2Bar   := newBar

// ── Anchor high / low for the chosen mode ──
swingOn = p1Type != 0 and p2Type != 0 and p1Type != p2Type and p1Price != p2Price
float aHi = na
float aLo = na
string aTxt = ""
if anchorMode == "Auto swing" and swingOn
    aHi  := math.max(p1Price, p2Price)
    aLo  := math.min(p1Price, p2Price)
    aTxt := "Swing " + str.tostring(p1Price, format.mintick) + " → " + str.tostring(p2Price, format.mintick)
else if anchorMode == "Prior day" and not na(pdh) and not na(pdl) and pdh != pdl
    aHi  := pdh
    aLo  := pdl
    aTxt := "Yesterday's range " + str.tostring(pdl, format.mintick) + " – " + str.tostring(pdh, format.mintick)
else if anchorMode == "Lookback"
    aHi  := ta.highest(high, lookLen)
    aLo  := ta.lowest(low, lookLen)
    aTxt := "Last " + str.tostring(lookLen) + " bars " + str.tostring(aLo, format.mintick) + " – " + str.tostring(aHi, format.mintick)
gridOn = not na(aHi) and not na(aLo) and aHi > aLo

// ── The grid: 7 levels, behaviour counters per level ──
ratios = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
var int[]   tests = array.new_int(7, 0)
var int[]   defs  = array.new_int(7, 0)
var int[]   brks  = array.new_int(7, 0)
var bool[]  wasIn = array.new_bool(7, false)
var float lastAHi = na
var float lastALo = na
if gridOn and (na(lastAHi) or aHi != lastAHi or aLo != lastALo)
    lastAHi := aHi
    lastALo := aLo
    for i = 0 to 6
        array.set(tests, i, 0)
        array.set(defs,  i, 0)
        array.set(brks,  i, 0)
        array.set(wasIn, i, false)

f_lvl(i) => aHi - array.get(ratios, i) * (aHi - aLo)
f_pct(i) => str.tostring(array.get(ratios, i) * 100, "#.#") + "%"

// Behaviour text for one level, judged against the last close.
f_behav(i) =>
    lvl = f_lvl(i)
    t = array.get(tests, i)
    d = array.get(defs, i)
    b = array.get(brks, i)
    s = ""
    if t == 0 and b == 0
        s := close >= lvl ? "support — not tested yet" : "resistance — not tested yet"
    else if close >= lvl
        s := "support — held " + str.tostring(d) + " of " + str.tostring(t) + (b > 0 ? " · broke " + str.tostring(b) + "×" : "")
    else
        s := "resistance — rejected " + str.tostring(d) + " of " + str.tostring(t) + (b > 0 ? " · broke " + str.tostring(b) + "×" : "")
    s

// ── Count tests / defenses / breaks on confirmed bars ──
if gridOn and barstate.isconfirmed
    for i = 0 to 6
        lvl = f_lvl(i)
        z = lvl * tolPct / 100.0
        inZone = low <= lvl + z and high >= lvl - z
        fresh = inZone and not array.get(wasIn, i)
        if fresh and close >= lvl and low <= lvl + z
            // Approached from above and the close stayed over it: defended.
            array.set(tests, i, array.get(tests, i) + 1)
            array.set(defs,  i, array.get(defs, i) + 1)
            if markEvents
                label.new(bar_index, low, "held", style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny)
        else if fresh and close < lvl and high >= lvl - z
            // Approached from below and the close stayed under it: rejected.
            array.set(tests, i, array.get(tests, i) + 1)
            array.set(defs,  i, array.get(defs, i) + 1)
            if markEvents
                label.new(bar_index, high, "rejected", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.tiny)
        if close < lvl - z and close[1] >= lvl - z
            array.set(brks, i, array.get(brks, i) + 1)
            if markEvents
                label.new(bar_index, high, "broke down", style = label.style_label_down, color = color.new(#616161, 0), textcolor = color.white, size = size.tiny)
        if close > lvl + z and close[1] <= lvl + z
            array.set(brks, i, array.get(brks, i) + 1)
            if markEvents
                label.new(bar_index, low, "broke up", style = label.style_label_up, color = color.new(#616161, 0), textcolor = color.white, size = size.tiny)
        array.set(wasIn, i, inZone)

// ── Drawing: fixed line/label set, moved with the anchor, coloured by role ──
var line[]  lns = array.new_line(7)
var label[] lbs = array.new_label(7)
var box zoneBox = na
cSup  = color.new(#2e7d32, 10)
cRes  = color.new(#b71c1c, 10)
cTest = color.new(#FF9800, 0)
cEdge = color.new(color.gray, 40)
if gridOn
    if na(zoneBox)
        zoneBox := box.new(bar_index - 50, f_lvl(3), bar_index + 50, f_lvl(4), border_color = color.new(color.gray, 100), bgcolor = color.new(#FFEB3B, 92))
    box.set_lefttop(zoneBox, bar_index - 50, f_lvl(3))
    box.set_rightbottom(zoneBox, bar_index + 50, f_lvl(4))
    for i = 0 to 6
        lvl = f_lvl(i)
        z = lvl * tolPct / 100.0
        testing = low <= lvl + z and high >= lvl - z
        c = testing ? cTest : close >= lvl ? cSup : cRes
        w = (i == 0 or i == 6) ? 1 : 2
        ln = array.get(lns, i)
        if na(ln)
            ln := line.new(bar_index - 50, lvl, bar_index + 50, lvl, xloc = xloc.bar_index, extend = extend.both, color = c, width = w, style = (i == 0 or i == 6) ? line.style_dashed : line.style_solid)
            array.set(lns, i, ln)
        else
            line.set_xy1(ln, bar_index - 50, lvl)
            line.set_xy2(ln, bar_index + 50, lvl)
            line.set_color(ln, c)
        lb = array.get(lbs, i)
        txt = f_pct(i) + " " + str.tostring(lvl, format.mintick) + " — " + f_behav(i)
        if na(lb)
            lb := label.new(bar_index, lvl, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = size.small)
            array.set(lbs, i, lb)
        else
            label.set_xy(lb, bar_index, lvl)
            label.set_text(lb, txt)
            label.set_textcolor(lb, c)

// ── HUD: plain words — anchor, nearest above/below, live test, best level ──
f_conf(lvl) =>
    s = ""
    tol = lvl * 0.0015
    if not na(pdh) and math.abs(lvl - pdh) <= tol
        s := "PDH " + str.tostring(pdh, format.mintick)
    else if not na(pdl) and math.abs(lvl - pdl) <= tol
        s := "PDL " + str.tostring(pdl, format.mintick)
    else if not na(dSma20) and math.abs(lvl - dSma20) <= tol
        s := "daily 20 SMA " + str.tostring(dSma20, format.mintick)
    else if not na(dSma50) and math.abs(lvl - dSma50) <= tol
        s := "daily 50 SMA " + str.tostring(dSma50, format.mintick)
    else if not na(dSma200) and math.abs(lvl - dSma200) <= tol
        s := "daily 200 SMA " + str.tostring(dSma200, format.mintick)
    s

var table hud = showHud ? table.new(position.top_right, 2, 5, bgcolor = color.new(#0d1318, 5), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1) : na
if showHud and barstate.islast
    if gridOn
        aboveTxt = "None — price is over the top of the grid"
        belowTxt = "None — price is under the bottom of the grid"
        nowTxt = "Between levels — no test live"
        bestTxt = "No defenses yet on this grid"
        bestD = 0
        confTxt = "Nearest levels line up with nothing"
        for i = 0 to 6
            lvl = f_lvl(i)
            z = lvl * tolPct / 100.0
            if lvl > close
                // Loop runs high→low price, so the LAST level still over price is the nearest above.
                aboveTxt := f_pct(i) + " " + str.tostring(lvl, format.mintick) + " — " + f_behav(i)
            if lvl <= close
                // first level at/under price in high→low order is the nearest below; only set once
                if belowTxt == "None — price is under the bottom of the grid"
                    belowTxt := f_pct(i) + " " + str.tostring(lvl, format.mintick) + " — " + f_behav(i)
            if low <= lvl + z and high >= lvl - z
                nowTxt := "Testing the " + f_pct(i) + " level now"
            d = array.get(defs, i)
            if d > bestD
                bestD := d
                bestTxt := f_pct(i) + " at " + str.tostring(lvl, format.mintick) + " — defended " + str.tostring(d) + " time" + (d == 1 ? "" : "s") + ", strongest on this grid"
        for i = 0 to 6
            lvl = f_lvl(i)
            cf = f_conf(lvl)
            if cf != "" and confTxt == "Nearest levels line up with nothing" and math.abs(lvl - close) <= (aHi - aLo) * 0.5
                confTxt := f_pct(i) + " lines up with " + cf
        table.cell(hud, 0, 0, "Fib on",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 0, aTxt,        text_color = color.white,  text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 1, "Above",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 1, aboveTxt,    text_color = color.white,  text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 2, "Below",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 2, belowTxt,    text_color = color.white,  text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 3, "Now",       text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 3, nowTxt,      text_color = color.white,  text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 4, "Strongest", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 4, bestTxt + " · " + confTxt, text_color = color.white, text_size = size.small, text_halign = text.align_right)
    else
        table.cell(hud, 0, 0, "Fib on",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 0, "No grid yet — waiting for the anchor", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 1, "Above",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 1, "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 2, "Below",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 2, "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 3, "Now",       text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 3, "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(hud, 0, 4, "Strongest", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(hud, 1, 4, "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
