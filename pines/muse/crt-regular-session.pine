//@version=5
// crt-regular-session v2026.11.16.8 — version is in the indicator title too: if the chart legend
// does not show this exact version, the chart is running an older copy.
// ─────────────────────────────────────────────────────────────────────────────
// CRT · REGULAR SESSION — Candle Range Theory / Power-of-3 overlay, RTH-ONLY.
//
//   The problem this solves: the usual CRT / HTF-candle overlays build the higher-
//   timeframe candle from the 24-HOUR feed, so the prior candle's HIGH and LOW
//   include pre- and post-market prints. On a name that spikes overnight, the CRT
//   "liquidity" lines sit at extended-hours extremes that regular-session price
//   never traded — the levels are wrong for an RTH trader.
//
//   The fix: every HTF candle's High / Low / Open / Close is read through a
//   REGULAR-SESSION ticker (ticker.new(..., session.regular)), so extended-hours
//   ticks can't leak into the range. Same idiom the proximity-levels pine uses.
//
//   What it draws — for each higher-timeframe candle (default DAILY), once it has
//   completed, its three CRT levels are drawn as flat lines ANCHORED AT THAT
//   CANDLE (where the level was made) and run to the right across the following
//   candle, so each level maps back to its source candle on the left — not
//   floating off to the right of where the high/low actually printed:
//     • CRT HIGH  — the prior candle's RTH high  (liquidity / resistance above)
//     • CRT LOW   — the prior candle's RTH low   (liquidity / support below)
//     • CRT MID   — the 50% equilibrium of that range
//   Optional SWEEP marks: when the active candle trades through the prior high
//   (purge up) or prior low (purge down) and the sweep is the manipulation leg,
//   a small tag flags it.
//
//   CONFLUENCE TAGS (default "Confluence only"): the pine also computes the key
//   structural levels — prior DAY / week / month / quarter H-L, the 8/21/50/200
//   SMA, and the last swing H/L, all RTH — and tags a CRT high/low ONLY when it
//   sits within the tolerance of one of them, naming what it lines up with
//   ("CRT Low · PDL · 200 SMA"). No confluence → no tag, just the line.
//   Confluence is re-checked on the LAST bar against the CURRENT level values
//   (not frozen at the candle's birth), so the newest CRT low that equals today's
//   PDL is tagged PDL, an older CRT level is tagged only if it STILL lines up, and
//   SMA/swing tags show where those levels sit now.
//
//   NON-REPAINTING: the prior candle is SETTLED (high[1]/low[1] + lookahead_on),
//   so historical lines never move. The active candle's sweep test uses the live
//   high/low vs those settled levels. VISUAL ONLY — no alertcondition emitted.
//   Set the CRT timeframe to one step ABOVE your chart (Daily on a 1h/4h chart,
//   Weekly on a Daily); it must not be lower than the chart timeframe.
// ─────────────────────────────────────────────────────────────────────────────
indicator("CRT · Regular Session · v2026.11.16.8", shorttitle = "CRT RTH", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Inputs ──
gC   = "CRT"
htf     = input.timeframe("D", "CRT candle timeframe", group = gC, tooltip = "The higher-timeframe candle whose high/low/mid become the CRT levels. Daily on a 1h/4h chart, Weekly on a Daily. Must be ONE STEP UP from the chart timeframe, never lower.")
nShow   = input.int(10, "Candles to display (most recent)", minval = 1, maxval = 120, group = gC)
showMid = input.bool(false, "Show the CRT mid (50% equilibrium)", group = gC)
rightPad = input.int(2, "Extend lines right (bars past the active candle)", minval = 0, maxval = 40, group = gC)

gSw  = "Sweeps (manipulation leg)"
showSweep = input.bool(false, "Flag when the active candle sweeps the prior high / low", group = gSw, tooltip = "A sweep = the active candle trades BEYOND the prior candle's high (purge up) or low (purge down) — the Power-of-3 manipulation leg that grabs liquidity before the real move. Marked once per side per candle, at the bar the level is first taken.")
sweepHiCol = input.color(#EF5350, "Sweep ↑ (high taken)", group = gSw, inline = "sw")
sweepLoCol = input.color(#26A69A, "Sweep ↓ (low taken)",  group = gSw, inline = "sw")

gV   = "Style"
hiCol   = input.color(#EF5350,      "CRT High colour",  group = gV, inline = "h")
loCol   = input.color(#26A69A,       "CRT Low colour",   group = gV, inline = "l")
midCol  = input.color(color.new(color.gray, 0), "CRT Mid colour", group = gV, inline = "m")
wLine   = input.int(2, "Line width", minval = 1, maxval = 6, group = gV)
lineStyleIn = input.string("solid", "Line style", options = ["solid", "dashed", "dotted"], group = gV)
midStyleIn  = input.string("dotted", "Mid line style", options = ["solid", "dashed", "dotted"], group = gV)
tagSize = input.string("small", "Label size", options = ["tiny", "small", "normal"], group = gV)

gCf  = "Confluence tags"
tagMode = input.string("Confluence only", "Show CRT tags", options = ["Confluence only", "All", "None"], group = gCf, tooltip = "Confluence only (default): a CRT high/low gets a tag ONLY when it lines up (within the tolerance) with one of the structural levels ticked below — and the tag names what it confluences with, so only the levels that actually matter are labelled. All: tag every CRT level. None: lines only, no tags.")
confTol = input.float(0.3, "Confluence tolerance %", minval = 0.05, maxval = 3.0, step = 0.05, group = gCf, tooltip = "How close (as a % of price) a CRT level must sit to a structural level to count as confluent.") / 100.0
cfDay   = input.bool(true,  "vs prior day H/L (PDH/PDL)", group = gCf, tooltip = "Tags a CRT level that sits on the prior-day high/low. On a daily CRT the newest CRT high/low IS today's PDH/PDL, so it's tagged; older CRT levels are tagged only if they still line up with today's PDH/PDL.")
cfWeek  = input.bool(true,  "vs prior week H/L",    group = gCf, inline = "cf1")
cfMonth = input.bool(true,  "vs prior month H/L",   group = gCf, inline = "cf1")
cfQtr   = input.bool(false, "vs prior quarter H/L", group = gCf, inline = "cf2")
cfSma   = input.bool(true,  "vs 8 / 21 / 50 / 200 SMA", group = gCf, inline = "cf2")
cfSwing = input.bool(true,  "vs swing H/L (pivot 5,5)", group = gCf)

f_style(string s) => s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid
_lineStyle = f_style(lineStyleIn)
_midStyle  = f_style(midStyleIn)
_tagSz     = tagSize == "normal" ? size.normal : tagSize == "tiny" ? size.tiny : size.small

// ── Regular-session HTF candle — the whole point: high/low from RTH only ──
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
// SETTLED prior completed candle (non-repainting). high[1]/low[1] on the HTF = the candle
// that just finished; with lookahead_on it is locked in as soon as the new candle opens.
[pH, pL] = request.security(rthTid, htf, [high[1], low[1]], lookahead = barmerge.lookahead_on)
mid = na(pH) or na(pL) ? na : (pH + pL) / 2.0

// A new HTF candle has opened on the chart (works on any chart TF ≤ htf).
newC = timeframe.change(htf)

// ── Confluence pool — structural levels a CRT line can line up with (RTH, settled, non-repainting).
//    The CRT candle's OWN timeframe prior H/L is deliberately NOT here (that would be self-confluence);
//    we check against OTHER structure: prior week / month / quarter H-L, the 50/200 SMA, and swings. ──
[cfPdh, cfPdl]  = request.security(rthTid, "D",  [high[1], low[1]], lookahead = barmerge.lookahead_on)
[cfPwh, cfPwl]  = request.security(rthTid, "W",  [high[1], low[1]], lookahead = barmerge.lookahead_on)
[cfPmh, cfPml]  = request.security(rthTid, "M",  [high[1], low[1]], lookahead = barmerge.lookahead_on)
[cfPqh, cfPql]  = request.security(rthTid, "3M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[cfS8, cfS21, cfS50, cfS200] = request.security(syminfo.tickerid, "D", [ta.sma(close, 8)[1], ta.sma(close, 21)[1], ta.sma(close, 50)[1], ta.sma(close, 200)[1]], lookahead = barmerge.lookahead_on)
f_swh() =>
    _p = ta.pivothigh(5, 5)
    ta.valuewhen(not na(_p), _p, 0)
f_swl() =>
    _p = ta.pivotlow(5, 5)
    ta.valuewhen(not na(_p), _p, 0)
[cfSwH, cfSwL]  = request.security(rthTid, "D", [f_swh(), f_swl()], lookahead = barmerge.lookahead_on)

// names every structural level a CRT price sits within confTol of; "" = no confluence
f_hit(float lvl, float ref) => not na(ref) and ref > 0 and math.abs(lvl - ref) / lvl <= confTol
f_conf(float lvl) =>
    string _o = ""
    if not na(lvl) and lvl > 0
        if cfDay and f_hit(lvl, cfPdh)
            _o := _o + (_o == "" ? "" : " · ") + "PDH"
        if cfDay and f_hit(lvl, cfPdl)
            _o := _o + (_o == "" ? "" : " · ") + "PDL"
        if cfWeek and f_hit(lvl, cfPwh)
            _o := _o + (_o == "" ? "" : " · ") + "PWH"
        if cfWeek and f_hit(lvl, cfPwl)
            _o := _o + (_o == "" ? "" : " · ") + "PWL"
        if cfMonth and f_hit(lvl, cfPmh)
            _o := _o + (_o == "" ? "" : " · ") + "PMH"
        if cfMonth and f_hit(lvl, cfPml)
            _o := _o + (_o == "" ? "" : " · ") + "PML"
        if cfQtr and f_hit(lvl, cfPqh)
            _o := _o + (_o == "" ? "" : " · ") + "PQH"
        if cfQtr and f_hit(lvl, cfPql)
            _o := _o + (_o == "" ? "" : " · ") + "PQL"
        if cfSma and f_hit(lvl, cfS8)
            _o := _o + (_o == "" ? "" : " · ") + "8 SMA"
        if cfSma and f_hit(lvl, cfS21)
            _o := _o + (_o == "" ? "" : " · ") + "21 SMA"
        if cfSma and f_hit(lvl, cfS50)
            _o := _o + (_o == "" ? "" : " · ") + "50 SMA"
        if cfSma and f_hit(lvl, cfS200)
            _o := _o + (_o == "" ? "" : " · ") + "200 SMA"
        if cfSwing and f_hit(lvl, cfSwH)
            _o := _o + (_o == "" ? "" : " · ") + "Swing H"
        if cfSwing and f_hit(lvl, cfSwL)
            _o := _o + (_o == "" ? "" : " · ") + "Swing L"
    _o

// ── State: the active candle's three lines, extended each bar ──
var line  hiLn = na
var line  loLn = na
var line  miLn = na
var int   activeStart = na     // start bar of the CURRENT (active) candle
var int   originStart = na     // start bar of the candle that MADE the level being drawn (the anchor)
var bool  sweptHi = false      // already flagged this candle's high sweep?
var bool  sweptLo = false

// history (older candles' finished segments), trimmed to nShow. We keep each line's price + side so
// confluence can be re-checked against the CURRENT structure on the last bar, not frozen at birth.
var array<line>   oldLn   = array.new_line()
var array<float>  oldVal  = array.new_float()
var array<string> oldSide = array.new_string()
var array<label>  allLb   = array.new_label()   // confluence tags, rebuilt each last bar

f_retire(_ln, _side) =>
    if not na(_ln)
        array.push(oldLn, _ln)
        array.push(oldVal, line.get_y1(_ln))
        array.push(oldSide, _side)

// each candle contributes up to 3 lines; keep the most recent nShow
f_trim() =>
    _max = nShow * 3
    while array.size(oldLn) > _max
        line.delete(array.shift(oldLn))
        array.shift(oldVal)
        array.shift(oldSide)

if newC and not na(pH) and not na(pL)
    // retire the segment that just closed, then open a fresh one. ANCHOR at the ORIGIN candle —
    // the one whose high/low this level is (the candle that just completed) — so the line starts
    // where the level was made (on the left) and runs right, instead of floating off to the right.
    f_retire(hiLn, "H")
    f_retire(loLn, "L")
    f_retire(miLn, "M")
    f_trim()
    originStart := na(activeStart) ? bar_index : activeStart   // the just-completed candle's start = the level's source
    activeStart := bar_index
    _x2 = bar_index + rightPad
    hiLn := line.new(originStart, pH, _x2, pH, color = hiCol, width = wLine, style = _lineStyle)
    loLn := line.new(originStart, pL, _x2, pL, color = loCol, width = wLine, style = _lineStyle)
    miLn := showMid ? line.new(originStart, mid, _x2, mid, color = midCol, width = 1, style = _midStyle) : na
    sweptHi := false
    sweptLo := false

// extend the active segment to the live edge each bar
if not na(hiLn)
    _x2 = bar_index + rightPad
    line.set_x2(hiLn, _x2)
    line.set_x2(loLn, _x2)
    if not na(miLn)
        line.set_x2(miLn, _x2)

// ── Tags — rebuilt on the LAST bar, confluence checked against CURRENT structure (so the newest
//    CRT low that equals today's PDL is tagged PDL, an older CRT level only if it STILL lines up,
//    and SMA/swing tags reflect where those levels sit now). ──
f_tagCol(string _s) => _s == "H" ? hiCol : _s == "L" ? loCol : midCol
f_tagText(float _v, string _s) =>
    _conf = _s == "M" ? "" : f_conf(_v)
    _base = _s == "H" ? "CRT High" : _s == "L" ? "CRT Low" : "CRT Mid"
    [_base + (_conf == "" ? "" : "  · " + _conf), _conf]
f_wantTag(string _s, string _conf) => _s == "M" ? (tagMode == "All") : (tagMode == "All" or (tagMode == "Confluence only" and _conf != ""))
f_drawTag(float _v, string _s, int _x) =>
    [_txt, _conf] = f_tagText(_v, _s)
    if f_wantTag(_s, _conf)
        array.push(allLb, label.new(_x, _v, _txt, style = label.style_label_left, color = color.new(f_tagCol(_s), 80), textcolor = f_tagCol(_s), size = _tagSz))

if barstate.islast
    for _l in allLb
        label.delete(_l)
    array.clear(allLb)
    // historical levels — value + side stored; tag sits at the line's frozen right edge
    if array.size(oldLn) > 0
        for i = 0 to array.size(oldLn) - 1
            f_drawTag(array.get(oldVal, i), array.get(oldSide, i), line.get_x2(array.get(oldLn, i)))
    // active levels — at the live right edge
    _ax = bar_index + rightPad
    if not na(hiLn)
        f_drawTag(pH, "H", _ax)
        f_drawTag(pL, "L", _ax)
        if not na(miLn)
            f_drawTag(mid, "M", _ax)

// ── Sweeps — the manipulation leg: active candle takes the prior high / low ──
if showSweep and not na(hiLn)
    if not sweptHi and not na(pH) and high > pH
        sweptHi := true
        label.new(bar_index, pH, "⤒ swept", style = label.style_label_down, yloc = yloc.price, color = color.new(sweepHiCol, 15), textcolor = color.white, size = size.tiny)
    if not sweptLo and not na(pL) and low < pL
        sweptLo := true
        label.new(bar_index, pL, "⤓ swept", style = label.style_label_up, yloc = yloc.price, color = color.new(sweepLoCol, 15), textcolor = color.white, size = size.tiny)
