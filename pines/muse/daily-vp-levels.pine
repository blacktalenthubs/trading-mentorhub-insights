//@version=5
// DAILY VOLUME PROFILE LEVELS — POC / VAH / VAL — v2026.10.31.1
// ═════════════════════════════════════════════════════════════════════════════
// ONLY the daily volume profile's three levels, drawn as flat lines with tags:
// the POC (red), the Value Area High and Low (orange). Nothing else.
//
// Split out of "Proximity Levels · HLC +TD/Swing" at Victor's request
// (2026-10-30): the levels are useful enough to deserve their own indicator,
// and the Prox chart was getting cluttered. Toggle this one on/off on its own.
//
// The math is VP Pro v2's own, unchanged: last 150 bars, 30-minute sub-bars
// collected through VP Pro's collection patterns. "Lock profile to Daily"
// defaults ON — the profile is the daily one on any chart. Turn it OFF to
// unlock VP Pro's original behaviour: the profile of the chart's own
// timeframe (last 150 bars of whatever you are viewing).
// f_dailyFlat pattern, 35 price rows, each sub-bar's volume distributed over
// the rows its range overlaps, POC = the heaviest row's centre, and the value
// area grown two rows at a time from the POC until it holds 70% of the volume.
// Validated against VP Pro on SPY (2026-10-30): POC 766.39, VAH 777.27,
// VAL 729.39 — exact. Keep these settings in step with VP Pro's if you change
// them there (bars back / rows / VA%).
//
// ANY-TIMEFRAME FIX (v2026.10.31.1): the Daily path's sub-bar request is now
// clamped to the chart timeframe (VP Pro v2's own LTF guard, applied inside
// f_vpFlat). Before, it asked for 30-minute sub-bars unconditionally; on any
// chart finer than 30 minutes (15m, 5m, …) Pine refuses a sub-bar timeframe
// that is not lower than the chart timeframe (RE10066) and the indicator
// failed to load. On sub-2-minute charts the Daily profile falls back to the
// daily bars themselves. The unlocked path below already had this guard.
// ═════════════════════════════════════════════════════════════════════════════
indicator("Daily VP Levels · POC/VAH/VAL v2026.10.31.1", "Daily VP Levels", overlay = true, max_lines_count = 10, max_labels_count = 10)

gP = "Profile (VP Pro settings)"
lockDaily = input.bool(true, "Lock profile to Daily timeframe", group = gP, tooltip = "ON (default here): the profile is ALWAYS the daily one — last N daily bars — whatever the chart shows. OFF: UNLOCKED, VP Pro's original behaviour — the profile is built from the CHART's own timeframe (last N bars of whatever you are viewing: 150 hours on a 1H chart, 150 15-minute bars on a 15m chart), using the sub-bars below it. On a Daily chart the two modes are identical.")
barsBack = input.int(150, "Bars back", group = gP, minval = 10, maxval = 500)
columns  = input.int(35, "Price rows", group = gP, minval = 5, maxval = 200)
vaPct    = input.float(70.0, "Value area %", group = gP, minval = 1, maxval = 100)
ltfTF    = input.timeframe("30", "Sub-bars (lower timeframe)", group = gP)

gL = "Lines"
showPOC  = input.bool(true, "Show POC", group = gL)
showVA   = input.bool(true, "Show VAH / VAL", group = gL)
pocColor = input.color(color.red, "POC colour", group = gL)
vaColor  = input.color(color.orange, "VAH / VAL colour", group = gL)
pocWidth = input.int(3, "POC line width", group = gL, minval = 1, maxval = 6)
vaWidth  = input.int(2, "VAH / VAL line width", group = gL, minval = 1, maxval = 6)
lblSize  = input.string("small", "Tag size", options = ["tiny", "small", "normal"], group = gL)
histoOffset = input.int(3, "Tags right offset (bars)", group = gL)

tid = syminfo.tickerid
f_sz(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal

// ── data — VP Pro v2's f_dailyFlat pattern: in a Daily security context,
//    collect the last barsBack days and each day's sub-bars, flattened into ONE
//    array returned only on the daily series' last bar.
//    Layout: [startTime, nSub, subH…, subL…, subV…, nDay, dayH…, dayL…, dayV…] ──
// LTF guard for the Daily path — VP Pro v2's own pattern: never request
// sub-bars on a timeframe that is not lower than the CHART timeframe (RE10066
// kills the script on 15m / 5m charts). Declared here, before the
// request.security call below, in chart scope; f_vpFlat reads them from
// inside the Daily context. flatUseSub: on sub-2-minute charts, 150 days of
// sub-bars can exceed Pine's 100k-element array cap, so the profile falls
// back to the daily bars there (the _nSub == 0 path already does that).
flatLtfSecs   = timeframe.in_seconds(ltfTF)
flatChartSecs = timeframe.in_seconds(timeframe.period)
effFlatLTF    = flatLtfSecs < flatChartSecs ? ltfTF : timeframe.period
flatUseSub    = flatChartSecs >= 120
f_vpFlat() =>
    var float[] aH = array.new_float(0)
    var float[] aL = array.new_float(0)
    var float[] aV = array.new_float(0)
    var float[] dH = array.new_float(0)
    var float[] dL = array.new_float(0)
    var float[] dV = array.new_float(0)
    var int lastDay = na
    var float wStart = na
    _h = request.security_lower_tf(tid, effFlatLTF, high)
    _l = request.security_lower_tf(tid, effFlatLTF, low)
    _v = request.security_lower_tf(tid, effFlatLTF, volume)
    if lockDaily and bar_index >= last_bar_index - barsBack + 1 and (na(lastDay) or bar_index != lastDay)
        lastDay := bar_index
        if na(wStart)
            wStart := time
        array.push(dH, high)
        array.push(dL, low)
        array.push(dV, nz(volume))
        if flatUseSub and timeframe.in_seconds(effFlatLTF) < 86400
            _nn = na(_h) ? 0 : array.size(_h)
            if _nn > 0
                for _s = 0 to _nn - 1
                    array.push(aH, array.get(_h, _s))
                    array.push(aL, array.get(_l, _s))
                    array.push(aV, nz(array.get(_v, _s)))
    _out = array.new_float(0)
    if barstate.islast and array.size(dH) > 0
        array.push(_out, wStart)
        array.push(_out, array.size(aH))
        if array.size(aH) > 0
            for _s = 0 to array.size(aH) - 1
                array.push(_out, array.get(aH, _s))
            for _s = 0 to array.size(aH) - 1
                array.push(_out, array.get(aL, _s))
            for _s = 0 to array.size(aH) - 1
                array.push(_out, array.get(aV, _s))
        array.push(_out, array.size(dH))
        for _s = 0 to array.size(dH) - 1
            array.push(_out, array.get(dH, _s))
        for _s = 0 to array.size(dH) - 1
            array.push(_out, array.get(dL, _s))
        for _s = 0 to array.size(dH) - 1
            array.push(_out, array.get(dV, _s))
    _out
dFlat = request.security(tid, "D", f_vpFlat())

// ── unlocked (chart-timeframe) path — VP Pro v2's original collection: sub-bars
//    of a lower timeframe for each of the last barsBack CHART bars. Only runs
//    when the Daily lock is off (or the chart itself is Daily, where the two
//    paths coincide). LTF guard: never request a TF higher than the chart TF. ──
chartIsDaily = timeframe.period == "D"
useDaily = lockDaily and not chartIsDaily
ltfSecs = timeframe.in_seconds(ltfTF)
chartSecs = timeframe.in_seconds(timeframe.period)
effLtfTF = ltfSecs < chartSecs ? ltfTF : timeframe.period
ltfH = request.security_lower_tf(tid, effLtfTF, high)
ltfL = request.security_lower_tf(tid, effLtfTF, low)
ltfV = request.security_lower_tf(tid, effLtfTF, volume)
ltfN = na(ltfH) ? 0 : array.size(ltfH)
var float[] subH = array.new_float(0)
var float[] subL = array.new_float(0)
var float[] subV = array.new_float(0)
var int lastSubBar = na
if not useDaily and bar_index >= last_bar_index - barsBack + 1 and (na(lastSubBar) or bar_index != lastSubBar) and ltfN > 0
    lastSubBar := bar_index
    for _s = 0 to ltfN - 1
        array.push(subH, array.get(ltfH, _s))
        array.push(subL, array.get(ltfL, _s))
        array.push(subV, nz(array.get(ltfV, _s)))

var float vpPOC = na
var float vpVAH = na
var float vpVAL = na

// ── build + draw on the last bar — VP Pro v2's math, step for step. Data comes
//    from the Daily path when locked (or the chart path when unlocked); the
//    profile build itself is identical either way. ──
var array<line> _lines = array.new_line()
var array<label> _lbls = array.new_label()
if barstate.islast
    dataH = array.new_float(0)
    dataL = array.new_float(0)
    dataV = array.new_float(0)
    float _winHi = na
    float _winLo = na
    int _xL = na
    int _xR = na
    _xl = xloc.bar_index
    if useDaily
        if array.size(dFlat) > 6
            _nSub = int(array.get(dFlat, 1))
            _dayOff = 2 + 3 * _nSub
            _nDay = int(array.get(dFlat, _dayOff))
            for _d = 0 to _nDay - 1
                _dH = array.get(dFlat, _dayOff + 1 + _d)
                _dL = array.get(dFlat, _dayOff + 1 + _nDay + _d)
                _winHi := na(_winHi) ? _dH : math.max(_winHi, _dH)
                _winLo := na(_winLo) ? _dL : math.min(_winLo, _dL)
            if _nSub > 0
                for _s = 0 to _nSub - 1
                    array.push(dataH, array.get(dFlat, 2 + _s))
                    array.push(dataL, array.get(dFlat, 2 + _nSub + _s))
                    array.push(dataV, array.get(dFlat, 2 + 2 * _nSub + _s))
            else if _nDay > 0
                for _d = 0 to _nDay - 1
                    array.push(dataH, array.get(dFlat, _dayOff + 1 + _d))
                    array.push(dataL, array.get(dFlat, _dayOff + 1 + _nDay + _d))
                    array.push(dataV, array.get(dFlat, _dayOff + 1 + 2 * _nDay + _d))
            _xl := xloc.bar_time
            _xL := int(array.get(dFlat, 0))
            _xR := time + int(histoOffset * timeframe.in_seconds(timeframe.period) * 1000)
    else
        _n = math.min(barsBack, bar_index)
        if array.size(subH) > 0
            for _s = 0 to array.size(subH) - 1
                array.push(dataH, array.get(subH, _s))
                array.push(dataL, array.get(subL, _s))
                array.push(dataV, array.get(subV, _s))
        else if _n >= 1
            for _f = 0 to _n - 1
                array.push(dataH, high[_f])
                array.push(dataL, low[_f])
                array.push(dataV, nz(volume[_f]))
        if _n >= 2
            _winHi := high
            _winLo := low
            for _b = 0 to _n - 1
                _winHi := math.max(_winHi, high[_b])
                _winLo := math.min(_winLo, low[_b])
        _xl := xloc.bar_index
        _xL := math.max(bar_index - _n + 1, bar_index - 9000)
        _xR := bar_index + histoOffset
    if not na(_winHi) and not na(_winLo) and array.size(dataH) > 0 and not na(_xL)
        _rng = _winHi - _winLo
        if _rng > 0
            _bs = _rng / columns
            vol = array.new_float(columns, 0.0)
            for _b = 0 to array.size(dataH) - 1
                _bLo = array.get(dataL, _b)
                _bHi = array.get(dataH, _b)
                _bV = nz(array.get(dataV, _b))
                _loI = int(math.floor((_bLo - _winLo) / _bs))
                _hiI = int(math.floor((_bHi - _winLo) / _bs))
                _loI := math.max(0, math.min(columns - 1, _loI))
                _hiI := math.max(0, math.min(columns - 1, _hiI))
                if _bHi <= _bLo
                    array.set(vol, _loI, array.get(vol, _loI) + _bV)
                else
                    for _k = _loI to _hiI
                        _rBot = _winLo + _k * _bs
                        _rTop = _rBot + _bs
                        _ov = math.min(_bHi, _rTop) - math.max(_bLo, _rBot)
                        if _ov > 0
                            array.set(vol, _k, array.get(vol, _k) + _bV * _ov / (_bHi - _bLo))
            _total = 0.0
            _maxV  = 0.0
            _poc   = 0
            for _k = 0 to columns - 1
                _v = array.get(vol, _k)
                _total += _v
                if _v > _maxV
                    _maxV := _v
                    _poc  := _k
            _vaVol  = array.get(vol, _poc)
            _up     = _poc
            _dn     = _poc
            _target = _total * vaPct / 100.0
            _go     = _total > 0
            while _go
                if _vaVol >= _target
                    _go := false
                else
                    _upN = math.min(2, columns - 1 - _up)
                    _dnN = math.min(2, _dn)
                    if _upN <= 0 and _dnN <= 0
                        _go := false
                    else
                        _upS = (_upN >= 1 ? array.get(vol, _up + 1) : 0.0) + (_upN >= 2 ? array.get(vol, _up + 2) : 0.0)
                        _dnS = (_dnN >= 1 ? array.get(vol, _dn - 1) : 0.0) + (_dnN >= 2 ? array.get(vol, _dn - 2) : 0.0)
                        if _upN > 0 and (_dnN <= 0 or _upS >= _dnS)
                            for _j = 1 to _upN
                                _up := _up + 1
                                _vaVol := _vaVol + array.get(vol, _up)
                        else
                            for _j = 1 to _dnN
                                _dn := _dn - 1
                                _vaVol := _vaVol + array.get(vol, _dn)
            vpVAH := _winLo + (_up + 1) * _bs
            vpVAL := _winLo + _dn * _bs
            vpPOC := _winLo + (_poc + 0.5) * _bs
            // redraw: clear the previous frame, then draw the three lines flat
            if array.size(_lines) > 0
                for _i = 0 to array.size(_lines) - 1
                    line.delete(array.get(_lines, _i))
                array.clear(_lines)
            if array.size(_lbls) > 0
                for _i = 0 to array.size(_lbls) - 1
                    label.delete(array.get(_lbls, _i))
                array.clear(_lbls)
            if showPOC and not na(vpPOC)
                array.push(_lines, line.new(_xL, vpPOC, _xR, vpPOC, xloc = _xl, color = pocColor, width = pocWidth))
                _t = (close >= vpPOC ? "▲ SUPPORT " : "▼ RESIST ") + "POC " + str.tostring(vpPOC, format.mintick)
                array.push(_lbls, label.new(_xR, vpPOC, _t, xloc = _xl, yloc = yloc.price, style = label.style_label_left, color = pocColor, textcolor = color.white, size = f_sz(lblSize)))
            if showVA and not na(vpVAH)
                array.push(_lines, line.new(_xL, vpVAH, _xR, vpVAH, xloc = _xl, color = vaColor, width = vaWidth))
                _t = (close >= vpVAH ? "▲ SUPPORT " : "▼ RESIST ") + "VAH " + str.tostring(vpVAH, format.mintick)
                array.push(_lbls, label.new(_xR, vpVAH, _t, xloc = _xl, yloc = yloc.price, style = label.style_label_left, color = vaColor, textcolor = color.white, size = f_sz(lblSize)))
            if showVA and not na(vpVAL)
                array.push(_lines, line.new(_xL, vpVAL, _xR, vpVAL, xloc = _xl, color = vaColor, width = vaWidth))
                _t = (close >= vpVAL ? "▲ SUPPORT " : "▼ RESIST ") + "VAL " + str.tostring(vpVAL, format.mintick)
                array.push(_lbls, label.new(_xR, vpVAL, _t, xloc = _xl, yloc = yloc.price, style = label.style_label_left, color = vaColor, textcolor = color.white, size = f_sz(lblSize)))

// hidden plots so the values show in the Data Window and other scripts can read them
plot(vpPOC, "POC", display = display.none)
plot(vpVAH, "VAH", display = display.none)
plot(vpVAL, "VAL", display = display.none)
