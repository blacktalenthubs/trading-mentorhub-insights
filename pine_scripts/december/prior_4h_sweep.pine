//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// PRIOR 4H SWEEP — trade the next 4h candle off the one that just closed.
// ─────────────────────────────────────────────────────────────────────────────
// The reference is ALWAYS the last COMPLETED 4h candle — its HIGH, LOW and CLOSE.
// Unlike the frozen "yesterday's last 4h", this one ROLLS: the instant a new 4h
// candle closes, the lines jump to it. You are always reading the freshest 4h
// footprint while you trade the forming one underneath it.
//
// Two ways price interacts with a 4h HIGH or LOW, and each one is a trade:
//
//   ① MANIPULATION  (sweep + reclaim — the A+ setup)
//      Price pokes a level with a WICK, grabs the stops sitting beyond it, then
//      CLOSES back through. That poke was a liquidity grab, so you FADE it.
//        • wick ABOVE the 4h HIGH, close back under  →  SHORT   stop = the wick HIGH
//        • wick BELOW the 4h LOW,  close back over   →  LONG    stop = the wick LOW
//      The swept wick is the stop because if price reclaims it, the grab was real
//      and you're wrong. Tight stop, the opposite 4h level is the natural target.
//      The reclaim can be the SAME 15m bar (poke + close back) or a bar or two
//      later (poke, looks like a break, then fails back through) — both caught.
//
//   ② CLEAN BREAK  (no manipulation — just go with it)
//      No wick-and-reclaim: price just CLOSES clean through the level and holds.
//        • confirmed close ABOVE the 4h HIGH  →  LONG    stop = the prior 4h LOW
//        • confirmed close BELOW the 4h LOW   →  SHORT   stop = the prior 4h HIGH
//      Here the stop is the OPPOSITE 4h extreme — the most recent 4h low/high —
//      a structural stop, because a clean break should not come back inside the
//      whole prior candle.
//
// ONE TRADE AT A TIME. The instant an entry fires it becomes the active read and
// locks the book: NO new entry — sweep or break, either side — fires until a
// confirmed close takes out its stop. A short sweep's stop is the swept wick HIGH,
// so only a close ABOVE that wick frees it; price poking back above the 4h HIGH
// (but closing under the wick) does NOT flip us long. That is what kills the
// sweep-up / sweep-down chop. The live LONG/SHORT tag + its stop ray stay on the
// chart until the stop is closed through, then clear — one setup on screen, ever.
//
// RUN THIS ON YOUR TRIGGER CHART — 15-MINUTE RECOMMENDED. The "15m close" you use
// to confirm a reclaim/break IS the chart-bar close here, so the chart timeframe
// is the confirmation timeframe. The 4h levels come settled [1] + lookahead →
// non-repainting, and by default use the symbol EXACTLY as shown on your chart,
// so the reference 4h candle matches whatever you see — 24h crypto/FX or a stock
// on a 24h / extended-hours chart. (Session input can force stock RTH if needed.)
//
// ALERTS — rules p4h_long / p4h_short, same JSON payload shape as the rest of the
// setup. Bind ONE alert on this study: condition "Any alert() function call",
// webhook on.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Prior 4H Sweep", "4H-SWP", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Inputs ───────────────────────────────────────────────────────────────────
gS       = "Structure"
structTF = input.timeframe("240", "Prior-candle timeframe", group = gS, tooltip = "Source of the HIGH/LOW/CLOSE levels. 240 = 4h. The levels roll to the newest completed candle at every close of this timeframe.")

gL       = "Levels"
showHi   = input.bool(true,  "High",  inline = "l1", group = gL)
showLo   = input.bool(true,  "Low",   inline = "l1", group = gL)
showCl   = input.bool(true,  "Close", inline = "l1", group = gL)
supCol   = input.color(#26a69a, "Support (price above)",  group = gL)
resCol   = input.color(#ef5350, "Resistance (price below)", group = gL)
clCol    = input.color(#9598a1, "Close line",            group = gL)
lvlW     = input.int(2, "Line width", minval = 1, maxval = 5, group = gL)
lvlStyle = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = gL)
lineLen  = input.int(60, "Line length left (bars)",  minval = 5, maxval = 500, group = gL)
rightPad = input.int(14, "Extend right (bars)",      minval = 0, maxval = 100, group = gL)
tagSize  = input.string("Small", "Tag size", options = ["Tiny", "Small", "Normal", "Large"], group = gL)
showPx   = input.bool(true, "Show price on tags", group = gL)

gE       = "Entries"
useManip = input.bool(true, "Manipulation (sweep + reclaim) reversals", group = gE)
useBreak = input.bool(true, "Clean-break momentum entries",             group = gE)
trHi     = input.bool(true, "Trade the 4h HIGH", inline = "t", group = gE)
trLo     = input.bool(true, "Trade the 4h LOW",  inline = "t", group = gE)
showMarks= input.bool(true, "Mark entries + stops on the chart", group = gE)
showStop = input.bool(true, "Draw the stop line when an entry fires", group = gE)
stopCol  = input.color(#f7a600, "Stop", inline = "c", group = gE)
longCol  = input.color(#26a69a, "Long", inline = "c", group = gE)
shortCol = input.color(#ef5350, "Short", inline = "c", group = gE)

gA       = "Alerts"
enAl     = input.bool(true,  "Fire platform alerts", group = gA, tooltip = "Bind ONE alert on this study: condition 'Any alert() function call', webhook on. Rules p4h_long / p4h_short.")
alLong   = input.bool(true,  "Longs",  inline = "a", group = gA)
alShort  = input.bool(true,  "Shorts", inline = "a", group = gA)

// ── Helpers ──────────────────────────────────────────────────────────────────
f_tsz(string s)     => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small
f_lnStyle(string s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// ── Session. On a 24h market (crypto/FX) there is NO regular session, so forcing
//    RTH mangles the 4h candle — it won't line up with the one on your chart.
//    Default "Chart" uses the symbol exactly as displayed, so the reference candle
//    always matches what you see. Flip to "Regular hours" only for stocks when you
//    want pre/post excluded.
gS2      = "Session"
sessMode = input.string("Chart (as shown)", "Session", options = ["Chart (as shown)", "Regular hours (stocks)"], group = gS2, tooltip = "Chart (as shown) = use the symbol exactly as displayed, so the 4h reference candle always matches your chart. Correct for crypto/FX AND for stocks viewed on a 24h / extended-hours chart. Regular hours = stocks RTH only (pre/post excluded) — use only if your chart hides extended hours.")

// ── The rolling prior 4h candle. Settled [1] + lookahead → non-repainting.
//    No day-freeze: these walk to the newest completed 4h candle.
srcTid = sessMode == "Regular hours (stocks)" ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
[pH, pL, pC] = request.security(srcTid, structTF, [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

newCandle = (ta.change(pH) != 0 or ta.change(pL) != 0) and not na(pH) and not na(pL)

// ── ONE active trade at a time. When an entry fires it becomes the active read
//    with its stop; NO new entry (sweep or break, either side) fires until a
//    confirmed close takes that stop out. A short sweep's stop is the swept wick
//    HIGH — only a close ABOVE it frees the book, so we never flip long while the
//    sweep is still valid. That kills the sweep-up / sweep-down chop.
//    Arming (which level got swept + the wick extreme) resets at each 4h roll;
//    the active trade + its stop line persist across rolls until invalidated, so
//    the chart only ever shows the ONE live setup.
var line  actLn      = na
var label actLb      = na
var int   activeDir  = 0        // 0 flat · +1 long · -1 short
var float activeStop = na
var bool  armedHi    = false
var bool  armedLo    = false
var float wickHi     = na
var float wickLo     = na
var int   armedHiBar = na
var int   armedLoBar = na
if newCandle
    armedHi    := false
    armedLo    := false
    wickHi     := na
    wickLo     := na
    armedHiBar := na
    armedLoBar := na

// ── Payload (same schema as the rest of the setup) ───────────────────────────
f_nl() => "4H H " + str.tostring(pH, format.mintick) + " · 4H L " + str.tostring(pL, format.mintick) + " · 4H C " + str.tostring(pC, format.mintick)

f_pay(string rule, string dir, string lvlNm, float lvl, float stp, string note) =>
    '{"symbol":"' + syminfo.ticker + '","price":"' + str.tostring(close, format.mintick) + '","rule":"' + rule + '","direction":"' + dir + '","level":"' + lvlNm + '","interval":"' + timeframe.period + '","entry":"' + str.tostring(close, format.mintick) + '","stop":"' + str.tostring(stp, format.mintick) + '","note":"' + note + '","nearby_levels":"' + f_nl() + '"}'

// ── Draw the active entry: a one-word LONG / SHORT tag + its stop line (a ray to
//    the right at the stop price). Nothing else — the direction and the stop are
//    all you need on the chart. Returns [line, label] so the caller can hold them
//    and delete them when the trade is invalidated.
f_entry(bool isLong, float stopPx, color dirCol, color stopC, string tszS, bool drawSL) =>
    _st = isLong ? label.style_label_up : label.style_label_down
    _y  = isLong ? low : high
    _lb = label.new(bar_index, _y, isLong ? "LONG" : "SHORT", style = _st, color = dirCol, textcolor = color.white, size = f_tsz(tszS))
    line _ln = na
    if drawSL
        _ln := line.new(bar_index, stopPx, bar_index, stopPx, color = stopC, width = 1, style = line.style_dashed, extend = extend.right)
    [_ln, _lb]

// ── Signals — evaluate only on CONFIRMED bars so nothing repaints intrabar ───
f_clearActive() =>
    if not na(actLn)
        line.delete(actLn)
    if not na(actLb)
        label.delete(actLb)

conf = barstate.isconfirmed and not na(pH) and not na(pL)
if conf
    // arm the sweep + track the swept wick extreme for this candle
    if high > pH
        armedHi    := true
        wickHi     := na(wickHi) ? high : math.max(wickHi, high)
        armedHiBar := bar_index
    if low < pL
        armedLo    := true
        wickLo     := na(wickLo) ? low : math.min(wickLo, low)
        armedLoBar := bar_index

    // ── invalidation: a close through the active stop frees the book (and clears
    //    the mark). This is the ONLY thing that ends the active trade.
    if (activeDir == -1 and close > activeStop) or (activeDir == 1 and close < activeStop)
        f_clearActive()
        actLn      := na
        actLb      := na
        activeDir  := 0
        activeStop := na

    // ── candidate entries (only matter while the book is flat)
    // ① MANIPULATION — swept the level with a wick, closed back through → fade
    manipS = useManip and trHi and armedHi and close < pH     // swept HIGH, reclaimed down → SHORT
    manipL = useManip and trLo and armedLo and close > pL     // swept LOW,  reclaimed up   → LONG
    // ② CLEAN BREAK — confirmed close through, came from the other side → go with it
    breakL = useBreak and trHi and close > pH and open <= pH  // close above HIGH → LONG,  stop = prior LOW
    breakS = useBreak and trLo and close < pL and open >= pL  // close below LOW  → SHORT, stop = prior HIGH
    // chop guard: if BOTH sweeps qualify on one bar (both sides swept, close in
    // the middle), fade only the MORE RECENT grab
    if manipS and manipL
        if nz(armedHiBar, -1) >= nz(armedLoBar, -1)
            manipL := false
        else
            manipS := false

    // fire the first qualifying entry; it locks the book until its stop is closed
    // through. Order: sweeps (tight wick stop) before breaks.
    if activeDir == 0 and manipS
        activeDir  := -1
        activeStop := wickHi
        if showMarks
            [l, b] = f_entry(false, wickHi, shortCol, stopCol, tagSize, showStop)
            actLn := l
            actLb := b
        if enAl and alShort
            alert(f_pay("p4h_short", "SHORT", "4H HIGH", pH, wickHi, "Sweep + reject of 4h HIGH " + str.tostring(pH, format.mintick) + ". Stop " + str.tostring(wickHi, format.mintick) + "."), alert.freq_once_per_bar_close)
    else if activeDir == 0 and manipL
        activeDir  := 1
        activeStop := wickLo
        if showMarks
            [l, b] = f_entry(true, wickLo, longCol, stopCol, tagSize, showStop)
            actLn := l
            actLb := b
        if enAl and alLong
            alert(f_pay("p4h_long", "BUY", "4H LOW", pL, wickLo, "Sweep + reclaim of 4h LOW " + str.tostring(pL, format.mintick) + ". Stop " + str.tostring(wickLo, format.mintick) + "."), alert.freq_once_per_bar_close)
    else if activeDir == 0 and breakL
        activeDir  := 1
        activeStop := pL
        if showMarks
            [l, b] = f_entry(true, pL, longCol, stopCol, tagSize, showStop)
            actLn := l
            actLb := b
        if enAl and alLong
            alert(f_pay("p4h_long", "BUY", "4H HIGH", pH, pL, "Clean break above 4h HIGH " + str.tostring(pH, format.mintick) + ". Stop " + str.tostring(pL, format.mintick) + "."), alert.freq_once_per_bar_close)
    else if activeDir == 0 and breakS
        activeDir  := -1
        activeStop := pH
        if showMarks
            [l, b] = f_entry(false, pH, shortCol, stopCol, tagSize, showStop)
            actLn := l
            actLb := b
        if enAl and alShort
            alert(f_pay("p4h_short", "SHORT", "4H LOW", pL, pH, "Clean breakdown below 4h LOW " + str.tostring(pL, format.mintick) + ". Stop " + str.tostring(pH, format.mintick) + "."), alert.freq_once_per_bar_close)

// ── Rolling level lines (right-edge only; redrawn in place each last bar) ─────
var line  hiLn = na
var line  loLn = na
var line  clLn = na
var label hiLb = na
var label loLb = na
var label clLb = na
if barstate.islast and not na(pH) and not na(pL)
    x1 = bar_index - lineLen
    x2 = bar_index + rightPad
    // create once
    if na(hiLn)
        hiLn := line.new(x1, pH, x2, pH, width = lvlW)
        loLn := line.new(x1, pL, x2, pL, width = lvlW)
        clLn := line.new(x1, pC, x2, pC, width = 1, style = line.style_dotted)
        hiLb := label.new(x2, pH, "", style = label.style_label_left, textcolor = color.white)
        loLb := label.new(x2, pL, "", style = label.style_label_left, textcolor = color.white)
        clLb := label.new(x2, pC, "", style = label.style_label_left, textcolor = color.white)
    hiSup = close > pH
    loSup = close > pL
    hiC = hiSup ? supCol : resCol
    loC = loSup ? supCol : resCol
    _tsz = f_tsz(tagSize)
    _sty = f_lnStyle(lvlStyle)
    // HIGH
    line.set_xy1(hiLn, x1, pH)
    line.set_xy2(hiLn, x2, pH)
    line.set_color(hiLn, showHi ? hiC : color.new(hiC, 100))
    line.set_width(hiLn, lvlW)
    line.set_style(hiLn, _sty)
    label.set_xy(hiLb, x2, pH)
    label.set_color(hiLb, hiC)
    label.set_size(hiLb, _tsz)
    label.set_text(hiLb, showHi ? (hiSup ? "▲ " : "▼ ") + "4H HIGH" + (showPx ? "  " + str.tostring(pH, format.mintick) : "") : "")
    // LOW
    line.set_xy1(loLn, x1, pL)
    line.set_xy2(loLn, x2, pL)
    line.set_color(loLn, showLo ? loC : color.new(loC, 100))
    line.set_width(loLn, lvlW)
    line.set_style(loLn, _sty)
    label.set_xy(loLb, x2, pL)
    label.set_color(loLb, loC)
    label.set_size(loLb, _tsz)
    label.set_text(loLb, showLo ? (loSup ? "▲ " : "▼ ") + "4H LOW" + (showPx ? "  " + str.tostring(pL, format.mintick) : "") : "")
    // CLOSE (context)
    line.set_xy1(clLn, x1, pC)
    line.set_xy2(clLn, x2, pC)
    line.set_color(clLn, showCl ? clCol : color.new(clCol, 100))
    label.set_xy(clLb, x2, pC)
    label.set_color(clLb, color.new(clCol, 100))
    label.set_textcolor(clLb, clCol)
    label.set_size(clLb, _tsz)
    label.set_text(clLb, showCl ? "4H CLOSE" + (showPx ? "  " + str.tostring(pC, format.mintick) : "") : "")
