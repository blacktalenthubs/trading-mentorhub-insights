//@version=6
// 4H Candle Countdown — time left until the current 4H candle CLOSES, shown on any
// chart timeframe. Pairs with the 4h-signals-only model: the prior-4H frame (and every
// signal judged against it) rolls the instant this hits 00:00:00, so you know when the
// levels are about to reset and when a forming-candle read becomes final.
//
// The close time is read from the symbol's own 4H series (request.security on the chosen
// timeframe), so it respects the real 4H grid TV draws — extended hours / the 24h overnight
// session included — no matter what timeframe your chart is on (10m, 1h, anything).
indicator("4H Candle Countdown", shorttitle = "4H Countdown", overlay = true)

// ── Inputs ────────────────────────────────────────────────────────────────────
tfStr     = input.timeframe("240", "Candle timeframe", tooltip = "The candle whose close is counted down. 240 = 4H (default). Change it to track another candle's close (e.g. 60 = 1H, D = daily).")
warnMin   = input.int(15, "Turn red when under (minutes)", minval = 0, maxval = 240, tooltip = "The countdown goes red in the final stretch — the window where the forming candle's read is close to locking in.")
showClock = input.bool(true, "Show the close time", tooltip = "Also show the wall-clock time the candle closes, in the exchange's timezone.")
posOpt    = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"])
txtSize   = input.string("Large", "Text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"])
cOk       = input.color(#26A69A, "Normal colour")
cWarn     = input.color(#EF5350, "Final-stretch colour")

// ── Helpers ───────────────────────────────────────────────────────────────────
f_size(string s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Huge" ? size.huge : size.large
f_pos(string p)  => p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right : p == "Bottom Left" ? position.bottom_left : p == "Bottom Right" ? position.bottom_right : p == "Middle Left" ? position.middle_left : position.middle_right
f_pad2(int v)    => (v < 10 ? "0" : "") + str.tostring(v)
f_tfName(string tf) => tf == "240" ? "4H" : tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "180" ? "3H" : tf == "D" ? "1D" : tf == "W" ? "1W" : tf + "m"

// ── The forming candle's close time on the chosen TF ───────────────────────────
// lookahead_on → the CURRENT (forming) higher-TF bar's close timestamp, so the
// countdown tracks the candle in progress, not the last completed one.
tfClose = request.security(syminfo.tickerid, tfStr, time_close, lookahead = barmerge.lookahead_on)

var table t = table.new(f_pos(posOpt), 1, 3, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

if barstate.islast and not na(tfClose)
    int remMs = int(math.max(0, tfClose - timenow))
    int totalSec = int(remMs / 1000)
    int hh = int(totalSec / 3600)
    int mm = int((totalSec % 3600) / 60)
    int ss = int(totalSec % 60)
    string cd = str.tostring(hh) + ":" + f_pad2(mm) + ":" + f_pad2(ss)
    color col = remMs <= warnMin * 60000 ? cWarn : cOk
    color bg  = color.new(col, 88)

    table.cell(t, 0, 0, f_tfName(tfStr) + " CLOSE IN", text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = bg)
    table.cell(t, 0, 1, cd, text_color = col, text_size = f_size(txtSize), bgcolor = bg)
    if showClock
        table.cell(t, 0, 2, "@ " + str.format_time(tfClose, "HH:mm", syminfo.timezone), text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = bg)
    else
        table.cell(t, 0, 2, "", bgcolor = bg)
