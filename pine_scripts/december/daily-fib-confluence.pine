//@version=6
// Daily Fib Confluence · v2026.11.25.1 — version is in the indicator title; if the legend doesn't show
// this exact version the chart is running an older copy.
// ─────────────────────────────────────────────────────────────────────────────
// DAILY FIB CONFLUENCE — auto-draws a Fibonacci retracement on the chosen timeframe (Daily by default)
// and RANKS each level by how much real structure sits on it, so the chart shows the fibs that matter and
// hides the noise. A naked 0.618 is weak; a 0.618 that lands on the 200-day SMA AND yesterday's low is a
// genuine decision zone — that's what gets flagged ★ STRONG.
//
//   • SWING: the most recent CONFIRMED pivot high→low leg on the fib timeframe (auto-oriented). As new
//     swings confirm, the fib re-anchors to the latest leg. 0% sits at the most recent extreme, 100% at
//     the start of the move.
//   • LEVELS: 0 / 23.6 / 38.2 / 50 / 61.8 / 65 / 78.6 / 100, plus optional 127.2 / 161.8 extension targets.
//     61.8–65 = the GOLDEN POCKET, shaded and given a base strength boost.
//   • STRENGTH SCORE per level = 2 × (confluence hits within the band) + 1 if it's the golden pocket.
//     Confluence sources (toggleable): 50 / 100 / 200 SMA, prior-day high/low, prior-week high/low.
//     Score ≥ the Strong threshold → ★, thick, tagged with what it stacks with ("61.8% 123.40 ★ +200SMA +PDL").
//   • HIDE WEAK: a level with no confluence that isn't the golden pocket or a 0/100 anchor is hidden, so
//     the chart stays to the levels worth watching (same spirit as the swing %-gate on the 4H pine).
//   • HUD: retracement depth (where price sits in the swing), the swing direction, and the nearest STRONG
//     fib above + below price — the day-trade decision lines.
//   • ALERT (opt-in, default OFF): one alert() when price enters the golden pocket.
// Lines-only context tool; it is drawn FROM the daily swing but shows on any chart TF, so you map the day
// off the daily fib and trade it intraday.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Daily Fib Confluence · v2026.11.25.1", shorttitle = "fib-conf", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Swing ─────────────────────────────────────────────────────────
gS = "Swing"
fibTF  = input.timeframe("D", "Fib timeframe", group = gS, tooltip = "The timeframe the swing + fib are measured on. D = daily (default). The levels then show on ANY chart timeframe, so you map the day off the daily fib and trade it intraday.")
pivLen = input.int(5, "Pivot strength (bars)", minval = 1, maxval = 20, group = gS, tooltip = "Bars to the left AND right that must be lower (pivot high) / higher (pivot low) to confirm a swing on the fib timeframe. Higher = fewer, bigger swings.")

// ── Fib levels ────────────────────────────────────────────────────
gF = "Fib levels"
showExt  = input.bool(false, "Show extension targets (127.2 / 161.8)", group = gF, tooltip = "Project the continuation targets beyond the 0% end of the move (take-profit side), tagged as targets, not entries.")
goldFill = input.bool(true,  "Shade the golden pocket (61.8–65)", group = gF)
hideWeak = input.bool(true,  "Hide weak naked levels (no confluence)", group = gF, tooltip = "Hide a fib level that has no confluence and isn't the golden pocket or a 0 / 100 anchor — keeps the chart to the levels that matter.")

// ── Confluence scoring ────────────────────────────────────────────
gC = "Confluence scoring"
bandPct      = input.float(0.3, "Confluence band (%)", minval = 0.05, step = 0.05, group = gC, tooltip = "A key level within this % of a fib counts as confluence (+2 to that fib's strength).")
strongThresh = input.int(3, "Strong score threshold", minval = 1, group = gC, tooltip = "A fib scoring at or above this is flagged ★ STRONG. Score = 2 per confluence hit + 1 for the golden pocket, so 3 = golden pocket on one key level, or one key level + another, etc.")
useSMA  = input.bool(true, "Confluence: 50 / 100 / 200 SMA", group = gC)
usePDHL = input.bool(true, "Confluence: prior-day high / low", group = gC)
usePWHL = input.bool(true, "Confluence: prior-week high / low", group = gC)

// ── Colours ───────────────────────────────────────────────────────
gClr = "Colours"
c_norm   = input.color(#90A4AE, "Normal level",         group = gClr)
c_gold   = input.color(#FFB300, "Golden pocket",        group = gClr)
c_strong = input.color(#D500F9, "Strong (confluence)",  group = gClr)
c_ext    = input.color(#26A69A, "Extension target",     group = gClr)

// ── HUD ───────────────────────────────────────────────────────────
gH = "HUD"
showHUD = input.bool(true, "Show fib HUD", group = gH)
hudPos  = input.string("Top Right", "HUD position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group = gH)
hudSize = input.string("Normal", "HUD text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = gH)

// ── Alert (opt-in) ────────────────────────────────────────────────
gA = "Alert (opt-in)"
alertGP = input.bool(false, "Alert when price enters the golden pocket", group = gA, tooltip = "One opt-in alert() on the bar price first enters the 61.8–65 zone. Bind with 'Any alert() function call'.")

// ── Helpers ───────────────────────────────────────────────────────
f_txtcol(color c) => (color.r(c) * 0.299 + color.g(c) * 0.587 + color.b(c) * 0.114) > 150 ? color.black : color.white
f_hudpos(string p) => p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right : p == "Bottom Left" ? position.bottom_left : p == "Bottom Right" ? position.bottom_right : p == "Middle Left" ? position.middle_left : position.middle_right
f_hudsize(string s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : s == "Huge" ? size.huge : size.normal
// Confluence score for a price: +1 per anchor within bandPct, plus the names it stacks with.
f_conf(float px, float band, float[] vals, string[] nms) =>
    int cnt = 0
    string s = ""
    if array.size(vals) > 0 and not na(px) and px != 0.0
        for i = 0 to array.size(vals) - 1
            float v = array.get(vals, i)
            if not na(v) and math.abs(px - v) / px * 100.0 <= band
                cnt += 1
                s += " +" + array.get(nms, i)
    [cnt, s]

// ── Swing: most recent confirmed pivot high / low on the fib TF ───
tid = syminfo.tickerid
[ph, phT, pl, plT] = request.security(tid, fibTF, [ta.pivothigh(high, pivLen, pivLen), time[pivLen], ta.pivotlow(low, pivLen, pivLen), time[pivLen]], lookahead = barmerge.lookahead_off)
var float swHi  = na
var int   swHiT = na
var float swLo  = na
var int   swLoT = na
if not na(ph)
    swHi  := ph
    swHiT := phT
if not na(pl)
    swLo  := pl
    swLoT := plT
// Orient: the more RECENT pivot is the 0% end. High newer than low → up-leg (retrace down); else down-leg.
bool haveSwing = not na(swHi) and not na(swLo) and not na(swHiT) and not na(swLoT) and swHi > swLo
bool isUp = haveSwing and swHiT >= swLoT
float rng = haveSwing ? swHi - swLo : na
int startT = haveSwing ? (isUp ? swLoT : swHiT) : na   // older pivot = start of the move
int endT   = haveSwing ? (isUp ? swHiT : swLoT) : na   // newer pivot = 0% end

// level price for a ratio: up-leg retraces DOWN from the high; down-leg retraces UP from the low.
f_level(float r) => isUp ? swHi - r * rng : swLo + r * rng

// ── Confluence anchors (built once, used for every level) ─────────
sma50  = request.security(tid, fibTF, ta.sma(close, 50),  lookahead = barmerge.lookahead_on)
sma100 = request.security(tid, fibTF, ta.sma(close, 100), lookahead = barmerge.lookahead_on)
sma200 = request.security(tid, fibTF, ta.sma(close, 200), lookahead = barmerge.lookahead_on)
pdh = request.security(tid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(tid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh = request.security(tid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(tid, "W", low[1],  lookahead = barmerge.lookahead_on)

// ── Golden-pocket alert (opt-in) — every bar, fires on ENTRY ──────
var bool _wasInGP = false
float gpA = f_level(0.618)
float gpB = f_level(0.65)
float gpHi = math.max(gpA, gpB)
float gpLo = math.min(gpA, gpB)
bool inGP = haveSwing and close != 0 and close <= gpHi and close >= gpLo
if alertGP and haveSwing and inGP and not _wasInGP
    alert("fib golden pocket: " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " (" + str.tostring(gpLo, format.mintick) + "–" + str.tostring(gpHi, format.mintick) + ")", alert.freq_once_per_bar)
_wasInGP := inGP

// ── Draw — rebuilt on the last bar (delete-then-redraw) ───────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()
if barstate.islast and haveSwing
    if array.size(_ln) > 0
        for i = 0 to array.size(_ln) - 1
            line.delete(array.get(_ln, i))
        array.clear(_ln)
    if array.size(_lb) > 0
        for i = 0 to array.size(_lb) - 1
            label.delete(array.get(_lb, i))
        array.clear(_lb)

    // Build the confluence anchor arrays from the toggles.
    float[] clVal = array.new_float()
    string[] clNm = array.new_string()
    if useSMA
        array.push(clVal, sma50)
        array.push(clNm, "50SMA")
        array.push(clVal, sma100)
        array.push(clNm, "100SMA")
        array.push(clVal, sma200)
        array.push(clNm, "200SMA")
    if usePDHL
        array.push(clVal, pdh)
        array.push(clNm, "PDH")
        array.push(clVal, pdl)
        array.push(clNm, "PDL")
    if usePWHL
        array.push(clVal, pwh)
        array.push(clNm, "PWH")
        array.push(clVal, pwl)
        array.push(clNm, "PWL")

    float[] ratios = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.65, 0.786, 1.0)
    line glA = na   // golden-pocket line refs for the shade
    line glB = na
    // collect STRONG level prices for the HUD's nearest-above / nearest-below read
    float[] stPx  = array.new_float()
    string[] stLb = array.new_string()

    for i = 0 to array.size(ratios) - 1
        float r  = array.get(ratios, i)
        float px = f_level(r)
        bool golden = r == 0.618 or r == 0.65
        bool anchor = r == 0.0 or r == 1.0
        [cnt, cnames] = f_conf(px, bandPct, clVal, clNm)
        int score = cnt * 2 + (golden ? 1 : 0)
        bool strong = score >= strongThresh
        bool skip = hideWeak and score == 0 and not golden and not anchor
        if not skip
            color col = strong ? c_strong : golden ? c_gold : c_norm
            int   w   = strong ? 3 : golden ? 2 : 1
            string rr = str.tostring(r * 100, "#.#") + "%"
            string star = strong ? " ★" : ""
            string tag = rr + "  " + str.tostring(px, format.mintick) + star + cnames
            line ln = line.new(startT, px, endT, px, xloc = xloc.bar_time, extend = extend.right, color = col, width = w, style = line.style_solid)
            array.push(_ln, ln)
            array.push(_lb, label.new(time, px, tag, xloc = xloc.bar_time, style = label.style_label_left, color = col, textcolor = f_txtcol(col), size = size.tiny))
            if r == 0.618
                glA := ln
            if r == 0.65
                glB := ln
            if strong
                array.push(stPx, px)
                array.push(stLb, rr)

    // Golden-pocket shade (between the 61.8 and 65 lines).
    if goldFill and not na(glA) and not na(glB)
        linefill.new(glA, glB, color.new(c_gold, 85))

    // Extension targets (continuation, beyond the 0% end) — tagged as targets.
    if showExt
        float[] exts = array.from(1.272, 1.618)
        for i = 0 to array.size(exts) - 1
            float r  = array.get(exts, i)
            float px = f_level(r)
            string tag = "EXT " + str.tostring(r * 100, "#.#") + "%  " + str.tostring(px, format.mintick)
            array.push(_ln, line.new(startT, px, endT, px, xloc = xloc.bar_time, extend = extend.right, color = c_ext, width = 1, style = line.style_dashed))
            array.push(_lb, label.new(time, px, tag, xloc = xloc.bar_time, style = label.style_label_left, color = c_ext, textcolor = f_txtcol(c_ext), size = size.tiny))

    // ── HUD ──
    if showHUD
        float depth = isUp ? (swHi - close) / rng * 100.0 : (close - swLo) / rng * 100.0
        string dirTxt = isUp ? "UP leg — retrace DOWN" : "DOWN leg — retrace UP"
        // nearest strong fib above / below price
        float nAbove = na
        float nBelow = na
        string nAboveL = ""
        string nBelowL = ""
        if array.size(stPx) > 0
            for i = 0 to array.size(stPx) - 1
                float p = array.get(stPx, i)
                if p >= close and (na(nAbove) or p < nAbove)
                    nAbove := p
                    nAboveL := array.get(stLb, i)
                if p <= close and (na(nBelow) or p > nBelow)
                    nBelow := p
                    nBelowL := array.get(stLb, i)
        string aboveTxt = na(nAbove) ? "—" : (nAboveL + " " + str.tostring(nAbove, format.mintick) + "  (" + str.tostring((nAbove - close) / close * 100.0, "#.##") + "%)")
        string belowTxt = na(nBelow) ? "—" : (nBelowL + " " + str.tostring(nBelow, format.mintick) + "  (" + str.tostring((close - nBelow) / close * 100.0, "#.##") + "%)")
        var table _hud = table.new(f_hudpos(hudPos), 2, 4, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
        table.cell(_hud, 0, 0, "FIB", text_color = color.white, text_size = f_hudsize(hudSize), bgcolor = color.new(c_strong, 20))
        table.cell(_hud, 1, 0, "retrace " + str.tostring(depth, "#.#") + "%", text_color = color.white, text_size = f_hudsize(hudSize), bgcolor = color.new(c_strong, 20))
        table.cell(_hud, 0, 1, "swing", text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = color.new(color.gray, 88))
        table.cell(_hud, 1, 1, dirTxt, text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = color.new(color.gray, 88))
        table.cell(_hud, 0, 2, "★ above", text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = color.new(color.green, 92))
        table.cell(_hud, 1, 2, aboveTxt, text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = color.new(color.green, 92))
        table.cell(_hud, 0, 3, "★ below", text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = color.new(color.red, 92))
        table.cell(_hud, 1, 3, belowTxt, text_color = color.new(color.gray, 0), text_size = size.small, bgcolor = color.new(color.red, 92))
