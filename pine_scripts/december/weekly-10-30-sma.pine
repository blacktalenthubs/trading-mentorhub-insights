//@version=6
// weekly-10-30-sma v2026.11.27.2 — version is in the indicator title too: if the chart legend
// does not show this exact version, the chart is running an older copy.
// ─────────────────────────────────────────────────────────────────────────────
// Just the 10 and 30 SMA — the Stan Weinstein stage lines. On a WEEKLY chart
// they are the 10-week and 30-week averages from the stage chart:
//   price above a RISING 30 = Stage 2 (advancing, the buy zone)
//   price below a FALLING 30 = Stage 4 (declining — no longs)
//   the 10 crossing under the 30 while the 30 starts curving down is the
//   early Stage 4 warning.
// v2026.11.27.2: HUD calls the stage automatically from price vs the 30 and
//   the 30's slope — rising / flat / falling over the slope lookback, with a
//   long lookback to split basing from topping when the 30 is flat.
indicator("10 / 30 SMA · v2026.11.27.2", shorttitle = "10/30 SMA", overlay = true)

lenFast = input.int(10, "Fast SMA", minval = 1)
lenSlow = input.int(30, "Slow SMA", minval = 1)

fast = ta.sma(close, lenFast)
slow = ta.sma(close, lenSlow)

plot(fast, title = "10 SMA", color = color.new(#2962FF, 0), linewidth = 2)
plot(slow, title = "30 SMA", color = color.new(#FF0000, 0), linewidth = 2)

// ── Stage call ──────────────────────────────────────────────────────────────
slopeLen = input.int(3, "30 slope lookback (bars)", minval = 1, group = "Stage")
longLen  = input.int(26, "30 long lookback (bars)", minval = 5, group = "Stage")
flatPct  = input.float(0.1, "Flat band %", minval = 0.0, step = 0.05, group = "Stage", tooltip = "The 30 counts as flat while it moves less than this % over the lookback.")

// direction of a series vs its value n bars ago: 1 rising, -1 falling, 0 flat
f_dir(float v, float ref) => na(v) or na(ref) or ref == 0 ? 0 : v > ref * (1 + flatPct / 100) ? 1 : v < ref * (1 - flatPct / 100) ? -1 : 0

slowDir = f_dir(slow, slow[slopeLen])
longDir = f_dir(slow, slow[longLen])
above   = close > slow

stage  = na(slow[slopeLen]) ? 0 : above ? (slowDir < 0 ? 3 : slowDir == 0 ? 3 : 2) : slowDir < 0 ? 4 : slowDir > 0 ? 1 : longDir > 0 ? 3 : 1
sName = stage == 2 ? "STAGE 2 — ADVANCING" : stage == 4 ? "STAGE 4 — DECLINING" : stage == 3 ? "STAGE 3 — TOPPING" : stage == 1 ? "STAGE 1 — BASING" : "STAGE —"
sMean = stage == 2 ? "Price above a rising 30 — the buy zone" :
     stage == 4 ? "Price below a falling 30 — no longs" :
     stage == 3 and above and slowDir < 0 ? "30 curving down over price — rolling over" :
     stage == 3 and above ? "Price above a flat 30 — advance stalling" :
     stage == 3 ? "Price broke under a flat 30 after advancing — topping" :
     stage == 1 and slowDir > 0 ? "Price under a rising 30 — basing under resistance" :
     stage == 1 ? "Price under a flat 30 — basing after a decline" : "Not enough history yet"
sCol = stage == 2 ? color.new(#009688, 0) : stage == 4 ? color.new(#C62828, 0) : stage == 3 ? color.new(#E65100, 0) : stage == 1 ? color.new(#546E7A, 0) : color.new(#424242, 0)

var table hud = table.new(position.top_right, 1, 2, bgcolor = color.new(#111418, 0), border_width = 1, border_color = color.new(#FFFFFF, 75))
if barstate.islast
    table.cell(hud, 0, 0, sName, bgcolor = sCol, text_color = color.white, text_size = size.normal)
    table.cell(hud, 0, 1, sMean, text_color = color.new(#FFFFFF, 10), text_size = size.small)
