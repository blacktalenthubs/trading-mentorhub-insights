//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// LEVELS PROXIMITY — prior Day / Week / Month highs & lows + premarket H/L. VISUAL ONLY.
// NO alerts, NO webhook — a pure chart overlay, companion to the MA/EMA proximity pine.
//
// What it draws, relative to WHERE PRICE IS:
//   • PDH / PDL (yesterday's range) and the premarket H/L ALWAYS draw — today's battleground.
//   • The weekly (PWH/PWL) and monthly (PMH/PML) levels are gated to the NEAREST one above
//     price + the nearest below — the next higher-timeframe magnet on each side, not all six.
//   • Levels within merge% of each other fuse into ONE tag naming every member ("PDL · PWL ·×2");
//     tags too close to merge are nudged apart vertically so none hides behind another.
//   • Each level has its OWN on/off checkbox + its group's colour / width / style; tags on the RIGHT.
// Prior highs/lows are settled ([1] + lookahead_on) so they never repaint; premarket comes from the
// extended-hours series (so it shows on a daily chart) with lookahead_off for an honest backtest/Replay.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Levels · D/W/M + Premkt", overlay = true, max_labels_count = 60, max_lines_count = 40, max_bars_back = 500)

// ── which levels (each toggles on its own; H+L of a group share colour / width / style) ──
gLv          = "Levels"
show_levels  = input.bool(true, "Show levels (master)", group = gLv)
show_pdh     = input.bool(true, "PDH", group = gLv, inline = "lv1")
show_pdl     = input.bool(true, "PDL", group = gLv, inline = "lv1")
c_pd         = input.color(#787B86, "", group = gLv, inline = "lv1")
w_pd         = input.int(1, "w", minval = 1, maxval = 10, group = gLv, inline = "lv1")
y_pd         = input.string("dashed", "", options = ["solid", "dashed", "dotted"], group = gLv, inline = "lv1")
show_pwh     = input.bool(true, "PWH", group = gLv, inline = "lv2")
show_pwl     = input.bool(true, "PWL", group = gLv, inline = "lv2")
c_pw         = input.color(#AB47BC, "", group = gLv, inline = "lv2")
w_pw         = input.int(1, "w", minval = 1, maxval = 10, group = gLv, inline = "lv2")
y_pw         = input.string("dashed", "", options = ["solid", "dashed", "dotted"], group = gLv, inline = "lv2")
show_pmh     = input.bool(true, "PMH", group = gLv, inline = "lv3")
show_pml     = input.bool(true, "PML", group = gLv, inline = "lv3")
c_pm         = input.color(#FF7043, "", group = gLv, inline = "lv3")
w_pm         = input.int(1, "w", minval = 1, maxval = 10, group = gLv, inline = "lv3")
y_pm         = input.string("dashed", "", options = ["solid", "dashed", "dotted"], group = gLv, inline = "lv3")
show_pqh     = input.bool(true, "PQH", group = gLv, inline = "lvq")
show_pql     = input.bool(true, "PQL", group = gLv, inline = "lvq")
c_pq         = input.color(#EC407A, "", group = gLv, inline = "lvq")
w_pq         = input.int(1, "w", minval = 1, maxval = 10, group = gLv, inline = "lvq")
y_pq         = input.string("dashed", "", options = ["solid", "dashed", "dotted"], group = gLv, inline = "lvq")
show_preh    = input.bool(true, "Pre-H", group = gLv, inline = "lv4")
show_prel    = input.bool(true, "Pre-L", group = gLv, inline = "lv4")
c_pre        = input.color(#00BCD4, "", group = gLv, inline = "lv4")
w_pre        = input.int(1, "w", minval = 1, maxval = 10, group = gLv, inline = "lv4")
y_pre        = input.string("dotted", "", options = ["solid", "dashed", "dotted"], group = gLv, inline = "lv4")

// ── style ──
gSt        = "Style"
color_mode = input.string("per-level", "Line color", options = ["per-level", "role (support / resistance)"], group = gSt, tooltip = "per-level = each line wears the colour you set above. role = green when price is above the level (support), red when below (resistance).")
sup_col    = input.color(#26A69A, "role · support (price above)",    group = gSt, inline = "c")
res_col    = input.color(#EF5350, "role · resistance (price below)", group = gSt, inline = "c")
flat_len   = input.int(60, "Flat line length (bars back)", minval = 10, maxval = 500, group = gSt)
merge_pct  = input.float(0.25, "Merge levels within (%) into ONE line", minval = 0.0, maxval = 3, step = 0.05, group = gSt, tooltip = "Levels stacked within this % collapse into a SINGLE line whose tag names every member (e.g. 'PDL · PWL ·×2'). The merged line sits on the member NEAREST price. 0 = draw every level separately.") / 100.0
lbl_gap    = input.float(0.08, "De-overlap labels within (%)", minval = 0.0, maxval = 1, step = 0.02, group = gSt, tooltip = "Two levels too close to MERGE but close enough that their right-edge tags would collide get nudged apart vertically — the LINE stays on its true price, only the text box shifts. 0 = off.") / 100.0
by_role    = color_mode != "per-level"
f_style(string s) => s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid
f_txtcol(color c) => (color.r(c) * 0.299 + color.g(c) * 0.587 + color.b(c) * 0.114) > 150 ? color.black : color.white

// ── HUD — the nearest level above and below price, so the proximity gate never hides what's out there ──
gHd        = "HUD"
show_hud   = input.bool(true, "Show nearest-level HUD", group = gHd)
hud_pos_in = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"], group = gHd)
hud_size   = input.string("small", "Text size", options = ["tiny", "small", "normal", "large"], group = gHd)
hud_pos    = hud_pos_in == "top_left" ? position.top_left : hud_pos_in == "bottom_right" ? position.bottom_right : hud_pos_in == "bottom_left" ? position.bottom_left : hud_pos_in == "middle_right" ? position.middle_right : position.top_right
hud_txt    = hud_size == "tiny" ? size.tiny : hud_size == "normal" ? size.normal : hud_size == "large" ? size.large : size.small

// ── level values — settled prior-period high/low (non-repainting) ──
tid = syminfo.tickerid
f_phi(simple string tf) => request.security(tid, tf, high[1], lookahead = barmerge.lookahead_on)
f_plo(simple string tf) => request.security(tid, tf, low[1],  lookahead = barmerge.lookahead_on)
pdh = f_phi("D")
pdl = f_plo("D")
pwh = f_phi("W")
pwl = f_plo("W")
pmh = f_phi("M")
pml = f_plo("M")
pqh = f_phi("3M")
pql = f_plo("3M")

// ── premarket high/low — the MOST RECENT premarket (0400-0930 ET), from the EXTENDED-HOURS
// series so it shows on ANY chart TF incl. a regular-session daily; rolls forward like PDL,
// lookahead_off = historically honest for Replay/backtest. ──
_tExt = ticker.modify(syminfo.tickerid, session = session.extended)
f_preCalc() =>
    _inP  = not na(time("5", "0400-0930", "America/New_York"))
    _newP = _inP and not nz(_inP[1], false)
    var float _h = na
    var float _l = na
    if _newP
        _h := high
        _l := low
    else if _inP
        _h := math.max(nz(_h, high), high)
        _l := math.min(nz(_l, low),  low)
    [_h, _l]
[premH, premL] = request.security(_tExt, "5", f_preCalc(), lookahead = barmerge.lookahead_off)

// ── queue machinery — everything that survives its gate is QUEUED, then merged + drawn in ONE pass ──
var line[]   _ln = array.new_line()
var label[]  _lb = array.new_label()
var float[]  _qv = array.new_float()
var string[] _qn = array.new_string()
var color[]  _qc = array.new_color()
var int[]    _qw = array.new_int()
var string[] _qy = array.new_string()
queue(float v, string nm, color col, int wid, string sty, bool show) =>
    if show and not na(v)
        array.push(_qv, v)
        array.push(_qn, nm)
        array.push(_qc, col)
        array.push(_qw, wid > 10 ? 10 : wid < 1 ? 1 : wid)
        array.push(_qy, f_style(sty))

// ── draw ──
if show_levels and barstate.islast
    if array.size(_ln) > 0
        for i = 0 to array.size(_ln) - 1
            line.delete(array.get(_ln, i))
        array.clear(_ln)
    if array.size(_lb) > 0
        for i = 0 to array.size(_lb) - 1
            label.delete(array.get(_lb, i))
        array.clear(_lb)
    array.clear(_qv)
    array.clear(_qn)
    array.clear(_qc)
    array.clear(_qw)
    array.clear(_qy)

    // always-on: yesterday's range + the most-recent premarket
    queue(pdh,   "PDH",   c_pd,  w_pd,  y_pd,  show_pdh  and not na(pdh))
    queue(pdl,   "PDL",   c_pd,  w_pd,  y_pd,  show_pdl  and not na(pdl))
    queue(premH, "Pre-H", c_pre, w_pre, y_pre, show_preh and not na(premH))
    queue(premL, "Pre-L", c_pre, w_pre, y_pre, show_prel and not na(premL))
    // weekly + monthly → keep only the nearest ABOVE and nearest BELOW price (enabled ones)
    _hv = array.from(pwh, pwl, pmh, pml, pqh, pql)
    _hn = array.from("PWH", "PWL", "PMH", "PML", "PQH", "PQL")
    _hc = array.from(c_pw, c_pw, c_pm, c_pm, c_pq, c_pq)
    _hw = array.from(w_pw, w_pw, w_pm, w_pm, w_pq, w_pq)
    _hy = array.from(y_pw, y_pw, y_pm, y_pm, y_pq, y_pq)
    _he = array.from(show_pwh, show_pwl, show_pmh, show_pml, show_pqh, show_pql)
    float  _luV = na
    string _luN = ""
    color  _luC = c_pw
    int    _luW = 1
    string _luY = "dashed"
    float  _ldV = na
    string _ldN = ""
    color  _ldC = c_pw
    int    _ldW = 1
    string _ldY = "dashed"
    for _li = 0 to array.size(_hv) - 1
        _lv = array.get(_hv, _li)
        if array.get(_he, _li) and not na(_lv)
            if _lv > close and (na(_luV) or _lv < _luV)
                _luV := _lv
                _luN := array.get(_hn, _li)
                _luC := array.get(_hc, _li)
                _luW := array.get(_hw, _li)
                _luY := array.get(_hy, _li)
            if _lv < close and (na(_ldV) or _lv > _ldV)
                _ldV := _lv
                _ldN := array.get(_hn, _li)
                _ldC := array.get(_hc, _li)
                _ldW := array.get(_hw, _li)
                _ldY := array.get(_hy, _li)
    queue(_luV, _luN, _luC, _luW, _luY, not na(_luV))
    queue(_ldV, _ldN, _ldC, _ldW, _ldY, not na(_ldV))

    // ── MERGE + DE-OVERLAP + DRAW — levels within merge_pct fuse into one tag naming all members;
    //    the merged line sits on the member nearest price. Tags too close to merge are nudged up. ──
    _n = array.size(_qv)
    if _n > 0
        _ord = array.sort_indices(_qv, order.ascending)
        float _gap     = close * lbl_gap
        float _lastLbl = na
        _i = 0
        while _i < _n
            _s     = array.get(_ord, _i)
            _hi    = array.get(_qv, _s)
            _nm    = array.get(_qn, _s)
            _cnt   = 1
            _near  = _hi
            _nearD = math.abs(close - _hi)
            _col   = array.get(_qc, _s)
            _wid   = array.get(_qw, _s)
            _sty   = array.get(_qy, _s)
            _j = _i + 1
            while _j < _n
                _k  = array.get(_ord, _j)
                _v2 = array.get(_qv, _k)
                if merge_pct > 0 and _v2 <= _hi * (1.0 + merge_pct)
                    _hi  := _v2
                    _nm  := _nm + " · " + array.get(_qn, _k)
                    _cnt := _cnt + 1
                    if math.abs(close - _v2) < _nearD
                        _near  := _v2
                        _nearD := math.abs(close - _v2)
                        _col   := array.get(_qc, _k)
                        _wid   := array.get(_qw, _k)
                        _sty   := array.get(_qy, _k)
                    _j := _j + 1
                else
                    break
            _sup  = close > _near
            _draw = by_role ? (_sup ? sup_col : res_col) : _col
            _w    = _cnt > 1 and _wid < 10 ? _wid + 1 : _wid
            float _pct = close > 0 ? math.abs(close - _near) / close * 100.0 : float(na)
            _txt = (_sup ? "▲ SUPPORT  " : "▼ RESIST  ") + _nm + (_cnt > 1 ? "  ·×" + str.tostring(_cnt) : "") + "  " + str.tostring(_near, format.mintick) + (na(_pct) ? "" : "  (" + str.tostring(_pct, "#.##") + "%)")
            float _lblY = _near
            if lbl_gap > 0 and not na(_lastLbl) and _lblY < _lastLbl + _gap
                _lblY := _lastLbl + _gap
            _lastLbl := _lblY
            array.push(_ln, line.new(bar_index - flat_len, _near, bar_index + 6, _near, color = _draw, width = _w, style = _sty))
            array.push(_lb, label.new(bar_index + 6, _lblY, _txt, style = label.style_label_left, color = _draw, textcolor = f_txtcol(_draw), size = size.small))
            _i := _j

// ── HUD — nearest ENABLED level above and below price (never hidden by the proximity gate) ──
var table _hud = not show_hud ? na : table.new(hud_pos, 2, 3, bgcolor = color.new(#0d1318, 5), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)
f_row(int r, string k, string v, color c) =>
    table.cell(_hud, 0, r, k, text_color = color.silver, text_size = hud_txt, text_halign = text.align_left)
    table.cell(_hud, 1, r, v, text_color = c, text_size = hud_txt, text_halign = text.align_right)
if show_hud and barstate.islast
    _av = array.from(pdh, pdl, pwh, pwl, pmh, pml, pqh, pql, premH, premL)
    _an = array.from("PDH", "PDL", "PWH", "PWL", "PMH", "PML", "PQH", "PQL", "Pre-H", "Pre-L")
    _ae = array.from(show_pdh, show_pdl, show_pwh, show_pwl, show_pmh, show_pml, show_pqh, show_pql, show_preh, show_prel)
    float  _uV = na
    string _uN = "—"
    float  _dV = na
    string _dN = "—"
    for _ai = 0 to array.size(_av) - 1
        _vv = array.get(_av, _ai)
        if array.get(_ae, _ai) and not na(_vv)
            if _vv > close and (na(_uV) or _vv < _uV)
                _uV := _vv
                _uN := array.get(_an, _ai)
            if _vv < close and (na(_dV) or _vv > _dV)
                _dV := _vv
                _dN := array.get(_an, _ai)
    f_row(0, "Levels  " + syminfo.ticker, str.tostring(close, format.mintick), color.white)
    f_row(1, "Nearest ▲", na(_uV) ? "—" : _uN + "  " + str.tostring(_uV, format.mintick) + "  (+" + str.tostring((_uV - close) / close * 100, "#.##") + "%)", res_col)
    f_row(2, "Nearest ▼", na(_dV) ? "—" : _dN + "  " + str.tostring(_dV, format.mintick) + "  (" + str.tostring((_dV - close) / close * 100, "#.##") + "%)", sup_col)
