//@version=5
// Weekly 8 / 20 / 50 SMA on any timeframe (daily, 4H, 1H, 5m ...). The levels are pulled from the
// weekly series via request.security, so they match what the weekly chart shows without switching.
//   Live mode (default): includes the current, still-forming week = the weekly chart's value right now.
//   Confirmed mode: last CLOSED week only — never changes intraweek (non-repainting).
// Also draws two MULTI-WEEK structure levels (VISUAL for now; scanner signals to follow once
// validated): W-TBA = the first weekly resistance to break (NEAREST tested high-cluster ABOVE
// price) and W-Sup = the significant base (MOST-TESTED low-cluster AT/BELOW price). A cluster
// counts only when >=minTouch weekly highs/lows sit within a tolerance of it (tested, not a spike);
// ×N on the label = how many weeks tagged it. This avoids the far range extremes and shallow blips
// (BE's real base ~250 not 185; WDC's first ceiling ~474 not the 564 range high).
indicator("Weekly 8/20/50 SMA", overlay=true, max_labels_count=10)

g1 = "Weekly SMAs"
// Checkbox per SMA: unchecked hides its line, label, table row and alert.
on0     = input.bool(true, "", inline="m0", group=g1)
len0    = input.int(8, "Momentum weekly SMA", minval=1, inline="m0", group=g1)
on1     = input.bool(true, "", inline="m1", group=g1)
len1    = input.int(20, "Fast weekly SMA", minval=1, inline="m1", group=g1)
on2     = input.bool(true, "", inline="m2", group=g1)
len2    = input.int(50, "Slow weekly SMA", minval=1, inline="m2", group=g1)
useLive = input.bool(true, "Include current (forming) week", group=g1, tooltip="On = matches the weekly chart right now. Off = last closed week only, fixed until the week closes.")

g2 = "Display"
col0     = input.color(color.new(#AB47BC, 0), "Momentum color", group=g2)
col1     = input.color(color.new(#2196F3, 0), "Fast color", group=g2)
col2     = input.color(color.new(#FF9800, 0), "Slow color", group=g2)
showLine = input.bool(true, "Plot lines", group=g2)
showLbl  = input.bool(true, "Right-edge labels", group=g2)
showHUD  = input.bool(true, "Show table", group=g2)
hudPos   = input.string("Bottom Right", "Table position", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Bottom Left"], group=g2)

g3 = "Support alerts (W8/W20/W50 = scanner wsma8/20/50_support)"
maxDist = input.float(4.0, "Open within % above the line", step=0.5, group=g3, tooltip="alert_config.WSMA20_SUPPORT_MAX_DISTANCE_PCT") / 100

// ── Multi-week structure (VISUAL for now — wire scanner signals later once validated) ──
// NEAREST tested cluster on each side of price — not the window extreme (that grabbed a far spike:
// BE's floor landed at 185 when the real base is ~250; WDC's ceiling at the 564 range high when the
// first resistance to break is ~474). A level counts only when minTouch weekly highs/lows CLUSTER
// within tolPct of it (tested, not a spike); then:
//   W-TBA = the LOWEST tested high-cluster ABOVE price  → the first weekly resistance to break
//   W-Sup = the HIGHEST tested low-cluster AT/BELOW price → the recent base price bounces from
g4 = "Multi-week resistance / support (nearest tested clusters)"
showTba  = input.bool(true, "Weekly resistance (first overhead)", group=g4, tooltip="The NEAREST tested weekly high-cluster ABOVE price — the first weekly resistance to break, not a far range high. ×N = weeks that tagged it.")
showSup  = input.bool(true, "Weekly support (nearest below)", group=g4, tooltip="The NEAREST tested weekly low-cluster AT/BELOW price — the recent base price bounces from, not a far range low.")
scanWin  = input.int(26, "Scan window (weeks)", minval=6, maxval=104, group=g4, tooltip="Recent completed weeks scanned for tested clusters. We always pick the cluster NEAREST price on each side, so a longer window only adds candidates — far ones are ignored.")
tolPct   = input.float(3.0, "Cluster width (± %)", minval=0.5, maxval=10, step=0.5, group=g4, tooltip="How close two weekly highs/lows must sit to count as the same level.") / 100
minTouch = input.int(3, "Min weeks in the cluster", minval=2, maxval=10, group=g4, tooltip="A level must be tagged by at least this many weekly highs/lows within the width — tested, not a spike. Raise it (4-5) to keep only the major multi-week bases/ceilings; lower it (2) to catch shallower ones.")
colRes   = input.color(color.new(#EF5350, 0), "resistance", inline="cc", group=g4)
colSup   = input.color(color.new(#26A69A, 0), "support", inline="cc", group=g4)

// [value, value one week earlier] — the prior-week value gives the slope (rising / falling).
wSma(len) =>
    s = ta.sma(close, len)
    [s, s[1]]

[l0, l0p] = request.security(syminfo.tickerid, "W", wSma(len0), lookahead=barmerge.lookahead_off)
[l1, l1p] = request.security(syminfo.tickerid, "W", wSma(len1), lookahead=barmerge.lookahead_off)
[l2, l2p] = request.security(syminfo.tickerid, "W", wSma(len2), lookahead=barmerge.lookahead_off)
// Confirmed: last closed week (shift by one + lookahead_on is the standard non-repainting form).
[c0, c0p] = request.security(syminfo.tickerid, "W", [ta.sma(close, len0)[1], ta.sma(close, len0)[2]], lookahead=barmerge.lookahead_on)
[c1, c1p] = request.security(syminfo.tickerid, "W", [ta.sma(close, len1)[1], ta.sma(close, len1)[2]], lookahead=barmerge.lookahead_on)
[c2, c2p] = request.security(syminfo.tickerid, "W", [ta.sma(close, len2)[1], ta.sma(close, len2)[2]], lookahead=barmerge.lookahead_on)

w0  = useLive ? l0  : c0
w0p = useLive ? l0p : c0p
w1  = useLive ? l1  : c1
w1p = useLive ? l1p : c1p
w2  = useLive ? l2  : c2
w2p = useLive ? l2p : c2p

// Below weekly: step line (the level holds flat for the week). Weekly and up: a normal smooth MA curve.
// plot style can't be a series, so each SMA has a step plot and a curve plot; only one is non-na.
isWk = timeframe.isweekly or timeframe.ismonthly
plot(showLine and on0 and not isWk ? w0 : na, "Weekly momentum SMA", color=col0, linewidth=2, style=plot.style_stepline)
plot(showLine and on1 and not isWk ? w1 : na, "Weekly fast SMA", color=col1, linewidth=2, style=plot.style_stepline)
plot(showLine and on2 and not isWk ? w2 : na, "Weekly slow SMA", color=col2, linewidth=2, style=plot.style_stepline)
plot(showLine and on0 and isWk ? w0 : na, "Weekly momentum SMA (curve)", color=col0, linewidth=2)
plot(showLine and on1 and isWk ? w1 : na, "Weekly fast SMA (curve)", color=col1, linewidth=2)
plot(showLine and on2 and isWk ? w2 : na, "Weekly slow SMA (curve)", color=col2, linewidth=2)

// ── Scanner support alerts (alertcondition only — no chart markers) ──
// Mirrors analytics/intraday_rules.py _check_weekly_sma_support + intraday_data._weekly_sma_family:
//   level  = SMA of COMPLETED weeks only (current partial week dropped)
//   rising = level > its value 4 completed weeks earlier
//   fire   = the day OPENS at/above the level and within maxDist above it
// W8 uses the same rule and now HAS a scanner counterpart too (wsma8_support, 2026-10-03) — for
// momentum names that ride the 8 and never dip to the 20.
// Always uses completed weeks, regardless of the live/closed display toggle. Daily chart: fires on
// the day's bar; intraday: on the first bar of the day.
[s0, s0r] = request.security(syminfo.tickerid, "W", [ta.sma(close, len0)[1], ta.sma(close, len0)[5]], lookahead=barmerge.lookahead_on)
[s1, s1r] = request.security(syminfo.tickerid, "W", [ta.sma(close, len1)[1], ta.sma(close, len1)[5]], lookahead=barmerge.lookahead_on)
[s2, s2r] = request.security(syminfo.tickerid, "W", [ta.sma(close, len2)[1], ta.sma(close, len2)[5]], lookahead=barmerge.lookahead_on)

// ── Nearest tested clusters above/below price, scanned on COMPLETED weeks ([i], i>=1, so the
// forming week can't move them). For each candidate week's high (resistance) / low (support) we
// count how many weeks in the window tag that price within tolPct; a cluster is VALID at >=minTouch.
// Then: resistance = the LOWEST valid high-cluster above price (first wall to break); support =
// the MOST-TESTED valid low-cluster at/below price (significant base). px = weekly close ~ price. ──
f_zones() =>
    float _res = na
    int   _resC = 0
    float _sup = na
    int   _supC = 0
    px = close
    for i = 1 to scanWin
        ch = high[i]
        cl = low[i]
        if not na(ch) and ch >= px and (na(_res) or ch < _res)
            int c = 0
            for j = 1 to scanWin
                hj = high[j]
                if not na(hj) and hj <= ch * (1 + tolPct) and hj >= ch * (1 - tolPct)
                    c += 1
            if c >= minTouch
                _res := ch
                _resC := c
        if not na(cl) and cl <= px
            int c2 = 0
            for j = 1 to scanWin
                lj = low[j]
                if not na(lj) and lj <= cl * (1 + tolPct) and lj >= cl * (1 - tolPct)
                    c2 += 1
            // support = the MOST-TESTED floor below price (the significant base, e.g. BE ~250),
            // not merely the nearest minor pullback low; tiebreak = the higher (nearer) one.
            if c2 >= minTouch and (na(_sup) or c2 > _supC or (c2 == _supC and cl > _sup))
                _sup := cl
                _supC := c2
    [_res, _resC, _sup, _supC]
[tbaLvl, tbaTouch, supLvl, supTouch] = request.security(syminfo.tickerid, "W", f_zones(), lookahead=barmerge.lookahead_on)
tbaValid = not na(tbaLvl)
supValid = not na(supLvl)

sigTf  = timeframe.isdaily or timeframe.isintraday
dayBar = timeframe.isintraday ? timeframe.change("D") : true
wkSup(lvl, lvlPrev) => sigTf and dayBar and not na(lvl) and not na(lvlPrev) and lvl > lvlPrev and open >= lvl and (open - lvl) / lvl <= maxDist
sig0 = on0 and wkSup(s0, s0r)
sig1 = on1 and wkSup(s1, s1r)
sig2 = on2 and wkSup(s2, s2r)

alertcondition(sig0, "Weekly 8 SMA support", "{{ticker}} opened above rising weekly 8 SMA")
alertcondition(sig1, "Weekly 20 SMA support", "{{ticker}} opened above rising weekly 20 SMA")
alertcondition(sig2, "Weekly 50 SMA support", "{{ticker}} opened above rising weekly 50 SMA")

distPct(lvl) => na(lvl) ? na : (close - lvl) / lvl * 100
slopeTxt(v, vp) => na(v) or na(vp) ? "" : v > vp ? "rising" : v < vp ? "falling" : "flat"
fmtPct(p) => na(p) ? "—" : (p >= 0 ? "+" : "") + str.tostring(p, "#.##") + "%"

// ── Right-edge labels ──
var label lb0 = na
var label lb1 = na
var label lb2 = na
if barstate.islast and showLbl
    label.delete(lb0)
    label.delete(lb1)
    label.delete(lb2)
    if on0 and not na(w0)
        lb0 := label.new(bar_index + 3, w0, "W" + str.tostring(len0) + " " + str.tostring(w0, format.mintick) + "  " + fmtPct(distPct(w0)), style=label.style_label_left, color=col0, textcolor=color.white, size=size.small)
    if on1 and not na(w1)
        lb1 := label.new(bar_index + 3, w1, "W" + str.tostring(len1) + " " + str.tostring(w1, format.mintick) + "  " + fmtPct(distPct(w1)), style=label.style_label_left, color=col1, textcolor=color.white, size=size.small)
    if on2 and not na(w2)
        lb2 := label.new(bar_index + 3, w2, "W" + str.tostring(len2) + " " + str.tostring(w2, format.mintick) + "  " + fmtPct(distPct(w2)), style=label.style_label_left, color=col2, textcolor=color.white, size=size.small)

// ── Multi-week TBA / support — full-chart rays + right-edge labels. Colour + label text carry the
// state: TBA red=unbroken / green=BROKE (a close took the ceiling); support green=holding / red=LOST. ──
var line  tbaLn = na
var label tbaLb = na
var line  supLn = na
var label supLb = na
if barstate.islast
    line.delete(tbaLn)
    label.delete(tbaLb)
    line.delete(supLn)
    label.delete(supLb)
    if showTba and tbaValid
        tbaLn := line.new(bar_index - 2, tbaLvl, bar_index + 10, tbaLvl, color=colRes, width=2, style=line.style_dashed, extend=extend.left)
        tbaLb := label.new(bar_index + 10, tbaLvl, "W-TBA " + str.tostring(tbaLvl, format.mintick) + "  " + fmtPct(distPct(tbaLvl)) + "  ×" + str.tostring(tbaTouch) + "  resist", style=label.style_label_left, color=colRes, textcolor=color.white, size=size.small)
    if showSup and supValid
        supLn := line.new(bar_index - 2, supLvl, bar_index + 10, supLvl, color=colSup, width=2, style=line.style_dashed, extend=extend.left)
        supLb := label.new(bar_index + 10, supLvl, "W-Sup " + str.tostring(supLvl, format.mintick) + "  " + fmtPct(distPct(supLvl)) + "  ×" + str.tostring(supTouch) + "  support", style=label.style_label_left, color=colSup, textcolor=color.white, size=size.small)

// ── Table ──
posT = hudPos == "Top Right" ? position.top_right : hudPos == "Middle Right" ? position.middle_right : hudPos == "Top Left" ? position.top_left : hudPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table hud = table.new(posT, 5, 6, bgcolor=color.new(#0d1318, 5), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 85), border_width=1)

hudRow(r, name, v, vp, c) =>
    d = distPct(v)
    side = na(v) ? "—" : close >= v ? "above" : "below"
    table.cell(hud, 0, r, name, text_color=c, text_halign=text.align_left, text_size=size.small)
    table.cell(hud, 1, r, na(v) ? "—" : str.tostring(v, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(hud, 2, r, slopeTxt(v, vp), text_color=v > vp ? color.lime : v < vp ? color.red : color.gray, text_size=size.small)
    table.cell(hud, 3, r, side, text_color=side == "above" ? color.lime : color.red, text_size=size.small)
    table.cell(hud, 4, r, fmtPct(d), text_color=color.white, text_size=size.small)

if barstate.islast and showHUD and (on0 or on1 or on2 or showTba or showSup)
    table.cell(hud, 0, 0, "Weekly" + (useLive ? "" : " (closed)"), text_color=color.gray, text_halign=text.align_left, text_size=size.small)
    table.cell(hud, 1, 0, "level", text_color=color.gray, text_size=size.small)
    table.cell(hud, 2, 0, "slope", text_color=color.gray, text_size=size.small)
    table.cell(hud, 3, 0, "price", text_color=color.gray, text_size=size.small)
    table.cell(hud, 4, 0, "dist", text_color=color.gray, text_size=size.small)
    row = 1
    if on0
        hudRow(row, "W" + str.tostring(len0) + " SMA", w0, w0p, col0)
        row += 1
    if on1
        hudRow(row, "W" + str.tostring(len1) + " SMA", w1, w1p, col1)
        row += 1
    if on2
        hudRow(row, "W" + str.tostring(len2) + " SMA", w2, w2p, col2)
        row += 1
    if showTba and tbaValid
        table.cell(hud, 0, row, "W-TBA ×" + str.tostring(tbaTouch), text_color=colRes, text_halign=text.align_left, text_size=size.small)
        table.cell(hud, 1, row, str.tostring(tbaLvl, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(hud, 2, row, "resist", text_color=color.red, text_size=size.small)
        table.cell(hud, 3, row, "above", text_color=color.red, text_size=size.small)
        table.cell(hud, 4, row, fmtPct(distPct(tbaLvl)), text_color=color.white, text_size=size.small)
        row += 1
    if showSup and supValid
        table.cell(hud, 0, row, "W-Sup ×" + str.tostring(supTouch), text_color=colSup, text_halign=text.align_left, text_size=size.small)
        table.cell(hud, 1, row, str.tostring(supLvl, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(hud, 2, row, "support", text_color=color.lime, text_size=size.small)
        table.cell(hud, 3, row, "below", text_color=color.lime, text_size=size.small)
        table.cell(hud, 4, row, fmtPct(distPct(supLvl)), text_color=color.white, text_size=size.small)
