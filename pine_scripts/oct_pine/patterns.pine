//@version=5
indicator("Breakout Pattern HUD", shorttitle="Pattern HUD", overlay=true, max_bars_back=500, max_lines_count=30, max_labels_count=30)

g1 = "Swings"
pivLen  = input.int(5, "Swing pivot length", minval=2, group=g1)
tolPct  = input.float(3.0, "Ceiling tolerance %", minval=0.5, step=0.5, group=g1) / 100

g2 = "Flat base / Ascending triangle"
maxDepth  = input.float(35.0, "Max base depth %", group=g2) / 100
flatDepth = input.float(15.0, "Flat base max depth %", group=g2) / 100
minBase   = input.int(10, "Min base length (bars)", group=g2)
maxBase   = input.int(120, "Max base lookback (bars)", group=g2)

g3 = "Bull flag"
poleMin    = input.float(12.0, "Min pole gain %", group=g3) / 100
poleMax    = input.int(15, "Max pole length (bars)", group=g3)
flagMin    = input.int(3, "Min flag length (bars)", group=g3)
flagMax    = input.int(12, "Max flag length (bars)", group=g3)
maxRetrace = input.float(50.0, "Max flag retrace of pole %", group=g3) / 100

g4 = "Cup with handle"
cupLen     = input.int(80, "Cup lookback (bars)", group=g4)
minCup     = input.int(20, "Min cup length (bars)", group=g4)
cupMinD    = input.float(12.0, "Min cup depth %", group=g4) / 100
cupMaxD    = input.float(40.0, "Max cup depth %", group=g4) / 100
rimTol     = input.float(5.0, "Right rim within % of left rim", group=g4) / 100
handleMin  = input.int(3, "Min handle length (bars)", group=g4)
handleMax  = input.int(15, "Max handle length (bars)", group=g4)
handleMaxD = input.float(12.0, "Max handle depth %", group=g4) / 100

g6 = "Inner base"
useInner  = input.bool(true, "Detect inner base", group=g6)
innerLook = input.int(40, "Inner base lookback (bars)", group=g6)
innerTol  = input.float(2.0, "Inner ceiling tolerance %", step=0.5, group=g6) / 100
innerGap  = input.float(1.0, "Min gap below main TBA %", step=0.5, group=g6) / 100

g7 = "Stage"
stageLook  = input.int(120, "Stage lookback (bars)", group=g7)
crashPct   = input.float(25.0, "Crash = drawdown from high %", group=g7) / 100
bottomPct  = input.float(8.0, "Still bottoming if within % of low", group=g7) / 100
basingBars = input.int(8, "Basing window (bars)", group=g7)
basingRng  = input.float(12.0, "Basing max range %", group=g7) / 100
nearHigh   = input.float(8.0, "Near highs within %", group=g7) / 100

g8 = "Support / resistance"
showSR  = input.bool(true, "Draw support / resistance", group=g8)
srLook  = input.int(120, "S/R lookback (bars)", group=g8)
stopBuf = input.float(2.0, "Stop buffer below support %", step=0.5, group=g8) / 100

g5 = "Volume, trend, stop, display"
volLen   = input.int(50, "Avg volume length", group=g5)
volMult  = input.float(1.5, "Breakout volume multiple", step=0.1, group=g5)
extPct   = input.float(5.0, "Extended above TBA %", group=g5) / 100
holdBars = input.int(5, "Keep showing pattern after breakout (bars)", group=g5)
maxRisk  = input.float(8.0, "Max stop distance below TBA %", group=g5) / 100
reqTrend = input.bool(false, "Only detect above rising 50 SMA", group=g5)
showMA   = input.bool(true, "Plot 50 SMA", group=g5)
hudPos   = input.string("Top Right", "HUD position", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Bottom Left"], group=g5)

gE = "EMAs (8 / 21 / 50)"
showE8   = input.bool(true,  "8 EMA",  inline="e", group=gE)
showE21  = input.bool(true,  "21 EMA", inline="e", group=gE)
showE50  = input.bool(true,  "50 EMA", inline="e", group=gE)
emaLock  = input.bool(false, "Lock EMAs to a fixed timeframe (same on any chart TF)", group=gE)
emaTf    = input.timeframe("D", "…locked timeframe", group=gE)
colE8    = input.color(#00BCD4,      "8 EMA colour",  inline="ec", group=gE)
colE21   = input.color(#9C27B0,      "21",            inline="ec", group=gE)
colE50   = input.color(color.green,  "50",            inline="ec", group=gE)

// Trend and volume
sma50   = ta.sma(close, 50)
sma200  = ta.sma(close, 200)
trendOK = close > sma50 and sma50 > sma50[5]
avgVol  = ta.sma(volume, volLen)
rvol    = avgVol > 0 ? volume / avgVol : na
vol5    = ta.sma(volume, 5)
recLow  = ta.lowest(low, 10)
recHigh = ta.highest(high, 10)
plot(showMA ? sma50 : na, "50 SMA", color=color.new(color.orange, 20), linewidth=1)

// 8 / 21 / 50 EMA — each toggleable; optionally locked to a fixed timeframe (settled [1] +
// lookahead_on = non-repainting, same values on any chart TF). Unlocked = live chart-TF EMA.
f_ema(simple int len) =>
    emaLock ? request.security(syminfo.tickerid, emaTf, ta.ema(close, len)[1], lookahead=barmerge.lookahead_on) : ta.ema(close, len)
ema8  = f_ema(8)
ema21 = f_ema(21)
ema50 = f_ema(50)
plot(showE8  ? ema8  : na, "8 EMA",  color=color.new(colE8, 0),  linewidth=1)
plot(showE21 ? ema21 : na, "21 EMA", color=color.new(colE21, 0), linewidth=1)
plot(showE50 ? ema50 : na, "50 EMA", color=color.new(colE50, 0), linewidth=2)

// Confirmed swing highs / lows
var shP = array.new_float()
var shI = array.new_int()
var slP = array.new_float()
var slI = array.new_int()
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    array.push(shP, ph)
    array.push(shI, bar_index - pivLen)
    if array.size(shP) > 30
        array.shift(shP)
        array.shift(shI)
if not na(pl)
    array.push(slP, pl)
    array.push(slI, bar_index - pivLen)
    if array.size(slP) > 30
        array.shift(slP)
        array.shift(slI)

// Flat base / ascending triangle
float ceilLvl    = na
int   touches    = 0
int   firstTouch = na
int   lowsFrom   = na
float baseLow    = na
float firstL     = na
float prevL      = na
float lastL      = na
int   nLows      = 0

nH = array.size(shP)
if nH > 0
    lastH = array.get(shP, nH - 1)
    ceilLvl := lastH
    for i = nH - 1 to 0
        h  = array.get(shP, i)
        ix = array.get(shI, i)
        if bar_index - ix > maxBase
            break
        if h > lastH * (1 + tolPct)
            lowsFrom := ix
            break
        if h >= lastH * (1 - tolPct)
            touches += 1
            ceilLvl := math.max(ceilLvl, h)
            firstTouch := ix
    if na(lowsFrom)
        lowsFrom := firstTouch
    nL = array.size(slP)
    if nL > 0 and not na(lowsFrom)
        for j = 0 to nL - 1
            ix = array.get(slI, j)
            if ix > lowsFrom
                l = array.get(slP, j)
                baseLow := na(baseLow) ? l : math.min(baseLow, l)
                if na(firstL)
                    firstL := l
                prevL := lastL
                lastL := l
                nLows += 1

baseLen    = na(lowsFrom) ? 0 : bar_index - lowsFrom
depth      = not na(baseLow) and ceilLvl > 0 ? (ceilLvl - baseLow) / ceilLvl : na
risingLows = nLows >= 2 and lastL > prevL and lastL > firstL
isTri      = touches >= 2 and risingLows and depth <= maxDepth and baseLen >= minBase
isFlat     = touches >= 2 and not isTri and depth <= flatDepth and baseLen >= minBase

// Bull flag
k        = nz(-ta.highestbars(high, flagMax + 1))
kLen     = math.max(k, 1)
kLen2    = math.max(k - 1, 1)
poleTop  = high[k]
lowPole  = ta.lowest(low, poleMax)
poleBase = lowPole[k]
flagLow  = ta.lowest(low, kLen)
flagHigh = ta.highest(high[1], kLen2)
poleGain = poleBase > 0 ? poleTop / poleBase - 1 : 0.0
retr     = poleTop > poleBase ? (poleTop - flagLow) / (poleTop - poleBase) : 1.0
isFlag   = k >= flagMin and k <= flagMax and poleGain >= poleMin and retr <= maxRetrace

// Cup with handle
lrOff     = nz(-ta.highestbars(high[handleMax], cupLen - handleMax))
lrLen     = math.max(lrOff, 1)
leftAgo   = handleMax + lrOff
leftRim   = high[leftAgo]
cupLow    = ta.lowest(low[handleMax], lrLen)
rOff      = nz(-ta.highestbars(high, handleMax))
rLen      = math.max(rOff, 1)
rightRim  = high[rOff]
handleLow = ta.lowest(low, rLen)
cupDepth  = leftRim > 0 ? (leftRim - cupLow) / leftRim : 0.0
hDepth    = rightRim > 0 ? (rightRim - handleLow) / rightRim : 1.0
cupMid    = cupLow + (leftRim - cupLow) / 2
isCup     = leftAgo - rOff >= minCup and cupDepth >= cupMinD and cupDepth <= cupMaxD and rightRim >= leftRim * (1 - rimTol) and rightRim <= leftRim * (1 + rimTol) and rOff >= handleMin and hDepth <= handleMaxD and handleLow > cupMid

// Pick the pattern
string pat = na
float  tba = na
float  stp = na
int    startBar = na
if isFlag
    pat := "Bull Flag"
    tba := flagHigh
    stp := flagLow
    startBar := bar_index - k
else if isCup
    pat := "Cup w/ Handle"
    tba := rightRim
    stp := handleLow
    startBar := bar_index - leftAgo
else if isTri
    pat := "Ascending Triangle"
    tba := ceilLvl
    stp := lastL
    startBar := lowsFrom
else if isFlat
    pat := "Flat Base"
    tba := ceilLvl
    stp := lastL
    startBar := lowsFrom
if reqTrend and not trendOK
    pat := na

var string mPat   = na
var float  mTba   = na
var float  mStp   = na
var int    mStart = na
var int    mBar   = na
if not na(pat)
    mPat   := pat
    mTba   := tba
    mStp   := stp
    mStart := startBar
    mBar   := bar_index

active = not na(mBar) and bar_index - mBar <= holdBars

// Main breakout tracking
var float brkLow  = na
var float brkRef  = na
var float brkRvol = na
crossUp = active and close > mTba and close[1] <= mTba
if crossUp
    brkLow  := low
    brkRef  := mTba
    brkRvol := rvol
afterBrk = active and not na(brkRef) and brkRef == mTba

// Inner base
float inCeil    = na
int   inTouches = 0
int   inFirst   = na
if useInner and nH > 0
    lastHi = array.get(shP, nH - 1)
    for i = nH - 1 to 0
        ix = array.get(shI, i)
        if bar_index - ix > innerLook
            break
        h = array.get(shP, i)
        if math.abs(h / lastHi - 1) <= innerTol
            inTouches += 1
            inCeil := na(inCeil) ? h : math.max(inCeil, h)
            inFirst := ix

innerOK = useInner and active and not afterBrk and inTouches >= 2 and not na(inCeil) and inCeil < mTba * (1 - innerGap)

var float inBrkLow  = na
var float inBrkRef  = na
var float inBrkRvol = na
crossIn = innerOK and close > inCeil and close[1] <= inCeil
if crossIn
    inBrkLow  := low
    inBrkRef  := inCeil
    inBrkRvol := rvol
afterIn = innerOK and not na(inBrkRef) and math.abs(inBrkRef / inCeil - 1) < 0.001

// Pattern stop
capStop = mTba * (1 - maxRisk)
stopF   = afterBrk ? math.max(brkLow, mStp) : afterIn ? inBrkLow : math.max(mStp, capStop)
riskRef = afterIn and not afterBrk ? inCeil : mTba

// Status
string status = "No pattern"
color  stCol  = color.gray
if active
    distPct = (close / mTba - 1) * 100
    if close < stopF
        status := "Failed (below stop)"
        stCol  := color.red
    else if close > mTba * (1 + extPct)
        status := "Extended +" + str.tostring(distPct, "#.0") + "%"
        stCol  := color.orange
    else if crossUp
        status := rvol >= volMult ? "BREAKOUT on volume" : "Breakout, light volume"
        stCol  := rvol >= volMult ? color.lime : color.yellow
    else if afterBrk and close > mTba
        status := "Holding above TBA"
        stCol  := color.lime
    else if afterBrk
        status := "Back below TBA"
        stCol  := color.orange
    else if innerOK and crossIn
        status := rvol >= volMult ? "INNER BREAKOUT on volume" : "Inner breakout, light volume"
        stCol  := rvol >= volMult ? color.lime : color.yellow
    else if innerOK and afterIn and close > inCeil
        status := "Above inner TBA, " + str.tostring(-distPct, "#.0") + "% to TBA"
        stCol  := color.lime
    else if innerOK
        status := "Inner base, " + str.tostring((1 - close / inCeil) * 100, "#.0") + "% below inner TBA"
        stCol  := color.yellow
    else
        status := "Forming, " + str.tostring(-distPct, "#.0") + "% below TBA"
        stCol  := color.aqua

// Stage
stHi     = ta.highest(high, stageLook)
hiAgo    = nz(-ta.highestbars(high, stageLook))
hiLen    = math.max(hiAgo, 1)
lowSince = ta.lowest(low, hiLen)
lowAgo   = nz(-ta.lowestbars(low, hiLen))
ddMax    = stHi > 0 ? (stHi - lowSince) / stHi : 0.0
ddNow    = stHi > 0 ? (stHi - close) / stHi : 0.0
offLow   = lowSince > 0 ? close / lowSince - 1 : 0.0
rngHi    = ta.highest(high, basingBars)
rngLo    = ta.lowest(low, basingBars)
rngPct   = rngLo > 0 ? (rngHi - rngLo) / rngLo : 1.0

string stage = "Neutral"
string play  = "-"
color  sgCol = color.gray
if active and close > mTba * (1 + extPct)
    stage := "Extended"
    play  := "Trim or sell covered calls"
    sgCol := color.orange
else if afterBrk or crossUp
    stage := "Breakout"
    play  := "Zanger entry / add on volume"
    sgCol := color.lime
else if crossIn or afterIn
    stage := "Inner breakout"
    play  := "Early entry, confirm at main TBA"
    sgCol := color.lime
else if active
    stage := "Pattern forming"
    play  := "Wait for TBA + HIGH volume"
    sgCol := color.aqua
else if ddMax >= crashPct and offLow <= bottomPct
    stage := "Crash / bottoming"
    play  := "Buy only on reclaim of support"
    sgCol := color.red
else if ddMax >= crashPct and lowAgo >= basingBars and rngPct <= basingRng
    stage := "Basing"
    play  := "Sell puts under support line"
    sgCol := color.yellow
else if ddMax >= crashPct and ddNow > nearHigh
    stage := "V rebound"
    play  := "Hold, don't chase into resistance"
    sgCol := color.orange
else if ddNow <= nearHigh and trendOK
    stage := "Uptrend near highs"
    play  := "Look for flags / tight bases"
    sgCol := color.lime
else if ddNow > nearHigh
    stage := "Pullback"
    play  := "Buy at support line, stop below"
    sgCol := color.yellow

// Support / resistance helpers
f_pickSup(v, t, curV, curT) =>
    better = not na(v) and v < close * 0.998 and (na(curV) or v > curV)
    [better ? v : curV, better ? t : curT]

f_pickRes(v, t, curV, curT) =>
    better = not na(v) and v > close * 1.002 and (na(curV) or v < curV)
    [better ? v : curV, better ? t : curT]

f_held(L) =>
    int n = 0
    for i = 0 to 9
        if low[i] <= L * 1.01 and close[i] > L * 0.995
            n += 1
    n

float  supLvl = na
string supTyp = "-"
float  resLvl = na
string resTyp = "-"
if barstate.islast
    nSL = array.size(slP)
    if nSL > 0
        for j = 0 to nSL - 1
            if bar_index - array.get(slI, j) <= srLook
                v = array.get(slP, j)
                [sv, st] = f_pickSup(v, "swing low", supLvl, supTyp)
                supLvl := sv
                supTyp := st
                [rv, rt] = f_pickRes(v, "broken swing low", resLvl, resTyp)
                resLvl := rv
                resTyp := rt
    nSH = array.size(shP)
    if nSH > 0
        for j = 0 to nSH - 1
            if bar_index - array.get(shI, j) <= srLook
                v = array.get(shP, j)
                [sv, st] = f_pickSup(v, "prior high (flipped)", supLvl, supTyp)
                supLvl := sv
                supTyp := st
                [rv, rt] = f_pickRes(v, "swing high", resLvl, resTyp)
                resLvl := rv
                resTyp := rt
    [s1, t1] = f_pickSup(sma50, "50 SMA", supLvl, supTyp)
    supLvl := s1
    supTyp := t1
    [s2, t2] = f_pickSup(sma200, "200 SMA", supLvl, supTyp)
    supLvl := s2
    supTyp := t2
    [r1, u1] = f_pickRes(sma50, "50 SMA", resLvl, resTyp)
    resLvl := r1
    resTyp := u1
    [r2, u2] = f_pickRes(sma200, "200 SMA", resLvl, resTyp)
    resLvl := r2
    resTyp := u2
    [r3, u3] = f_pickRes(recHigh, "10-day high", resLvl, resTyp)
    resLvl := r3
    resTyp := u3

supStop = na(supLvl) ? na : supLvl * (1 - stopBuf)
rrVal   = not na(supStop) and not na(resLvl) and close > supStop ? (resLvl - close) / (close - supStop) : na

brk   = crossUp and rvol >= volMult
brkIn = crossIn and rvol >= volMult
plotshape(brk, "Breakout on volume", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(brkIn, "Inner breakout on volume", shape.triangleup, location.belowbar, color.yellow, size=size.tiny)
alertcondition(brk, "Pattern breakout on volume", "{{ticker}} broke above its TBA on volume")
alertcondition(brkIn, "Inner base breakout on volume", "{{ticker}} broke above its inner TBA on volume")

// Lines
var line  tbaLn = na
var line  stpLn = na
var line  inLn  = na
var line  supLn = na
var line  recLn = na
var line  resLn = na
var label tbaLb = na
var label stpLb = na
var label inLb  = na
var label supLb = na
var label recLb = na
var label resLb = na
if barstate.islast
    line.delete(tbaLn)
    line.delete(stpLn)
    line.delete(inLn)
    line.delete(supLn)
    line.delete(recLn)
    line.delete(resLn)
    label.delete(tbaLb)
    label.delete(stpLb)
    label.delete(inLb)
    label.delete(supLb)
    label.delete(recLb)
    label.delete(resLb)
    if active
        x1 = na(mStart) ? bar_index - 20 : mStart
        tbaLn := line.new(x1, mTba, bar_index + 10, mTba, color=color.aqua, width=2)
        stpLn := line.new(x1, stopF, bar_index + 10, stopF, color=color.new(color.red, 20), width=1, style=line.style_dashed)
        tbaLb := label.new(bar_index + 10, mTba, "TBA " + str.tostring(mTba, format.mintick), style=label.style_label_left, color=color.aqua, textcolor=color.black, size=size.small)
        stpLb := label.new(bar_index + 10, stopF, "Stop " + str.tostring(stopF, format.mintick), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
    if innerOK
        xi = na(inFirst) ? bar_index - 20 : inFirst
        inLn := line.new(xi, inCeil, bar_index + 10, inCeil, color=color.yellow, width=1, style=line.style_dotted)
        inLb := label.new(bar_index + 10, inCeil, "Inner TBA " + str.tostring(inCeil, format.mintick), style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.small)
    if showSR and not na(supLvl)
        supLn := line.new(bar_index - 40, supLvl, bar_index + 25, supLvl, color=color.lime, width=2, style=line.style_dashed)
        supLb := label.new(bar_index + 25, supLvl, "Support " + str.tostring(supLvl, format.mintick), style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
    if showSR and not na(recLow) and (na(supLvl) or math.abs(recLow / supLvl - 1) > 0.005)
        recLn := line.new(bar_index - 10, recLow, bar_index + 25, recLow, color=color.new(color.lime, 30), width=1, style=line.style_dotted)
        recLb := label.new(bar_index + 25, recLow, "Recent low " + str.tostring(recLow, format.mintick), style=label.style_label_left, color=color.new(color.lime, 40), textcolor=color.black, size=size.small)
    if showSR and not na(resLvl)
        resLn := line.new(bar_index - 40, resLvl, bar_index + 25, resLvl, color=color.new(color.red, 10), width=2, style=line.style_dotted)
        resLb := label.new(bar_index + 25, resLvl, "Resistance " + str.tostring(resLvl, format.mintick), style=label.style_label_left, color=color.new(color.red, 10), textcolor=color.white, size=size.small)

// HUD
posT = hudPos == "Middle Right" ? position.middle_right : hudPos == "Bottom Right" ? position.bottom_right : hudPos == "Top Left" ? position.top_left : hudPos == "Bottom Left" ? position.bottom_left : position.top_right
var table hud = table.new(posT, 2, 18, bgcolor=color.new(#0d1318, 5), frame_color=color.new(color.gray, 60), frame_width=1, border_color=color.new(color.gray, 85), border_width=1)

f_row(t, r, key, val, c) =>
    table.cell(t, 0, r, key, text_color=color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, r, val, text_color=c, text_size=size.small, text_halign=text.align_right)

if barstate.islast
    heldN   = na(supLvl) ? 0 : f_held(supLvl)
    heldTxt = na(supLvl) ? "-" : heldN > 0 ? "held " + str.tostring(heldN) + "x / 10d" : "untested"
    planTxt = na(supStop) ? "-" : "Stop " + str.tostring(supStop, format.mintick) + (na(rrVal) ? "" : " | R/R " + str.tostring(rrVal, "#.0"))
    riskPct = active and riskRef > 0 ? (riskRef - stopF) / riskRef * 100 : na
    volTxt  = vol5 < avgVol * 0.8 ? "Drying up" : vol5 > avgVol * 1.2 ? "Heavy" : "Normal"
    brkTxt  = afterBrk ? str.tostring(brkRvol, "#.0") + "x avg" : afterIn ? str.tostring(inBrkRvol, "#.0") + "x (inner)" : "-"
    brkCol  = (afterBrk and brkRvol >= volMult) or (afterIn and inBrkRvol >= volMult) ? color.lime : color.white
    f_row(hud, 0, "PATTERN HUD", syminfo.ticker, color.white)
    f_row(hud, 1, "Stage", stage, sgCol)
    f_row(hud, 2, "Playbook", play, sgCol)
    f_row(hud, 3, "Support", na(supLvl) ? "-" : str.tostring(supLvl, format.mintick) + " (" + supTyp + ")", color.lime)
    f_row(hud, 4, "Tested", heldTxt, heldN > 0 ? color.lime : color.gray)
    f_row(hud, 5, "Recent low", str.tostring(recLow, format.mintick), color.lime)
    f_row(hud, 6, "Resistance", na(resLvl) ? "-" : str.tostring(resLvl, format.mintick) + " (" + resTyp + ")", color.red)
    f_row(hud, 7, "Support plan", planTxt, color.white)
    f_row(hud, 8, "Pattern", active ? mPat : "None", active ? color.white : color.gray)
    f_row(hud, 9, "Status", status, stCol)
    f_row(hud, 10, "TBA", active ? str.tostring(mTba, format.mintick) : "-", color.aqua)
    f_row(hud, 11, "Inner TBA", innerOK ? str.tostring(inCeil, format.mintick) : "-", color.yellow)
    f_row(hud, 12, "Pattern stop", active ? str.tostring(stopF, format.mintick) + " (" + str.tostring(riskPct, "#.0") + "%)" : "-", color.red)
    f_row(hud, 13, "Breakout day vol", brkTxt, brkCol)
    f_row(hud, 14, "Volume today", str.tostring(rvol, "#.0") + "x avg", rvol >= volMult ? color.lime : color.white)
    f_row(hud, 15, "5-day volume", volTxt, volTxt == "Drying up" ? color.lime : color.white)
    f_row(hud, 16, "50 SMA trend", trendOK ? "Above & rising" : "Weak", trendOK ? color.lime : color.orange)
    f_row(hud, 17, "Pattern length", active and not na(mStart) ? str.tostring(bar_index - mStart) + " bars" : "-", color.white)