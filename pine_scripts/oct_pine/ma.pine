//@version=5
// =============================================================================
// MA · EMA (Daily) + VWAP — the moving-average half of the two-pine kit.
// =============================================================================
// Just the moving-average lines — no bounce / reject / proximity / PDL·PDH / pullback
// signals, no webhook alerts, no payload (all stripped 2026-09-24). Pairs with the
// "All Levels" pine. This one draws:
//   • Daily EMA 5 / 8 / 20 / 50 / 100 / 200 and SMA 50 / 100 / 200 (locked to the daily
//     timeframe via request.security, so they stay the same daily curves on any chart TF).
//   • 5 / 20 EMA cross arrows (green up = 5 crosses above 20, red down = 5 below 20).
//   • Rolling VWAP over the last N bars — same AVWAP as volume_profile.pine.
// Each MA is its own uncheckable toggle (Inputs tab), which hides BOTH the line and its
// end tag. The daily MAs use lookahead_off (no future leak): closed daily bars are final,
// and the CURRENT forming daily bar updates live — so a 5/20 cross that happens TODAY shows
// today (confirms at the daily close). Earlier this used a settled [1] value, which lagged a
// full day and hid same-day crosses.
// =============================================================================
indicator("MA · EMA (Daily) + VWAP", "MA·EMA", overlay = true, max_labels_count = 500)

// ── Global ─────────────────────────────────────────────────────────────────
show_lines   = input.bool(true, "Show daily MA lines")
show_ma_tags = input.bool(false, "Show MA name tags at the right end of each line")

// ── Per-MA toggles — each hides BOTH the line AND its end tag. Use THESE (Inputs
//    tab), not the Style-tab line checkboxes (the script can't read those). ─────
grp_ma = "MA lines + tags"
sel_ema5   = input.bool(true, "EMA 5",   group = grp_ma)
sel_ema8   = input.bool(true, "EMA 8",   group = grp_ma)
sel_ema20  = input.bool(true, "EMA 20",  group = grp_ma)
sel_ema50  = input.bool(true, "EMA 50",  group = grp_ma)
sel_ema100 = input.bool(true, "EMA 100", group = grp_ma)
sel_ema200 = input.bool(true, "EMA 200", group = grp_ma)
sel_sma50  = input.bool(true, "SMA 50",  group = grp_ma)
sel_sma100 = input.bool(true, "SMA 100", group = grp_ma)
sel_sma200 = input.bool(true, "SMA 200", group = grp_ma)

// ── 5 / 20 EMA cross ─────────────────────────────────────────────────────────
grp_x   = "5 / 20 EMA cross"
show_x  = input.bool(true, "Show 5/20 cross arrows", group = grp_x)
x_tags  = input.bool(true, "Label the arrows (5/20 ▲ / ▼)", group = grp_x)

// ── VWAP (rolling AVWAP, same as volume_profile.pine) ────────────────────────
grp_vw  = "VWAP"
show_vw = input.bool(true, "Show rolling VWAP", group = grp_vw)
vwBars  = input.int(150, "VWAP lookback bars", minval = 10, maxval = 5000, group = grp_vw)
vwCol   = input.color(color.blue, "VWAP colour", group = grp_vw)
vwWidth = input.int(2, "VWAP width", minval = 1, maxval = 8, group = grp_vw)

// ── HUD (entry / exit dashboard) ─────────────────────────────────────────────
grp_h   = "HUD (entry / exit)"
show_hud = input.bool(true, "Show entry/exit HUD", group = grp_h)
rsiLen   = input.int(14, "RSI length", minval = 2, maxval = 50, group = grp_h)
hudPosIn = input.string("top_right", "HUD position", options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"], group = grp_h)
hudSzIn  = input.string("normal", "HUD text size", options = ["tiny", "small", "normal", "large"], group = grp_h)

// ── Daily MAs — current daily value (lookahead_off: no future leak; the forming day
//    updates live, so today's 5/20 cross fires today rather than a day late). ──────
f_dma(simple int len) => request.security(syminfo.tickerid, "D", ta.ema(close, len), lookahead = barmerge.lookahead_off)
ema5   = f_dma(5)
ema8   = f_dma(8)
ema20  = f_dma(20)
ema50  = f_dma(50)
ema100 = f_dma(100)
ema200 = f_dma(200)
sma50  = request.security(syminfo.tickerid, "D", ta.sma(close, 50),  lookahead = barmerge.lookahead_off)
sma100 = request.security(syminfo.tickerid, "D", ta.sma(close, 100), lookahead = barmerge.lookahead_off)
sma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200), lookahead = barmerge.lookahead_off)

// ── Plot MAs ─────────────────────────────────────────────────────────────────
plot(show_lines and sel_ema5   ? ema5   : na, "EMA 5 (D)",   color = color.new(#00BCD4,     0), linewidth = 2)
plot(show_lines and sel_ema8   ? ema8   : na, "EMA 8 (D)",   color = color.new(#9C27B0,     0), linewidth = 2)
plot(show_lines and sel_ema20  ? ema20  : na, "EMA 20 (D)",  color = color.new(color.green, 0), linewidth = 3)
plot(show_lines and sel_ema50  ? ema50  : na, "EMA 50 (D)",  color = color.new(#1565C0,     0), linewidth = 3)
plot(show_lines and sel_ema100 ? ema100 : na, "EMA 100 (D)", color = color.new(#F57F17,     0), linewidth = 3)
plot(show_lines and sel_ema200 ? ema200 : na, "EMA 200 (D)", color = color.new(color.black, 0), linewidth = 3)
plot(show_lines and sel_sma50  ? sma50  : na, "SMA 50 (D)",  color = color.new(#1565C0,     0), linewidth = 3, style = plot.style_circles)
plot(show_lines and sel_sma100 ? sma100 : na, "SMA 100 (D)", color = color.new(#F57F17,     0), linewidth = 3, style = plot.style_circles)
plot(show_lines and sel_sma200 ? sma200 : na, "SMA 200 (D)", color = color.new(color.black, 0), linewidth = 3, style = plot.style_circles)

// ── End-of-line tags — one per MA, on the last bar, following the per-MA toggle ─
matag(float v, string txt, color c, bool show) =>
    var label lb = na
    if barstate.islast
        label.delete(lb)
        if show and show_lines and show_ma_tags and not na(v)
            lb := label.new(bar_index + 3, v, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 0), textcolor = color.white, size = size.small)
matag(ema5,   "EMA 5",   #00BCD4,     sel_ema5)
matag(ema8,   "EMA 8",   #9C27B0,     sel_ema8)
matag(ema20,  "EMA 20",  color.green, sel_ema20)
matag(ema50,  "EMA 50",  #1565C0,     sel_ema50)
matag(ema100, "EMA 100", #F57F17,     sel_ema100)
matag(ema200, "EMA 200", color.black, sel_ema200)
matag(sma50,  "SMA 50",  #1565C0,     sel_sma50)
matag(sma100, "SMA 100", #F57F17,     sel_sma100)
matag(sma200, "SMA 200", color.black, sel_sma200)

// ── 5 / 20 EMA cross arrows (on the daily-locked EMAs → a daily momentum turn) ─
x_up = not na(ema5) and not na(ema20) and ta.crossover(ema5, ema20)
x_dn = not na(ema5) and not na(ema20) and ta.crossunder(ema5, ema20)
plotshape(show_x and x_up, title = "5/20 cross up",   location = location.belowbar, color = color.new(color.green, 0), style = shape.triangleup,   size = size.small)
plotshape(show_x and x_dn, title = "5/20 cross down", location = location.abovebar, color = color.new(color.red,   0), style = shape.triangledown, size = size.small)
if show_x and x_tags and x_up
    label.new(bar_index, low,  "5/20 ▲", style = label.style_label_up,   color = color.new(color.green, 0), textcolor = color.white, size = size.tiny, yloc = yloc.belowbar)
if show_x and x_tags and x_dn
    label.new(bar_index, high, "5/20 ▼", style = label.style_label_down, color = color.new(color.red,   0), textcolor = color.white, size = size.tiny, yloc = yloc.abovebar)
alertcondition(x_up, "5/20 EMA cross up",   "5 EMA crossed ABOVE the 20 EMA")
alertcondition(x_dn, "5/20 EMA cross down", "5 EMA crossed BELOW the 20 EMA")

// ── Rolling VWAP — identical to volume_profile.pine's AVWAP over the window ────
_hlc  = (high + low + close) / 3.0
_svol = math.sum(volume, vwBars)
avwap = _svol > 0 ? math.sum(_hlc * volume, vwBars) / _svol : na
plot(show_vw ? avwap : na, "VWAP", color = color.new(vwCol, 0), linewidth = vwWidth)

// ═════════════════════════════════════════════════════════════════════════════
// HUD — a compact entry/exit dashboard: RSI + the three reads I check before a
// trade — trend bias (are the EMAs stacked with me?), VWAP location (near = entry
// zone, extended = trim), and ATR (how much room / where the stop goes).
// ═════════════════════════════════════════════════════════════════════════════
_hudPos = hudPosIn == "top_left" ? position.top_left : hudPosIn == "bottom_right" ? position.bottom_right : hudPosIn == "bottom_left" ? position.bottom_left : hudPosIn == "middle_right" ? position.middle_right : position.top_right
_hudSz  = hudSzIn == "tiny" ? size.tiny : hudSzIn == "small" ? size.small : hudSzIn == "large" ? size.large : size.normal

// Palette
_cBg   = color.new(#0E1116, 8)      // panel background
_cHdr  = color.new(#1D4ED8, 0)      // header band
_cLbl  = color.new(#1B2430, 0)      // label-column cells
_cTxt  = color.new(#E5E7EB, 0)      // primary text
_cMut  = color.new(#9CA3AF, 0)      // muted text
_cGrn  = color.new(#22C55E, 0)
_cRed  = color.new(#EF4444, 0)
_cAmb  = color.new(#F59E0B, 0)
_cBlu  = color.new(#38BDF8, 0)

// ── RSI (chart TF) — momentum + overbought/oversold ──────────────────────────
_rsi = ta.rsi(close, rsiLen)
_rsiTxt = na(_rsi) ? "—" : str.tostring(_rsi, "#.#") + (_rsi >= 70 ? "  OVERBOUGHT" : _rsi <= 30 ? "  OVERSOLD" : _rsi >= 50 ? "  bullish" : "  bearish")
_rsiCol = na(_rsi) ? _cMut : _rsi >= 70 ? _cRed : _rsi <= 30 ? _cGrn : _rsi >= 50 ? _cGrn : _cAmb

// ── Trend bias — price vs the daily EMA stack (entry direction gate) ──────────
_above = (close > nz(ema5, close) ? 1 : 0) + (close > nz(ema20, close) ? 1 : 0) + (close > nz(ema50, close) ? 1 : 0) + (close > nz(ema200, close) ? 1 : 0)
_biasTxt = _above == 4 ? "LONG  ▲  (4/4 above)" : _above == 0 ? "SHORT  ▼  (0/4 above)" : "MIXED  ·  " + str.tostring(_above) + "/4 above"
_biasCol = _above == 4 ? _cGrn : _above == 0 ? _cRed : _cAmb

// ── VWAP location — % from the rolling VWAP (near = entry, extended = trim) ───
_vwDist = not na(avwap) and avwap > 0 ? (close - avwap) / avwap * 100.0 : na
_vwTxt = na(_vwDist) ? "—" : (_vwDist >= 0 ? "+" : "") + str.tostring(_vwDist, "#.##") + "%  " + (math.abs(_vwDist) <= 0.3 ? "AT VWAP" : _vwDist > 0 ? "above" : "below")
_vwCol = na(_vwDist) ? _cMut : math.abs(_vwDist) <= 0.3 ? _cBlu : _vwDist > 0 ? _cGrn : _cRed

// ── ATR (chart TF) — volatility for stop / target sizing ─────────────────────
_atr = ta.atr(14)
_atrPct = not na(_atr) and close > 0 ? _atr / close * 100.0 : na
_atrTxt = na(_atr) ? "—" : str.tostring(_atr, format.mintick) + "  (" + str.tostring(_atrPct, "#.#") + "%)  · 1.5×=" + str.tostring(_atr * 1.5, format.mintick)

var table hud = table.new(_hudPos, 2, 6, bgcolor = _cBg, frame_color = color.new(#334155, 0), frame_width = 1, border_color = color.new(#334155, 40), border_width = 1)
if show_hud and barstate.islast
    // Header — symbol + timeframe.
    table.cell(hud, 0, 0, "ENTRY / EXIT", text_color = color.white, bgcolor = _cHdr, text_size = _hudSz, text_halign = text.align_left)
    table.cell(hud, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.new(#DBEAFE, 0), bgcolor = _cHdr, text_size = _hudSz, text_halign = text.align_right)
    // Rows.
    table.cell(hud, 0, 1, "RSI " + str.tostring(rsiLen), text_color = _cMut, bgcolor = _cLbl, text_size = _hudSz, text_halign = text.align_left)
    table.cell(hud, 1, 1, _rsiTxt, text_color = _rsiCol, text_size = _hudSz, text_halign = text.align_right)
    table.cell(hud, 0, 2, "Trend", text_color = _cMut, bgcolor = _cLbl, text_size = _hudSz, text_halign = text.align_left)
    table.cell(hud, 1, 2, _biasTxt, text_color = _biasCol, text_size = _hudSz, text_halign = text.align_right)
    table.cell(hud, 0, 3, "VWAP", text_color = _cMut, bgcolor = _cLbl, text_size = _hudSz, text_halign = text.align_left)
    table.cell(hud, 1, 3, _vwTxt, text_color = _vwCol, text_size = _hudSz, text_halign = text.align_right)
    table.cell(hud, 0, 4, "ATR 14", text_color = _cMut, bgcolor = _cLbl, text_size = _hudSz, text_halign = text.align_left)
    table.cell(hud, 1, 4, _atrTxt, text_color = _cTxt, text_size = _hudSz, text_halign = text.align_right)
    // Momentum footer — the 5/20 state.
    _xState = not na(ema5) and not na(ema20) ? (ema5 > ema20 ? "5 ▸ above 20  (bull)" : "5 ▸ below 20  (bear)") : "—"
    _xCol = not na(ema5) and not na(ema20) ? (ema5 > ema20 ? _cGrn : _cRed) : _cMut
    table.cell(hud, 0, 5, "5 / 20", text_color = _cMut, bgcolor = _cLbl, text_size = _hudSz, text_halign = text.align_left)
    table.cell(hud, 1, 5, _xState, text_color = _xCol, text_size = _hudSz, text_halign = text.align_right)
