//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// MA PROXIMITY — EMA 8/20/50/100/200 + SMA 20/50/100/200, gated by % distance. VISUAL ONLY.
// NO alerts, NO webhook payload — nothing here can touch the ma/ema alert engine.
//
// The whole point: a 200 SMA sitting 22% below price is not a level you trade today, it's a
// line that squashes the candles into a ribbon. So:
//   • EMA 8 / 20 / 50 ALWAYS draw — the working cluster, price lives on them.
//   • EVERYTHING else (EMA 100 / 200 + SMA 20 / 50 / 100 / 200) draws ONLY when price is
//     within prox_pct% of it. Price falls toward the 50, the next supports come into range
//     and reveal themselves; a far 200 stays hidden until it actually matters.
//
// Every MA owns its LOOK — its own color, width and line style (solid / dashed / dotted),
// set per line in the "Per-MA look" group. "Line color = role" switches the whole set back to
// the green-support / red-resistance read.
//
// THE HUD — the daily read, in one block:
//   • RSI 14 (daily) · SMA 20 and EMA 20 SLOPE IN DEGREES (both lengths are inputs) (ATR-normalised, so the angle means
//     the same thing on a $9 stock and a $900 one — that is how "rising" is measured here).
//   • Today's volume vs yesterday's, and vs the 50-day average.
//   • Daily ATR % (how much room the name gives a stop) and today's change.
//   • The PATTERN forming — bull flag / cup w/ handle / ascending triangle / flat base — with
//     its TBA (the breakout line), the distance to it, and the pattern stop. Detection is the
//     engine from patterns.pine, run on the daily and drawn here as the TBA + stop lines.
//     A pattern that closes below its stop is INVALIDATED — flagged once, then dropped.
//   • Nearest MA above and below price, so the proximity gate never hides what is out there.
// ONE TIMEFRAME LOCK governs all of it: locked (default D), every value — MA lines, HUD,
// pattern and TBA — is computed on that timeframe and does NOT move when you change the chart
// TF. Unlock it and everything follows the chart instead.
// The HUD's live metrics (RSI, volume, pattern) read the FORMING daily bar, so they update
// through the session — that is the point of them.
// ─────────────────────────────────────────────────────────────────────────────
indicator("MA-EMA-TBA-v2", overlay = true, max_labels_count = 100, max_lines_count = 60, max_bars_back = 500)

// ── TIMEFRAME LOCK — one switch for the whole indicator ─────────────────────────
// LOCKED (default): every number here — MA values, HUD metrics, the pattern and its TBA — is
// computed on lock_tf and stays put whatever chart timeframe you are on. Drop from the daily
// to a 5m and the lines do not move, the TBA does not move, the HUD still reads the daily.
// UNLOCKED: everything follows the chart, so a 5m chart shows 5m MAs and a 5m pattern.
gTf     = "Timeframe lock"
lock_on = input.bool(true, "🔒 Lock everything to a fixed timeframe", group = gTf, tooltip = "ON = MA lines, HUD and the pattern/TBA are all read from the timeframe below, no matter what the chart is set to — that is what keeps the daily TBA and the daily MAs identical on a 5m, 15m or 1h chart. OFF = everything follows the chart timeframe (5m chart = 5m MAs, 5m pattern).")
lock_tf = input.timeframe("D", "  · …to this timeframe", group = gTf, tooltip = "D = the daily read. W gives weekly MAs and a weekly TBA. Ignored while the lock above is off.")
// One resolution for everything downstream. "" is not used: timeframe.period IS the chart's own.
tf_use  = lock_on ? lock_tf : timeframe.period
tf_tag  = lock_on ? "🔒 " + lock_tf : "chart " + timeframe.period

// ── which MAs ───────────────────────────────────────────────────────────────────
gMa        = "MA lines"
show_lines = input.bool(true, "Show MA flat lines (master)", group = gMa)
show_e8    = input.bool(true, "  · EMA 8",   group = gMa, inline = "e1")
show_e20   = input.bool(true, "  · EMA 20",  group = gMa, inline = "e1")
show_e50   = input.bool(true, "  · EMA 50",  group = gMa, inline = "e1")
show_e100  = input.bool(true, "  · EMA 100", group = gMa, inline = "e2")
show_e200  = input.bool(true, "  · EMA 200", group = gMa, inline = "e2")
show_s20   = input.bool(true, "  · SMA 20",  group = gMa, inline = "s1")
show_s50   = input.bool(true, "  · SMA 50",  group = gMa, inline = "s1")
show_s100  = input.bool(true, "  · SMA 100", group = gMa, inline = "s2")
show_s200  = input.bool(true, "  · SMA 200", group = gMa, inline = "s2")

// ── proximity gate — the reason this file exists ────────────────────────────────
gPx       = "Proximity gate"
prox_on   = input.bool(true, "Gate the deeper MAs by % distance from price", group = gPx, tooltip = "EMA 8/20/50 always draw — they're the working cluster. Everything else (EMA 100/200 + all four SMAs) is subject to the % below. OFF = draw all nine regardless of distance, and watch the chart compress.")
prox_pct  = input.float(10.0, "  · gated MAs draw only within % of price", minval = 0.5, maxval = 50, step = 0.5, group = gPx, tooltip = "A gated MA draws only when |price - MA| / price is at or under this %. 10 = anything further than 10% away stays off the chart. Lower it (4-6%) for a tight day-trading read, raise it (15-20%) when you want to see what price is falling toward.")
gate_fast = input.bool(false, "  · gate the EMA 8/20/50 too (they're exempt by default)", group = gPx, tooltip = "Off: the 8/20/50 EMA always draw, however far price has run from them — they're the reference the day is read against. On: they obey the same % as everything else.")
prox_near = input.bool(true, "  · if EVERYTHING is out of range, still draw the nearest one", group = gPx, tooltip = "Only bites when the fast EMAs are gated too (otherwise the 8/20/50 are always on the chart anyway). On = you always keep one reference line, accepting that a far one compresses the scale. Off = an empty chart when price is nowhere near a moving average, with the HUD still naming the nearest MA above and below.")
gate_mode = input.string("nearest above + below", "Deeper-MA gate mode", options = ["nearest above + below", "within % of price"], group = gPx, tooltip = "The fast cluster (EMA 8/20/50) always draws. This controls the DEEPER MAs (EMA 100/200 + all four SMAs). 'nearest above + below' = show ONLY the single closest one above price and the single closest below — one support + one resistance, always relative to where price is, matching the D/W/M levels. 'within % of price' = the older gate: any deeper MA closer than the % above.")

// ── per-MA look — each line its own color, width and style ──────────────────────
// One row per MA: colour swatch · width (w) · style. The defaults encode two things at once:
// COLOUR = THE LENGTH — 8 red · 20 green · 50 blue · 100 orange · 200 black, so the same length
// is the same colour in both families and an EMA/SMA pair is read as one colour, two lines.
// STYLE = THE FAMILY — EMA solid, SMA dotted. Width steps up with the length (1 / 1 / 2 / 2 / 3),
// so the deeper the average, the heavier the line. Note the 200s are black: set for a light
// chart, and worth recolouring if you run a dark theme.
gLk    = "Per-MA look (color · width · style)"
c_e8   = input.color(#EF5350, "EMA 8", group = gLk, inline = "L1")
w_e8   = input.int(1, "w", minval = 1, maxval = 10, group = gLk, inline = "L1")
y_e8   = input.string("solid", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L1")
c_e20  = input.color(#26A69A, "EMA 20", group = gLk, inline = "L2")
w_e20  = input.int(1, "w", minval = 1, maxval = 10, group = gLk, inline = "L2")
y_e20  = input.string("solid", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L2")
c_e50  = input.color(#2962FF, "EMA 50", group = gLk, inline = "L3")
w_e50  = input.int(2, "w", minval = 1, maxval = 10, group = gLk, inline = "L3")
y_e50  = input.string("solid", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L3")
c_e100 = input.color(#FF9800, "EMA 100", group = gLk, inline = "L4")
w_e100 = input.int(2, "w", minval = 1, maxval = 10, group = gLk, inline = "L4")
y_e100 = input.string("solid", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L4")
c_e200 = input.color(#000000, "EMA 200", group = gLk, inline = "L5")
w_e200 = input.int(3, "w", minval = 1, maxval = 10, group = gLk, inline = "L5")
y_e200 = input.string("solid", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L5")
c_s20  = input.color(#26A69A, "SMA 20", group = gLk, inline = "L6")
w_s20  = input.int(1, "w", minval = 1, maxval = 10, group = gLk, inline = "L6")
y_s20  = input.string("dotted", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L6")
c_s50  = input.color(#2962FF, "SMA 50", group = gLk, inline = "L7")
w_s50  = input.int(2, "w", minval = 1, maxval = 10, group = gLk, inline = "L7")
y_s50  = input.string("dotted", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L7")
c_s100 = input.color(#FF9800, "SMA 100", group = gLk, inline = "L8")
w_s100 = input.int(2, "w", minval = 1, maxval = 10, group = gLk, inline = "L8")
y_s100 = input.string("dotted", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L8")
c_s200 = input.color(#000000, "SMA 200", group = gLk, inline = "L9")
w_s200 = input.int(3, "w", minval = 1, maxval = 10, group = gLk, inline = "L9")
y_s200 = input.string("dotted", "", options = ["solid", "dashed", "dotted"], group = gLk, inline = "L9")

// ── style (global) ──────────────────────────────────────────────────────────────
gSt        = "Style"
color_mode = input.string("per-MA", "Line color", options = ["per-MA", "role (support / resistance)"], group = gSt, tooltip = "per-MA = every line wears the colour you set above, so you identify the MA from the line. role = the old read: green when price is above the level (support), red when price is below it (resistance). Width and line style stay per-MA either way.")
sup_col    = input.color(#26A69A, "role · support (price above)",    group = gSt, inline = "c")
res_col    = input.color(#EF5350, "role · resistance (price below)", group = gSt, inline = "c")
flat_len   = input.int  (60, "Flat line length (bars back)", minval = 10, maxval = 500, group = gSt)
w_boost    = input.int  (2, "Thickness boost — adds to EVERY line", minval = 0, maxval = 6, group = gSt, tooltip = "Quick global fattener on top of the per-MA widths set above: +2 (the default) makes a 1 draw at 3 and a 3 at 5. Set it to 0 and each MA keeps exactly the width you gave it above. Capped at 10.")
merge_pct  = input.float(0.25, "Merge MAs within (%) into ONE line", minval = 0.0, maxval = 3, step = 0.05, group = gSt, tooltip = "MAs stacked within this % of each other collapse into a SINGLE line whose label names every member (e.g. 'EMA 20 · SMA 50 ·×2'). Identity kept, stacked labels gone. The merged line sits on the member NEAREST price — a real level, never a fabricated average — takes that member's colour and style, and draws one step thicker. 0 = draw every MA separately.") / 100.0
lbl_gap    = input.float(0.08, "De-overlap labels within (%)", minval = 0.0, maxval = 1, step = 0.02, group = gSt, tooltip = "Two MA lines too close to MERGE but close enough that their right-edge tags would sit on top of each other (hiding one behind the other) get nudged apart vertically — the LINE stays on its true price, only the text box shifts. This is a label-height proxy in price terms; raise it if tags still overlap when zoomed out, lower it (or 0) if they float too far from their lines.") / 100.0
by_role    = color_mode != "per-MA"
f_style(string s) => s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid
// label text that stays readable on a bright swatch (amber/yellow lines need black text)
f_txtcol(color c) => (color.r(c) * 0.299 + color.g(c) * 0.587 + color.b(c) * 0.114) > 150 ? color.black : color.white


// ── HUD ─────────────────────────────────────────────────────────────────────────
gHd        = "HUD"
show_hud   = input.bool(true, "Show the HUD", group = gHd)
hud_pos_in = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"], group = gHd)
hud_size   = input.string("small", "Text size", options = ["tiny", "small", "normal", "large"], group = gHd)
slope_sma  = input.int(20, "Slope · SMA length", minval = 2, maxval = 200, group = gHd, inline = "sl")
slope_ema  = input.int(20, "Slope · EMA length", minval = 2, maxval = 200, group = gHd, inline = "sl")
slope_lb   = input.int(5, "Slope lookback (daily bars)", minval = 2, maxval = 30, group = gHd, tooltip = "The angle is measured over this many daily bars: rise per bar ÷ daily ATR, turned into degrees. ATR-normalising is what makes the number comparable across symbols and price levels — 30° on a $9 stock means the same slope as 30° on a $900 one. 5 bars = this week's angle; 10-20 = the trend's angle.")
hud_pos    = hud_pos_in == "top_left" ? position.top_left : hud_pos_in == "bottom_right" ? position.bottom_right : hud_pos_in == "bottom_left" ? position.bottom_left : hud_pos_in == "middle_right" ? position.middle_right : position.top_right
hud_txt    = hud_size == "tiny" ? size.tiny : hud_size == "normal" ? size.normal : hud_size == "large" ? size.large : size.small

// ── pattern engine (ported from patterns.pine — same thresholds, same TBA) ──────
gPt        = "Pattern · TBA (from patterns.pine)"
show_pat   = input.bool(true, "Detect the forming pattern", group = gPt)
show_tba   = input.bool(true, "Draw the TBA + pattern stop lines", group = gPt)
p_piv      = input.int(5, "Swing pivot length", minval = 2, group = gPt)
p_tol      = input.float(3.0, "Ceiling tolerance %", minval = 0.5, step = 0.5, group = gPt) / 100
p_maxD     = input.float(35.0, "Max base depth %", group = gPt) / 100
p_flatD    = input.float(15.0, "Flat base max depth %", group = gPt) / 100
p_minB     = input.int(10, "Min base length (bars)", group = gPt)
p_maxB     = input.int(120, "Max base lookback (bars)", group = gPt)
p_poleMin  = input.float(12.0, "Flag · min pole gain %", group = gPt) / 100
p_poleMax  = input.int(15, "Flag · max pole length (bars)", group = gPt)
p_flagMin  = input.int(3, "Flag · min length (bars)", group = gPt)
p_flagMax  = input.int(12, "Flag · max length (bars)", group = gPt)
p_retrMax  = input.float(50.0, "Flag · max retrace of pole %", group = gPt) / 100
p_cupLen   = input.int(80, "Cup · lookback (bars)", group = gPt)
p_minCup   = input.int(20, "Cup · min length (bars)", group = gPt)
p_cupMinD  = input.float(12.0, "Cup · min depth %", group = gPt) / 100
p_cupMaxD  = input.float(40.0, "Cup · max depth %", group = gPt) / 100
p_rimTol   = input.float(5.0, "Cup · right rim within % of left", group = gPt) / 100
p_hMin     = input.int(3, "Cup · min handle (bars)", group = gPt)
p_hMax     = input.int(15, "Cup · max handle (bars)", group = gPt)
p_hMaxD    = input.float(12.0, "Cup · max handle depth %", group = gPt) / 100
p_volLen   = input.int(50, "Avg volume length (bars)", group = gPt)
p_volMlt   = input.float(1.5, "Breakout volume multiple", step = 0.1, group = gPt)
p_ext      = input.float(5.0, "Extended above TBA %", group = gPt) / 100
p_hold     = input.int(5, "Keep the pattern after breakout (bars)", group = gPt)
p_maxRisk  = input.float(8.0, "Max stop distance below TBA %", group = gPt) / 100
p_trailOn  = input.bool(true, "After the break, trail the stop up with each day's low", group = gPt, tooltip = "ON: once price breaks the TBA the stop stops being a fixed line. Every new bar it lifts to the prior bar's low and NEVER steps back down — the trade keeps the ground it has taken. OFF: the old behaviour, one lift to the breakout bar's low and then static.")
p_trailLb  = input.int(1, "  · trail to the lowest low of the last N bars", minval = 1, maxval = 10, group = gPt, tooltip = "1 = the prior day's low, the tightest version — it will shake you out of a breakout that consolidates sideways for two or three days. 2-3 gives the move room to breathe and still ratchets. The trail never drops, whatever you set.")
c_tba      = input.color(color.aqua, "TBA line", group = gPt, inline = "pc")
c_stp      = input.color(#EF5350, "Stop line", group = gPt, inline = "pc")

// ── MA values — locked to lock_tf (settled, non-repainting) or the chart TF when unlocked ──
tid    = syminfo.tickerid
// LOCKED: settled ([1] + lookahead_on) values off lock_tf — flat and non-repainting on any
// chart TF. UNLOCKED: the plain chart-TF average. Same idiom as patterns.pine's f_ema/f_sma.
f_ema(simple int len) =>
    lock_on ? request.security(tid, lock_tf, ta.ema(close, len)[1], lookahead = barmerge.lookahead_on) : ta.ema(close, len)
f_sma(simple int len) =>
    lock_on ? request.security(tid, lock_tf, ta.sma(close, len)[1], lookahead = barmerge.lookahead_on) : ta.sma(close, len)
ema8   = f_ema(8)
ema20  = f_ema(20)
ema50  = f_ema(50)
ema100 = f_ema(100)
ema200 = f_ema(200)
sma20  = f_sma(20)
sma50  = f_sma(50)
sma100 = f_sma(100)
sma200 = f_sma(200)


// signed % distance: positive = MA is ABOVE price (resistance overhead), negative = below (support under).
sdist(float v) => na(v) or close <= 0 ? float(na) : (v - close) / close * 100.0
// the gate itself — absolute distance, so a far level is hidden whichever side it sits on.
prox_ok(float v) =>
    float d = sdist(v)
    not prox_on or na(d) or math.abs(d) <= prox_pct
// the fast cluster: exempt unless the user opts them into the gate.
fast_ok(float v) => not gate_fast or prox_ok(v)

// ── HUD metrics — read on tf_use's FORMING bar (lookahead_off) so they are live today ──────
// The slope is ATR-normalised: (MA − MA[lookback]) / lookback / ATR, as an angle. A raw price
// slope is meaningless across symbols ($2 a day is vertical on a $20 stock, nothing on a $900
// one); dividing by ATR puts every name on the same protractor.
[h_rsi, h_sma20, h_sma20p, h_ema20, h_ema20p, h_atr, h_vol, h_volPrev, h_volAvg, h_close, h_closePrev] = request.security(tid, tf_use, [ta.rsi(close, 14), ta.sma(close, slope_sma), ta.sma(close, slope_sma)[slope_lb], ta.ema(close, slope_ema), ta.ema(close, slope_ema)[slope_lb], ta.atr(14), volume, volume[1], ta.sma(volume, 50)[1], close, close[1]], lookahead = barmerge.lookahead_off)

f_deg(float now, float then) =>
    na(now) or na(then) or na(h_atr) or h_atr <= 0 ? float(na) : math.todegrees(math.atan((now - then) / slope_lb / h_atr))
deg_s20 = f_deg(h_sma20, h_sma20p)
deg_e20 = f_deg(h_ema20, h_ema20p)
// one vocabulary for both angles, so "rising" means the same thing on every row
f_degTxt(float d) => na(d) ? "—" : str.tostring(d, "#.0") + "°  " + (d >= 30 ? "steep up" : d >= 10 ? "rising" : d > -10 ? "flat" : d > -30 ? "falling" : "steep down")
f_degCol(float d) => na(d) ? color.gray : d >= 30 ? color.lime : d >= 10 ? #8BC34A : d > -10 ? color.gray : d > -30 ? color.orange : color.red

vol_chg  = na(h_vol) or na(h_volPrev) or h_volPrev <= 0 ? float(na) : (h_vol / h_volPrev - 1) * 100.0
vol_rel  = na(h_vol) or na(h_volAvg) or h_volAvg <= 0 ? float(na) : h_vol / h_volAvg
day_chg  = na(h_close) or na(h_closePrev) or h_closePrev <= 0 ? float(na) : (h_close / h_closePrev - 1) * 100.0
atr_pct  = na(h_atr) or na(h_close) or h_close <= 0 ? float(na) : h_atr / h_close * 100.0

// ── PATTERN ENGINE — ported from patterns.pine (same swings, same TBA, same status) ────────
// Computed on the chart TF, then re-evaluated on tf_use by request.security below, so a 5m chart
// still reads the DAILY pattern while the lock is on. Trimmed to the part that answers "what is forming, where does
// it break out, where is the stop" — no inner base, stage or playbook rows here.
p_avgVol = ta.sma(volume, p_volLen)
p_rvol   = p_avgVol > 0 ? volume / p_avgVol : na

var p_shP = array.new_float()
var p_shI = array.new_int()
var p_slP = array.new_float()
var p_slI = array.new_int()
p_ph = ta.pivothigh(high, p_piv, p_piv)
p_pl = ta.pivotlow(low, p_piv, p_piv)
if not na(p_ph)
    array.push(p_shP, p_ph)
    array.push(p_shI, bar_index - p_piv)
    if array.size(p_shP) > 30
        array.shift(p_shP)
        array.shift(p_shI)
if not na(p_pl)
    array.push(p_slP, p_pl)
    array.push(p_slI, bar_index - p_piv)
    if array.size(p_slP) > 30
        array.shift(p_slP)
        array.shift(p_slI)

// flat base / ascending triangle — a ceiling touched twice, lows flat or rising underneath
float p_ceil     = na
int   p_touch    = 0
int   p_first    = na
int   p_lowsFrom = na
float p_baseLow  = na
float p_firstL   = na
float p_prevL    = na
float p_lastL    = na
int   p_nLows    = 0
p_nH = array.size(p_shP)
if p_nH > 0
    p_lastH = array.get(p_shP, p_nH - 1)
    p_ceil := p_lastH
    for i = p_nH - 1 to 0
        h  = array.get(p_shP, i)
        ix = array.get(p_shI, i)
        if bar_index - ix > p_maxB
            break
        if h > p_lastH * (1 + p_tol)
            p_lowsFrom := ix
            break
        if h >= p_lastH * (1 - p_tol)
            p_touch += 1
            p_ceil  := math.max(p_ceil, h)
            p_first := ix
    if na(p_lowsFrom)
        p_lowsFrom := p_first
    p_nL = array.size(p_slP)
    if p_nL > 0 and not na(p_lowsFrom)
        for j = 0 to p_nL - 1
            ix = array.get(p_slI, j)
            if ix > p_lowsFrom
                l = array.get(p_slP, j)
                p_baseLow := na(p_baseLow) ? l : math.min(p_baseLow, l)
                if na(p_firstL)
                    p_firstL := l
                p_prevL := p_lastL
                p_lastL := l
                p_nLows += 1

p_baseLen = na(p_lowsFrom) ? 0 : bar_index - p_lowsFrom
p_depth   = not na(p_baseLow) and p_ceil > 0 ? (p_ceil - p_baseLow) / p_ceil : na
p_rising  = p_nLows >= 2 and p_lastL > p_prevL and p_lastL > p_firstL
p_isTri   = p_touch >= 2 and p_rising and p_depth <= p_maxD and p_baseLen >= p_minB
p_isFlat  = p_touch >= 2 and not p_isTri and p_depth <= p_flatD and p_baseLen >= p_minB

// bull flag — a pole, then a shallow drift
p_k        = nz(-ta.highestbars(high, p_flagMax + 1))
p_kLen     = math.max(p_k, 1)
p_kLen2    = math.max(p_k - 1, 1)
p_poleTop  = high[p_k]
p_lowPole  = ta.lowest(low, p_poleMax)
p_poleBase = p_lowPole[p_k]
p_flagLow  = ta.lowest(low, p_kLen)
p_flagHigh = ta.highest(high[1], p_kLen2)
p_poleGain = p_poleBase > 0 ? p_poleTop / p_poleBase - 1 : 0.0
p_retr     = p_poleTop > p_poleBase ? (p_poleTop - p_flagLow) / (p_poleTop - p_poleBase) : 1.0
p_isFlag   = p_k >= p_flagMin and p_k <= p_flagMax and p_poleGain >= p_poleMin and p_retr <= p_retrMax

// cup with handle
p_lrOff     = nz(-ta.highestbars(high[p_hMax], p_cupLen - p_hMax))
p_lrLen     = math.max(p_lrOff, 1)
p_leftAgo   = p_hMax + p_lrOff
p_leftRim   = high[p_leftAgo]
p_cupLow    = ta.lowest(low[p_hMax], p_lrLen)
p_rOff      = nz(-ta.highestbars(high, p_hMax))
p_rLen      = math.max(p_rOff, 1)
p_rightRim  = high[p_rOff]
p_handleLow = ta.lowest(low, p_rLen)
p_cupDepth  = p_leftRim > 0 ? (p_leftRim - p_cupLow) / p_leftRim : 0.0
p_hDepth    = p_rightRim > 0 ? (p_rightRim - p_handleLow) / p_rightRim : 1.0
p_cupMid    = p_cupLow + (p_leftRim - p_cupLow) / 2
p_isCup     = p_leftAgo - p_rOff >= p_minCup and p_cupDepth >= p_cupMinD and p_cupDepth <= p_cupMaxD and p_rightRim >= p_leftRim * (1 - p_rimTol) and p_rightRim <= p_leftRim * (1 + p_rimTol) and p_rOff >= p_hMin and p_hDepth <= p_hMaxD and p_handleLow > p_cupMid

// pick one — flag first (most immediate), then cup, then triangle, then flat base
string p_pat = na
float  p_tba = na
float  p_stp = na
if p_isFlag
    p_pat := "Bull Flag"
    p_tba := p_flagHigh
    p_stp := p_flagLow
else if p_isCup
    p_pat := "Cup w/ Handle"
    p_tba := p_rightRim
    p_stp := p_handleLow
else if p_isTri
    p_pat := "Ascending Triangle"
    p_tba := p_ceil
    p_stp := p_lastL
else if p_isFlat
    p_pat := "Flat Base"
    p_tba := p_ceil
    p_stp := p_lastL

// a found pattern is held for p_hold bars so a breakout day does not blank the HUD
var string p_mPat = na
var float  p_mTba = na
var float  p_mStp = na
var int    p_mBar = na
// A structure that already failed is remembered by its ceiling so the detector cannot simply
// re-find it on the next bar and show it again — which is exactly what made a dead base linger.
// It is un-blocked when price closes back above the STOP it broke (not the ceiling: demanding a
// close above the ceiling would hide a perfectly good base rebuilt underneath it).
var float p_deadTba  = na
var float p_deadStop = na
if not na(p_deadStop) and close > p_deadStop
    p_deadTba  := na
    p_deadStop := na
p_fresh = na(p_deadTba) or na(p_tba) or math.abs(p_tba - p_deadTba) > p_deadTba * 0.002
if not na(p_pat) and p_fresh
    p_mPat := p_pat
    p_mTba := p_tba
    p_mStp := p_stp
    p_mBar := bar_index
p_active = not na(p_mBar) and bar_index - p_mBar <= p_hold

var float p_brkLow = na
var float p_brkRef = na
p_crossUp = p_active and close > p_mTba and close[1] <= p_mTba
if p_crossUp
    p_brkLow := low
    p_brkRef := p_mTba
p_afterBrk = p_active and not na(p_brkRef) and p_brkRef == p_mTba
p_capStop  = p_mTba * (1 - p_maxRisk)
// ── TRAILING STOP — a stop that does not move is not managing anything. Once the TBA breaks,
// the stop lifts to the prior bar's low every bar and RATCHETS: math.max against its own last
// value, so it can only ever climb. Break below it and the status flips to "Failed".
// p_trailRef is the lowest low of the last N bars ENDING AT THE PRIOR BAR ([1]) — today's own
// low is deliberately excluded, or an intraday flush would drag the stop down onto itself.
p_trailRef = ta.lowest(low, p_trailLb)[1]
var float p_trail = na
if p_crossUp
    p_trail := math.max(low, p_mStp)                  // seed at the breakout bar's low
else if p_afterBrk
    p_trail := na(p_trailRef) ? p_trail : math.max(nz(p_trail, p_trailRef), p_trailRef)
else
    p_trail := na                                     // no breakout in play, no trail
p_trailed = p_afterBrk and p_trailOn and not na(p_trail)
p_stopF   = p_trailed ? math.max(p_trail, p_mStp) : p_afterBrk ? math.max(p_brkLow, p_mStp) : math.max(p_mStp, p_capStop)

string p_status = "No pattern"
color  p_stCol  = color.gray
if p_active
    p_distPct = (close / p_mTba - 1) * 100
    if close < p_stopF
        p_status := "Failed (below stop)"
        p_stCol  := color.red
    else if close > p_mTba * (1 + p_ext)
        p_status := "Extended +" + str.tostring(p_distPct, "#.0") + "%"
        p_stCol  := color.orange
    else if p_crossUp
        p_status := p_rvol >= p_volMlt ? "BREAKOUT on volume" : "Breakout, light volume"
        p_stCol  := p_rvol >= p_volMlt ? color.lime : color.yellow
    else if p_afterBrk and close > p_mTba
        p_status := "Holding above TBA"
        p_stCol  := color.lime
    else if p_afterBrk
        p_status := "Back below TBA"
        p_stCol  := color.orange
    else
        p_status := "Forming, " + str.tostring(-p_distPct, "#.0") + "% below TBA"
        p_stCol  := color.aqua

// ── INVALIDATION — a close below the stop ends the pattern. It says "Failed (below stop)" on
// the bar it breaks (that is the exit), and from the next bar there is no pattern at all: no
// name in the HUD, no TBA line, no stop line. Its ceiling goes into p_deadTba so the detector
// cannot re-adopt the same dead structure. Without this a base stayed on screen for weeks
// after price had fallen through it — 14% below a TBA it will not see again this month.
if p_active and not na(p_stopF) and close < p_stopF
    p_deadTba  := p_mTba
    p_deadStop := p_stopF
    p_mPat    := na
    p_mTba    := na
    p_mStp    := na
    p_mBar    := na
    p_brkRef  := na
    p_brkLow  := na
    p_trail   := na

// re-read the whole engine on tf_use — locked, a 5m chart carries the DAILY pattern and its levels
[P_act, P_pat, P_tba, P_stop, P_stat, P_col, P_trl] = request.security(tid, tf_use, [p_active, p_mPat, p_mTba, p_stopF, p_status, p_stCol, p_trailed], lookahead = barmerge.lookahead_off)

// ── draw the MA lines (rebuilt on the last bar) ─────────────────────────────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()
// everything that survived its gate is QUEUED first, then merged and drawn in one pass —
// drawing each level as it is decided is what produces stacks of overlapping labels.
// FIVE arrays in lockstep — value · name · color · width · style. Every push site pushes ALL
// five (queue_ma is the only one), or a short array reads out of bounds during the merge.
var float[]  _qv = array.new_float()
var string[] _qn = array.new_string()
var color[]  _qc = array.new_color()
var int[]    _qw = array.new_int()
var string[] _qy = array.new_string()
queue_ma(float v, string nm, color col, int wid, string sty, bool show) =>
    if show and not na(v)
        array.push(_qv, v)
        array.push(_qn, nm)
        array.push(_qc, col)
        int _wB = wid + w_boost
        array.push(_qw, _wB > 10 ? 10 : _wB < 1 ? 1 : _wB)
        array.push(_qy, f_style(sty))

if show_lines and barstate.islast
    if array.size(_ln) > 0
        for i = 0 to array.size(_ln) - 1
            line.delete(array.get(_ln, i))
        array.clear(_ln)
    if array.size(_lb) > 0
        for i = 0 to array.size(_lb) - 1
            label.delete(array.get(_lb, i))
        array.clear(_lb)
    array.clear(_qv)
    array.clear(_qn)
    array.clear(_qc)
    array.clear(_qw)
    array.clear(_qy)

    // the working cluster — ALWAYS drawn (unless the user gates them on purpose)
    queue_ma(ema8,  "EMA 8",  c_e8,  w_e8,  y_e8,  show_e8  and fast_ok(ema8))
    queue_ma(ema20, "EMA 20", c_e20, w_e20, y_e20, show_e20 and fast_ok(ema20))
    queue_ma(ema50, "EMA 50", c_e50, w_e50, y_e50, show_e50 and fast_ok(ema50))
    // everything deeper (EMA 100/200 + all four SMAs) — gated either by % distance (old mode)
    // or, by default, to the single NEAREST one above price + the single nearest below, so the
    // chart always carries one deeper support and one deeper resistance relative to price.
    _dv = array.from(ema100, ema200, sma20, sma50, sma100, sma200)
    _dn = array.from("EMA 100", "EMA 200", "SMA 20", "SMA 50", "SMA 100", "SMA 200")
    _de = array.from(show_e100, show_e200, show_s20, show_s50, show_s100, show_s200)
    _dc = array.from(c_e100, c_e200, c_s20, c_s50, c_s100, c_s200)
    _dw = array.from(w_e100, w_e200, w_s20, w_s50, w_s100, w_s200)
    _dy = array.from(y_e100, y_e200, y_s20, y_s50, y_s100, y_s200)
    if gate_mode == "within % of price"
        for _di = 0 to array.size(_dv) - 1
            _dvv = array.get(_dv, _di)
            queue_ma(_dvv, array.get(_dn, _di), array.get(_dc, _di), array.get(_dw, _di), array.get(_dy, _di), array.get(_de, _di) and prox_ok(_dvv))
    else
        int   _upI  = -1
        float _upVd = na
        int   _dnI  = -1
        float _dnVd = na
        for _di = 0 to array.size(_dv) - 1
            _dvv = array.get(_dv, _di)
            if array.get(_de, _di) and not na(_dvv)
                if _dvv > close and (na(_upVd) or _dvv < _upVd)
                    _upVd := _dvv
                    _upI  := _di
                if _dvv < close and (na(_dnVd) or _dvv > _dnVd)
                    _dnVd := _dvv
                    _dnI  := _di
        if _upI >= 0
            queue_ma(array.get(_dv, _upI), array.get(_dn, _upI), array.get(_dc, _upI), array.get(_dw, _upI), array.get(_dy, _upI), true)
        if _dnI >= 0
            queue_ma(array.get(_dv, _dnI), array.get(_dn, _dnI), array.get(_dc, _dnI), array.get(_dw, _dnI), array.get(_dy, _dnI), true)

    // fallback — every MA was gated out (only possible with gate_fast on) and the user asked
    // for one reference line anyway: draw the single NEAREST enabled MA, in its own look.
    if prox_near and array.size(_qv) == 0
        _fv = array.from(ema8, ema20, ema50, ema100, ema200, sma20, sma50, sma100, sma200)
        _fn = array.from("EMA 8", "EMA 20", "EMA 50", "EMA 100", "EMA 200", "SMA 20", "SMA 50", "SMA 100", "SMA 200")
        _fe = array.from(show_e8, show_e20, show_e50, show_e100, show_e200, show_s20, show_s50, show_s100, show_s200)
        _fc = array.from(c_e8, c_e20, c_e50, c_e100, c_e200, c_s20, c_s50, c_s100, c_s200)
        _fw = array.from(w_e8, w_e20, w_e50, w_e100, w_e200, w_s20, w_s50, w_s100, w_s200)
        _fy = array.from(y_e8, y_e20, y_e50, y_e100, y_e200, y_s20, y_s50, y_s100, y_s200)
        float  _fbest  = na
        string _fbnm   = ""
        color  _fbcol  = color.gray
        int    _fbw    = 1
        string _fbsty  = "solid"
        float  _fbestD = 1e18
        for _fi = 0 to array.size(_fv) - 1
            _fvv = array.get(_fv, _fi)
            if array.get(_fe, _fi) and not na(_fvv)
                _fd = math.abs(close - _fvv)
                if _fd < _fbestD
                    _fbestD := _fd
                    _fbest  := _fvv
                    _fbnm   := array.get(_fn, _fi)
                    _fbcol  := array.get(_fc, _fi)
                    _fbw    := array.get(_fw, _fi)
                    _fbsty  := array.get(_fy, _fi)
        queue_ma(_fbest, _fbnm + " (nearest, out of range)", _fbcol, _fbw, _fbsty, not na(_fbest))

    // ── MERGE + DRAW — MAs stacked within merge_pct collapse into ONE line that NAMES every
    //    member. The merged line sits on the member NEAREST price — a real level, never a
    //    fabricated average that lands on none of them — wears THAT member's colour and style,
    //    and draws one step thicker, because two MAs at one price IS the information.
    _n = array.size(_qv)
    if _n > 0
        _ord = array.sort_indices(_qv, order.ascending)
        // de-overlap: clusters draw bottom→top, so each tag is pushed to at least _gap above the
        // previous tag's text position. Lines keep their true price; only the label box shifts.
        float _gap     = close * lbl_gap
        float _lastLbl = na
        _i = 0
        while _i < _n
            _s     = array.get(_ord, _i)
            _hi    = array.get(_qv, _s)
            _nm    = array.get(_qn, _s)
            _cnt   = 1
            _near  = _hi                          // the member closest to price anchors the line
            _nearD = math.abs(close - _hi)
            _col   = array.get(_qc, _s)           // …and lends it its look
            _wid   = array.get(_qw, _s)
            _sty   = array.get(_qy, _s)
            _j = _i + 1
            while _j < _n
                _k  = array.get(_ord, _j)
                _v2 = array.get(_qv, _k)
                if merge_pct > 0 and _v2 <= _hi * (1.0 + merge_pct)
                    _hi  := _v2
                    _nm  := _nm + " · " + array.get(_qn, _k)
                    _cnt := _cnt + 1
                    if math.abs(close - _v2) < _nearD
                        _near  := _v2
                        _nearD := math.abs(close - _v2)
                        _col   := array.get(_qc, _k)
                        _wid   := array.get(_qw, _k)
                        _sty   := array.get(_qy, _k)
                    _j := _j + 1
                else
                    break
            _sup  = close > _near
            _draw = by_role ? (_sup ? sup_col : res_col) : _col
            _w    = _cnt > 1 and _wid < 10 ? _wid + 1 : _wid             // a merged cluster (a wall) draws one thicker
            float _pct = close > 0 ? math.abs(close - _near) / close * 100.0 : float(na)
            _txt = (_sup ? "▲ SUPPORT  " : "▼ RESIST  ") + _nm + (_cnt > 1 ? "  ·×" + str.tostring(_cnt) : "") + "  " + str.tostring(_near, format.mintick) + (na(_pct) ? "" : "  (" + str.tostring(_pct, "#.##") + "%)")
            float _lblY = _near
            if lbl_gap > 0 and not na(_lastLbl) and _lblY < _lastLbl + _gap
                _lblY := _lastLbl + _gap           // nudge up so this tag clears the one below it
            _lastLbl := _lblY
            array.push(_ln, line.new(bar_index - flat_len, _near, bar_index + 6, _near, color = _draw, width = _w, style = _sty))
            array.push(_lb, label.new(bar_index + 6, _lblY, _txt, style = label.style_label_left, color = _draw, textcolor = f_txtcol(_draw), size = size.small))
            _i := _j

// ── TBA + pattern stop lines ────────────────────────────────────────────────────
// Horizontal, so a fixed lookback is used for x1 (a daily bar_index cannot map onto a 5m chart).
var line  _tbaLn = na
var line  _stpLn = na
var label _tbaLb = na
var label _stpLb = na
if barstate.islast
    line.delete(_tbaLn)
    line.delete(_stpLn)
    label.delete(_tbaLb)
    label.delete(_stpLb)
    if show_pat and show_tba and P_act and not na(P_tba)
        _tbaLn := line.new(bar_index - flat_len, P_tba, bar_index + 6, P_tba, color = c_tba, width = 2)
        _tbaLb := label.new(bar_index + 6, P_tba, "TBA " + str.tostring(P_tba, format.mintick) + "  ·  " + P_pat, style = label.style_label_left, color = c_tba, textcolor = f_txtcol(c_tba), size = size.small)
        if not na(P_stop)
            _stpLn := line.new(bar_index - flat_len, P_stop, bar_index + 6, P_stop, color = color.new(c_stp, 20), width = 1, style = line.style_dashed)
            _stpLb := label.new(bar_index + 6, P_stop, (P_trl ? "Trailing stop ▲ " : "Pattern stop ") + str.tostring(P_stop, format.mintick), style = label.style_label_left, color = color.new(c_stp, 20), textcolor = f_txtcol(c_stp), size = size.small)

// ── HUD — the daily read: angles, volume, pattern, and what price sits between. ────────────
// Unchecked = the table is never even created, so nothing can sit over the chart on a phone.
var table _hud = not show_hud ? na : table.new(hud_pos, 2, 13, bgcolor = color.new(#0d1318, 5), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)
f_row(int r, string k, string v, color c) =>
    table.cell(_hud, 0, r, k, text_color = color.silver, text_size = hud_txt, text_halign = text.align_left)
    table.cell(_hud, 1, r, v, text_color = c, text_size = hud_txt, text_halign = text.align_right)

if show_hud and barstate.islast
    // nearest MA under and over price — the proximity gate can hide a line, but never the fact
    // that it is there. Two rows replace the old nine-row distance table.
    _nv = array.from(ema8, ema20, ema50, ema100, ema200, sma20, sma50, sma100, sma200)
    _nn = array.from("EMA 8", "EMA 20", "EMA 50", "EMA 100", "EMA 200", "SMA 20", "SMA 50", "SMA 100", "SMA 200")
    _ne = array.from(show_e8, show_e20, show_e50, show_e100, show_e200, show_s20, show_s50, show_s100, show_s200)
    float  _upV = na
    float  _dnV = na
    string _upN = "—"
    string _dnN = "—"
    for _ni = 0 to array.size(_nv) - 1
        _nvv = array.get(_nv, _ni)
        if array.get(_ne, _ni) and not na(_nvv)
            if _nvv > close and (na(_upV) or _nvv < _upV)
                _upV := _nvv
                _upN := array.get(_nn, _ni)
            if _nvv < close and (na(_dnV) or _nvv > _dnV)
                _dnV := _nvv
                _dnN := array.get(_nn, _ni)
    _upTxt = na(_upV) ? "—" : _upN + "  " + str.tostring(_upV, format.mintick) + "  (+" + str.tostring(sdist(_upV), "#.#") + "%)"
    _dnTxt = na(_dnV) ? "—" : _dnN + "  " + str.tostring(_dnV, format.mintick) + "  (" + str.tostring(sdist(_dnV), "#.#") + "%)"

    _rsiTxt = na(h_rsi) ? "—" : str.tostring(h_rsi, "#.0") + "  " + (h_rsi >= 70 ? "overbought" : h_rsi <= 30 ? "oversold" : h_rsi >= 50 ? "bullish" : "bearish")
    _rsiCol = na(h_rsi) ? color.gray : h_rsi >= 70 ? color.red : h_rsi <= 30 ? color.lime : h_rsi >= 50 ? #8BC34A : color.orange
    _volTxt = na(vol_chg) ? "—" : (vol_chg >= 0 ? "▲ +" : "▼ ") + str.tostring(vol_chg, "#.0") + "% vs yest"
    _volCol = na(vol_chg) ? color.gray : vol_chg >= 0 ? color.lime : color.orange
    _relTxt = na(vol_rel) ? "—" : str.tostring(vol_rel, "#.00") + "x  " + (vol_rel >= 2.0 ? "heavy" : vol_rel >= p_volMlt ? "above avg" : vol_rel >= 0.8 ? "normal" : "drying up")
    _relCol = na(vol_rel) ? color.gray : vol_rel >= p_volMlt ? color.lime : vol_rel >= 0.8 ? color.white : color.aqua
    _chgTxt = na(day_chg) ? "—" : (day_chg >= 0 ? "+" : "") + str.tostring(day_chg, "#.00") + "%"
    _chgCol = na(day_chg) ? color.gray : day_chg >= 0 ? color.lime : color.red
    _atrTxt = na(atr_pct) ? "—" : str.tostring(atr_pct, "#.0") + "%  (" + str.tostring(h_atr, format.mintick) + ")"
    _tbaTxt = not show_pat ? "off" : not P_act or na(P_tba) ? "—" : str.tostring(P_tba, format.mintick) + "  (" + (close > P_tba ? "+" : "") + str.tostring((close / P_tba - 1) * 100, "#.0") + "%)"

    f_row(0,  "MA·prox  " + syminfo.ticker, tf_tag, color.white)
    f_row(1,  "RSI 14", _rsiTxt, _rsiCol)
    f_row(2,  "SMA " + str.tostring(slope_sma) + " slope", f_degTxt(deg_s20), f_degCol(deg_s20))
    f_row(3,  "EMA " + str.tostring(slope_ema) + " slope", f_degTxt(deg_e20), f_degCol(deg_e20))
    f_row(4,  "Volume today", _volTxt, _volCol)
    f_row(5,  "vs 50-day avg", _relTxt, _relCol)
    f_row(6,  "Change today", _chgTxt, _chgCol)
    f_row(7,  "ATR 14", _atrTxt, color.white)
    f_row(8,  "Pattern", not show_pat ? "off" : P_act ? P_pat : "None", P_act ? color.white : color.gray)
    f_row(9,  "Status", not show_pat ? "off" : P_stat, P_col)
    f_row(10, "TBA", _tbaTxt, P_act ? c_tba : color.gray)
    f_row(11, "Next resistance", _upTxt, res_col)
    f_row(12, "Next support", _dnTxt, sup_col)
