//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// SMA PROXIMITY — 20 / 50 / 100 / 200, gated by % distance from price. VISUAL ONLY.
// NO alerts, NO webhook payload — nothing here can touch the ma/ema alert engine.
//
// The whole point: a 200 SMA sitting 22% below price is not a level you trade today, it's
// a line that squashes the candles into a ribbon. So EVERY SMA here is %-gated — a line
// draws only when price is within prox_pct% of it. Price falls toward the 50, the 100
// comes into range and appears. The 200 stays hidden until it actually matters.
//
// Draws:
//   • Daily SMA 20 / 50 / 100 / 200 flat lines (settled [1]+lookahead_on, non-repainting),
//     role-colored — green = support (price above), red = resistance (price below).
//   • CONFLUENCE MERGE — SMAs within ±0.20% collapse into ONE line naming every member
//     ("SMA 50 · SMA 100 ·×2"), drawn thicker. Two MAs at one price IS the information.
//   • DISTANCE TABLE — every SMA, in range or not, with its price and signed % distance.
//     Nothing is lost by hiding a line: you still see "SMA 200  412.80  -18.4%  hidden".
// Bind on any intraday TF — the values are settled daily, so the lines stay flat.
// ─────────────────────────────────────────────────────────────────────────────
indicator("SMA Proximity · 20/50/100/200", "SMA·prox", overlay = true, max_labels_count = 100, max_lines_count = 30)

// ── which SMAs ──────────────────────────────────────────────────────────────────
gMa        = "SMA lines"
show_lines = input.bool(true, "Show SMA flat lines (master)", group = gMa)
show_20    = input.bool(true, "  · SMA 20",  group = gMa, inline = "m1")
show_50    = input.bool(true, "  · SMA 50",  group = gMa, inline = "m1")
show_100   = input.bool(true, "  · SMA 100", group = gMa, inline = "m2")
show_200   = input.bool(true, "  · SMA 200", group = gMa, inline = "m2")
maTf       = input.timeframe("D", "SMA timeframe", group = gMa, tooltip = "Daily by default. Values are read settled ([1] + lookahead_on) so the lines are flat and never repaint on an intraday chart.")

// ── proximity gate — the reason this file exists ────────────────────────────────
gPx      = "Proximity gate"
prox_on  = input.bool(true, "Gate every SMA by % distance from price", group = gPx, tooltip = "OFF = draw all four regardless of distance (and watch the chart compress).")
prox_pct = input.float(10.0, "  · draw only within % of price", minval = 0.5, maxval = 50, step = 0.5, group = gPx, tooltip = "An SMA draws only when |price - SMA| / price is at or under this %. 10 = anything further than 10% away stays off the chart. Lower it (4-6%) for a tight day-trading read, raise it (15-20%) when you want to see what price is falling toward.")
prox_near = input.bool(false, "  · if EVERYTHING is out of range, still draw the nearest one", group = gPx, tooltip = "Off by default: an empty chart is the honest answer when price is nowhere near a moving average — and the distance table below still tells you where they all are. Turn on if you'd rather always have one reference line, accepting that a far line compresses the scale.")

// ── style ───────────────────────────────────────────────────────────────────────
gSt       = "Style"
sup_col   = input.color(#26A69A, "Support (price above)",    group = gSt, inline = "c")
res_col   = input.color(#EF5350, "Resistance (price below)", group = gSt, inline = "c")
flat_len  = input.int  (60, "Flat line length (bars back)", minval = 10, maxval = 500, group = gSt)
line_w    = input.int  (2, "Line thickness (merged lines +1)", minval = 1, maxval = 8, group = gSt)
style_in  = input.string("solid", "Line style", options = ["solid", "dashed", "dotted"], group = gSt)
merge_pct = input.float(0.20, "Merge SMAs within (%) into ONE line", minval = 0.0, maxval = 3, step = 0.05, group = gSt, tooltip = "SMAs stacked within this % of each other collapse into a SINGLE line whose label names every member (e.g. 'SMA 50 · SMA 100 ·×2'). Identity kept, stacked labels gone. The merged line sits on the member NEAREST price — a real level, never a fabricated average — and draws thicker. 0 = draw every SMA separately.") / 100.0
ln_style  = style_in == "dashed" ? line.style_dashed : style_in == "dotted" ? line.style_dotted : line.style_solid

// ── distance table ──────────────────────────────────────────────────────────────
gTb        = "Distance table"
show_table = input.bool(true, "Show the distance table (all four, in range or not)", group = gTb)
tbl_pos_in = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"], group = gTb)
tbl_size   = input.string("small", "Text size", options = ["tiny", "small", "normal"], group = gTb)
tbl_pos    = tbl_pos_in == "top_left" ? position.top_left : tbl_pos_in == "bottom_right" ? position.bottom_right : tbl_pos_in == "bottom_left" ? position.bottom_left : tbl_pos_in == "middle_right" ? position.middle_right : position.top_right
tbl_txt    = tbl_size == "tiny" ? size.tiny : tbl_size == "normal" ? size.normal : size.small

// ── values — SETTLED daily SMAs ([1]+lookahead_on), non-repainting, flat on any chart TF ──
tid   = syminfo.tickerid
sma20  = request.security(tid, maTf, ta.sma(close, 20)[1],  lookahead = barmerge.lookahead_on)
sma50  = request.security(tid, maTf, ta.sma(close, 50)[1],  lookahead = barmerge.lookahead_on)
sma100 = request.security(tid, maTf, ta.sma(close, 100)[1], lookahead = barmerge.lookahead_on)
sma200 = request.security(tid, maTf, ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on)

// signed % distance: positive = SMA is ABOVE price (resistance overhead), negative = below (support under).
sdist(float v) => na(v) or close <= 0 ? float(na) : (v - close) / close * 100.0
// the gate itself — absolute distance, so a far level is hidden whichever side it sits on.
prox_ok(float v) =>
    float d = sdist(v)
    not prox_on or na(d) or math.abs(d) <= prox_pct

// ── draw (rebuilt on the last bar) ──────────────────────────────────────────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()
// everything that survived the gate is QUEUED first, then merged and drawn in one pass —
// drawing each level as it's decided is what produces stacks of overlapping labels.
var float[]  _qv = array.new_float()
var string[] _qn = array.new_string()
queue_sma(float v, string nm, bool show) =>
    if show and not na(v)
        array.push(_qv, v)
        array.push(_qn, nm)

if show_lines and barstate.islast
    if array.size(_ln) > 0
        for i = 0 to array.size(_ln) - 1
            line.delete(array.get(_ln, i))
        array.clear(_ln)
    if array.size(_lb) > 0
        for i = 0 to array.size(_lb) - 1
            label.delete(array.get(_lb, i))
        array.clear(_lb)
    array.clear(_qv)
    array.clear(_qn)

    queue_sma(sma20,  "SMA 20",  show_20  and prox_ok(sma20))
    queue_sma(sma50,  "SMA 50",  show_50  and prox_ok(sma50))
    queue_sma(sma100, "SMA 100", show_100 and prox_ok(sma100))
    queue_sma(sma200, "SMA 200", show_200 and prox_ok(sma200))

    // fallback — every SMA was gated out and the user asked for one reference line anyway:
    // draw the single NEAREST enabled SMA (least compression of the four).
    if prox_near and array.size(_qv) == 0
        _fv = array.from(sma20, sma50, sma100, sma200)
        _fn = array.from("SMA 20", "SMA 50", "SMA 100", "SMA 200")
        _fe = array.from(show_20, show_50, show_100, show_200)
        float _fbest  = na
        string _fbnm  = ""
        float _fbestD = 1e18
        for _fi = 0 to 3
            _fvv = array.get(_fv, _fi)
            if array.get(_fe, _fi) and not na(_fvv)
                _fd = math.abs(close - _fvv)
                if _fd < _fbestD
                    _fbestD := _fd
                    _fbest  := _fvv
                    _fbnm   := array.get(_fn, _fi)
        queue_sma(_fbest, _fbnm + " (nearest, out of range)", not na(_fbest))

    // ── MERGE + DRAW — SMAs stacked within merge_pct collapse into ONE line that NAMES every
    //    member. The merged line sits on the member NEAREST price — a real level, never a
    //    fabricated average that lands on none of them — and draws thicker, because two MAs
    //    at one price IS the information.
    _n = array.size(_qv)
    if _n > 0
        _ord = array.sort_indices(_qv, order.ascending)
        _i = 0
        while _i < _n
            _s     = array.get(_ord, _i)
            _hi    = array.get(_qv, _s)
            _nm    = array.get(_qn, _s)
            _cnt   = 1
            _near  = _hi                          // the member closest to price anchors the line
            _nearD = math.abs(close - _hi)
            _j = _i + 1
            while _j < _n
                _k  = array.get(_ord, _j)
                _v2 = array.get(_qv, _k)
                if merge_pct > 0 and _v2 <= _hi * (1.0 + merge_pct)
                    _hi  := _v2
                    _nm  := _nm + " · " + array.get(_qn, _k)
                    _cnt := _cnt + 1
                    if math.abs(close - _v2) < _nearD
                        _near  := _v2
                        _nearD := math.abs(close - _v2)
                    _j := _j + 1
                else
                    break
            _sup = close > _near
            _col = _sup ? sup_col : res_col
            _w   = _cnt > 1 ? line_w + 1 : line_w          // a merged cluster (a wall) draws one thicker
            float _pct = close > 0 ? math.abs(close - _near) / close * 100.0 : float(na)
            _txt = (_sup ? "▲ SUPPORT  " : "▼ RESIST  ") + _nm + (_cnt > 1 ? "  ·×" + str.tostring(_cnt) : "") + "  " + str.tostring(_near, format.mintick) + (na(_pct) ? "" : "  (" + str.tostring(_pct, "#.##") + "%)")
            array.push(_ln, line.new(bar_index - flat_len, _near, bar_index + 6, _near, color = _col, width = _w, style = ln_style))
            array.push(_lb, label.new(bar_index + 6, _near, _txt, style = label.style_label_left, color = _col, textcolor = color.white, size = size.small))
            _i := _j

// ── DISTANCE TABLE — nothing is lost by hiding a line. Every SMA is listed with its price
//    and signed % distance (+ = overhead resistance, − = support below), and whether it made
//    the proximity cut. A 200 that's 18% away is still information; it just isn't a line.
var table _tb = table.new(tbl_pos, 4, 5, border_width = 1)
if show_table and barstate.islast
    table.clear(_tb, 0, 0, 3, 4)
    _hdrBg = color.new(color.gray, 70)
    table.cell(_tb, 0, 0, "SMA",  bgcolor = _hdrBg, text_color = color.white, text_size = tbl_txt)
    table.cell(_tb, 1, 0, "price", bgcolor = _hdrBg, text_color = color.white, text_size = tbl_txt)
    table.cell(_tb, 2, 0, "dist",  bgcolor = _hdrBg, text_color = color.white, text_size = tbl_txt)
    table.cell(_tb, 3, 0, prox_on ? str.tostring(prox_pct, "#.#") + "% gate" : "gate off", bgcolor = _hdrBg, text_color = color.white, text_size = tbl_txt)
    _tv = array.from(sma20, sma50, sma100, sma200)
    _tn = array.from("20", "50", "100", "200")
    _te = array.from(show_20, show_50, show_100, show_200)
    for _ti = 0 to 3
        _tvv  = array.get(_tv, _ti)
        _td   = sdist(_tvv)                                  // + = above price, − = below
        _ton  = array.get(_te, _ti)
        _tin  = _ton and prox_ok(_tvv) and not na(_tvv)
        _tcol = na(_td) ? color.gray : _td < 0 ? sup_col : res_col
        _tdim = _tin ? 0 : 55                                // out-of-range rows sit faded, still readable
        table.cell(_tb, 0, _ti + 1, "SMA " + array.get(_tn, _ti), text_color = color.new(_tcol, _tdim), text_size = tbl_txt)
        table.cell(_tb, 1, _ti + 1, na(_tvv) ? "—" : str.tostring(_tvv, format.mintick), text_color = color.new(_tcol, _tdim), text_size = tbl_txt)
        table.cell(_tb, 2, _ti + 1, na(_td) ? "—" : (_td > 0 ? "+" : "") + str.tostring(_td, "#.#") + "%", text_color = color.new(_tcol, _tdim), text_size = tbl_txt)
        table.cell(_tb, 3, _ti + 1, not _ton ? "off" : na(_tvv) ? "n/a" : _tin ? "shown" : "hidden", text_color = color.new(_tin ? _tcol : color.gray, _tdim), text_size = tbl_txt)
