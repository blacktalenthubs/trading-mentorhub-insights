//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// PREMARKET HIGH / LOW — marks each day's premarket high (PMH) and low (PML) and
// keeps the last N days on the chart. Works even when the chart's EXTENDED HOURS
// toggle is OFF: the premarket range is pulled from the extended-session feed via
// request.security (an extended-hours ticker), not from the chart's own bars.
// Intraday only. US equities premarket defaults to 04:00–09:30 America/New_York.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Premarket High / Low", "PMH·PML", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Session ──
pmSession = input.session("0400-0930", "Premarket session", group = "Session")
tz        = input.string("America/New_York", "Timezone",    group = "Session")

// ── Display ──
nDays   = input.int(4, "Days to display", minval = 1, maxval = 30, group = "Display")
gLabels = input.bool(true, "Show PMH / PML labels",               group = "Display")

// ── Style ──
cHigh   = input.color(#26a69a, "PMH color", group = "Style")
cLow    = input.color(#ef5350, "PML color", group = "Style")
wdth    = input.int(1, "Line width", minval = 1, maxval = 5, group = "Style")
styleIn = input.string("solid", "Line style", options = ["solid", "dashed", "dotted"], group = "Style")
lStyle  = styleIn == "dashed" ? line.style_dashed : styleIn == "dotted" ? line.style_dotted : line.style_solid

// Running premarket high/low for the day. Evaluated in the EXTENDED-ticker context
// (below) so premarket bars are always present, ETH toggle or not. Resets each day
// on the first premarket bar; holds its value through the regular session.
pmHL() =>
    var float h = na
    var float l = na
    isPm = not na(time(timeframe.period, pmSession, tz))
    if isPm and not isPm[1]
        h := high
        l := low
    else if isPm
        h := math.max(h, high)
        l := math.min(l, low)
    [h, l]

et = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)
[pmh, pml] = request.security(et, timeframe.period, pmHL(), lookahead = barmerge.lookahead_off)

// Keep the last N days as separate horizontal segments (parallel arrays, in lockstep).
var line[]  hLines = array.new_line()
var line[]  lLines = array.new_line()
var label[] hLabs  = array.new_label()
var label[] lLabs  = array.new_label()

newDay = timeframe.isintraday and ta.change(time("D")) != 0

if newDay and not na(pmh)
    hl = line.new(bar_index, pmh, bar_index, pmh, color = cHigh, width = wdth, style = lStyle)
    ll = line.new(bar_index, pml, bar_index, pml, color = cLow,  width = wdth, style = lStyle)
    hb = label.new(bar_index, pmh, "PMH", style = label.style_label_left, color = color.new(cHigh, 88), textcolor = cHigh, size = size.small)
    lb = label.new(bar_index, pml, "PML", style = label.style_label_left, color = color.new(cLow, 88), textcolor = cLow, size = size.small)
    if not gLabels
        label.delete(hb)
        label.delete(lb)
        hb := na
        lb := na
    array.push(hLines, hl)
    array.push(lLines, ll)
    array.push(hLabs, hb)
    array.push(lLabs, lb)
    if array.size(hLines) > nDays               // drop the oldest day (all four arrays together)
        line.delete(array.shift(hLines))
        line.delete(array.shift(lLines))
        oh = array.shift(hLabs)
        ol = array.shift(lLabs)
        if not na(oh)
            label.delete(oh)
        if not na(ol)
            label.delete(ol)

// Each bar: converge the current day's levels to the latest PMH/PML and extend them right.
if array.size(hLines) > 0 and not na(pmh)
    ch = array.get(hLines, array.size(hLines) - 1)
    cl = array.get(lLines, array.size(lLines) - 1)
    line.set_y1(ch, pmh)
    line.set_y2(ch, pmh)
    line.set_x2(ch, bar_index)
    line.set_y1(cl, pml)
    line.set_y2(cl, pml)
    line.set_x2(cl, bar_index)
    if gLabels and array.size(hLabs) > 0
        lh = array.get(hLabs, array.size(hLabs) - 1)
        ll2 = array.get(lLabs, array.size(lLabs) - 1)
        if not na(lh)
            label.set_xy(lh, bar_index, pmh)
            label.set_text(lh, "PMH " + str.tostring(pmh, format.mintick))
        if not na(ll2)
            label.set_xy(ll2, bar_index, pml)
            label.set_text(ll2, "PML " + str.tostring(pml, format.mintick))
