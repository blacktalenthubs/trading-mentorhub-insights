//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// PRIOR LAST 4H — yesterday's FINAL 4h candle, plus the day rails.
// ─────────────────────────────────────────────────────────────────────────────
// Not yesterday's whole range, not its four-candle structure — just the ONE 4h candle the
// session ended on. That candle is where the market left off: its high and low are the levels
// today opens against, and they sit INSIDE the daily range, where PDH/PDL are often too wide
// to trade off.
//
//   HIGH   the last thing sellers defended before the close
//   LOW    the last thing buyers defended
//   CLOSE  where the session actually settled — the strength line. Holding above it says
//          yesterday's closing hand is still in control; losing it says it changed.
//
// PDH / PDL sit alongside them, drawn DASHED so the day rails read apart from the 4h lines at a
// glance. Same colours, different weight of evidence: the 4h trio is where the session ended,
// PDH/PDL is the whole day's range around it.
//
// CONFLUENCE. Levels sitting within a % of each other are ONE level in practice — price can't
// tell them apart. They collapse to a single line whose tag names every member, so a stack
// reads as the single thicker wall it actually is instead of three lines fighting for the same
// pixels. A merged group keeps the heaviest thickness of its members, and draws in the 4h style
// unless every member is a day rail — the stronger evidence wins the look.
//
// FROZEN AT THE SESSION ROLL. At the instant a new day begins, "the last completed 4h" IS
// yesterday's final one, so it's captured there and held all day. Read live it would walk
// forward through today's own 4h candles and stop being yesterday's anything.
//
// RTH-accurate (regular-session ticker, so extended-hours prints never leak in) and
// non-repainting (settled [1] + lookahead). Flat lines, role-coloured: green ▲ SUPPORT when
// price is above, red ▼ RESISTANCE when below.
//
// ALERTS — two lines, long and short. The last 4h candle's HIGH and LOW are the only levels
// that fire by default; the CLOSE and the day rails are drawable but alert-silent unless you
// switch them on. Rules `last4h_long` / `last4h_short`, routed to the Day feed.
//
// The qualification is the same one every pine in this setup uses:
//
//   RECLAIM   open above the level, wick through it, price back above  → fires IMMEDIATELY.
//             Nothing to confirm: the market already showed the level held.
//   BREAK     price came from the other side and pushed through        → needs a CONFIRMED CLOSE
//             at the chart timeframe. Coming from below, an unclosed poke is not a break.
//
// The short side is the exact mirror — REJECT (open below, poke up, close back under) fires
// immediately; BREAKDOWN needs the close.
//
// ONE alert per level per direction per session, reset at the day roll, so a level that gets
// tested six times in a morning sends one message, not six.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Prior last 4H", "Y-4H", overlay = true, max_lines_count = 10, max_labels_count = 10)

gL       = "Lines"
enH      = input.bool(true, "High",  inline = "l", group = gL)
enL      = input.bool(true, "Low",   inline = "l", group = gL)
enC      = input.bool(true, "Close", inline = "l", group = gL)
enPDH    = input.bool(true, "PDH — prior-day high", inline = "p", group = gL)
enPDL    = input.bool(true, "PDL — prior-day low",  inline = "p", group = gL)
wDay     = input.int(2, "PDH / PDL thickness", minval = 1, maxval = 6, group = gL)
dayStyle = input.string("dashed", "PDH / PDL line style", options = ["solid", "dashed", "dotted"], group = gL, tooltip = "Dashed by default so the DAY rails read apart from the three 4h lines at a glance — same colours, different weight of evidence.")
supCol   = input.color(#26A69A, "Support (price above)",    group = gL)
resCol   = input.color(#EF5350, "Resistance (price below)", group = gL)
wLine    = input.int(2,  "Line thickness", minval = 1, maxval = 6, group = gL)
wClose   = input.int(2,  "Close line thickness", minval = 1, maxval = 6, group = gL)
lineLen  = input.int(80, "Line length (bars back)", minval = 10, maxval = 500, group = gL)
extendAll= input.bool(false, "Extend across the whole chart", group = gL)
lineStyle= input.string("solid", "Line style", options = ["solid", "dashed", "dotted"], group = gL)

gC       = "Confluence"
enConf   = input.bool(true, "Merge levels within a % of each other", group = gC, tooltip = "Levels this close are one wall in practice — price can't tell them apart. Merged lines name every member on the tag.")
confPct  = input.float(0.15, "Merge tolerance %", minval = 0.0, maxval = 5.0, step = 0.05, group = gC)
confBump = input.int(1, "Extra thickness on a merged line", minval = 0, maxval = 4, group = gC, tooltip = "A stack is a heavier wall than any single level in it. 0 to keep the plain thickness.")

gT       = "Tags"
showLbl  = input.bool(true, "Show tags", group = gT)
showPx   = input.bool(true, "Show the price on the tag", group = gT)
labelX   = input.int(8, "Tag column — bars right of the last bar", minval = 2, maxval = 40, group = gT)
tagSz    = input.string("small", "Tag size", options = ["tiny", "small", "normal"], group = gT)

_tagSz   = tagSz == "normal" ? size.normal : tagSz == "tiny" ? size.tiny : size.small
_lnStyle = lineStyle == "dashed" ? line.style_dashed : lineStyle == "dotted" ? line.style_dotted : line.style_solid
_dyStyle = dayStyle == "solid" ? line.style_solid : dayStyle == "dotted" ? line.style_dotted : line.style_dashed

// ── the candle. Settled [1] + lookahead → non-repainting; RTH ticker keeps pre/post out.
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[_h, _l, _c] = request.security(rthTid, "240", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
// The day rails. These need no freezing — high[1]/low[1] on the daily ARE yesterday's, settled,
// and they don't move once the session rolls. Only the 4h values walk forward if left live.
[pdh, pdl] = request.security(rthTid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
var float y4H = na
var float y4L = na
var float y4C = na
if ta.change(time("D")) != 0 or na(y4H)
    y4H := _h
    y4L := _l
    y4C := _c

// ── candidate book. Everything enabled lands here first; the merge pass runs over the whole
// book at once, so a 4h level and a day rail can collapse together the same as two 4h levels.
var float[]  _cv = array.new_float()
var string[] _cn = array.new_string()
var bool[]   _cd = array.new_bool()
var int[]    _cw = array.new_int()

f_add(float v, string nm, bool show, int w, bool isDay) =>
    if show and not na(v)
        array.push(_cv, v)
        array.push(_cn, nm)
        array.push(_cd, isDay)
        array.push(_cw, w)

var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()

f_draw(float v, string nm, int w, bool isDay, bool merged) =>
    _sup = close > v
    _col = _sup ? supCol : resCol
    _wid = math.min(6, w + (merged ? confBump : 0))
    array.push(_ln, line.new(bar_index - lineLen, v, bar_index + labelX, v, color = _col, width = _wid, style = isDay ? _dyStyle : _lnStyle, extend = extendAll ? extend.both : extend.none))
    if showLbl
        array.push(_lb, label.new(bar_index + labelX, v, (_sup ? "▲ SUPPORT  " : "▼ RESISTANCE  ") + nm + (showPx ? "  " + str.tostring(v, format.mintick) : ""), style = label.style_label_left, color = _col, textcolor = color.white, size = _tagSz))

if barstate.islast
    for x in _ln
        line.delete(x)
    for y in _lb
        label.delete(y)
    array.clear(_ln)
    array.clear(_lb)
    array.clear(_cv)
    array.clear(_cn)
    array.clear(_cd)
    array.clear(_cw)

    f_add(y4H, "Y-4H HIGH",  enH, wLine,  false)
    f_add(y4L, "Y-4H LOW",   enL, wLine,  false)
    f_add(y4C, "Y-4H CLOSE", enC, wClose, false)
    f_add(pdh, "PDH", enPDH, wDay, true)
    f_add(pdl, "PDL", enPDL, wDay, true)

    // sort ascending by price — merging only ever needs to look at the next neighbour up
    n = array.size(_cv)
    if n > 1
        for a = 0 to n - 2
            m = a
            for b = a + 1 to n - 1
                if array.get(_cv, b) < array.get(_cv, m)
                    m := b
            if m != a
                tv = array.get(_cv, a)
                tn = array.get(_cn, a)
                td = array.get(_cd, a)
                tw = array.get(_cw, a)
                array.set(_cv, a, array.get(_cv, m))
                array.set(_cn, a, array.get(_cn, m))
                array.set(_cd, a, array.get(_cd, m))
                array.set(_cw, a, array.get(_cw, m))
                array.set(_cv, m, tv)
                array.set(_cn, m, tn)
                array.set(_cd, m, td)
                array.set(_cw, m, tw)

    // merge pass — chain members off the group ANCHOR, not the running member, so a long
    // ladder of near-equal levels can't drift the group wider than the tolerance itself
    i = 0
    while i < n
        anchor = array.get(_cv, i)
        gSum = anchor
        gNm  = array.get(_cn, i)
        gDay = array.get(_cd, i)
        gW   = array.get(_cw, i)
        gCnt = 1
        j = i + 1
        // the bounds check has to stand ALONE. Pine's `and` does not short-circuit, so an
        // array.get() sharing a condition with `j < n` still evaluates once j walks off the end.
        _more = true
        while _more and j < n
            _nv = array.get(_cv, j)
            if enConf and anchor != 0 and math.abs(_nv - anchor) / math.abs(anchor) * 100 <= confPct
                gSum += _nv
                gNm  += " + " + array.get(_cn, j)
                gDay := gDay and array.get(_cd, j)
                gW   := math.max(gW, array.get(_cw, j))
                gCnt += 1
                j += 1
            else
                _more := false
        f_draw(gSum / gCnt, gNm, gW, gDay, gCnt > 1)
        i := j

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
gA      = "Alerts"
enAl    = input.bool(true,  "Fire platform alerts", group = gA, tooltip = "Bind ONE alert on this study: condition 'Any alert() function call', webhook on. Rules last4h_long / last4h_short.")
alHi    = input.bool(true,  "Alert on the 4h HIGH", inline = "a1", group = gA)
alLo    = input.bool(true,  "Alert on the 4h LOW",  inline = "a1", group = gA)
alCl    = input.bool(false, "Alert on the 4h CLOSE", inline = "a2", group = gA, tooltip = "OFF by default — the experiment is the two candle rails. Turn on to add the settle line as a third trigger.")
alLong  = input.bool(true,  "Longs",  inline = "a3", group = gA)
alShort = input.bool(true,  "Shorts", inline = "a3", group = gA)
alMark  = input.bool(true,  "Mark the trigger on the chart", group = gA)

// Stateless — current-bar OHLC only, no history reads, so these are safe at any call site.
f_hold(float v)    => not na(v) and open > v and low  <= v and close > v   // wick + reclaim, no confirm
f_cross(float v)   => not na(v) and close > v and open <= v                // came from below → confirm
f_holdDn(float v)  => not na(v) and open < v and high >= v and close < v   // poke + reject, no confirm
f_crossDn(float v) => not na(v) and close < v and open >= v                // came from above → confirm

f_nl() => "Y-4H H " + str.tostring(y4H, format.mintick) + " · Y-4H L " + str.tostring(y4L, format.mintick) + " · Y-4H C " + str.tostring(y4C, format.mintick) + " · PDH " + str.tostring(pdh, format.mintick) + " · PDL " + str.tostring(pdl, format.mintick)

f_pay(string rule, string dir, string lvlNm, float lvl, float stp, string note) =>
    '{"symbol":"' + syminfo.ticker + '","price":"' + str.tostring(close, format.mintick) + '","rule":"' + rule + '","direction":"' + dir + '","level":"' + lvlNm + '","interval":"' + timeframe.period + '","entry":"' + str.tostring(close, format.mintick) + '","stop":"' + str.tostring(stp, format.mintick) + '","note":"' + note + '","nearby_levels":"' + f_nl() + '"}'

// One fire per level per direction per session. Pine keeps a SEPARATE var per call site, so these
// have to be explicit globals — a flag inside a helper would be a different flag at each call.
var bool fHiL = false
var bool fHiS = false
var bool fLoL = false
var bool fLoS = false
var bool fClL = false
var bool fClS = false
if ta.change(time("D")) != 0
    fHiL := false
    fHiS := false
    fLoL := false
    fLoS := false
    fClL := false
    fClS := false

okLong  = enAl and alLong
okShort = enAl and alShort

// ── 4h HIGH
hiRec = alHi and f_hold(y4H)
hiBrk = alHi and f_cross(y4H)
hiRej = alHi and f_holdDn(y4H)
hiBdn = alHi and f_crossDn(y4H)
if okLong and hiRec and not fHiL
    fHiL := true
    alert(f_pay("last4h_long", "BUY", "Y-4H HIGH", y4H, low, "RECLAIM of yesterday's last 4h HIGH " + str.tostring(y4H, format.mintick) + " — opened above it, wicked through, back above. The last level sellers defended is holding as support. Stop below the swept wick " + str.tostring(low, format.mintick) + "."), alert.freq_once_per_bar)
if okLong and hiBrk and not fHiL
    fHiL := true
    alert(f_pay("last4h_long", "BUY", "Y-4H HIGH", y4H, y4H, "BREAK above yesterday's last 4h HIGH " + str.tostring(y4H, format.mintick) + " — confirmed " + timeframe.period + " close through the level price came into from below. Stop back under " + str.tostring(y4H, format.mintick) + "."), alert.freq_once_per_bar_close)
if okShort and hiRej and not fHiS
    fHiS := true
    alert(f_pay("last4h_short", "SHORT", "Y-4H HIGH", y4H, high, "REJECT at yesterday's last 4h HIGH " + str.tostring(y4H, format.mintick) + " — poked above and closed back under. The ceiling held. Stop above the poke " + str.tostring(high, format.mintick) + "."), alert.freq_once_per_bar)
if okShort and hiBdn and not fHiS
    fHiS := true
    alert(f_pay("last4h_short", "SHORT", "Y-4H HIGH", y4H, y4H, "BREAKDOWN through yesterday's last 4h HIGH " + str.tostring(y4H, format.mintick) + " — confirmed " + timeframe.period + " close back below a level that was holding as support. Stop back above " + str.tostring(y4H, format.mintick) + "."), alert.freq_once_per_bar_close)

// ── 4h LOW
loRec = alLo and f_hold(y4L)
loBrk = alLo and f_cross(y4L)
loRej = alLo and f_holdDn(y4L)
loBdn = alLo and f_crossDn(y4L)
if okLong and loRec and not fLoL
    fLoL := true
    alert(f_pay("last4h_long", "BUY", "Y-4H LOW", y4L, low, "RECLAIM of yesterday's last 4h LOW " + str.tostring(y4L, format.mintick) + " — opened above it, wicked through, back above. The last level buyers defended is still theirs. Stop below the swept wick " + str.tostring(low, format.mintick) + "."), alert.freq_once_per_bar)
if okLong and loBrk and not fLoL
    fLoL := true
    alert(f_pay("last4h_long", "BUY", "Y-4H LOW", y4L, y4L, "BREAK back above yesterday's last 4h LOW " + str.tostring(y4L, format.mintick) + " — confirmed " + timeframe.period + " close through from underneath. Stop back under " + str.tostring(y4L, format.mintick) + "."), alert.freq_once_per_bar_close)
if okShort and loRej and not fLoS
    fLoS := true
    alert(f_pay("last4h_short", "SHORT", "Y-4H LOW", y4L, high, "REJECT at yesterday's last 4h LOW " + str.tostring(y4L, format.mintick) + " — poked above a lost level and closed back under. Old support is resistance. Stop above the poke " + str.tostring(high, format.mintick) + "."), alert.freq_once_per_bar)
if okShort and loBdn and not fLoS
    fLoS := true
    alert(f_pay("last4h_short", "SHORT", "Y-4H LOW", y4L, y4L, "BREAKDOWN through yesterday's last 4h LOW " + str.tostring(y4L, format.mintick) + " — confirmed " + timeframe.period + " close under the last level buyers defended. Stop back above " + str.tostring(y4L, format.mintick) + "."), alert.freq_once_per_bar_close)

// ── 4h CLOSE (off by default)
clRec = alCl and f_hold(y4C)
clBrk = alCl and f_cross(y4C)
clRej = alCl and f_holdDn(y4C)
clBdn = alCl and f_crossDn(y4C)
if okLong and clRec and not fClL
    fClL := true
    alert(f_pay("last4h_long", "BUY", "Y-4H CLOSE", y4C, low, "RECLAIM of yesterday's SETTLE " + str.tostring(y4C, format.mintick) + " — wicked under where the session ended and recovered it. Yesterday's closing hand is still in control. Stop below the swept wick " + str.tostring(low, format.mintick) + "."), alert.freq_once_per_bar)
if okLong and clBrk and not fClL
    fClL := true
    alert(f_pay("last4h_long", "BUY", "Y-4H CLOSE", y4C, y4C, "BREAK above yesterday's SETTLE " + str.tostring(y4C, format.mintick) + " — confirmed " + timeframe.period + " close back over where the session ended. Stop back under " + str.tostring(y4C, format.mintick) + "."), alert.freq_once_per_bar_close)
if okShort and clRej and not fClS
    fClS := true
    alert(f_pay("last4h_short", "SHORT", "Y-4H CLOSE", y4C, high, "REJECT at yesterday's SETTLE " + str.tostring(y4C, format.mintick) + " — poked above and closed back under. Stop above the poke " + str.tostring(high, format.mintick) + "."), alert.freq_once_per_bar)
if okShort and clBdn and not fClS
    fClS := true
    alert(f_pay("last4h_short", "SHORT", "Y-4H CLOSE", y4C, y4C, "BREAKDOWN through yesterday's SETTLE " + str.tostring(y4C, format.mintick) + " — confirmed " + timeframe.period + " close below where the session ended. The closing hand changed. Stop back above " + str.tostring(y4C, format.mintick) + "."), alert.freq_once_per_bar_close)

// Chart marks — same triggers, so what fired is visible without opening the alert log.
_mkLong  = alMark and okLong  and (hiRec or hiBrk or loRec or loBrk or clRec or clBrk)
_mkShort = alMark and okShort and (hiRej or hiBdn or loRej or loBdn or clRej or clBdn)
plotshape(_mkLong,  title = "Long trigger",  style = shape.triangleup,   location = location.belowbar, color = supCol, size = size.tiny)
plotshape(_mkShort, title = "Short trigger", style = shape.triangledown, location = location.abovebar, color = resCol, size = size.tiny)
