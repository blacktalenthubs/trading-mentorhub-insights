//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 5 / 8 EMA — flat & non-repainting, locked to a fixed timeframe.
// ─────────────────────────────────────────────────────────────────────────────
// The 5- and 8-period EMA drawn as FLAT lines. Uses the SETTLED lock-TF value ([1] +
// lookahead_on) so each level holds flat for the whole current period and only STEPS
// when that period closes — no intrabar wiggle, no repaint. Bind on any chart TF; the
// EMAs are the lock-TF's (default Daily) regardless of what you're viewing.
//   • above BOTH  = bullish   · below BOTH = bearish   · between = mixed
// ─────────────────────────────────────────────────────────────────────────────
indicator("5/8 EMA · flat", "5/8ema", overlay = true, max_labels_count = 6)

// ── inputs ───────────────────────────────────────────────────────────────────
lockTf  = input.timeframe("D", "Lock timeframe", tooltip = "The EMAs are computed on THIS timeframe and held flat on your chart. Default Daily — set to W for weekly, or blank for the chart TF.")
len1    = input.int(5, "Fast EMA", minval = 1)
len2    = input.int(8, "Slow EMA", minval = 1)
col5    = input.color(#2962FF, "5 EMA")
col8    = input.color(#FF6D00, "8 EMA")
wLine   = input.int(2, "Line width", minval = 1, maxval = 5)
showFill = input.bool(true, "Shade the 5↔8 band")
showRgm  = input.bool(true, "Regime tint (bull/bear vs both)")
showLbl  = input.bool(true, "Right-edge value labels")

// ── settled EMAs ([1] + lookahead → FLAT within the period, non-repainting) ──
e5 = request.security(syminfo.tickerid, lockTf, ta.ema(close, len1)[1], lookahead = barmerge.lookahead_on)
e8 = request.security(syminfo.tickerid, lockTf, ta.ema(close, len2)[1], lookahead = barmerge.lookahead_on)

// ── plot (flat per period, steps at the close) ────────────────────────────────
p5 = plot(e5, "5 EMA", color = color.new(col5, 0), linewidth = wLine, style = plot.style_linebr)
p8 = plot(e8, "8 EMA", color = color.new(col8, 0), linewidth = wLine, style = plot.style_linebr)
fill(p5, p8, color = showFill ? color.new(e5 >= e8 ? col5 : col8, 88) : na)

// ── regime tint ───────────────────────────────────────────────────────────────
bull = not na(e5) and not na(e8) and close > e5 and close > e8
bear = not na(e5) and not na(e8) and close < e5 and close < e8
bgcolor(showRgm ? (bull ? color.new(color.green, 92) : bear ? color.new(color.red, 92) : na) : na)

// ── right-edge value labels ────────────────────────────────────────────────────
if showLbl and barstate.islast
    label.new(bar_index + 3, e5, "5 EMA " + str.tostring(e5, format.mintick), style = label.style_label_left, color = color.new(col5, 80), textcolor = col5, size = size.small)
    label.new(bar_index + 3, e8, "8 EMA " + str.tostring(e8, format.mintick), style = label.style_label_left, color = color.new(col8, 80), textcolor = col8, size = size.small)
