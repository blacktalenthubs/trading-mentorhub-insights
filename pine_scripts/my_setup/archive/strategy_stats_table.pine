//@version=5
// =============================================================================
// STRATEGY STATS TABLE — THT-style backtest + open-position panel (2026-07-30)
// =============================================================================
// A self-contained stats table like the paid "THT Long Term" panel. Runs a simple,
// SWAPPABLE long-only system over history and reports the real metrics:
//   • Accuracy (W/L)  • Avg Win / Avg Loss  • RVR (reward:risk)  • Return (compounded)
//   • Profit Factor   • Avg Hold (bars)     • live OPEN P&L (since entry, bars in trade)
// Plus a CONDITIONS block (fair-value + weekly/monthly trend).
//
// THE SIGNAL is isolated in ONE place (see "ENTRY / EXIT" below) — default is a fair-value
// basis reclaim (close crosses the 33-SMA-of-OHLC4 basis = LONG; loses it = EXIT). Drop your
// own THT logic into longEntry / longExit and every metric recomputes. Long-only.
indicator("Strategy Stats Table", "Stats", overlay = true, max_labels_count = 20)

// ── Inputs ───────────────────────────────────────────────────────────────────
gS       = "Signal — drive from your THT indicators"
useSrc   = input.bool(true, "Read the THT indicators (connect the plots below)", group = gS, tooltip = "ON = build the stats on the REAL THT signals — connect the Fair Value basis line + the Multi-TF BX plot below. OFF = compute a 33-SMA basis internally.")
srcBasis = input.source(close, "  ↳ THT Fair Value BASIS plot", group = gS)
srcBX    = input.source(close, "  ↳ THT Multi-TF BX plot", group = gS)
entryMode= input.string("BX turn + above FV", "Entry / exit rule", options = ["BX turn + above FV","BX zero-cross","Fair-value reclaim"], group = gS, tooltip = "BX turn + above FV = enter when BX crosses up through 0 AND price is above fair value; exit when BX crosses down OR price loses fair value. The others use one signal alone.")
fvbLen   = input.int(33, "Internal basis length (used when the toggle is OFF)", group = gS, minval = 2)
gT       = "Table"
tblName  = input.string("THT-style · Long Term", "Panel title", group = gT)
tblPos   = input.string("top_right", "Position", options = ["top_right","top_left","bottom_right","bottom_left","middle_right"], group = gT)
txtSz    = input.string("small", "Text size", options = ["tiny","small","normal"], group = gT)

// ── Signals from the connected indicators (or internal fallback) ─────────────
tid    = syminfo.tickerid
basis  = useSrc ? srcBasis : ta.sma(ohlc4, fvbLen)   // fair-value basis (THT green line, or internal)
bx     = srcBX                                        // THT Multi-TF BX momentum
wkB    = request.security(tid, "W", ta.sma(ohlc4, fvbLen))
moB    = request.security(tid, "M", ta.sma(ohlc4, fvbLen))
wkC    = request.security(tid, "W", close)
moC    = request.security(tid, "M", close)
fvbBull = close > basis
bxBull  = bx > 0
wkBull  = wkC > wkB
moBull  = moC > moB

// ── ENTRY / EXIT — derived from the THT signals ──────────────────────────────
_eBX = ta.crossover(bx, 0)
_xBX = ta.crossunder(bx, 0)
_eFV = ta.crossover(close, basis)
_xFV = ta.crossunder(close, basis)
longEntry = entryMode == "BX zero-cross" ? _eBX : entryMode == "Fair-value reclaim" ? _eFV : (_eBX and fvbBull)
longExit  = entryMode == "BX zero-cross" ? _xBX : entryMode == "Fair-value reclaim" ? _xFV : (_xBX or _xFV)

// ── Trade bookkeeping (long-only) ────────────────────────────────────────────
var bool  inTrade    = false
var float entryPrice = na
var int   entryBar   = na
var int   nTrades    = 0
var int   wins       = 0
var int   losses     = 0
var float sumWin     = 0.0   // Σ winning returns (fraction)
var float sumLoss    = 0.0   // Σ |losing returns|
var int   sumBars    = 0
var float equity     = 1.0   // compounded

conf = barstate.isconfirmed
if conf
    if inTrade and longExit
        _ret  = close / entryPrice - 1.0
        _bars = bar_index - entryBar
        nTrades += 1
        sumBars += _bars
        equity  *= (1.0 + _ret)
        if _ret > 0
            wins   += 1
            sumWin += _ret
        else
            losses  += 1
            sumLoss += -_ret
        inTrade := false
    if (not inTrade) and longEntry
        inTrade    := true
        entryPrice := close
        entryBar   := bar_index

// ── Derived metrics ──────────────────────────────────────────────────────────
acc     = nTrades > 0 ? wins / nTrades * 100.0 : 0.0
avgWin  = wins   > 0 ? sumWin  / wins   * 100.0 : 0.0
avgLoss = losses > 0 ? sumLoss / losses * 100.0 : 0.0
rvr     = avgLoss > 0 ? avgWin / avgLoss : 0.0
totRet  = (equity - 1.0) * 100.0
pf      = sumLoss > 0 ? sumWin / sumLoss : (sumWin > 0 ? 999.0 : 0.0)
avgHold = nTrades > 0 ? sumBars / nTrades : 0
sincePct = inTrade ? (close / entryPrice - 1.0) * 100.0 : 0.0
sinceAbs = inTrade ? close - entryPrice : 0.0
barsIn   = inTrade ? bar_index - entryBar : 0

// ── Table ────────────────────────────────────────────────────────────────────
_pos = tblPos == "top_left" ? position.top_left : tblPos == "bottom_right" ? position.bottom_right : tblPos == "bottom_left" ? position.bottom_left : tblPos == "middle_right" ? position.middle_right : position.top_right
_sz  = txtSz == "tiny" ? size.tiny : txtSz == "normal" ? size.normal : size.small
cHead = #12132b
cSect = #1e2140
cGood = #0e3b2e
cBad  = #3b1418
cNeu  = #181a30
cGoodT= #26d18a
cBadT = #ff6b6b
cWhite= #e8ebf7
cDim  = #8890b5

f_pct(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.##") + "%"

marginW = input.int(2, "Right-edge margin (spaces)", group = gT, minval = 0, maxval = 8, tooltip = "Pads the panel off the price scale so it doesn't clip on the right. Increase to push it further left.")
var table t = table.new(_pos, 3, 19, border_width = 1, border_color = #2a2d55, frame_width = 1, frame_color = #2a2d55)
if barstate.islast
    _tc = inTrade ? (sincePct >= 0 ? cGoodT : cBadT) : cDim
    // Header
    table.cell(t, 0, 0, "▲ " + tblName, text_color = cWhite, text_size = _sz, bgcolor = cHead, text_halign = text.align_left)
    table.cell(t, 1, 0, inTrade ? "LONG " + f_pct(sincePct) : "FLAT", text_color = _tc, text_size = _sz, bgcolor = cHead, text_halign = text.align_right)
    // CONDITIONS
    table.cell(t, 0, 1, "── CONDITIONS", text_color = cDim, text_size = _sz, bgcolor = cSect, text_halign = text.align_left)
    table.cell(t, 1, 1, "", bgcolor = cSect)
    table.cell(t, 0, 2, str.tostring(fvbLen) + " FVB", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 2, fvbBull ? "BULLISH ▲" : "BEARISH ▼", text_color = fvbBull ? cGoodT : cBadT, text_size = _sz, bgcolor = fvbBull ? cGood : cBad, text_halign = text.align_right)
    table.cell(t, 0, 3, "Weekly", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 3, wkBull ? "bullish ▲" : "bearish ▼", text_color = wkBull ? cGoodT : cBadT, text_size = _sz, bgcolor = wkBull ? cGood : cBad, text_halign = text.align_right)
    table.cell(t, 0, 4, "Monthly", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 4, moBull ? "bullish ▲" : "bearish ▼", text_color = moBull ? cGoodT : cBadT, text_size = _sz, bgcolor = moBull ? cGood : cBad, text_halign = text.align_right)
    // SYMBOL STATS
    table.cell(t, 0, 5, "── SYMBOL STATS", text_color = cDim, text_size = _sz, bgcolor = cSect, text_halign = text.align_left)
    table.cell(t, 1, 5, "", bgcolor = cSect)
    table.cell(t, 0, 6, "Accuracy", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 6, str.tostring(acc, "#.#") + "%  " + str.tostring(wins) + "W / " + str.tostring(losses) + "L", text_color = acc >= 50 ? cGoodT : cBadT, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    table.cell(t, 0, 7, "Avg WIN", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 7, f_pct(avgWin), text_color = cGoodT, text_size = _sz, bgcolor = cGood, text_halign = text.align_right)
    table.cell(t, 0, 8, "Avg LOSS", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 8, "-" + str.tostring(avgLoss, "#.##") + "%", text_color = cBadT, text_size = _sz, bgcolor = cBad, text_halign = text.align_right)
    table.cell(t, 0, 9, "RVR", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 9, str.tostring(rvr, "#.##") + " : 1", text_color = rvr >= 1 ? cGoodT : cBadT, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    table.cell(t, 0, 10, "Return", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 10, f_pct(totRet), text_color = totRet >= 0 ? cGoodT : cBadT, text_size = _sz, bgcolor = totRet >= 0 ? cGood : cBad, text_halign = text.align_right)
    table.cell(t, 0, 11, "Profit Factor", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 11, str.tostring(pf, "#.##"), text_color = pf >= 1 ? cGoodT : cBadT, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    table.cell(t, 0, 12, "Avg Hold", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 12, str.tostring(avgHold) + " bars", text_color = cWhite, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    // OPEN P&L
    table.cell(t, 0, 13, "── OPEN P&L", text_color = cDim, text_size = _sz, bgcolor = cSect, text_halign = text.align_left)
    table.cell(t, 1, 13, "", bgcolor = cSect)
    table.cell(t, 0, 14, "Since Entry", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 14, inTrade ? f_pct(sincePct) + "   " + (sinceAbs >= 0 ? "+" : "") + str.tostring(sinceAbs, format.mintick) : "—", text_color = inTrade ? (sincePct >= 0 ? cGoodT : cBadT) : cDim, text_size = _sz, bgcolor = inTrade ? (sincePct >= 0 ? cGood : cBad) : cNeu, text_halign = text.align_right)
    table.cell(t, 0, 15, "Entry Price", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 15, inTrade ? str.tostring(entryPrice, format.mintick) : "—", text_color = cWhite, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    table.cell(t, 0, 16, "Current", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 16, str.tostring(close, format.mintick), text_color = cWhite, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    table.cell(t, 0, 17, "Bars in trade", text_color = cWhite, text_size = _sz, bgcolor = cNeu)
    table.cell(t, 1, 17, inTrade ? str.tostring(barsIn) : "—", text_color = cWhite, text_size = _sz, bgcolor = cNeu, text_halign = text.align_right)
    table.cell(t, 0, 18, "Status", text_color = cDim, text_size = _sz, bgcolor = cSect, text_halign = text.align_left)
    table.cell(t, 1, 18, inTrade ? "IN TRADE" : "flat", text_color = inTrade ? cGoodT : cDim, text_size = _sz, bgcolor = cSect, text_halign = text.align_right)
    // right-edge spacer column so the panel clears the price scale (fixes the clip on the right)
    _pad = ""
    if marginW > 0
        for _i = 1 to marginW
            _pad := _pad + " "
    for _r = 0 to 18
        table.cell(t, 2, _r, _pad, text_size = _sz, bgcolor = color.new(color.black, 100))

// mark the entries/exits on the chart so the table ties to visible trades
plotshape(conf and (not inTrade[1]) and inTrade, "Entry", style = shape.triangleup,   location = location.belowbar, color = color.new(#26d18a, 0), size = size.tiny)
plotshape(conf and inTrade[1] and (not inTrade), "Exit",  style = shape.triangledown, location = location.abovebar, color = color.new(#ff6b6b, 0), size = size.tiny)
plot(useSrc ? na : basis, "Fair value basis (internal)", color = color.new(#26A69A, 30), linewidth = 1)
