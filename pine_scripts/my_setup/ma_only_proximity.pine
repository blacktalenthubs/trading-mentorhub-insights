//@version=5
// =============================================================================
// PROXIMITY MAs · FLAT — 8/20/50/100/200 SMA + 20/50/100/200 EMA as flat levels. NO structural levels.
// =============================================================================
// The moving-average half of Proximity Levels · Pure, on its own. Nothing but the MAs, each drawn
// as a FLAT horizontal line at its current value — never a sloping curve. Role-colored by where
// price is NOW: every tag spells the ROLE, not the price — "20 SMA ▼ RESISTANCE". The price is
// already on the axis; the word is there so a wall always registers as a wall. Traders talk
// themselves through resistance and give the gains back — this makes that harder to do.
// Pair it with "Proximity Levels · Structural" for the PDH/PDL/PWH-type lines.
//
// ONE show-rule, no exemptions: a MA draws only inside the nearest-N bracket — the N closest MAs
// ABOVE price and the N closest BELOW (default 3 each). A far 200 EMA stays hidden until price
// approaches, so it can never stretch the axis. N means N: nothing bypasses the count and eats a
// slot, so "3" always puts three lines on each side of price.
// MERGE: MAs stacked within ±0.20% collapse into ONE line naming all of them ("50 SMA · 200 EMA").
//
// NON-REPAINTING: values are the SETTLED higher-TF MA (ta.sma(close,len)[1] + lookahead_on) — the
// same idiom as active/ma_ema_daily.pine. That's yesterday's closed daily MA, which is what a flat
// structural line should be; lookahead_off reads the developing value and shifts intrabar.
//
// RECLAIM MARKER: a small ⟲ tag under the bar that CLOSES back above a MA it was beneath, naming
// which one ("⟲ 8 SMA · 20 EMA" when it takes several at once). Confirmed bars only — it never
// paints on the live bar and then vanishes. The mirror (losing a MA) is one toggle away, off by default.
//
// LEVEL FALLBACK: when the open is above (or below) EVERY MA, the stack can't define the day — so the
// two structural levels that DO bracket the open are named AND drawn automatically, right beside the
// open line. Open above all MAs but inside yesterday's range → PDH and PDL appear. Open above the MAs
// AND above PDH → the next pair up appears (PDH below, PMH above). Candidates: PDH/PDL · PWH/PWL ·
// PMH/PML · PQH/PQL. They show up only in that case; inside the MA stack nothing extra is drawn.
//
// HUD (top center): daily RSI + the 50/200 TREND STATE. The state combines STRUCTURE (50 vs 200)
// with PRICE POSITION, so a golden cross with price underneath reads as RECLAIM WATCH, not bullish:
//   50>200 · above both = BULLISH      50>200 · below both = RECLAIM WATCH
//   50<200 · below both = BEARISH      50<200 · above both = RECOVERY WATCH   between = MIXED
// It reads its own 50/200, so unticking those MAs hides the lines without blinding the regime read.
//
// WHERE THE DAY OPENED rides on the OPEN LINE's own label, not the HUD. Short, no price, UPPER name
// first so it reads top-down the way the lines sit: "Open BTW 50 SMA and 20 SMA" tells you the 50 SMA is the ceiling to respect and not get carried away above.
// Boxed by two MAs —
// that's the range they'll play, and those two lines are the day's rails. "ABOVE all MAs" (or below)
// means the stack has nothing left to offer: no MA is in the way, so switch to the STRUCTURAL levels
// (PDH/PDL, weekly/monthly) in "Proximity Levels · Structural" to find the day's range instead.
//
// VISUAL ONLY — no alertcondition, nothing emitted to the platform webhook.
indicator("Proximity MAs · Flat", "Prox MAs", overlay = true, max_lines_count = 30, max_labels_count = 500)

// ── which MAs ───────────────────────────────────────────────────────────────────
gMA    = "Moving averages"
maTf   = input.timeframe("D", "MA timeframe", group = gMA, tooltip = "Which timeframe's MAs. Default Daily = the 8/20/50/100/200-day structural MAs, drawn flat so you can read them on any intraday chart.")
en8    = input.bool(true, "8 SMA",   inline = "ma1", group = gMA)
en20   = input.bool(true, "20 SMA",  inline = "ma1", group = gMA)
en50   = input.bool(true, "50 SMA",  inline = "ma1", group = gMA)
en100  = input.bool(true, "100 SMA", inline = "ma2", group = gMA)
en200  = input.bool(true, "200 SMA", inline = "ma2", group = gMA)
en20e  = input.bool(true, "20 EMA",  inline = "ma3", group = gMA)
en50e  = input.bool(true, "50 EMA",  inline = "ma3", group = gMA)
en100e = input.bool(true, "100 EMA", inline = "ma3", group = gMA)
en200e = input.bool(true, "200 EMA", inline = "ma3", group = gMA)
mergePct = input.float(0.20, "Merge MAs within (%) into one line", group = gMA, minval = 0.0, maxval = 2, step = 0.05, tooltip = "MAs within this % of each other collapse into ONE line naming all (e.g. '50 SMA · 200 EMA'). 0 = draw each separately.") / 100.0

// ── proximity ───────────────────────────────────────────────────────────────────
gN        = "Proximity"
nBracket  = input.int(3, "Show this many NEAREST MAs above & below price", group = gN, minval = 1, maxval = 8, tooltip = "Always draw the N closest MAs ABOVE price and the N closest BELOW — a count, not a %, so every symbol shows the same-size near-price set.")
farCapPct = input.float(0, "  Optional cap — never show anything farther than ± % (0 = off)", group = gN, minval = 0, maxval = 30, step = 0.5) / 100.0
showAll   = input.bool(false, "Show ALL MAs (ignore proximity — will compress the scale)", group = gN)

// ── reclaim marker ──────────────────────────────────────────────────────────────
gR      = "Reclaim marker"
enRc    = input.bool(true,  "Mark the bar that CLOSES back ABOVE a MA (reclaim)", group = gR, tooltip = "A small ⟲ tag under the bar, naming every MA reclaimed on that close. This is the trigger side — price taking back a level it was trading under.")
enLost  = input.bool(false, "Also mark the bar that CLOSES back BELOW a MA (lost)", group = gR, tooltip = "The mirror: a ▽ tag above the bar when price loses a MA it was holding. That's the exit side. OFF by default so the chart only shows reclaims.")
rcConf  = input.bool(true,  "Confirmed bars only (never paint on the live bar)", group = gR, tooltip = "ON = the tag appears only once the bar CLOSES, so it can't appear mid-bar and then disappear. OFF = marks intrabar the moment price crosses (repaints).")
rcUpCol = input.color(#26A69A, "Reclaim", inline = "rc", group = gR)
rcDnCol = input.color(#EF5350, "Lost",    inline = "rc", group = gR)
rcSize  = input.string("small", "Tag size", options = ["tiny", "small", "normal"], group = gR)

// ── level fallback — what to say when the MA stack can't bracket the open ───────
gL       = "Level fallback (open outside the MA stack)"
enLvl    = input.bool(true, "Name the structural levels that bracket the open", group = gL, tooltip = "When the open is above (or below) EVERY MA, the stack has nothing to say about the day's range — so fall back to PDH/PDL · PWH/PWL · PMH/PML · PQH/PQL and name the two that actually bracket the open. 'Open below all MAs · between PWL and PDL' beats 'below all MAs'.")
enLvlDraw = input.bool(true, "  DRAW those two levels automatically", group = gL, tooltip = "ON by default: the moment the MA stack can't bracket the open, the two structural levels that DO bracket it are drawn beside the open line — so the day's range is on the chart without you going to find it. They appear ONLY in that case; while the open sits inside the MA stack nothing extra is drawn. Turn OFF if you also run 'Proximity Levels · Structural' and don't want the duplicate lines.")

// ── daily RSI + open HUD ────────────────────────────────────────────────────────
gH      = "Daily RSI + open (HUD)"
enHud   = input.bool(true, "Show the HUD", group = gH, tooltip = "Two lines: today's DAILY RSI (locked to daily on any chart TF) and where the session OPENED inside the MA stack.")
hudPos  = input.string("top_center", "HUD position", options = ["top_center", "top_right", "top_left", "bottom_center", "bottom_right"], group = gH)
rsiLen  = input.int(14, "RSI length", group = gH, minval = 2)
rsiOS   = input.float(30, "Oversold ≤ (green)",   group = gH, minval = 5,  maxval = 50)
rsiOB   = input.float(70, "Overbought ≥ (red)",   group = gH, minval = 50, maxval = 95)
enState = input.bool(true, "Show the 50/200 trend state (second HUD row)", group = gH, tooltip = "Combines STRUCTURE (50 vs 200) with PRICE POSITION, so a golden cross with price underneath doesn't read as bullish. Uses its own 50/200 values, so it stays correct even if you untick those MAs above.")
enOpenLn = input.bool(true, "Draw a faint line at the day's OPEN", group = gH, tooltip = "The session open, drawn subtly so it never competes with the MAs. Where price opened inside the stack is what sets the day's playable range.")
openCol  = input.color(color.new(#EAB308, 55), "Open line", inline = "ol", group = gH)
openW    = input.int(1, "width", inline = "ol", group = gH, minval = 1, maxval = 5)

// ── style ───────────────────────────────────────────────────────────────────────
gV        = "Style"
supCol    = input.color(#26A69A, "Support (price above)",    group = gV)
resCol    = input.color(#EF5350, "Resistance (price below)", group = gV)
wLine     = input.int(2,  "Line width", group = gV, minval = 1, maxval = 5)
lineLen   = input.int(80, "Line length (bars back, when NOT extended)", group = gV, minval = 10, maxval = 500)
extendAll = input.bool(false, "Extend lines across the whole chart (infinite)", group = gV)
dotted    = input.bool(true, "Draw MAs dotted (so a MA still reads as a MA)", group = gV)
labelX    = input.int(8, "Tag column — bars right of the last bar", group = gV, minval = 2, maxval = 40)
lblGap    = input.float(0.5, "Fan tags apart when MAs are within ± % of each other", group = gV, minval = 0.05, maxval = 5, step = 0.05) / 100.0
lblStep   = input.int(4, "  Fan step (bars per collision)", group = gV, minval = 1, maxval = 40)

// ── values — SETTLED higher-TF MA ([1] + lookahead_on), the ma_ema_daily idiom. Flat, non-repainting.
// (each call written out in full — a request.security wrapped in a helper that also branches is the
//  one shape that bites; this is the exact form proximity_levels_pure / ma_ema_daily already use)
sma8v   = en8    ? request.security(syminfo.tickerid, maTf, ta.sma(close, 8)[1],   lookahead = barmerge.lookahead_on) : na
sma20v  = en20   ? request.security(syminfo.tickerid, maTf, ta.sma(close, 20)[1],  lookahead = barmerge.lookahead_on) : na
sma50v  = en50   ? request.security(syminfo.tickerid, maTf, ta.sma(close, 50)[1],  lookahead = barmerge.lookahead_on) : na
sma100v = en100  ? request.security(syminfo.tickerid, maTf, ta.sma(close, 100)[1], lookahead = barmerge.lookahead_on) : na
sma200v = en200  ? request.security(syminfo.tickerid, maTf, ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on) : na
ema20v  = en20e  ? request.security(syminfo.tickerid, maTf, ta.ema(close, 20)[1],  lookahead = barmerge.lookahead_on) : na
ema50v  = en50e  ? request.security(syminfo.tickerid, maTf, ta.ema(close, 50)[1],  lookahead = barmerge.lookahead_on) : na
ema100v = en100e ? request.security(syminfo.tickerid, maTf, ta.ema(close, 100)[1], lookahead = barmerge.lookahead_on) : na
ema200v = en200e ? request.security(syminfo.tickerid, maTf, ta.ema(close, 200)[1], lookahead = barmerge.lookahead_on) : na

// ── day open (RTH-accurate) + daily RSI — both locked to D regardless of chart TF ──
rthTid  = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
dayOpen = request.security(rthTid, "D", open, lookahead = barmerge.lookahead_on)
rsiD    = request.security(syminfo.tickerid, "D", ta.rsi(close, rsiLen), lookahead = barmerge.lookahead_off)
// the trend state reads its OWN 50/200 — independent of the display toggles above, so unticking
// "50 SMA" hides the line without blinding the regime read
st50  = request.security(syminfo.tickerid, maTf, ta.sma(close, 50)[1],  lookahead = barmerge.lookahead_on)
st200 = request.security(syminfo.tickerid, maTf, ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on)
f_state() =>
    string txt = na
    color  col = na
    if na(st50) or na(st200)
        txt := "50/200 — no data"
        col := color.new(color.gray, 20)
    else
        _golden = st50 > st200
        _above  = close > st50 and close > st200
        _below  = close < st50 and close < st200
        if _golden and _above
            txt := "BULLISH · 50>200 · price above both"
            col := color.new(color.green, 10)
        else if _golden and _below
            txt := "RECLAIM WATCH · 50>200 but price below — wait for the 200 reclaim"
            col := color.new(color.orange, 10)
        else if not _golden and _below
            txt := "BEARISH · 50<200 · price below both"
            col := color.new(color.red, 10)
        else if not _golden and _above
            txt := "RECOVERY WATCH · 50<200 but price above — potential turn"
            col := color.new(color.blue, 10)
        else
            txt := "MIXED · price between the 50 and the 200"
            col := color.new(color.gray, 10)
    [txt, col]
[stateTxt, stateCol] = f_state()
// structural levels — only consulted when the MA stack can't bracket the open. Settled + RTH, same as the levels pine.
f_lvl(string tf, float expr) => request.security(rthTid, tf, expr, lookahead = barmerge.lookahead_on)
lPdh = f_lvl("D",  high[1])
lPdl = f_lvl("D",  low[1])
lPwh = f_lvl("W",  high[1])
lPwl = f_lvl("W",  low[1])
lPmh = f_lvl("M",  high[1])
lPml = f_lvl("M",  low[1])
lPqh = f_lvl("3M", high[1])
lPql = f_lvl("3M", low[1])

// ── collection + flat-line drawing ──────────────────────────────────────────────
var line[]   _ln = array.new_line()
var label[]  _lb = array.new_label()
var float[]  _maV = array.new_float()
var string[] _maN = array.new_string()
var float[]  _drawnY = array.new_float()   // prices already tagged this bar (collision fan)
var float    _brkHi = 1.0e18               // Nth-nearest ABOVE price — bracket top
var float    _brkLo = -1.0                 // Nth-nearest BELOW price — bracket bottom
f_xoff(float price) =>
    _cnt = 0
    if array.size(_drawnY) > 0
        for _k = 0 to array.size(_drawnY) - 1
            if math.abs(array.get(_drawnY, _k) - price) / price <= lblGap
                _cnt := _cnt + 1
    array.push(_drawnY, price)
    labelX + math.min(_cnt, 6) * lblStep
// ONE rule, no exemptions: a MA draws when it's inside the nearest-N bracket. N means N.
f_draw(float v, string nm) =>
    _inBr = v <= _brkHi and v >= _brkLo
    _cap  = farCapPct <= 0 or math.abs(close - v) / close <= farCapPct
    if not na(v) and v > 0 and (showAll or (_inBr and _cap))
        col = close > v ? supCol : resCol
        _xo = f_xoff(v)
        array.push(_ln, line.new(bar_index - lineLen, v, bar_index + _xo, v, color = col, width = wLine, style = dotted ? line.style_dotted : line.style_solid, extend = extendAll ? extend.both : extend.none))
        array.push(_lb, label.new(bar_index + _xo, v, nm + (close > v ? "  ▲ SUPPORT" : "  ▼ RESISTANCE"), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
f_collect(float v, string nm) =>
    if not na(v) and v > 0
        array.push(_maV, v)
        array.push(_maN, nm)

_hudPosC = hudPos == "top_right" ? position.top_right : hudPos == "top_left" ? position.top_left : hudPos == "bottom_center" ? position.bottom_center : hudPos == "bottom_right" ? position.bottom_right : position.top_center
var table _hudT = table.new(_hudPosC, 1, 2, border_width = 1, border_color = color.new(color.gray, 40))

if barstate.islast
    for _l in _ln
        line.delete(_l)
    for _b in _lb
        label.delete(_b)
    array.clear(_ln)
    array.clear(_lb)
    array.clear(_maV)
    array.clear(_maN)
    array.clear(_drawnY)
    f_collect(sma8v,   "8 SMA")
    f_collect(sma20v,  "20 SMA")
    f_collect(sma50v,  "50 SMA")
    f_collect(sma100v, "100 SMA")
    f_collect(sma200v, "200 SMA")
    f_collect(ema20v,  "20 EMA")
    f_collect(ema50v,  "50 EMA")
    f_collect(ema100v, "100 EMA")
    f_collect(ema200v, "200 EMA")
    // ── NEAREST-N bracket — the N closest MAs above price and N closest below ──
    _ab = array.new_float()
    _bl = array.new_float()
    if array.size(_maV) > 0
        for _i = 0 to array.size(_maV) - 1
            v = array.get(_maV, _i)
            if v > close
                array.push(_ab, v)
            else if v < close
                array.push(_bl, v)
    array.sort(_ab, order.ascending)     // nearest-above first
    array.sort(_bl, order.descending)    // nearest-below first
    _brkHi := array.size(_ab) > 0 ? array.get(_ab, math.min(nBracket, array.size(_ab)) - 1) : 1.0e18
    _brkLo := array.size(_bl) > 0 ? array.get(_bl, math.min(nBracket, array.size(_bl)) - 1) : -1.0
    // ── MERGE stacked MAs into one line, then draw (the bracket test lives in f_draw) ──
    _n = array.size(_maV)
    if _n > 0
        _ord = array.sort_indices(_maV, order.ascending)
        _i = 0
        while _i < _n
            _s  = array.get(_ord, _i)
            _lo = array.get(_maV, _s)
            _hi = _lo
            _nm = array.get(_maN, _s)
            _j  = _i + 1
            while _j < _n
                _vj = array.get(_maV, array.get(_ord, _j))
                if mergePct > 0 and _vj <= _hi * (1.0 + mergePct)
                    _hi := _vj
                    _nm := _nm + " · " + array.get(_maN, array.get(_ord, _j))
                    _j  := _j + 1
                else
                    break
            f_draw((_lo + _hi) / 2.0, _nm)
            _i := _j
    // ── where did the day OPEN inside the stack? nearest MA above the open and nearest below ──
    _oUp  = 1.0e18
    _oDn  = -1.0
    _oUpN = ""
    _oDnN = ""
    if not na(dayOpen) and array.size(_maV) > 0
        for _k = 0 to array.size(_maV) - 1
            _v = array.get(_maV, _k)
            if _v > dayOpen and _v < _oUp
                _oUp  := _v
                _oUpN := array.get(_maN, _k)
            if _v < dayOpen and _v > _oDn
                _oDn  := _v
                _oDnN := array.get(_maN, _k)
    _hasUp = _oUp < 1.0e17
    _hasDn = _oDn > 0
    // ── the MA stack can't bracket the open → fall back to the structural levels ──
    _lUp  = 1.0e18
    _lDn  = -1.0
    _lUpN = ""
    _lDnN = ""
    if enLvl and not na(dayOpen)
        _lv  = array.from(lPdh, lPdl, lPwh, lPwl, lPmh, lPml, lPqh, lPql)
        _lnm = array.from("PDH", "PDL", "PWH", "PWL", "PMH", "PML", "PQH", "PQL")
        for _k = 0 to array.size(_lv) - 1
            _v = array.get(_lv, _k)
            if not na(_v) and _v > 0
                if _v > dayOpen and _v < _lUp
                    _lUp  := _v
                    _lUpN := array.get(_lnm, _k)
                if _v < dayOpen and _v > _lDn
                    _lDn  := _v
                    _lDnN := array.get(_lnm, _k)
    _lHasUp = _lUp < 1.0e17
    _lHasDn = _lDn > 0
    _boxed  = _hasUp and _hasDn
    // the level phrasing, reused by both the line label and the HUD row
    _lvlTxt = not enLvl ? "" : _lHasUp and _lHasDn ? "BTW " + _lUpN + " and " + _lDnN : _lHasUp ? "under " + _lUpN : _lHasDn ? "over " + _lDnN : "no levels"
    // draw the two bracketing levels only when the stack has failed (that's the fallback)
    if enLvl and enLvlDraw and not _boxed
        if _lHasDn
            _dxo = f_xoff(_lDn)
            _dc  = close > _lDn ? supCol : resCol
            array.push(_ln, line.new(bar_index - lineLen, _lDn, bar_index + _dxo, _lDn, color = _dc, width = wLine, style = line.style_dashed, extend = extendAll ? extend.both : extend.none))
            array.push(_lb, label.new(bar_index + _dxo, _lDn, _lDnN + (close > _lDn ? "  ▲ SUPPORT" : "  ▼ RESISTANCE"), style = label.style_label_left, color = _dc, textcolor = color.white, size = size.small))
        if _lHasUp
            _uxo = f_xoff(_lUp)
            _uc  = close > _lUp ? supCol : resCol
            array.push(_ln, line.new(bar_index - lineLen, _lUp, bar_index + _uxo, _lUp, color = _uc, width = wLine, style = line.style_dashed, extend = extendAll ? extend.both : extend.none))
            array.push(_lb, label.new(bar_index + _uxo, _lUp, _lUpN + (close > _lUp ? "  ▲ SUPPORT" : "  ▼ RESISTANCE"), style = label.style_label_left, color = _uc, textcolor = color.white, size = size.small))
    // the faint open line — subtle, never competing with the MAs
    if enOpenLn and not na(dayOpen)
        _oxo = f_xoff(dayOpen)
        array.push(_ln, line.new(bar_index - lineLen, dayOpen, bar_index + _oxo, dayOpen, color = openCol, width = openW, style = line.style_dotted, extend = extendAll ? extend.both : extend.none))
        _oTag = _boxed ? "Open BTW " + _oUpN + " and " + _oDnN : _hasDn ? "Open ABOVE all MAs · " + _lvlTxt : _hasUp ? "Open BELOW all MAs · " + _lvlTxt : "Open"
        array.push(_lb, label.new(bar_index + _oxo, dayOpen, _oTag, style = label.style_label_left, color = openCol, textcolor = color.black, size = size.small))
    // ── HUD ──
    if enHud
        _rTxt = na(rsiD) ? "RSI-D —" : "RSI-D " + str.tostring(rsiD, "#.0") + " · " + (rsiD <= rsiOS ? "oversold" : rsiD >= rsiOB ? "overbought" : "neutral")
        _rCol = na(rsiD) ? color.new(color.gray, 20) : rsiD <= rsiOS ? color.new(color.green, 0) : rsiD >= rsiOB ? color.new(color.red, 0) : color.new(color.gray, 10)
        table.set_position(_hudT, _hudPosC)
        table.cell(_hudT, 0, 0, _rTxt, bgcolor = _rCol, text_color = color.white, text_size = size.normal)
        table.cell(_hudT, 0, 1, enState ? stateTxt : "", bgcolor = enState ? stateCol : color.new(color.gray, 100), text_color = color.white, text_size = size.small)
    else
        table.cell(_hudT, 0, 0, "")
        table.cell(_hudT, 0, 1, "")

// ═══════════════════════════════════════════════════════════════════════════════
// RECLAIM / LOST MARKERS — the bar that CLOSES back through a MA, naming which one.
// Every ta.crossover/crossunder is evaluated on EVERY bar at global scope (they're stateful —
// calling them conditionally makes them miss crosses), then the names are assembled for the tag.
// ═══════════════════════════════════════════════════════════════════════════════
_up8    = ta.crossover(close, sma8v)
_up20   = ta.crossover(close, sma20v)
_up50   = ta.crossover(close, sma50v)
_up100  = ta.crossover(close, sma100v)
_up200  = ta.crossover(close, sma200v)
_up20e  = ta.crossover(close, ema20v)
_up50e  = ta.crossover(close, ema50v)
_up100e = ta.crossover(close, ema100v)
_up200e = ta.crossover(close, ema200v)
_dn8    = ta.crossunder(close, sma8v)
_dn20   = ta.crossunder(close, sma20v)
_dn50   = ta.crossunder(close, sma50v)
_dn100  = ta.crossunder(close, sma100v)
_dn200  = ta.crossunder(close, sma200v)
_dn20e  = ta.crossunder(close, ema20v)
_dn50e  = ta.crossunder(close, ema50v)
_dn100e = ta.crossunder(close, ema100v)
_dn200e = ta.crossunder(close, ema200v)
f_join(string acc, bool hit, string nm) => hit ? (str.length(acc) > 0 ? acc + " · " + nm : nm) : acc
_rcTxt = ""
_rcTxt := f_join(_rcTxt, _up8,    "8 SMA")
_rcTxt := f_join(_rcTxt, _up20,   "20 SMA")
_rcTxt := f_join(_rcTxt, _up20e,  "20 EMA")
_rcTxt := f_join(_rcTxt, _up50,   "50 SMA")
_rcTxt := f_join(_rcTxt, _up50e,  "50 EMA")
_rcTxt := f_join(_rcTxt, _up100,  "100 SMA")
_rcTxt := f_join(_rcTxt, _up100e, "100 EMA")
_rcTxt := f_join(_rcTxt, _up200,  "200 SMA")
_rcTxt := f_join(_rcTxt, _up200e, "200 EMA")
_lsTxt = ""
_lsTxt := f_join(_lsTxt, _dn8,    "8 SMA")
_lsTxt := f_join(_lsTxt, _dn20,   "20 SMA")
_lsTxt := f_join(_lsTxt, _dn20e,  "20 EMA")
_lsTxt := f_join(_lsTxt, _dn50,   "50 SMA")
_lsTxt := f_join(_lsTxt, _dn50e,  "50 EMA")
_lsTxt := f_join(_lsTxt, _dn100,  "100 SMA")
_lsTxt := f_join(_lsTxt, _dn100e, "100 EMA")
_lsTxt := f_join(_lsTxt, _dn200,  "200 SMA")
_lsTxt := f_join(_lsTxt, _dn200e, "200 EMA")
_rcSz  = rcSize == "tiny" ? size.tiny : rcSize == "normal" ? size.normal : size.small
_rcOk  = not rcConf or barstate.isconfirmed
if enRc and _rcOk and str.length(_rcTxt) > 0
    label.new(bar_index, low, "⟲ " + _rcTxt, yloc = yloc.belowbar, style = label.style_label_up, color = rcUpCol, textcolor = color.white, size = _rcSz)
if enLost and _rcOk and str.length(_lsTxt) > 0
    label.new(bar_index, high, "▽ " + _lsTxt, yloc = yloc.abovebar, style = label.style_label_down, color = rcDnCol, textcolor = color.white, size = _rcSz)
