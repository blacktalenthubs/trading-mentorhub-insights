//@version=5
// =============================================================================
// SWING RECLAIM ENTRIES — SMA 50/100/200 + RSI-30 + FV basis + Smart Money zones
// =============================================================================
// The validated long-hold / accumulation entries. Bind on DAILY for your whole watchlist.
// EVERY entry is the SAME pattern: a structural line that was acting as SUPPORT (price held
// above it) gets wicked below and RECLAIMED (closed back above) — role-guarded, so a
// from-BELOW breakup of resistance does NOT fire. Stop = the swept low (lose the line = out):
//   • 50 / 100 / 200 SMA reclaim                                  -> swing_sma{50,100,200}_reclaim
//   • RSI(14) reclaims 30 (oversold turn from a washout)          -> swing_rsi_30
//   • FV basis reclaim (33-SMA of OHLC4, weekly — the key value)  -> swing_fv_reclaim
//   • Smart Money zone reclaim (golden pocket of the weekly swing)-> swing_smz_reclaim
//   • 5/20 EMA bullish cross (Steve Burns — daily trend flip up)  -> ema_5_20_cross
// LONG only. Stop = the swept bar low. (user 2026-07-30 · +FV/SMZ 2026-08-02 · +5/20 cross 2026-08-03)
indicator("Swing Reclaim — SMA/RSI/FV/SMZ", overlay = true, max_lines_count = 20, max_labels_count = 20, max_boxes_count = 4)

gM   = "Entries"
en50 = input.bool(true, "50 SMA reclaim (wick + hold)", group = gM)
en100= input.bool(true, "100 SMA reclaim (wick + hold)", group = gM)
en200= input.bool(true, "200 SMA reclaim", group = gM)
enR  = input.bool(true, "RSI-30 reclaim (oversold turn)", group = gM)
enFV = input.bool(true, "FV basis reclaim (33-SMA of OHLC4)", group = gM)
enSMZ= input.bool(true, "Smart Money zone reclaim (golden pocket)", group = gM)
en520= input.bool(true, "5/20 EMA bullish cross (Burns)", group = gM)
enAl = input.bool(true, "Fire alerts (on bar close)", group = gM)

gP     = "Params"
len50  = input.int(50,  "Fast SMA length", group = gP, minval = 2)
len100 = input.int(100, "Mid SMA length", group = gP, minval = 2)
len200 = input.int(200, "Slow SMA length", group = gP, minval = 2)
lbAbove= input.int(10,  "Reclaim lookback — bars price must have HELD ABOVE recently", group = gP, minval = 1, maxval = 60, tooltip = "The MA's role must be SUPPORT: price must have closed ABOVE it within this many recent bars. A sustained-below cross-up is a BREAKUP (resistance broken), NOT a reclaim — it won't fire.")
rsiLen = input.int(14,  "RSI length", group = gP, minval = 2)
rsiOS  = input.int(30,  "RSI oversold level", group = gP, minval = 5, maxval = 50)
emaFast= input.int(5,   "5/20 cross — fast EMA", group = gP, minval = 2)
emaSlow= input.int(20,  "5/20 cross — slow EMA", group = gP, minval = 3)
showSMA = input.bool(true, "Draw the SMA lines (50/100/200)", group = gP)

gL       = "Flat / lock to timeframe"
flatMode = input.bool(true, "FLAT — lock the SMAs to a fixed timeframe", group = gL, tooltip = "ON = the 50/200 SMA (and RSI) use the LOCK timeframe's value, drawn FLAT — so you can bind this pine INTRADAY (e.g. 15m) and still trade reclaims of the DAILY 50/200 SMA. OFF = the current chart-TF sloping SMA (bind on Daily).")
lockTf   = input.timeframe("D", "Lock timeframe", group = gL)

// FLAT = the lock-TF (daily) SMA — settled ([1], non-repainting), flat within the period,
// steps at the roll. RSI in flat mode is the DEVELOPING lock-TF RSI (no [1]) so it can reclaim
// 30 intraday. REGULAR = the chart-TF sloping values.
tid       = syminfo.tickerid
flat50    = request.security(tid, lockTf, ta.sma(close, len50)[1],  lookahead = barmerge.lookahead_on)
flat100   = request.security(tid, lockTf, ta.sma(close, len100)[1], lookahead = barmerge.lookahead_on)
flat200   = request.security(tid, lockTf, ta.sma(close, len200)[1], lookahead = barmerge.lookahead_on)
flatRsi   = request.security(tid, lockTf, ta.rsi(close, rsiLen),    lookahead = barmerge.lookahead_off)
// prior-period CLOSE (yesterday, on the lock TF) — the RECLAIM role-guard: the level counts as SUPPORT
// only if the PRIOR DAILY close was ABOVE it. A name that closed BELOW the daily SMA (came from below)
// and breaks back up is a BREAKUP, not a reclaim (user 2026-08-04: NBIS fired 50-SMA "reclaim" on a
// breakup — 0/10 prior daily closes were above the 50 SMA). In flat mode this is the DAILY close.
dPrevClose = flatMode ? request.security(tid, lockTf, close[1], lookahead = barmerge.lookahead_on) : close[1]
sma50  = flatMode ? flat50  : ta.sma(close, len50)
sma100 = flatMode ? flat100 : ta.sma(close, len100)
sma200 = flatMode ? flat200 : ta.sma(close, len200)
rsi    = flatMode ? flatRsi : ta.rsi(close, rsiLen)
// 5/20 EMA cross (Burns) — DEVELOPING lock-TF EMAs (like the RSI, no [1]) so the daily cross can fire
// intraday on the bound TF's close; chart-TF EMAs when flat mode is OFF (bind on Daily).
emaFastV = flatMode ? request.security(tid, lockTf, ta.ema(close, emaFast), lookahead = barmerge.lookahead_off) : ta.ema(close, emaFast)
emaSlowV = flatMode ? request.security(tid, lockTf, ta.ema(close, emaSlow), lookahead = barmerge.lookahead_off) : ta.ema(close, emaSlow)
conf   = barstate.isconfirmed

// ── Fair Value basis — 33-SMA of OHLC4, locked to the WEEKLY (the key swing entry level). A close
// back above the basis after dipping below = reclaim (same mechanic + role-guard as the SMAs).
gFV     = "Fair Value basis (33-SMA OHLC4)"
fvLen   = input.int(33, "FV SMA length", group = gFV, minval = 2)
fvTf    = input.timeframe("W", "FV timeframe", group = gFV)
showFV  = input.bool(true, "Draw the FV line", group = gFV)
fvBasis = request.security(tid, fvTf, ta.sma(ohlc4, fvLen)[1], lookahead = barmerge.lookahead_on)

// ── Smart Money zones — golden pocket of the recent WEEKLY swing (AUTO: highest high & lowest low
// over the window → fib retracement DOWN from the high, the discount-buy zone). The zone must be
// acting as SUPPORT (price held above it) before a reclaim counts — same role-guard as the SMAs;
// stop = the swept low (lose the zone = out). 4 edges — the middle 0.786 is shared → 3 prices.
gSMZ    = "Smart Money zones (golden pocket)"
smzTf   = input.timeframe("W", "Zone timeframe", group = gSMZ)
smzLb   = input.int(40, "Recent swing window (bars)", group = gSMZ, minval = 5, maxval = 500, tooltip = "The zones fib the highest high & lowest low over this many WEEKLY bars — an AUTO swing leg (won't match a hand-drawn leg). Tune until the zones line up with your read.")
fInsT   = input.float(0.618, "Institutional top",             group = gSMZ, step = 0.001)
fInsB   = input.float(0.786, "Institutional bottom / SM top", group = gSMZ, step = 0.001)
fSmB    = input.float(0.85,  "Smart Money bottom",            group = gSMZ, step = 0.001)
showSMZ = input.bool(true, "Draw the SMZ edge lines", group = gSMZ)
showZone= input.bool(true, "Shade the SMZ zone boxes", group = gSMZ)
colInst = input.color(color.new(color.blue,   85), "Institutional zone fill", group = gSMZ)
colSm   = input.color(color.new(color.purple, 72), "Smart Money zone fill",   group = gSMZ)
smzHi   = request.security(tid, smzTf, ta.highest(high, smzLb)[1], lookahead = barmerge.lookahead_on)
smzLo   = request.security(tid, smzTf, ta.lowest(low,  smzLb)[1], lookahead = barmerge.lookahead_on)
smzRng  = smzHi - smzLo
instTop = smzHi - fInsT * smzRng
instBot = smzHi - fInsB * smzRng
smzBot  = smzHi - fSmB  * smzRng

// The MA's role must be SUPPORT before a reclaim counts — price must have CLOSED ABOVE it within
// the recent lookback (so it owned the level, then lost it briefly, then recovered). If price has
// been BELOW the MA the whole window (MA = overhead resistance), a close-up-through it is a BREAKUP,
// NOT a reclaim — and a breakup is a different, un-enabled setup (user 2026-08-02: AMD/AVGO/VRT).
f_wasAbove(float L, int n) =>
    _r = false
    for _i = 1 to n
        _r := _r or (not na(L[_i]) and close[_i] > L[_i])
    _r

// RECLAIM = close back above the level, with the MA acting as support:
//   • wick-and-hold  — intrabar dip below, closed back above, prior close was still above (never lost it), OR
//   • brief recovery — closed below for a bar or two BUT held above within the recent lookback.
// A sustained-below cross-up (breakup of resistance) fails f_wasAbove and does NOT fire.
f_reclaim(float L) => not na(L) and not na(L[1]) and not na(dPrevClose) and dPrevClose > L and close > L and ((low < L and close[1] >= L[1]) or (close[1] < L[1] and f_wasAbove(L, lbAbove)))

rc50  = en50  and conf and f_reclaim(sma50)
rc100 = en100 and conf and f_reclaim(sma100)
rc200 = en200 and conf and f_reclaim(sma200)
rcR   = enR   and conf and ta.crossover(rsi, rsiOS)
rc520 = en520 and conf and ta.crossover(emaFastV, emaSlowV)   // 5 EMA crosses UP through 20 EMA (Burns)
rcFV  = enFV  and conf and f_reclaim(fvBasis)
// Smart Money zone reclaims — same reclaim + role-guard on each golden-pocket edge.
rcInsT = enSMZ and conf and f_reclaim(instTop)
rcInsB = enSMZ and conf and f_reclaim(instBot)
rcSmB  = enSMZ and conf and f_reclaim(smzBot)
rcSMZ  = rcInsT or rcInsB or rcSmB
smzLvl = rcInsT ? instTop : rcInsB ? instBot : rcSmB ? smzBot : na
smzNm  = rcInsT ? "Institutional top" : rcInsB ? "Institutional bottom (SM top)" : rcSmB ? "Smart Money bottom" : ""

// ── Flat S/R lines — GREEN = SUPPORT (price above), RED = RESISTANCE (price below);
// role flips when price closes across. Drawn as a horizontal ray per SMA (flat mode only).
supCol  = input.color(#26A69A, "Support color (price above)",    group = gL)
resCol  = input.color(#EF5350, "Resistance color (price below)", group = gL)
lineW   = input.int(2,  "Line width", group = gL, minval = 1, maxval = 5)
lineLen = input.int(60, "Line length (bars back)", group = gL, minval = 10, maxval = 500)
var line[]  _lns = array.new_line(0)
var label[] _lbs = array.new_label(0)
f_sr(float ma, string nm, bool show) =>
    if show and not na(ma)
        sup = close > ma
        col = sup ? supCol : resCol
        array.push(_lns, line.new(bar_index - lineLen, ma, bar_index + 6, ma, color = col, width = lineW))
        array.push(_lbs, label.new(bar_index + 6, ma, nm + (sup ? "  SUPPORT  " : "  RESIST  ") + str.tostring(ma, format.mintick), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
if barstate.islast and flatMode
    for _l in _lns
        line.delete(_l)
    for _b in _lbs
        label.delete(_b)
    array.clear(_lns)
    array.clear(_lbs)
    f_sr(sma50,  "50 SMA",  en50  and showSMA)
    f_sr(sma100, "100 SMA", en100 and showSMA)
    f_sr(sma200, "200 SMA", en200 and showSMA)
    f_sr(fvBasis, "FV 33",  enFV  and showFV)
    f_sr(instTop, "Inst top", enSMZ and showSMZ)
    f_sr(instBot, "Inst bot / SM top", enSMZ and showSMZ)
    f_sr(smzBot,  "SM bot",  enSMZ and showSMZ)

// ── Smart Money zone boxes — the shaded Institutional (blue) + Smart Money (purple) bands
// between the golden-pocket edges, like the GP Auto pine. Right-anchored, redrawn each bar.
var box _iBox = na
var box _sBox = na
if barstate.islast and enSMZ and showZone and not na(instTop) and not na(smzBot) and instTop > smzBot
    box.delete(_iBox)
    box.delete(_sBox)
    _iBox := box.new(bar_index - lineLen, math.max(instTop, instBot), bar_index + 6, math.min(instTop, instBot), border_color = color.new(color.blue, 50), bgcolor = colInst)
    _sBox := box.new(bar_index - lineLen, math.max(instBot, smzBot),  bar_index + 6, math.min(instBot, smzBot),  border_color = color.new(color.purple, 50), bgcolor = colSm)
// sloping fallback (flat mode OFF) — normal plotted MA
plot(showSMA and not flatMode and en50  ? sma50  : na, "50 SMA",  color = color.new(#3B82F6, 20), linewidth = 1)
plot(showSMA and not flatMode and en200 ? sma200 : na, "200 SMA", color = color.new(color.teal, 10), linewidth = 2)
plotshape(rc50,  "50 SMA reclaim",  style = shape.triangleup, location = location.belowbar, color = color.new(#3B82F6, 0),    size = size.tiny)
plotshape(rc100, "100 SMA reclaim", style = shape.triangleup, location = location.belowbar, color = color.new(#8B5CF6, 0),    size = size.tiny)
plotshape(rc200, "200 SMA reclaim", style = shape.arrowup,    location = location.belowbar, color = color.new(color.teal, 0),  size = size.small)
plotshape(rcR,   "RSI-30 reclaim",  style = shape.circle,     location = location.belowbar, color = color.new(color.purple, 0), size = size.tiny)
plotshape(rc520, "5/20 EMA cross",  style = shape.labelup,    location = location.belowbar, color = color.new(#10B981, 0),     size = size.tiny, text = "5/20")
plotshape(rcFV,  "FV basis reclaim", style = shape.diamond,   location = location.belowbar, color = color.new(#F59E0B, 0),    size = size.tiny)
plotshape(rcSMZ, "Smart Money zone reclaim", style = shape.triangleup, location = location.belowbar, color = color.new(#A855F7, 0), size = size.small)

f_pay(string rule, string note) => '{"symbol":"' + syminfo.ticker + '","price":"' + str.tostring(close, format.mintick) + '","rule":"' + rule + '","direction":"BUY","interval":"' + timeframe.period + '","entry":"' + str.tostring(close, format.mintick) + '","stop":"' + str.tostring(low, format.mintick) + '","note":"' + note + '"}'

if enAl and rc50
    alert(f_pay("swing_sma50_reclaim",  "50 SMA reclaim at "  + str.tostring(sma50,  format.mintick) + " · wick below + close back above (held). Stop = the swept low; invalid on a close below "  + str.tostring(sma50,  format.mintick)), alert.freq_once_per_bar_close)
if enAl and rc100
    alert(f_pay("swing_sma100_reclaim", "100 SMA reclaim at " + str.tostring(sma100, format.mintick) + " · wick below + close back above (held). Stop = the swept low; invalid on a close below " + str.tostring(sma100, format.mintick)), alert.freq_once_per_bar_close)
if enAl and rc200
    alert(f_pay("swing_sma200_reclaim", "200 SMA reclaim at " + str.tostring(sma200, format.mintick) + " · structural support recovered. Stop = the swept low; invalid on a close below " + str.tostring(sma200, format.mintick)), alert.freq_once_per_bar_close)
if enAl and rcR
    alert(f_pay("swing_rsi_30",  "RSI reclaimed 30 (oversold turn) — momentum turning up from a washout. Stop = the swept low."), alert.freq_once_per_bar_close)
if enAl and rc520
    alert(f_pay("ema_5_20_cross", "5/20 EMA bullish cross (Burns) — the " + str.tostring(emaFast) + " EMA crossed ABOVE the " + str.tostring(emaSlow) + " EMA at " + str.tostring(emaSlowV, format.mintick) + " · short-term trend flip up, a swing entry (hold days). Stop = the swept low; invalid on a close back under the " + str.tostring(emaSlow) + " EMA."), alert.freq_once_per_bar_close)
if enAl and rcFV
    alert(f_pay("swing_fv_reclaim", "Fair Value (33-SMA OHLC4) reclaim at " + str.tostring(fvBasis, format.mintick) + " · closed back above the basis (weekly value support held). Stop = the swept low; invalid on a close below " + str.tostring(fvBasis, format.mintick)), alert.freq_once_per_bar_close)
if enAl and rcSMZ
    alert(f_pay("swing_smz_reclaim", "Smart Money zone reclaim — " + smzNm + " at " + str.tostring(smzLvl, format.mintick) + " · the golden-pocket edge held as support (price reclaimed it). Stop = the swept low; invalid on a close below " + str.tostring(smzLvl, format.mintick)), alert.freq_once_per_bar_close)
