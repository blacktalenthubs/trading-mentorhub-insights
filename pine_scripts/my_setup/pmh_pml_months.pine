//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// PMH / PML · Months — the MONTHLY High & Low of each of the last N completed months. Clean & standalone.
// ─────────────────────────────────────────────────────────────────────────────
// The monthly sibling of PDH/PDL · 5 Days and PWH/PWL · Weeks. Draws the high & low of each of the last N
// *completed* months (default 3) as FLAT horizontal lines, tagged M-1 … M-N — the CURRENT building month
// is excluded (its range isn't set yet). Optionally include the developing month too. RTH-accurate
// (regular session, so extended-hours prints don't leak the monthly H/L). Optionally colored by ROLE vs
// the current price (green = support below · red = resistance above), faded by age. No confluence, no
// merge — every level stands on its own. Bind on any timeframe; the levels are always the monthly H/L.
// ─────────────────────────────────────────────────────────────────────────────
indicator("PMH/PML · Months", "pmh-pml-mo", overlay = true, max_lines_count = 16, max_labels_count = 16)

// ── inputs ───────────────────────────────────────────────────────────────────
nMonths   = input.int(3, "Prior months (PMH/PML)", minval = 1, maxval = 6, tooltip = "How many COMPLETED months back to draw (M-1 = last month … M-6). The current building month is excluded unless you turn it on below.")
inclThis  = input.bool(false, "Include this month's developing H/L", tooltip = "Also draw the CURRENT month's high & low so far (tagged 'this mo'). Off = completed months only (M-1..M-N).")
roleCol   = input.bool(true, "Color by role vs price", tooltip = "On: a level BELOW price draws green (support), ABOVE draws red (resistance). Off: highs always red, lows always green.")
colHi     = input.color(#EF5350, "High / resistance", inline = "c")
colLo     = input.color(#26A69A, "Low / support",    inline = "c")
wLine     = input.int(2, "Line thickness", minval = 1, maxval = 6)
lineLen   = input.int(200, "Line length (bars back)", minval = 10, maxval = 2000)
tagOff    = input.int(8, "Label offset (bars right)", minval = 0, maxval = 50)
lblSide   = input.string("Right", "Label side", options = ["Left", "Right"])
showLbl   = input.bool(true, "Show labels")
fadeOld   = input.bool(true, "Fade older months")

// ── RTH-accurate monthly H/L for this month + the last 6 months (settled offsets, non-repainting) ──
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[mh0, ml0, mh1, ml1, mh2, ml2, mh3, ml3, mh4, ml4, mh5, ml5, mh6, ml6] = request.security(rthTid, "M", [high, low, high[1], low[1], high[2], low[2], high[3], low[3], high[4], low[4], high[5], low[5], high[6], low[6]], lookahead = barmerge.lookahead_on)

// ── draw (rebuilt on the last bar) ────────────────────────────────────────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()

// draw one flat, role-colored level — each on its own line, no merging
f_draw(float v, string nm, int age, bool isHigh) =>
    if not na(v)
        _base = roleCol ? (v >= close ? colHi : colLo) : (isHigh ? colHi : colLo)
        _fade = fadeOld ? math.min(65, age * 16) : 0        // this mo / M-1 solid, each older month fainter
        _col  = color.new(_base, _fade)
        array.push(_ln, line.new(bar_index - lineLen, v, bar_index + tagOff, v, color = _col, width = wLine, extend = extend.left))
        if showLbl
            _lx = lblSide == "Left" ? bar_index - lineLen : bar_index + tagOff
            _ls = lblSide == "Left" ? label.style_label_right : label.style_label_left
            array.push(_lb, label.new(_lx, v, nm + "  " + str.tostring(v, format.mintick), style = _ls, color = color.new(_base, 82), textcolor = _base, size = size.small))

if barstate.islast
    for x in _ln
        line.delete(x)
    for y in _lb
        label.delete(y)
    array.clear(_ln)
    array.clear(_lb)
    // each in-window monthly H/L, drawn on its own (0 = this month, 1 = M-1 …). All draw regardless of distance.
    _hs = array.from(mh0, mh1, mh2, mh3, mh4, mh5, mh6)
    _ls = array.from(ml0, ml1, ml2, ml3, ml4, ml5, ml6)
    _start = inclThis ? 0 : 1
    for _a = _start to nMonths
        _lab = _a == 0 ? "this mo" : "M-" + str.tostring(_a)
        f_draw(array.get(_hs, _a), "PMH " + _lab, _a, true)
        f_draw(array.get(_ls, _a), "PML " + _lab, _a, false)
