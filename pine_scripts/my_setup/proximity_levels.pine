//@version=5
// =============================================================================
// PROXIMITY LEVELS — SMAs always on · nearest context level above & below always shown
// =============================================================================
// The declutter tool. EVERYTHING is a FLAT horizontal line (green = SUPPORT / price above,
// red = RESISTANCE / price below), labeled. Your 20/50/100/200 SMAs + 50/100/200 EMAs
// (daily-locked, flat) are always drawn — the decision core.
//
// For the CONTEXT levels (prior week / month / quarter H/L/C + the weekly Fair-Value basis),
// two rules — so you always know the bracket price is trading in, yet the chart stays clean:
//   1. ALWAYS show the NEAREST context level ABOVE price and the NEAREST BELOW (the bracket) —
//      even if far (a 20% gap-down still shows PML above / PQ-Low below, the RDDT case).
//   2. ALSO show any context level within a proximity band (default ±1.5%) — catches clusters.
// The Smart Money zone (golden pocket of the weekly swing) shows its shaded band + edges ONLY
// when price is INSIDE it or within the band — hidden when price is far away, same idea.
// CONFLUENCE: any levels stacked within ±0.4% (tunable) merge into ONE thicker line whose label
// lists all members + a ·×N count (e.g. "50 SMA + 50 EMA ·×2") — so a wall reads at a glance.
// DAY OPEN: the open is marked (dotted line) and the level it opened ABOVE (today's support) /
// opened BELOW (today's resistance) is tagged — the open sets each level's role for the session.
// No alerts — purely visual. Bind on the DAILY chart.
indicator("Proximity Levels", "Prox Levels", overlay = true, max_lines_count = 40, max_labels_count = 40, max_boxes_count = 4)

// ── proximity band (extra clusters near price) ─────────────────────────────────
gN      = "Proximity"
nearPct = input.float(1.5, "Also show context levels within ± % of price", group = gN, minval = 0.1, maxval = 10, step = 0.1) / 100.0
confPct = input.float(0.4, "Confluence — merge levels within ± % into one", group = gN, minval = 0.05, maxval = 3, step = 0.05) / 100.0

// ── SMAs — ALWAYS on (your decision core), drawn FLAT ──────────────────────────
gS    = "SMAs (always on)"
en20  = input.bool(true, "20 SMA",  group = gS, inline = "a")
en50  = input.bool(true, "50 SMA",  group = gS, inline = "a")
en100 = input.bool(true, "100 SMA", group = gS, inline = "b")
en200 = input.bool(true, "200 SMA", group = gS, inline = "b")
smaTf = input.timeframe("D", "SMA/EMA lock timeframe (flat)", group = gS, tooltip = "The SMAs/EMAs use this timeframe's value, drawn FLAT — so bind on the daily (or intraday) and still see the DAILY MAs.")

// ── EMAs — always on, drawn FLAT (50/100/200) ──────────────────────────────────
gE     = "EMAs (always on)"
en50e  = input.bool(true, "50 EMA",  group = gE, inline = "e")
en100e = input.bool(true, "100 EMA", group = gE, inline = "e")
en200e = input.bool(true, "200 EMA", group = gE, inline = "e")

// ── context levels — nearest above & below always shown; more within the band ──
gC   = "Context levels (nearest above & below always show)"
enPW = input.bool(true, "Weekly — PWH / PWL",         group = gC)
enPM = input.bool(true, "Monthly — PMH / PML",        group = gC)
enPQ = input.bool(true, "Quarter — PQH / PQL / PQC",  group = gC)
enFV = input.bool(true, "Fair Value (33-SMA OHLC4, weekly)", group = gC)

// ── Smart Money zone — shows only when price is inside/near the zone ────────────
gZ    = "Smart Money zone (shows when price is inside/near)"
enSMZ = input.bool(true, "Smart Money zone (golden pocket, weekly)", group = gZ)
smzLb = input.int(40, "Recent swing window (weekly bars)", group = gZ, minval = 5, maxval = 500)
fInsT = input.float(0.618, "Institutional top",             group = gZ, step = 0.001)
fInsB = input.float(0.786, "Institutional bottom / SM top", group = gZ, step = 0.001)
fSmB  = input.float(0.85,  "Smart Money bottom",            group = gZ, step = 0.001)
colInst = input.color(color.new(color.blue,   85), "Institutional fill", group = gZ)
colSm   = input.color(color.new(color.purple, 72), "Smart Money fill",   group = gZ)

// ── style ──────────────────────────────────────────────────────────────────────
gV     = "Style"
supCol = input.color(#26A69A, "Support (price above)",    group = gV)
resCol = input.color(#EF5350, "Resistance (price below)", group = gV)
wLine  = input.int(2,  "Line width", group = gV, minval = 1, maxval = 5)
lineLen= input.int(80, "Line length (bars back)", group = gV, minval = 10, maxval = 500)

// ── day open — mark it + tag the level it opened above (day support) / below (day resistance)
gO      = "Day open"
enOpen  = input.bool(true, "Mark the day's open + tag the levels it bracketed", group = gO, tooltip = "Where price OPENED sets each level's role for the day: the nearest level BELOW the open = today's SUPPORT (opened above it), the nearest ABOVE = today's RESISTANCE (opened below it).")
openCol = input.color(color.new(#EAB308, 0), "Open line", group = gO)

// ── values (settled [1], non-repainting) ───────────────────────────────────────
tid = syminfo.tickerid
f_sec(string tf, float expr) => request.security(tid, tf, expr, lookahead = barmerge.lookahead_on)
sma20  = f_sec(smaTf, ta.sma(close, 20)[1])
sma50  = f_sec(smaTf, ta.sma(close, 50)[1])
sma100 = f_sec(smaTf, ta.sma(close, 100)[1])
sma200 = f_sec(smaTf, ta.sma(close, 200)[1])
ema50  = f_sec(smaTf, ta.ema(close, 50)[1])
ema100 = f_sec(smaTf, ta.ema(close, 100)[1])
ema200 = f_sec(smaTf, ta.ema(close, 200)[1])
pwh = f_sec("W",  high[1])
pwl = f_sec("W",  low[1])
pmh = f_sec("M",  high[1])
pml = f_sec("M",  low[1])
pqh = f_sec("3M", high[1])
pql = f_sec("3M", low[1])
pqc = f_sec("3M", close[1])
fv  = f_sec("W",  ta.sma(ohlc4, 33)[1])
// prior-day H/L — RTH-accurate (regular-session ticker so extended-hours prints don't leak)
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
pdh = request.security(rthTid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(rthTid, "D", low[1],  lookahead = barmerge.lookahead_on)
// Smart Money zone edges — golden pocket of the recent weekly swing (GP-Auto formula)
smzHi   = f_sec("W", ta.highest(high, smzLb)[1])
smzLo   = f_sec("W", ta.lowest(low,  smzLb)[1])
smzRng  = smzHi - smzLo
instTop = smzHi - fInsT * smzRng
instBot = smzHi - fInsB * smzRng
smzBot  = smzHi - fSmB  * smzRng
dayOpen = request.security(tid, "D", open, lookahead = barmerge.lookahead_on)

// ── collection + flat-line drawing (with confluence clustering) ─────────────────
var line[]   _ln = array.new_line()
var label[]  _lb = array.new_label()
var float[]  _cv = array.new_float()   // context candidates (for the nearest-above/below bracket)
var string[] _cn = array.new_string()
var float[]  _dv = array.new_float()   // EVERYTHING that will be drawn (SMAs/EMAs/context/SMZ edges)
var string[] _dn = array.new_string()
var box _iBox = na
var box _sBox = na
f_draw(float lvl, string nm, int w) =>
    sup = close > lvl
    col = sup ? supCol : resCol
    array.push(_ln, line.new(bar_index - lineLen, lvl, bar_index + 8, lvl, color = col, width = w))
    array.push(_lb, label.new(bar_index + 8, lvl, nm + (sup ? "  ▲ " : "  ▼ ") + str.tostring(lvl, format.mintick), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
f_cand(float v, string nm, bool show) =>
    if show and not na(v) and v > 0
        array.push(_cv, v)
        array.push(_cn, nm)
f_add(float v, string nm, bool show) =>
    if show and not na(v) and v > 0
        array.push(_dv, v)
        array.push(_dn, nm)

if barstate.islast
    for _l in _ln
        line.delete(_l)
    for _b in _lb
        label.delete(_b)
    array.clear(_ln)
    array.clear(_lb)
    array.clear(_cv)
    array.clear(_cn)
    array.clear(_dv)
    array.clear(_dn)
    // SMAs + EMAs — always in the draw set
    f_add(sma20,  "20 SMA",  en20)
    f_add(sma50,  "50 SMA",  en50)
    f_add(sma100, "100 SMA", en100)
    f_add(sma200, "200 SMA", en200)
    f_add(ema50,  "50 EMA",  en50e)
    f_add(ema100, "100 EMA", en100e)
    f_add(ema200, "200 EMA", en200e)
    // context candidates (for bracket calc)
    f_cand(pwh, "PWH", enPW)
    f_cand(pwl, "PWL", enPW)
    f_cand(pmh, "PMH", enPM)
    f_cand(pml, "PML", enPM)
    f_cand(pqh, "PQH", enPQ)
    f_cand(pql, "PQL", enPQ)
    f_cand(pqc, "PQC", enPQ)
    f_cand(fv,  "FV 33", enFV)
    // nearest context ABOVE & BELOW price (the always-show bracket)
    naV = 1.0e18
    nbV = -1.0
    if array.size(_cv) > 0
        for _i = 0 to array.size(_cv) - 1
            v = array.get(_cv, _i)
            if v > close and v < naV
                naV := v
            if v < close and v > nbV
                nbV := v
    // add qualifying context (immediate bracket, or within the band) to the draw set
    if array.size(_cv) > 0
        for _i = 0 to array.size(_cv) - 1
            v = array.get(_cv, _i)
            if math.abs(close - v) / close <= nearPct or v == naV or v == nbV
                f_add(v, array.get(_cn, _i), true)
    // Smart Money zone — shaded band + edges, ONLY when price is inside/near it
    box.delete(_iBox)
    box.delete(_sBox)
    smzOk = enSMZ and not na(instTop) and not na(smzBot) and instTop > smzBot
    smzNear = smzOk and close >= smzBot * (1 - nearPct) and close <= instTop * (1 + nearPct)
    if smzNear
        _iBox := box.new(bar_index - lineLen, math.max(instTop, instBot), bar_index + 8, math.min(instTop, instBot), border_color = color.new(color.blue, 55), bgcolor = colInst)
        _sBox := box.new(bar_index - lineLen, math.max(instBot, smzBot),  bar_index + 8, math.min(instBot, smzBot),  border_color = color.new(color.purple, 55), bgcolor = colSm)
        f_add(instTop, "Inst top", true)
        f_add(instBot, "Inst bot", true)
        f_add(smzBot,  "SM bot",   true)
    // day-open bracket — the drawn level nearest BELOW the open (day support) & nearest ABOVE (day resist)
    oSupV = -1.0
    oResV = 1.0e18
    if enOpen and not na(dayOpen) and array.size(_dv) > 0
        for _i = 0 to array.size(_dv) - 1
            v = array.get(_dv, _i)
            if v < dayOpen and v > oSupV
                oSupV := v
            if v > dayOpen and v < oResV
                oResV := v
    // the day's open — a dotted neutral line. Its label also flags the open vs YESTERDAY's range:
    // opened ABOVE PDH = strong (gap over the range), BELOW PDL = weak (gap under it), else neutral.
    if enOpen and not na(dayOpen)
        _openCtx = not na(pdh) and dayOpen > pdh ? "  · above PDH ▲ (strong)" : not na(pdl) and dayOpen < pdl ? "  · below PDL ▼ (weak)" : (not na(pdh) and not na(pdl) ? "  · inside PDH–PDL" : "")
        array.push(_ln, line.new(bar_index - lineLen, dayOpen, bar_index + 8, dayOpen, color = openCol, width = 1, style = line.style_dotted))
        array.push(_lb, label.new(bar_index + 8, dayOpen, "Open " + str.tostring(dayOpen, format.mintick) + _openCtx, style = label.style_label_left, color = color.new(openCol, 15), textcolor = color.black, size = size.small))
    // ── CONFLUENCE — group levels within confPct into ONE thicker line, label lists all members
    if array.size(_dv) > 0
        _used = array.new_bool(array.size(_dv), false)
        for _i = 0 to array.size(_dv) - 1
            if not array.get(_used, _i)
                vi   = array.get(_dv, _i)
                nm   = array.get(_dn, _i)
                sumv = vi
                cnt  = 1
                isOS = vi == oSupV
                isOR = vi == oResV
                array.set(_used, _i, true)
                if _i < array.size(_dv) - 1
                    for _j = _i + 1 to array.size(_dv) - 1
                        if not array.get(_used, _j) and math.abs(array.get(_dv, _j) - vi) / vi <= confPct
                            nm   := nm + " + " + array.get(_dn, _j)
                            sumv := sumv + array.get(_dv, _j)
                            cnt  := cnt + 1
                            isOS := isOS or array.get(_dv, _j) == oSupV
                            isOR := isOR or array.get(_dv, _j) == oResV
                            array.set(_used, _j, true)
                base = cnt > 1 ? nm + "  ·×" + str.tostring(cnt) : nm
                tag  = isOS ? "  ⊙ opened ABOVE (day support)" : isOR ? "  ⊙ opened BELOW (day resist)" : ""
                f_draw(sumv / cnt, base + tag, isOS or isOR or cnt > 1 ? wLine + 2 : wLine)
