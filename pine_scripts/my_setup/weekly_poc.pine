//@version=5
// =============================================================================
// VOLUME PROFILE · POC — mirrors THT "Volume Pro" (bars-back model)
// =============================================================================
// A single flat line at the POC (Point of Control) — the price bucket where the most volume
// has traded over the last N bars of the CURRENT chart timeframe (THT's "Bars Back" model).
// BIND ON THE WEEKLY CHART for a weekly POC.
//
// THE WINDOW IS EVERYTHING. A POC is only as useful as its lookback:
//   • RECENT window (~26–52 bars, DEFAULT) → the CURRENT battleground's fair value, near price →
//     ACTIONABLE as a trade level. This is what you usually want.
//   • LONG window (150+ bars) → the ALL-TIME volume wall, which is often FAR from price (e.g. NVDA's
//     ~50 accumulation while price is 200) → context only, not a trade level. Set 150 to MATCH THT's
//     default (which lands on that far-out all-time POC — by design, not a bug in either tool).
// Volume is spread uniformly across each bar's high–low (the standard profile method).
indicator("Volume Profile · POC", "POC", overlay = true, max_lines_count = 6, max_labels_count = 6)

barsBack = input.int(52, "Bars Back (per current timeframe)", minval = 10, maxval = 1000, tooltip = "Bars of THIS chart's TF in the profile. On the WEEKLY: 26 = ~6mo (tightest, nearest price), 52 = ~1yr (recent battleground — DEFAULT), 150 = THT's default (all-time POC, usually far out).")
rows     = input.int(35,  "Rows (= THT 'Columns')", minval = 10, maxval = 300, tooltip = "Price buckets — set equal to THT's 'Columns' (default 35) so the POC lands in the same bucket.")
showVol  = input.bool(true,  "Show the POC's volume on the label (e.g. '1.2B · 18%')")
showVA   = input.bool(false, "Also draw the Value Area (VAH / VAL)")
vaPct    = input.float(70, "Value Area %", minval = 50, maxval = 95) / 100.0
pocCol   = input.color(#EF5350, "POC color")
vaCol    = input.color(color.new(#FF9800, 40), "Value Area color")
wLine    = input.int(2,  "POC line width", minval = 1, maxval = 5)
lineLen  = input.int(150, "Line length (bars back)", minval = 10, maxval = 1000)

// compact volume formatter (1_234_000_000 → "1.23B", 457_000_000 → "457M")
f_vol(float v) => v >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : v >= 1e6 ? str.tostring(v / 1e6, "#.#") + "M" : v >= 1e3 ? str.tostring(v / 1e3, "#") + "K" : str.tostring(v, "#")

var line  pocLn = na
var label pocLb = na
var line  vahLn = na
var line  valLn = na

if barstate.islast
    hh = ta.highest(high, barsBack)
    ll = ta.lowest(low, barsBack)
    if not na(hh) and not na(ll) and hh > ll
        step = (hh - ll) / rows
        vp = array.new_float(rows, 0.0)
        // spread each bar's volume uniformly across the rows its high–low spans
        for i = 0 to barsBack - 1
            bh = high[i]
            bl = low[i]
            bv = volume[i]
            if not na(bv) and bv > 0 and not na(bh) and not na(bl)
                rng = bh - bl
                if rng > 0
                    for r = 0 to rows - 1
                        rlo = ll + r * step
                        rhi = rlo + step
                        ov = math.min(bh, rhi) - math.max(bl, rlo)
                        if ov > 0
                            array.set(vp, r, array.get(vp, r) + bv * ov / rng)
                else
                    _r = int(math.max(0, math.min(rows - 1, math.floor((bl - ll) / step))))
                    array.set(vp, _r, array.get(vp, _r) + bv)
        // POC = the fattest row
        pocR = 0
        pocV = array.get(vp, 0)
        for r = 1 to rows - 1
            if array.get(vp, r) > pocV
                pocV := array.get(vp, r)
                pocR := r
        poc = ll + (pocR + 0.5) * step
        _ptot  = array.sum(vp)
        _pvtxt = showVol and _ptot > 0 ? "  ·  " + f_vol(pocV) + " · " + str.tostring(pocV / _ptot * 100, "#") + "%" : ""
        line.delete(pocLn)
        label.delete(pocLb)
        pocLn := line.new(bar_index - lineLen, poc, bar_index + 6, poc, color = pocCol, width = wLine)
        pocLb := label.new(bar_index + 6, poc, "POC  " + str.tostring(poc, format.mintick) + _pvtxt, style = label.style_label_left, color = color.new(pocCol, 20), textcolor = color.white, size = size.small)
        // Value Area — expand out from the POC (toward the fatter neighbor) to vaPct of volume
        line.delete(vahLn)
        line.delete(valLn)
        if showVA
            total = array.sum(vp)
            acc = pocV
            lo = pocR
            hi = pocR
            target = total * vaPct
            while acc < target and (lo > 0 or hi < rows - 1)
                vLo = lo > 0 ? array.get(vp, lo - 1) : -1.0
                vHi = hi < rows - 1 ? array.get(vp, hi + 1) : -1.0
                if hi < rows - 1 and vHi >= vLo
                    hi := hi + 1
                    acc := acc + array.get(vp, hi)
                else if lo > 0
                    lo := lo - 1
                    acc := acc + array.get(vp, lo)
                else if hi < rows - 1
                    hi := hi + 1
                    acc := acc + array.get(vp, hi)
            vah = ll + (hi + 1) * step
            val = ll + lo * step
            vahLn := line.new(bar_index - lineLen, vah, bar_index + 6, vah, color = vaCol, width = 1, style = line.style_dashed)
            valLn := line.new(bar_index - lineLen, val, bar_index + 6, val, color = vaCol, width = 1, style = line.style_dashed)
