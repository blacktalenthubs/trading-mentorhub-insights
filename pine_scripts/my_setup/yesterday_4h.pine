//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// DAY-TRADE SIGNALS (was "Yesterday 4H") — the 4h levels a day trade is fought over. Yesterday's
// completed 4h candles
// as flat H/L lines (green = support / price above, red = resistance / price below),
// each tagged by its start time (e.g. "4H 09:30 H"). Nothing else — no PDH/PDL, no
// confluence, no alerts. Non-repainting (240 settled [1] + lookahead). Bind on any intraday TF.
// ─────────────────────────────────────────────────────────────────────────────
indicator("day-trade-signals", "day-trade", overlay = true, max_lines_count = 40, max_labels_count = 100, max_boxes_count = 20)

colHi   = input.color(#EF5350, "Resistance (above price)", inline = "c")
colLo   = input.color(#26A69A, "Support (below price)",   inline = "c")
wLine   = input.int(3,  "Line thickness", minval = 1, maxval = 6)
lineLen = input.int(60, "Line length (bars back)", minval = 10, maxval = 500)
tagOff  = input.int(6,  "Label offset (bars right)", minval = 0, maxval = 50)
showLbl = input.bool(true, "Show labels")
showPx  = input.bool(true, "Show the price on level tags", tooltip = "Appends the level's own price to its tag — 4h levels, structural levels, the first-4h close and the MAs. The ROLE still leads (▲ SUPPORT / ▼ RESISTANCE); the figure comes after it, so the word is still what registers first.")
lblGap  = input.float(0.4, "Stagger labels closer than ± % (so confluent lines don't overlap)", minval = 0.05, maxval = 5, step = 0.05) / 100.0
lblStep = input.int(3, "Label stagger step (bars per collision)", minval = 1, maxval = 40)
// ── higher-low structure across consecutive 4h candles ──────────────────────────
gHL     = "4h higher-low structure"
enHL    = input.bool(true, "Number the higher-low sequence on the candle tails", group = gHL, tooltip = "The sequence is yesterday's selected 4h candles followed by TODAY's first 4h once it closes — the frame the day is actually traded in. Each candle holding a higher low continues the count (1, 2, 3); one that undercuts the prior low BREAKS it and gets ✕, and the next higher low restarts at 1. On equities that's a 3-candle read: two from yesterday plus today's first.")
hlUpCol = input.color(color.new(#26A69A, 0), "Streak", inline = "hl", group = gHL)
hlXCol  = input.color(color.new(#EF5350, 0), "Break",  inline = "hl", group = gHL)
// How much of yesterday to carry forward. Set PER MARKET TYPE, because "yesterday" isn't the same
// length: equity RTH holds two completed 4h candles, a 24h market holds six. One shared number would
// either starve stocks or flood crypto, and you'd be editing it every time you switched symbol.
maxC4hEq = input.int(2, "Equity (RTH) — 4h candles to use", minval = 1, maxval = 2, group = "4h candles", tooltip = "RTH only contains two completed 4h candles, so 2 = all of them = 4 lines.")
enToday  = input.bool(false, "TODAY's first 4h — HIGH + LOW", group = "4h candles", tooltip = "The moment the current session's first 4h candle CLOSES, its high and low join the chart. Yesterday's levels say where price came from; today's first 4h says what this session has actually built so far — and it's the level the rest of the day trades against. Nothing is drawn until that candle closes.")
enT1C    = input.bool(true, "TODAY's first 4h — CLOSE (strength line)", group = "4h candles", tooltip = "Where the session's opening battle actually SETTLED, not merely where it traded. Holding above it says buyers kept what they took; losing it says the move failed and the first 4h H/L become a range instead. Tagged ▲ held / ▼ lost so the verdict reads without comparing prices.")
t1cW     = input.int(2, "  CLOSE line thickness", minval = 1, maxval = 6, group = "4h candles")
t1BarCol = input.color(color.new(#EAB308, 0), "  Print-bar tag colour", group = "4h candles", tooltip = "Solid by default so the tag reads at a glance. Amber keeps it distinct from the green/red support-resistance tags — this one marks a MOMENT, not a level.")
enT1Bar  = input.bool(true, "  Tag the bar that PRINTED that close", group = "4h candles", tooltip = "Marks the last chart candle of that 4h block — on a 30m chart, the 30m candle whose close IS the 4h close. Lets you see exactly which candle set the level instead of inferring it from the clock.")
maxC4hCr = input.int(3, "24h market (crypto) — 4h candles to use", minval = 1, maxval = 6, group = "4h candles", tooltip = "A 24h day holds SIX 4h candles. All six is 12 lines and 11 cells — noise. 3 keeps the newest 12 hours of yesterday = 6 lines, matching the weight stocks get from their 4.")
enOpen  = input.bool(true, "Mark today's open (subtle) + tag it vs prior-day PDH/PDL", group = "Day open")
openCol = input.color(color.new(#EAB308, 0), "Open line", group = "Day open")
enPdl   = input.bool(true, "Show prior-day LOW as the STOP line (Redler)", group = "Risk — PDL stop (Redler)", tooltip = "Scott Redler's risk rule: yesterday's low (PDL) is the line in the sand — never hold a long that closes below it. Drawn as a subtle dashed line with a STOP note.")
pdlCol  = input.color(color.new(#EF5350, 25), "PDL stop line", group = "Risk — PDL stop (Redler)")
enPdc   = input.bool(true, "Show yesterday's CLOSE (subtle dotted line)", group = "Prior close")
pdcCol  = input.color(color.new(#787B86, 0), "Yesterday close line", group = "Prior close")
enConf  = input.bool(true, "Tag a 4h level when it lines up with PDH/PDL or a W/M/Q level", group = "Confluence", tooltip = "If a 4h high/low sits within the band % of a prior-day/week/month/quarter high or low, that level's name is appended to the 4h label and the line is drawn a touch bolder. The HTF levels themselves are NEVER drawn (computed only) so they can't compress the scale.")
confPct = input.float(0.15, "Confluence band (%)", group = "Confluence", minval = 0.02, maxval = 2, step = 0.01) / 100.0
lvlMergePct = input.float(0.10, "Collapse 4h levels within (%) — merge near-equal H/L into one line", group = "Confluence", minval = 0.0, maxval = 2, step = 0.01, tooltip = "When two 4h levels (e.g. a 4h high and a 4h low) sit within this % of each other, they collapse into ONE line whose label names both (e.g. '4H 09:30 H + 4H 13:30 L ·×2'). Keeps the chart clean when levels stack. 0 = draw every 4h level separately.") / 100.0
// ── structural levels (PDH/PDL · PWH/PWL · PMH/PML · PQH/PQL) — own proximity bracket ──
// These were computed for confluence TAGGING only and never drawn. Now they draw as flat
// role-coloured lines with their OWN nearest-N counts, independent of the MA bracket — the
// 4h lines are the trade, MAs are context, and these are the higher-timeframe walls; each
// deserves its own budget rather than competing for one shared set of slots.
gLv     = "Structural levels (PDH/PWH/PMH/PQH…)"
enLvls  = input.bool(true, "Draw the structural levels", group = gLv)
lvlUp   = input.int(2, "How many LEVELS above price", minval = 0, maxval = 8, group = gLv, tooltip = "The N nearest structural levels above price. Separate from the MA counts — a wall of HTF levels and a wall of MAs are different information and shouldn't crowd each other out.")
lvlDn   = input.int(2, "How many LEVELS below price", minval = 0, maxval = 8, group = gLv)
lvlW    = input.int(2, "Level line thickness", minval = 1, maxval = 6, group = gLv)
lvlFade = input.int(25, "Level fade (higher = fainter)", minval = 0, maxval = 95, group = gLv)
enPDHl  = input.bool(true, "PDH", inline = "l1", group = gLv)
enPWl   = input.bool(true, "PWH/PWL", inline = "l1", group = gLv)
enPMl   = input.bool(true, "PMH/PML", inline = "l1", group = gLv)
enPQl   = input.bool(false, "PQH/PQL", inline = "l1", group = gLv)

// ── auto SMA/EMA — drawn as FLAT role-colored levels (house style, never sloping), proximity-gated + merged ──
gSma  = "Auto MAs (flat levels)"
enSma = input.bool(true, "Show MAs as flat levels", group = gSma, tooltip = "Each MA is drawn as a FLAT horizontal line at its CURRENT value (green = below price / support, red = above price / resistance) — a level to react to, not a sloping plot. Proximity-gated + merged so the chart stays clean.")
smaTf = input.timeframe("D", "MA timeframe", group = gSma, tooltip = "Which timeframe's MAs to plot (default Daily = the structural 8/20/50/100/200-day MAs). Set to blank for the chart's own timeframe.")
maUp  = input.int(2, "How many MAs to show ABOVE price", minval = 0, maxval = 8, group = gSma, tooltip = "The N nearest MAs above current price. A count, not a %, so every symbol shows the same-size set — 5% is $50 on a $1000 stock and $1.50 on a $30 one. 0 = none above.")
maDn  = input.int(2, "How many MAs to show BELOW price", minval = 0, maxval = 8, group = gSma, tooltip = "The N nearest MAs below current price. The 4h H/L lines are NEVER affected by this — they always draw.")
maCapPct = input.float(0, "  Optional cap — hide anything farther than ± % (0 = off)", minval = 0, maxval = 30, step = 0.5, group = gSma) / 100.0
maW     = input.int(1, "MA line thickness", minval = 1, maxval = 6, group = gSma, tooltip = "Independent of the 4h H/L thickness above — keep the MAs thinner so they sit UNDER the 4h levels rather than competing with them.")
maFade  = input.int(55, "MA fade (higher = fainter)", minval = 0, maxval = 95, group = gSma, tooltip = "Transparency of the MA lines. 0 = solid colour, 95 = barely there. The MAs are context; the 4h levels are the trade.")
maStyle = input.string("dashed", "MA line style", options = ["dashed", "dotted", "solid"], group = gSma)
maMergePct = input.float(0.20, "Merge MAs within (%)", minval = 0.0, maxval = 2, step = 0.05, group = gSma, tooltip = "MAs sitting within this % of each other collapse into ONE line that NAMES all of them (e.g. '50 SMA · 200 EMA') — fewer lines, no lost identities. An MA that lines up with a yesterday-4h level is folded into that level's label instead of drawing a duplicate. 0 = draw every MA separately.") / 100.0
en8    = input.bool(true, "8 SMA",   inline = "s1", group = gSma)
en20   = input.bool(true, "20 SMA",  inline = "s1", group = gSma)
en50   = input.bool(true, "50 SMA",  inline = "s2", group = gSma)
en100  = input.bool(true, "100 SMA", inline = "s2", group = gSma)
en200  = input.bool(true, "200 SMA", inline = "s2", group = gSma)
en8e   = input.bool(true, "8 EMA",   inline = "s3", group = gSma)
en20e  = input.bool(true, "20 EMA",  inline = "s3", group = gSma)
en50e  = input.bool(true, "50 EMA",  inline = "s3", group = gSma)
en100e = input.bool(true, "100 EMA", inline = "s3", group = gSma)
en200e = input.bool(true, "200 EMA", inline = "s3", group = gSma)

// ── regular-session ticker so extended-hours prints NEVER leak into the 4h / daily levels ──
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)

// ── last completed 4h candle: H / L / open-time — RTH-only (settled [1] + lookahead → non-repainting) ──
[h4, l4, c4, t4] = request.security(rthTid, "240", [high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
f_dnum(int t) => na(t) ? int(na) : year(t) * 10000 + month(t) * 100 + dayofmonth(t)

// ── today's RTH open + prior-day H/L ──
[pdh, pdl] = request.security(rthTid, "D",  [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(rthTid, "W",  [high[1], low[1]], lookahead = barmerge.lookahead_on)   // for confluence TAGGING only — never drawn
[pmh, pml] = request.security(rthTid, "M",  [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pqh, pql] = request.security(rthTid, "3M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
// lookahead_OFF for the open — it is known at the session's first tick, so there is nothing to
// wait for. lookahead_on would hand back the enclosing daily bar's open on bars that precede it,
// which lands the line on a neighbouring session's open. Settled values (high[1], low[1]) still
// use lookahead_on: those bars are already closed. Same idiom as active/ma_ema_daily.pine.
dayOpen = request.security(rthTid, "D", open, lookahead = barmerge.lookahead_off)
pdc = request.security(rthTid, "D", close[1], lookahead = barmerge.lookahead_on)   // yesterday's CLOSE
// current SMA values from the chosen timeframe (lookahead off → live developing value on the realtime bar, no future leak)
sma8v   = enSma and en8   ? request.security(rthTid, smaTf, ta.sma(close, 8),   lookahead = barmerge.lookahead_off) : na
sma20v  = enSma and en20  ? request.security(rthTid, smaTf, ta.sma(close, 20),  lookahead = barmerge.lookahead_off) : na
sma50v  = enSma and en50  ? request.security(rthTid, smaTf, ta.sma(close, 50),  lookahead = barmerge.lookahead_off) : na
sma100v = enSma and en100 ? request.security(rthTid, smaTf, ta.sma(close, 100), lookahead = barmerge.lookahead_off) : na
sma200v = enSma and en200 ? request.security(rthTid, smaTf, ta.sma(close, 200), lookahead = barmerge.lookahead_off) : na
ema8v   = enSma and en8e   ? request.security(rthTid, smaTf, ta.ema(close, 8),   lookahead = barmerge.lookahead_off) : na
ema20v  = enSma and en20e  ? request.security(rthTid, smaTf, ta.ema(close, 20),  lookahead = barmerge.lookahead_off) : na
ema50v  = enSma and en50e  ? request.security(rthTid, smaTf, ta.ema(close, 50),  lookahead = barmerge.lookahead_off) : na
ema100v = enSma and en100e ? request.security(rthTid, smaTf, ta.ema(close, 100), lookahead = barmerge.lookahead_off) : na
ema200v = enSma and en200e ? request.security(rthTid, smaTf, ta.ema(close, 200), lookahead = barmerge.lookahead_off) : na
// which prior day/week/month/quarter level(s) — and which MA — a 4h level lines up with (within confPct) → the tag
// (f_maTag / f_conf removed 2026-08-26 — replaced by nearest-OWNER confluence assignment
//  in the draw block: testing each level independently let one MA be claimed by two
//  levels whose spacing was tighter than the confluence band.)
// ── forward-accumulate every DISTINCT completed 4h candle (H, L, open-time), keyed on t4 ───────
var float[] aH = array.new_float()
var float[] aL = array.new_float()
var int[]   aT = array.new_int()
var int[]   aB = array.new_int()     // bar_index of the LAST chart bar inside each 4h block
// TODAY's first completed 4h candle — captured the moment it lands, cleared at each new session.
// Yesterday's set answers "where did price come from"; this answers "what has today built".
var float t1H = na
var float t1L = na
var float t1C = na
var int   t1T = na
var int   t1B = na   // bar_index of the LAST chart candle inside that 4h block
if ta.change(time("D")) != 0
    t1H := na
    t1L := na
    t1C := na
    t1T := na
    t1B := na
if not na(h4) and not na(l4) and not na(t4)
    _push = array.size(aT) == 0
    if not _push
        _push := array.get(aT, array.size(aT) - 1) != t4
    if _push and na(t1H) and f_dnum(t4) == f_dnum(time)
        t1H := h4
        t1L := l4
        t1C := c4
        t1T := t4
        // the settled 4h value lands on the FIRST bar of the next block, so the candle that actually
        // printed this close is the one before it
        t1B := bar_index - 1
    if _push
        array.push(aH, h4)
        array.push(aL, l4)
        array.push(aT, t4)
        array.push(aB, bar_index - 1)     // the settled value lands on the next block's first bar
        if array.size(aT) > 40
            array.shift(aH)
            array.shift(aL)
            array.shift(aT)
            array.shift(aB)

// ── YESTERDAY's COMPLETE 4h set, rebuilt once per day and frozen. On equity RTH that's the two
//    completed 4h candles (4 levels). On a 24h market like BTC it's all SIX (12 levels) — the
//    consumers below must never assume two, or crypto silently reads only the last 8 hours.
_isEqSym = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
maxC4h   = _isEqSym ? maxC4hEq : maxC4hCr   // 2 candles / 4 lines on stocks · 3 candles / 6 lines on crypto
var float[]  yV = array.new_float()
var string[] yN = array.new_string()
var float[]  yCL = array.new_float()   // per-CANDLE lows of the selected set (chronological)
var int[]    yCB = array.new_int()     // ...and the chart bar each one printed on
var bool[]   yBrk = array.new_bool()   // ...and whether TODAY has closed below it (structure broken)
var bool     t1Brk = false             // same, for today's own first 4h low
_newDayY = ta.change(time("D")) != 0
if _newDayY or array.size(yV) == 0
    array.clear(yV)
    array.clear(yN)
    array.clear(yCL)
    array.clear(yCB)
    array.clear(yBrk)
    _todayY = f_dnum(time)
    int _ydayY = 0
    if array.size(aT) > 0
        for _yi = 0 to array.size(aT) - 1
            _dY = f_dnum(array.get(aT, _yi))
            if _dY < _todayY and _dY > _ydayY
                _ydayY := _dY
        if _ydayY > 0
            // collect yesterday's candle indices in order, then keep only the NEWEST maxC4h of them —
            // the ones price just came from. Six 4h candles is 12 levels and 11 cells; that reads as
            // noise, not structure.
            _idx = array.new_int()
            for _yi = 0 to array.size(aT) - 1
                if f_dnum(array.get(aT, _yi)) == _ydayY
                    array.push(_idx, _yi)
            _start = math.max(0, array.size(_idx) - maxC4h)
            if array.size(_idx) > 0
                // numbered by RECENCY, newest = 1. A clock time ("4H 09:30 H") is detail you can't
                // act on; how recent the candle is, is exactly what you weigh. Matches the naming
                // the fourh_* alert payloads already use.
                _lastK = array.size(_idx) - 1
                for _k = _start to _lastK
                    _ii  = array.get(_idx, _k)
                    _age = str.tostring(_lastK - _k + 1)
                    array.push(yV, array.get(aH, _ii))
                    array.push(yN, "4H-" + _age + " H")
                    array.push(yV, array.get(aL, _ii))
                    array.push(yN, "4H-" + _age + " L")
                    array.push(yCL, array.get(aL, _ii))
                    array.push(yCB, array.get(aB, _ii))
                    array.push(yBrk, false)

// ── LIVE structure state — the 4h low LINES are the structure. It holds while price stays above
//    them; a confirmed close below one breaks THAT low for the rest of the session (a later wick
//    back over it doesn't un-break it — the close already happened).
if ta.change(time("D")) != 0
    t1Brk := false
if barstate.isconfirmed and array.size(yBrk) == array.size(yCL) and array.size(yCL) > 0
    for _bi = 0 to array.size(yCL) - 1
        if not array.get(yBrk, _bi) and close < array.get(yCL, _bi)
            array.set(yBrk, _bi, true)
if barstate.isconfirmed and not na(t1L) and close < t1L
    t1Brk := true

// ── draw (rebuilt on the last bar) ─────────────────────────────────────────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()
var float[] _lblY = array.new_float()   // prices already labeled this bar (confluence stagger)
// push a label RIGHT so it doesn't stack on an already-drawn one at ~the same price
f_xoff(float v) =>
    _c = 0
    if array.size(_lblY) > 0
        for _k = 0 to array.size(_lblY) - 1
            if math.abs(array.get(_lblY, _k) - v) / v <= lblGap
                _c := _c + 1
    array.push(_lblY, v)
    tagOff + math.min(_c, 4) * lblStep   // cap the stagger so a line can't shoot off to the right
// Equal-length lines: left end fixed at bar_index - lineLen (no extend.left), right end at the base
// tagOff — it only extends further right when f_xoff detects a collision (two levels ~same price).
f_draw(float v, string nm, string _tag) =>
    _c   = close > v ? colLo : colHi
    _w   = str.length(_tag) > 0 ? wLine + 1 : wLine    // bolder when it lines up with one
    _xo  = f_xoff(v)
    array.push(_ln, line.new(bar_index - lineLen, v, bar_index + _xo, v, color = _c, width = _w))
    if showLbl
        array.push(_lb, label.new(bar_index + _xo, v, (close > v ? "▲ SUPPORT  " : "▼ RESISTANCE  ") + nm + _tag + (showPx ? "  " + str.tostring(v, format.mintick) : ""), style = label.style_label_left, color = color.new(_c, 82), textcolor = _c, size = size.small))

// one MA as a FLAT role-colored level — subtle dotted so it sits UNDER the 4h H/L, never crowding them.
// The nearest-N gate lives in f_addMa (collection); by here the cluster has already earned its place.
var float _maHi = 1.0e18   // Nth-nearest MA ABOVE price — bracket top
var float _maLo = -1.0     // Nth-nearest MA BELOW price — bracket bottom
f_sma(float v, string nm) =>
    if not na(v) and v > 0
        _c  = close > v ? colLo : colHi
        _xo = f_xoff(v)
        _mst = maStyle == "solid" ? line.style_solid : maStyle == "dotted" ? line.style_dotted : line.style_dashed
        // the LINE ends at the shared base column so every MA is exactly as long as a clean 4h line.
        // Only the LABEL fans right on a price collision — MAs are drawn last, so the fan had been
        // counting every 4h level, the open, PDC and PDL before them and stretching MA lines for
        // reasons that had nothing to do with confluence.
        array.push(_ln, line.new(bar_index - lineLen, v, bar_index + tagOff, v, color = color.new(_c, maFade), width = maW, style = _mst))
        if showLbl
            array.push(_lb, label.new(bar_index + _xo, v, nm + (close > v ? "  ▲ SUPPORT" : "  ▼ RESISTANCE") + (showPx ? "  " + str.tostring(v, format.mintick) : ""), style = label.style_label_left, color = color.new(_c, 88), textcolor = _c, size = size.small))

// ── MA merge machinery ──────────────────────────────────────────────────────────
var float[]  _anchors = array.new_float()   // yesterday-4h level prices — MAs on one of these fold into it, no redraw
var float[]  _maV     = array.new_float()   // MA values collected for the merge pass
var string[] _maN     = array.new_string()  // parallel MA names
// queue an MA for merging — only if in-proximity AND not already sitting on a 4h level (that one's folded via f_maTag)
f_addMa(float v, string nm) =>
    if not na(v) and v > 0 and v <= _maHi and v >= _maLo and (maCapPct <= 0 or math.abs(close - v) / close <= maCapPct)
        _onAnchor = false
        if array.size(_anchors) > 0
            for _ai = 0 to array.size(_anchors) - 1
                if math.abs(array.get(_anchors, _ai) - v) / v <= confPct
                    _onAnchor := true
        if not _onAnchor
            array.push(_maV, v)
            array.push(_maN, nm)

if barstate.islast
    for x in _ln
        line.delete(x)
    for y in _lb
        label.delete(y)
    array.clear(_ln)
    array.clear(_lb)
    array.clear(_lblY)
    array.clear(_anchors)
    array.clear(_maV)
    array.clear(_maN)
    // the SAME frozen, capped set the markers / trend read / shading use — one source of truth, so a
    // line on the chart and a level in the read can never disagree
    _lvV = array.copy(yV)
    _lvN = array.copy(yN)
    if array.size(_lvV) > 0
        for i = 0 to array.size(_lvV) - 1
            array.push(_anchors, array.get(_lvV, i))     // MAs on these fold into the 4h label, no duplicate line
    // MERGE 4h levels within lvlMergePct → ONE line naming all members (sort, cluster, draw the cluster midpoint)
    _dV4 = array.new_float()     // drawable levels (merged clusters, then today's H/L)
    _dN4 = array.new_string()
    _n4 = array.size(_lvV)
    if _n4 > 0
        _ord4 = array.sort_indices(_lvV, order.ascending)
        _i4 = 0
        while _i4 < _n4
            _s4  = array.get(_ord4, _i4)
            _lo4 = array.get(_lvV, _s4)
            _hi4 = _lo4
            _nm4 = array.get(_lvN, _s4)
            _cn4 = 1
            _j4  = _i4 + 1
            while _j4 < _n4
                _vj4 = array.get(_lvV, array.get(_ord4, _j4))
                if lvlMergePct > 0 and _vj4 <= _hi4 * (1.0 + lvlMergePct)
                    _hi4 := _vj4
                    _nm4 := _nm4 + " + " + array.get(_lvN, array.get(_ord4, _j4))
                    _cn4 := _cn4 + 1
                    _j4  := _j4 + 1
                else
                    break
            array.push(_dV4, (_lo4 + _hi4) / 2.0)
            array.push(_dN4, _cn4 > 1 ? _nm4 + " ·×" + str.tostring(_cn4) : _nm4)
            _i4 := _j4

    // ── TODAY's first completed 4h candle — drawn once it closes, named apart from yesterday's
    //    so you always know which session a level belongs to.
    // The H/L and the CLOSE are INDEPENDENT toggles. The close is the strength read — where the
    // session's opening battle actually settled, not merely where it traded — so it stands on its
    // own, and the H/L can be switched off to keep the chart clean without losing it.
    if not na(t1T)
        if enToday and not na(t1H) and not na(t1L)
            array.push(_dV4, t1H)
            array.push(_dN4, "T-4H H")
            array.push(_dV4, t1L)
            array.push(_dN4, "T-4H L")
            array.push(_anchors, t1H)
            array.push(_anchors, t1L)

    // ── CONFLUENCE OWNERSHIP — each member belongs to ONE level: the nearest.
    // The old test asked "is this MA within the band of THIS level" for every level
    // independently, so when two 4h highs sat closer together than the band, a single
    // MA answered yes to both and the chart claimed the 8 SMA was in two places at once.
    // Now every candidate picks its closest drawn level and is named only there.
    _tags4 = array.new_string(array.size(_dV4), "")
    if array.size(_dV4) > 0
        _cfV = array.from(enConf ? pdh : na, enConf ? pdl : na, enConf ? pwh : na, enConf ? pwl : na, enConf ? pmh : na, enConf ? pml : na, enConf ? pqh : na, enConf ? pql : na, enConf ? pdc : na, enSma ? ema8v : na, enSma ? sma8v : na, enSma ? sma20v : na, enSma ? ema20v : na, enSma ? sma50v : na, enSma ? sma100v : na, enSma ? sma200v : na, enSma ? ema50v : na, enSma ? ema100v : na, enSma ? ema200v : na)
        _cfN = array.from("PDH", "PDL", "PWH", "PWL", "PMH", "PML", "PQH", "PQL", "PDC", "8EMA", "8SMA", "20SMA", "20EMA", "50SMA", "100SMA", "200SMA", "50EMA", "100EMA", "200EMA")
        for _fi = 0 to array.size(_cfV) - 1
            _fv = array.get(_cfV, _fi)
            if not na(_fv) and _fv > 0
                _best = -1
                _bestD = 1.0e18
                for _gi = 0 to array.size(_dV4) - 1
                    _gv = array.get(_dV4, _gi)
                    _d = math.abs(_gv - _fv) / _fv
                    if _d <= confPct and _d < _bestD
                        _bestD := _d
                        _best := _gi
                if _best >= 0
                    array.set(_tags4, _best, array.get(_tags4, _best) + " · " + array.get(_cfN, _fi))
        for _gi = 0 to array.size(_dV4) - 1
            f_draw(array.get(_dV4, _gi), array.get(_dN4, _gi), array.get(_tags4, _gi))
        if enT1C and enT1Bar and not na(t1B) and t1B >= 0
            array.push(_lb, label.new(t1B, low, "4H close", yloc = yloc.belowbar, style = label.style_label_up, color = t1BarCol, textcolor = color.black, size = size.tiny))
        if enT1C and not na(t1C)
            _cc  = close > t1C ? colLo : colHi
            _cxo = f_xoff(t1C)
            array.push(_ln, line.new(bar_index - lineLen, t1C, bar_index + _cxo, t1C, color = _cc, width = t1cW, style = line.style_dashed))
            if showLbl
                array.push(_lb, label.new(bar_index + _cxo, t1C, (close > t1C ? "▲ SUPPORT  " : "▼ RESISTANCE  ") + "T-4H CLOSE" + (showPx ? "  " + str.tostring(t1C, format.mintick) : ""), style = label.style_label_left, color = color.new(_cc, 70), textcolor = _cc, size = size.small))
            array.push(_anchors, t1C)

    // ── HIGHER-LOW STRUCTURE — number each 4h candle that holds a higher low; mark the one that breaks it.
    //    The streak is recomputed from the start of the stored history so the number shown is the TRUE
    //    run length, not a count that happens to begin wherever the drawing window starts.
    // THE day-trade sequence: yesterday's selected 4h candles, then TODAY's first once it closes.
    // Not a rolling streak over all stored history — this is the frame the day is actually traded
    // in, so the count answers "has today continued yesterday's structure or broken it".
    if enHL and array.size(yCL) > 0
        _seqL = array.copy(yCL)
        _seqB = array.copy(yCB)
        if not na(t1L) and not na(t1B)
            array.push(_seqL, t1L)
            array.push(_seqB, t1B)
        _seqBrk = array.new_bool()
        if array.size(yBrk) == array.size(yCL)
            for _qi = 0 to array.size(yBrk) - 1
                array.push(_seqBrk, array.get(yBrk, _qi))
        if not na(t1L) and not na(t1B)
            array.push(_seqBrk, t1Brk)
        _hlRun = 1                                   // the first candle in the frame is the baseline
        for _hi = 0 to array.size(_seqL) - 1
            if _hi > 0
                _hlRun := array.get(_seqL, _hi) > array.get(_seqL, _hi - 1) ? _hlRun + 1 : 0
            // the LINE is the structure: a low that price has closed under is broken, whatever the
            // candle-to-candle comparison said when it formed
            _brk = array.size(_seqBrk) > _hi ? array.get(_seqBrk, _hi) : false
            if _brk
                _hlRun := 0
            _hlB = array.get(_seqB, _hi)
            if not na(_hlB) and _hlB >= 0
                _hlTxt = _hlRun > 0 ? str.tostring(_hlRun) : "✕"
                _hlCol = _hlRun > 0 ? hlUpCol : hlXCol
                array.push(_lb, label.new(_hlB, array.get(_seqL, _hi), _hlTxt, yloc = yloc.price, style = label.style_label_up, color = _hlCol, textcolor = color.white, size = size.tiny))

    // ── STRUCTURAL LEVELS — nearest-N above / below price, own budget. A level sitting on a 4h
    //    line is skipped: it's already named in that line's confluence tag, so drawing it again
    //    would put two lines at one price and say the same thing twice.
    if enLvls
        // candidates + their enable flags, walked in one pass (a helper function can't be
        // declared in a local scope in Pine v5, and it would need these locals anyway)
        _lvV2 = array.new_float()
        _lvN2 = array.new_string()
        _cand  = array.from(pdh,   pwh,   pwl,   pmh,   pml,   pqh,   pql)
        _candN = array.from("PDH", "PWH", "PWL", "PMH", "PML", "PQH", "PQL")
        _candOn = array.from(enPDHl, enPWl, enPWl, enPMl, enPMl, enPQl, enPQl)
        for _ci = 0 to array.size(_cand) - 1
            _cv = array.get(_cand, _ci)
            if array.get(_candOn, _ci) and not na(_cv) and _cv > 0
                _dup = false
                if array.size(_anchors) > 0
                    for _ai2 = 0 to array.size(_anchors) - 1
                        if math.abs(array.get(_anchors, _ai2) - _cv) / _cv <= confPct
                            _dup := true
                if not _dup
                    array.push(_lvV2, _cv)
                    array.push(_lvN2, array.get(_candN, _ci))
        // nearest-N bracket over just these
        _lAb = array.new_float()
        _lBl = array.new_float()
        if array.size(_lvV2) > 0
            for _li = 0 to array.size(_lvV2) - 1
                _lv2 = array.get(_lvV2, _li)
                if _lv2 > close
                    array.push(_lAb, _lv2)
                else if _lv2 < close
                    array.push(_lBl, _lv2)
        array.sort(_lAb, order.ascending)
        array.sort(_lBl, order.descending)
        _lHi = lvlUp <= 0 or array.size(_lAb) == 0 ? (lvlUp <= 0 ? -1.0 : 1.0e18) : array.get(_lAb, math.min(lvlUp, array.size(_lAb)) - 1)
        _lLo = lvlDn <= 0 or array.size(_lBl) == 0 ? (lvlDn <= 0 ? 1.0e18 : -1.0) : array.get(_lBl, math.min(lvlDn, array.size(_lBl)) - 1)
        if array.size(_lvV2) > 0
            for _li = 0 to array.size(_lvV2) - 1
                _lv2 = array.get(_lvV2, _li)
                if _lv2 <= _lHi and _lv2 >= _lLo
                    _lc2 = close > _lv2 ? colLo : colHi
                    _lxo2 = f_xoff(_lv2)
                    array.push(_ln, line.new(bar_index - lineLen, _lv2, bar_index + tagOff, _lv2, color = color.new(_lc2, lvlFade), width = lvlW))
                    if showLbl
                        array.push(_lb, label.new(bar_index + _lxo2, _lv2, (close > _lv2 ? "▲ SUPPORT  " : "▼ RESISTANCE  ") + array.get(_lvN2, _li) + (showPx ? "  " + str.tostring(_lv2, format.mintick) : ""), style = label.style_label_left, color = color.new(_lc2, 82), textcolor = _lc2, size = size.small))

    // ── subtle open line (dotted) — WHICH of yesterday's 4h levels the open sits between.
    //    That pair is the cell today started in, and the cell is the range being played.
    //    Upper name first, so it reads top-down the way the lines sit on the chart.
    if enOpen and not na(dayOpen)
        _ovUp = 1.0e18
        _ovDn = -1.0
        _onUp = ""
        _onDn = ""
        if array.size(_lvV) > 0
            for _oi = 0 to array.size(_lvV) - 1
                _ov = array.get(_lvV, _oi)
                if not na(_ov) and _ov > 0
                    if _ov > dayOpen and _ov < _ovUp
                        _ovUp := _ov
                        _onUp := array.get(_lvN, _oi)
                    if _ov < dayOpen and _ov > _ovDn
                        _ovDn := _ov
                        _onDn := array.get(_lvN, _oi)
        _oHasU = _ovUp < 1.0e17
        _oHasD = _ovDn > 0
        _ctx = _oHasU and _oHasD ? "Open BTW " + _onUp + " and " + _onDn : _oHasD ? "Open ABOVE all 4H levels" : _oHasU ? "Open BELOW all 4H levels" : "Open"
        _oxo = f_xoff(dayOpen)
        array.push(_ln, line.new(bar_index - lineLen, dayOpen, bar_index + _oxo, dayOpen, color = color.new(openCol, 20), width = 1, style = line.style_dotted))
        array.push(_lb, label.new(bar_index + _oxo, dayOpen, _ctx, style = label.style_label_left, color = color.new(openCol, 15), textcolor = color.black, size = size.small))

    // ── yesterday's CLOSE — a subtle dotted neutral line (the gap-from-close reference) ──
    if enPdc and not na(pdc)
        _pcxo = f_xoff(pdc)
        array.push(_ln, line.new(bar_index - lineLen, pdc, bar_index + _pcxo, pdc, color = pdcCol, width = 1, style = line.style_dotted))
        if showLbl
            array.push(_lb, label.new(bar_index + _pcxo, pdc, "PDC " + str.tostring(pdc, format.mintick) + "  · yest close", style = label.style_label_left, color = color.new(pdcCol, 82), textcolor = pdcCol, size = size.small))

    // ── PDL — the Redler stop line: subtle dashed, "never hold below it" ──
    if enPdl and not na(pdl)
        _sxo = f_xoff(pdl)
        array.push(_ln, line.new(bar_index - lineLen, pdl, bar_index + _sxo, pdl, color = pdlCol, width = 1, style = line.style_dashed))
        if showLbl
            array.push(_lb, label.new(bar_index + _sxo, pdl, "PDL " + str.tostring(pdl, format.mintick) + "  · 🛑 STOP — exit if lost (Redler)", style = label.style_label_left, color = color.new(pdlCol, 82), textcolor = pdlCol, size = size.small))

    // ── auto MAs — proximity-gated, then MERGED so stacked MAs become ONE line naming all of them ──
    if enSma
        // ── nearest-N bracket: the maUp closest MAs above price and maDn closest below.
        //    The 4h H/L lines above are NOT gated by this — they always draw.
        _mAb = array.new_float()
        _mBl = array.new_float()
        _mAll = array.from(ema8v, sma8v, sma20v, ema20v, sma50v, sma100v, sma200v, ema50v, ema100v, ema200v)
        for _mi = 0 to array.size(_mAll) - 1
            _mv = array.get(_mAll, _mi)
            if not na(_mv) and _mv > 0
                if _mv > close
                    array.push(_mAb, _mv)
                else if _mv < close
                    array.push(_mBl, _mv)
        array.sort(_mAb, order.ascending)
        array.sort(_mBl, order.descending)
        _maHi := maUp <= 0 or array.size(_mAb) == 0 ? (maUp <= 0 ? -1.0 : 1.0e18) : array.get(_mAb, math.min(maUp, array.size(_mAb)) - 1)
        _maLo := maDn <= 0 or array.size(_mBl) == 0 ? (maDn <= 0 ? 1.0e18 : -1.0) : array.get(_mBl, math.min(maDn, array.size(_mBl)) - 1)
        f_addMa(ema8v,   "8 EMA")
        f_addMa(sma8v,   "8 SMA")
        f_addMa(sma20v,  "20 SMA")
        f_addMa(sma50v,  "50 SMA")
        f_addMa(sma100v, "100 SMA")
        f_addMa(sma200v, "200 SMA")
        f_addMa(ema20v,  "20 EMA")
        f_addMa(ema50v,  "50 EMA")
        f_addMa(ema100v, "100 EMA")
        f_addMa(ema200v, "200 EMA")
        _mn = array.size(_maV)
        if _mn > 0
            _ord = array.sort_indices(_maV, order.ascending)
            _i = 0
            while _i < _mn
                _s   = array.get(_ord, _i)
                _lo  = array.get(_maV, _s)
                _hi  = _lo
                _nm  = array.get(_maN, _s)
                _j   = _i + 1
                while _j < _mn
                    _vj = array.get(_maV, array.get(_ord, _j))
                    if maMergePct > 0 and _vj <= _hi * (1.0 + maMergePct)
                        _hi := _vj
                        _nm := _nm + " · " + array.get(_maN, array.get(_ord, _j))
                        _j  := _j + 1
                    else
                        break
                f_sma((_lo + _hi) / 2.0, _nm)   // one flat, role-colored, dotted line for the whole cluster
                _i := _j

// ═════════════════════════════════════════════════════════════════════════════
// DAY-TRADE ALERTS — reactions on the 15m CLOSE at YESTERDAY's two 4h levels ONLY.
// No confluence, no EMA/structural gating: purely reclaim / reject / break of the two
// 4h candle highs & lows. Emits the platform JSON (fourh_reclaim/reject/breakup/breakdn).
// nearby_levels carries ONLY the 4h levels, so targets stay 4h-only too. Bind on 15m.
// ═════════════════════════════════════════════════════════════════════════════
gA    = "Day-trade alerts (bind on 15m)"
enMk  = input.bool(true, "Show reaction arrows", group = gA)
enAl  = input.bool(true, "Fire reaction alerts (on the 15m close)", group = gA)
colUp = input.color(color.new(#26A69A, 0), "Bullish ▲", group = gA, inline = "a")
colDn = input.color(color.new(#EF5350, 0), "Bearish ▼", group = gA, inline = "a")

// YESTERDAY's last two completed 4h H/L, FROZEN at each new session so they stay yesterday's
// all day (once today opens, the "last two completed 4h" ARE yesterday's two RTH 4h candles).
isEquityType = _isEqSym
blockTf  = isEquityType ? "D" : "480"
newBlock = ta.change(time(blockTf)) != 0
[pH1, pL1, pH2, pL2] = request.security(rthTid, "240", [high[1], low[1], high[2], low[2]], lookahead = barmerge.lookahead_on)
var float yh1 = na
var float yl1 = na
var float yh2 = na
var float yl2 = na
if na(yh1) or newBlock
    yh1 := pH1
    yl1 := pL1
    yh2 := pH2
    yl2 := pL2

// reaction on the CLOSE (Lp = the level one bar ago, so a reclaim needs price to have been on the other side)
rc_below(float L, float Lp) => not na(L) and close[1] > nz(Lp, L) and low  < L and close > L   // wick below, close back above = reclaim
rj_above(float L, float Lp) => not na(L) and close[1] < nz(Lp, L) and high > L and close < L   // poke above, close back below = rejection
bu_thru (float L, float Lp) => not na(L) and close[1] <= nz(Lp, L) and close > L               // close breaks up through
bd_thru (float L, float Lp) => not na(L) and close[1] >= nz(Lp, L) and close < L               // close breaks down through
f_pick(bool a1, bool a2, bool a3, bool a4) => a1 ? yh1 : a2 ? yl1 : a3 ? yh2 : a4 ? yl2 : na
// WHICH of the 4 levels reacted (a High vs a Low = OPPOSITE context) + a plain-language meaning.
// 4H-1 = yesterday's LAST 4h (afternoon), 4H-2 = its FIRST 4h (morning). H = resistance, L = support.
f_nm(bool a1, bool a2, bool a3, bool a4) => a1 ? "4H-1 H" : a2 ? "4H-1 L" : a3 ? "4H-2 H" : a4 ? "4H-2 L" : ""
f_ctx(string nm, string k) =>
    _low = str.endswith(nm, "L")
    k == "rc" ? (_low ? "held the low — SUPPORT defended" : "back above the high") : k == "rj" ? (_low ? "failed at the low" : "held under the high — RESISTANCE") : k == "bu" ? (_low ? "reclaimed the low" : "cleared the high — RESISTANCE broken") : (_low ? "lost the low — SUPPORT gone" : "lost the high")
rcLvl = f_pick(rc_below(yh1, yh1[1]), rc_below(yl1, yl1[1]), rc_below(yh2, yh2[1]), rc_below(yl2, yl2[1]))
rcNm  = f_nm  (rc_below(yh1, yh1[1]), rc_below(yl1, yl1[1]), rc_below(yh2, yh2[1]), rc_below(yl2, yl2[1]))
rjLvl = f_pick(rj_above(yh1, yh1[1]), rj_above(yl1, yl1[1]), rj_above(yh2, yh2[1]), rj_above(yl2, yl2[1]))
rjNm  = f_nm  (rj_above(yh1, yh1[1]), rj_above(yl1, yl1[1]), rj_above(yh2, yh2[1]), rj_above(yl2, yl2[1]))
buLvl = f_pick(bu_thru(yh1, yh1[1]),  bu_thru(yl1, yl1[1]),  bu_thru(yh2, yh2[1]),  bu_thru(yl2, yl2[1]))
buNm  = f_nm  (bu_thru(yh1, yh1[1]),  bu_thru(yl1, yl1[1]),  bu_thru(yh2, yh2[1]),  bu_thru(yl2, yl2[1]))
bdLvl = f_pick(bd_thru(yh1, yh1[1]),  bd_thru(yl1, yl1[1]),  bd_thru(yh2, yh2[1]),  bd_thru(yl2, yl2[1]))
bdNm  = f_nm  (bd_thru(yh1, yh1[1]),  bd_thru(yl1, yl1[1]),  bd_thru(yh2, yh2[1]),  bd_thru(yl2, yl2[1]))
_conf = barstate.isconfirmed
isRc = _conf and not na(rcLvl)
isRj = _conf and not na(rjLvl)
isBu = _conf and not na(buLvl)
isBd = _conf and not na(bdLvl)
// VISUAL "LOST" markers — we ONLY flag PDH / PDL being LOST on the close. A 4h level that is CONFLUENT with
// PDH/PDL sits at the same price, so breaking it IS breaking PDH/PDL — covered automatically. A 4h high/low
// that is NOT on PDH/PDL gets no "lost" tag. One tag each per session.
//   PDH lost = price TRADED above PDH today (any high > PDH — a gap-up open counts), then a close back
//              below it → won/tagged-then-lost (catches the open-above-then-reverse candle in one bar).
//   PDL lost = prior close held PDL, then this close breaks below it → support gone.
var bool _pdhMk    = false
var bool _pdlMk    = false
var bool _pdhArmed = false      // price reached above PDH today → arms the "PDH lost" flag
if newBlock
    _pdhMk    := false
    _pdlMk    := false
    _pdhArmed := false
if not na(pdh) and high > pdh
    _pdhArmed := true
_pdhLost = _conf and not _pdhMk and _pdhArmed and not na(pdh) and close < pdh
_pdlLost = _conf and not _pdlMk and not na(pdl) and close < pdl and nz(close[1], close) >= pdl
if _pdhLost
    _pdhMk := true
if _pdlLost
    _pdlMk := true
// The "lost" tags and the short marker both want the space directly above the bar, so they
// collided whenever they fired together. Two fixes: the two lost tags merge into ONE when they
// fire on the same bar, and the tag is lifted an ATR clear of the candle so the abovebar
// plotshape keeps its own slot underneath it.
_lostTxt = _pdhLost and _pdlLost ? "PDH+PDL lost" : _pdhLost ? "PDH lost" : _pdlLost ? "PDL lost" : ""
_lostOff = nz(ta.atr(14), 0.0) * 0.9
if enMk and str.length(_lostTxt) > 0
    label.new(bar_index, high + _lostOff, _lostTxt, yloc = yloc.price, style = label.style_label_down, color = colDn, textcolor = color.white, size = size.tiny)
// MARKERS — RECLAIM / REJECTION ONLY, and both require a WICK through the level first.
// A plain close through a level (bu_thru / bd_thru) is NOT marked: momentum carrying price
// past a line says nothing about whether the line was defended. What earns a marker is price
// PROBING the level and being pushed back:
//   long  = wick BELOW the level, close back ABOVE it  (rc_below) — the level held as support
//   short = poke ABOVE the level, close back BELOW it  (rj_above) — the level held as resistance
// ONE signal per SESSION, full stop — not one per level. The first level to give a wick-and-reclaim
// (or a wick-and-rejection) is the day's read; everything after it is the same story retold, or it's
// chop, which the crossing counter reports on its own. One decision per day, one mark on the chart.
var bool _sigDone = false
if newBlock
    _sigDone := false
newLong  = false
newShort = false
if _conf and not _sigDone and array.size(yV) > 0
    for _mi = 0 to array.size(yV) - 1
        if not _sigDone
            _L  = array.get(yV, _mi)
            _Lp = _L                       // levels are frozen for the session, so prior == current
            if rc_below(_L, _Lp)                                // wicked under, closed back above → LONG
                _sigDone := true
                newLong  := true
            else if rj_above(_L, _Lp)                           // poked above, closed back below → SHORT
                _sigDone := true
                newShort := true
// ── FIRST-4H-CLOSE reclaim / loss arrows ──────────────────────────────────────────────
// The strength line is only worth drawing if you can see the moment it changes hands. A confirmed
// close back ABOVE it = reclaimed (buyers took it back); a confirmed close BELOW = lost.
// Crossovers are evaluated on EVERY bar at global scope — they're stateful and miss crosses if
// called inside a branch. Each direction fires once per session: the first handover is the signal,
// the rest is the chop the crossing counter already reports.
_t1cUpX = ta.crossover(close, t1C)
_t1cDnX = ta.crossunder(close, t1C)
var bool _t1cUpMk = false
var bool _t1cDnMk = false
if ta.change(time("D")) != 0
    _t1cUpMk := false
    _t1cDnMk := false
t1cReclaim = enMk and enT1C and barstate.isconfirmed and not na(t1C) and _t1cUpX and not _t1cUpMk
t1cLost    = enMk and enT1C and barstate.isconfirmed and not na(t1C) and _t1cDnX and not _t1cDnMk
if t1cReclaim
    _t1cUpMk := true
if t1cLost
    _t1cDnMk := true
plotshape(t1cReclaim, "1st 4H close reclaimed", style = shape.arrowup,   location = location.belowbar, color = colUp, textcolor = color.white, text = "4H C reclaim", size = size.tiny)
plotshape(t1cLost,    "1st 4H close lost",      style = shape.arrowdown, location = location.abovebar, color = colDn, textcolor = color.white, text = "4H C lost",    size = size.tiny)

plotshape(enMk and newLong,  "Long",  style = shape.labelup,   location = location.belowbar, color = colUp, textcolor = color.white, text = "long",  size = size.tiny)
plotshape(enMk and newShort, "Short", style = shape.labeldown, location = location.abovebar, color = colDn, textcolor = color.white, text = "short", size = size.tiny)

// nearby_levels = ONLY the two 4h candles' H/L (purely 4h — backend targets off these alone)
f_nl() =>
    s = ""
    s := na(yh1) ? s : s + "4h|" + str.tostring(yh1, format.mintick) + "|4H-1 H,"
    s := na(yl1) ? s : s + "4h|" + str.tostring(yl1, format.mintick) + "|4H-1 L,"
    s := na(yh2) ? s : s + "4h|" + str.tostring(yh2, format.mintick) + "|4H-2 H,"
    s := na(yl2) ? s : s + "4h|" + str.tostring(yl2, format.mintick) + "|4H-2 L"
    s
fh_pay(string rule, string dir, float ent, float stp, string lvlNm, string note) => '{"symbol":"' + syminfo.ticker + '","price":"' + str.tostring(close, format.mintick) + '","rule":"' + rule + '","direction":"' + dir + '","level":"' + lvlNm + '","interval":"' + timeframe.period + '","entry":"' + str.tostring(ent, format.mintick) + '","stop":"' + str.tostring(stp, format.mintick) + '","note":"' + note + '","nearby_levels":"' + f_nl() + '"}'
if enAl and isRc
    alert(fh_pay("fourh_reclaim", "BUY",   close, low,  rcNm, "4H reclaim of "      + rcNm + " " + str.tostring(rcLvl, format.mintick) + " · " + f_ctx(rcNm, "rc") + " · invalid on a 15m close below " + str.tostring(rcLvl, format.mintick)), alert.freq_once_per_bar_close)
if enAl and isRj
    alert(fh_pay("fourh_reject",  "SHORT", close, high, rjNm, "4H rejection at "    + rjNm + " " + str.tostring(rjLvl, format.mintick) + " · " + f_ctx(rjNm, "rj") + " · invalid on a 15m close above " + str.tostring(rjLvl, format.mintick)), alert.freq_once_per_bar_close)
if enAl and isBu
    alert(fh_pay("fourh_breakup", "BUY",   close, low,  buNm, "4H break-up thru "   + buNm + " " + str.tostring(buLvl, format.mintick) + " · " + f_ctx(buNm, "bu") + " · invalid on a 15m close below " + str.tostring(buLvl, format.mintick)), alert.freq_once_per_bar_close)
if enAl and isBd
    alert(fh_pay("fourh_breakdn", "SHORT", close, high, bdNm, "4H break-down thru " + bdNm + " " + str.tostring(bdLvl, format.mintick) + " · " + f_ctx(bdNm, "bd") + " · invalid on a 15m close above " + str.tostring(bdLvl, format.mintick)), alert.freq_once_per_bar_close)

// ═════════════════════════════════════════════════════════════════════════════
// TREND / CHOP READ — the whole point of trading off yesterday's four 4h levels: are we
// MAINTAINING a move through them, or ping-ponging between them? Position answers the first
// question, crossing-count answers the second.
//   price above all four  -> TREND UP     (yesterday's whole 4h range is support underneath)
//   price below all four  -> TREND DOWN   (the entire range is overhead supply)
//   price inside them     -> RANGE, naming the two that bracket it (upper first)
//   many crossings today  -> CHOP         (the levels are being cut, not respected)
// Reads only — changes nothing about the alerts above.
// ═════════════════════════════════════════════════════════════════════════════
gT       = "Trend / chop read"
enTrend  = input.bool(true, "Show the trend / chop state", group = gT)
trendPos = input.string("top_right", "Position", options = ["top_right", "top_center", "top_left", "bottom_right", "bottom_center"], group = gT)
chopN    = input.int(4, "Crossings today that mean CHOP", minval = 2, maxval = 20, group = gT, tooltip = "Each time a 15m close cuts through one of the four 4h levels it counts as one crossing. A trend day cuts a level once and holds; a chop day saws the same levels repeatedly. Reaching this many crossings in a session flags CHOP.")

// crossings of ANY of the four levels, reset each session
var int _xCnt = 0
if newBlock
    _xCnt := 0
if barstate.isconfirmed
    _x1 = bu_thru(yh1, yh1[1]) or bd_thru(yh1, yh1[1]) ? 1 : 0
    _x2 = bu_thru(yl1, yl1[1]) or bd_thru(yl1, yl1[1]) ? 1 : 0
    _x3 = bu_thru(yh2, yh2[1]) or bd_thru(yh2, yh2[1]) ? 1 : 0
    _x4 = bu_thru(yl2, yl2[1]) or bd_thru(yl2, yl2[1]) ? 1 : 0
    _xCnt := _xCnt + _x1 + _x2 + _x3 + _x4

_trPosC = trendPos == "top_center" ? position.top_center : trendPos == "top_left" ? position.top_left : trendPos == "bottom_right" ? position.bottom_right : trendPos == "bottom_center" ? position.bottom_center : position.top_right
var table _trT = table.new(_trPosC, 1, 1, border_width = 1, border_color = color.new(color.gray, 40))
if barstate.islast
    table.set_position(_trT, _trPosC)
    if enTrend
        _tv = yV
        _tn = yN
        _nAb = 0
        _nBl = 0
        _nOk = 0
        _tUp = 1.0e18
        _tDn = -1.0
        _tUpN = ""
        _tDnN = ""
        for _ti = 0 to array.size(_tv) - 1
            _tvv = array.get(_tv, _ti)
            if not na(_tvv) and _tvv > 0
                _nOk := _nOk + 1
                if _tvv > close
                    _nAb := _nAb + 1
                    if _tvv < _tUp
                        _tUp  := _tvv
                        _tUpN := array.get(_tn, _ti)
                else
                    _nBl := _nBl + 1
                    if _tvv > _tDn
                        _tDn  := _tvv
                        _tDnN := array.get(_tn, _ti)
        _isChop = _xCnt >= chopN
        _base = _nOk == 0 ? "4H — no data" : _nBl == _nOk ? "TREND UP · above all " + str.tostring(_nOk) + " 4H levels" : _nAb == _nOk ? "TREND DOWN · below all " + str.tostring(_nOk) + " 4H levels" : "RANGE · BTW " + (_tUpN == "" ? "—" : _tUpN) + " and " + (_tDnN == "" ? "—" : _tDnN)
        _txt = (_isChop ? "CHOP · " : "") + _base + "  ·  " + str.tostring(_xCnt) + (_xCnt == 1 ? " crossing" : " crossings")
        _col = _nOk == 0 ? color.new(color.gray, 20) : _isChop ? color.new(color.orange, 10) : _nBl == _nOk ? color.new(color.green, 10) : _nAb == _nOk ? color.new(color.red, 10) : color.new(color.gray, 10)
        table.cell(_trT, 0, 0, _txt, bgcolor = _col, text_color = color.white, text_size = size.normal)
    else
        table.cell(_trT, 0, 0, "")

// ═════════════════════════════════════════════════════════════════════════════
// CELL SHADING — N levels sort into N-1 cells (3 on equity RTH, 11 on a 24h market). Shading them turns the read from "four
// lines" into "which box am I in", which is the actual question when you're deciding trend
// vs range. The cell price sits in is highlighted; cells overhead shade as supply, cells
// underneath as support. Drawn last so the H/L lines and their tags stay on top.
// ═════════════════════════════════════════════════════════════════════════════
gZ       = "Cell shading (the 3 cells between the 4 levels)"
enShade  = input.bool(true, "Shade the cells between yesterday's four 4H levels", group = gZ)
shNow    = input.color(color.new(#EAB308, 88), "Cell price is IN", inline = "z", group = gZ)
shUp     = input.color(color.new(#EF5350, 92), "Cells above",      inline = "z", group = gZ)
shDn     = input.color(color.new(#26A69A, 92), "Cells below",      inline = "z", group = gZ)

var box[] _bx = array.new_box()
if barstate.islast
    for _b in _bx
        box.delete(_b)
    array.clear(_bx)
    if enShade
        _zv = yV
        _zo = array.new_float()
        for _zi = 0 to array.size(_zv) - 1
            _zvv = array.get(_zv, _zi)
            if not na(_zvv) and _zvv > 0
                array.push(_zo, _zvv)
        if array.size(_zo) >= 2
            array.sort(_zo, order.ascending)
            for _zj = 0 to array.size(_zo) - 2
                _zlo = array.get(_zo, _zj)
                _zhi = array.get(_zo, _zj + 1)
                _zIn = close >= _zlo and close <= _zhi
                _zc  = _zIn ? shNow : _zlo > close ? shUp : shDn
                array.push(_bx, box.new(bar_index - lineLen, _zhi, bar_index + tagOff, _zlo, border_color = color.new(color.gray, 100), bgcolor = _zc))

