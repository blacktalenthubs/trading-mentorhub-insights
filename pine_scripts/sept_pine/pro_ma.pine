// ── FORMING tag on the live bar. The qualification is already satisfied — open above, wick
// through, price back above — and only the close can still change it. Drawn faint with a
// "· forming" suffix and REPLACED each tick, so it never accumulates and never claims to be
// confirmed. It vanishes on its own if price closes back under.
var label _pendUp = na
var label _pendDn = na
if barstate.islast
    label.delete(_pendUp)
    label.delete(_pendDn)
    if enPend and not barstate.isconfirmed
        if enRc and str.length(_pdTxt) > 0
            _pendUp := label.new(bar_index, low, "⟲ " + _pdTxt + "  · forming", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(rcUpCol, 55), textcolor = color.white, size = _rcSz)
        if enLost and str.length(_pdDnTxt) > 0
            _pendDn := label.new(bar_index, high, "▽ " + _pdDnTxt + "  · forming", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(rcDnCol, 55), textcolor = color.white, size = _rcSz)

// the tag sits UNDER the candle that did the work, naming which level it took
if enRc and str.length(_upTxt) > 0
    label.new(bar_index, low,  "⟲ " + _upTxt, yloc = yloc.belowbar, style = label.style_label_up,   color = rcUpCol, textcolor = color.white, size = _rcSz)
if enLost and str.length(_dnTxt) > 0
    label.new(bar_index, high, "▽ " + _dnTxt, yloc = yloc.abovebar, style = label.style_label_down, color = rcDnCol, textcolor = color.white, size = _rcSz)
