// @version=5
//
// Weekly Stage (Weinstein) — long-term trend entry/exit, ANCHORED TO THE WEEKLY.
//
// Everything (8/21-week EMA, 30-week MA, stage, signals, trailing stop, weekly
// open) is computed on the WEEKLY timeframe via request.security, so it stays the
// SAME when you drop to a lower chart TF. On a 1h chart the MAs are still the
// WEEKLY 8/21/30 (not lower-TF averages), the stage tint is the weekly stage, and
// the levels are fixed — so you can watch how intraday/daily price acts against
// the weekly structure. Read it on the weekly for decisions; zoom lower to time.
//
//   Stage 1 Basing · 2 Advancing (hold/add) · 3 Topping · 4 Declining (out).
//   ▲ BUY  = weekly close back above a rising 30w MA (the break).
//   ● ADD  = pullback to a RISING weekly EMA (8w / 21w / 30w) that reclaims —
//            each rising average is dynamic support, tagged +8w / +21w / +30w.
//   ◆ RC   = undercut & reclaim of the prior-week low (yellow = below MA,
//            bottoming; gray = above MA, in-uptrend dip).
//   ▼ EXIT = weekly close below the trailing stop (default prior-week low).
//
// Stage/MA readout is a fixed-corner HUD (table), so it never covers price.
//
indicator("Weekly Stage (Weinstein)", "WkStage", overlay = true, max_labels_count = 20, max_lines_count = 20)

ma_len    = input.int  (30,  "Trend MA length (weeks)", minval = 5, group = "Trend")
slope_lb  = input.int  (4,   "Slope lookback (weeks)", minval = 1, group = "Trend")
slope_thr = input.float(0.5, "Min |slope %| to count as rising/falling — below = FLAT (chop)", minval = 0.0, step = 0.05, group = "Trend")
ctx_lb    = input.int  (12,  "Flat-MA context (disambiguate Stage 1 basing vs 3 topping)", minval = 4, group = "Trend")
show_ema  = input.bool(true, "Draw the weekly 8 / 21 EMA", group = "Trend")
show_200d = input.bool(true, "Draw the DAILY 200 SMA (long-term line in the sand)", group = "Trend")

show_sig  = input.bool(true, "Entry / exit markers", group = "Display")
show_bg   = input.bool(true, "Stage background tint", group = "Display")
show_hud  = input.bool(true, "Stage HUD (corner, doesn't block price)", group = "Display")
hud_pos_s = input.string("top_right", "  HUD position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = "Display")
show_wo   = input.bool(true, "Weekly open line (horizontal, rolls each Monday)", group = "Display")
wo_color  = input.color(color.new(color.green, 0), "  Weekly open — color", group = "Display")
wo_width  = input.int(2, "  Weekly open — thickness", minval = 1, maxval = 5, group = "Display")
tag_x     = input.int(10, "Tag column — bars right of the last bar (open + base tags)", minval = 2, maxval = 40, group = "Display", tooltip = "The weekly-open and base lines extend LEFT across history and END at this column to the right of the last bar, where their tag sits — so the label lands in clear space, not on the candles.")

exit_mode = input.string("Prior week low", "Trailing stop / exit rule", options = ["Prior week low", "Swing low", "30-week MA"], group = "Exit")
piv_lb    = input.int(3, "Swing-low strength (Swing-low mode only)", minval = 1, group = "Exit")

show_add  = input.bool(true, "Mark pullback-reclaim 'ADD' on each RISING weekly EMA (8/21/30)", group = "Entry")
ma_buf    = input.float(3.0, "Pullback buffer %", minval = 0.0, step = 0.5, group = "Entry")
show_rc    = input.bool(true, "Mark RC below MA (yellow ◆, bottoming)", group = "Entry")
show_rc_up = input.bool(true, "Mark RC above MA (gray ◆, in-uptrend dip)", group = "Entry")

// Weekly base floor — K of the last M weekly lows stacked at one price (basing).
show_base = input.bool(true, "Weekly base floor — K of the last M weekly lows at one price", group = "Base", tooltip = "A stock is BASING when its recent weekly lows stop making lower lows and sit at the SAME price. Draws the floor where at least K of the last M weekly lows cluster within the tolerance, tagged 'BASE (Nx)'. Nothing drawn when no cluster reaches K touches.")
base_m    = input.int(5, "  Weeks to scan (M)", minval = 2, maxval = 12, group = "Base")
base_k    = input.int(3, "  Min touches (K)", minval = 2, maxval = 10, group = "Base", tooltip = "3–5 = a tight base.")
base_tol  = input.float(2.0, "  Touch tolerance (% cap)", minval = 0.1, maxval = 10, step = 0.1, group = "Base", tooltip = "A coarse % cap on how far a weekly low can be from the floor and still count. The real tightness comes from the ATR gate below.") / 100.0
base_atr  = input.float(0.75, "  Max base width (× weekly ATR)", minval = 0.1, maxval = 3, step = 0.05, group = "Base", tooltip = "The real tightness gate, volatility-aware: a weekly low only counts as a touch if it's within this many WEEKLY ATRs of the floor (and within the % cap above). A base on a calm ETF must be far tighter in % than one on a fast mover — that's why a 2% cluster on a low-vol name is NOT a base. Lower = stricter.")
base_col  = input.color(color.new(color.teal, 0), "  Base color", group = "Base")
// Visual only — the weekly ALERTS fire from levels-day-vwap (one TV alert slot
// runs the whole watchlist); this indicator is just the chart you read.

// ── Everything computed on the WEEKLY, returned as a tuple ──────────
f_wk() =>
    _ma  = ta.sma(close, ma_len)
    _e8  = ta.ema(close, 8)
    _e21 = ta.ema(close, 21)
    _slope = _ma[slope_lb] != 0 ? (_ma - _ma[slope_lb]) / _ma[slope_lb] * 100.0 : 0.0
    _rising = _slope > slope_thr
    _falling = _slope < -slope_thr
    _above = close > _ma
    _stage = (_above and _rising) ? 2 : (((not _above) and _falling) ? 4 : ((_ma > _ma[ctx_lb]) ? 3 : 1))
    _ma_up  = _ma  > _ma[slope_lb]
    _e8_up  = _e8  > _e8[slope_lb]
    _e21_up = _e21 > _e21[slope_lb]
    _buy = (not na(_ma)) and (close > _ma) and (close[1] <= _ma[1]) and _ma_up
    _sw = ta.pivotlow(low, piv_lb, piv_lb)
    var float _swing = na
    if not na(_sw)
        _swing := _sw
    _trail = exit_mode == "Prior week low" ? low[1] : (exit_mode == "Swing low" ? _swing : _ma)
    var bool _inpos = false
    _b = _buy and (not _inpos)
    _x = _inpos and (not na(_trail)) and (close < _trail)
    if _b
        _inpos := true
    if _x
        _inpos := false
    // ADD = a fresh pullback into a RISING weekly EMA that reclaims it — this week
    // dipped to within the buffer of the EMA and closed back above, and last week
    // was clear of the zone (a new touch, not a consecutive-bar repeat). One per
    // rising average (8w / 21w / 30w); gated on THAT average rising, not on stage.
    _buf = 1.0 + ma_buf / 100.0
    _add8  = show_add and _e8_up  and (not na(_e8))  and (low <= _e8  * _buf) and (close > _e8)  and (low[1] > _e8[1]  * _buf)
    _add21 = show_add and _e21_up and (not na(_e21)) and (low <= _e21 * _buf) and (close > _e21) and (low[1] > _e21[1] * _buf)
    _add30 = show_add and _ma_up  and (not na(_ma))  and (low <= _ma  * _buf) and (close > _ma)  and (low[1] > _ma[1]  * _buf)
    // Strong reclaim = closed UP or in the TOP HALF of the bar's range. Earlier this required a
    // GREEN week, but that rejected strong RED reclaims that held the level (NBIS 06-08 @217 closed
    // 74% up but red). Top-half still rejects genuine weak sweeps (closed near the low).
    _rcbase = (low < low[1]) and (close > low[1]) and ((close > open) or (close - low >= (high - low) * 0.5)) and (not na(_ma))
    _rcb = show_rc and _rcbase and (close < _ma)
    _rca = show_rc_up and _rcbase and (close >= _ma)
    [_ma, _e8, _e21, _slope, _stage, _b, _x, _trail, _inpos, _add8, _add21, _add30, _rcb, _rca, _e8_up, _e21_up]

[ma, e8, e21, wslope, stage, buy_sig, exit_sig, trail, in_pos, add8, add21, add30, rc_below, rc_above, e8_up, e21_up] = request.security(syminfo.tickerid, "W", f_wk(), lookahead = barmerge.lookahead_off)
// Weekly open uses lookahead_ON — the open is fixed at the week's first tick, so this is
// NON-repainting, and it puts the CURRENT week's open on every lower-TF bar. lookahead_off
// lags one period on a lower TF (shows last week's open), which is the drift you'd see intraday.
wk_open = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_on)
// DAILY 200 SMA — pulled from the "D" timeframe so it's the same 200-day line on any
// chart TF. lookahead_off (updates live on the forming day, never leaks the future).
sma200d = request.security(syminfo.tickerid, "D", ta.sma(close, 200), lookahead = barmerge.lookahead_off)
// Weekly base — the last 12 COMPLETED weekly lows (settled + lookahead_on, non-repainting).
[wb1, wb2, wb3, wb4, wb5, wb6, wb7, wb8, wb9, wb10, wb11, wb12] = request.security(syminfo.tickerid, "W", [low[1], low[2], low[3], low[4], low[5], low[6], low[7], low[8], low[9], low[10], low[11], low[12]], lookahead = barmerge.lookahead_on)
// weekly ATR — the volatility yardstick for base tightness (settled, non-repainting).
watr = request.security(syminfo.tickerid, "W", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

stage_col = stage == 2 ? color.lime : stage == 4 ? color.red : stage == 3 ? color.orange : stage == 1 ? color.gray : color.silver
plot(show_ema ? e8  : na, "8w EMA",  color = color.new(color.aqua, 15), linewidth = 1)
plot(show_ema ? e21 : na, "21w EMA", color = color.new(#2962ff, 10),    linewidth = 1)
plot(ma, "30wMA", color = stage_col, linewidth = 2)
plot(show_200d ? sma200d : na, "200d SMA", color = color.new(#9c27b0, 0), linewidth = 2)
plot(in_pos ? trail : na, "trailing stop", color = color.new(color.red, 10), style = plot.style_stepline, linewidth = 1)

bg = stage == 2 ? color.new(color.lime, 92) : stage == 4 ? color.new(color.red, 92) : stage == 3 ? color.new(color.orange, 94) : stage == 1 ? color.new(color.gray, 95) : na
bgcolor(show_bg ? bg : na, title = "stage tint")

// Weekly open — ONE horizontal line at the current week's open, redrawn on the
// last bar, rolling to the new open each Monday.
var line  wo_line = na
var label wo_lab  = na
if show_wo and barstate.islast
    if not na(wo_line)
        line.delete(wo_line)
    if not na(wo_lab)
        label.delete(wo_lab)
    wo_line := line.new(bar_index, wk_open, bar_index + tag_x, wk_open, xloc = xloc.bar_index, extend = extend.left, color = wo_color, width = wo_width, style = line.style_dashed)
    wo_lab := label.new(bar_index + tag_x, wk_open, "wk open " + str.tostring(wk_open, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(wo_color, 85), textcolor = wo_color, size = size.tiny)

// Weekly base floor — a flat line where K of the last M weekly lows cluster at one price.
var line  base_line = na
var label base_lab  = na
if show_base and barstate.islast
    if not na(base_line)
        line.delete(base_line)
    if not na(base_lab)
        label.delete(base_lab)
    _bAll  = array.from(wb1, wb2, wb3, wb4, wb5, wb6, wb7, wb8, wb9, wb10, wb11, wb12)
    _bLows = array.new_float()
    _bi = 0
    while _bi < array.size(_bAll) and array.size(_bLows) < base_m
        _bv = array.get(_bAll, _bi)
        if not na(_bv) and _bv > 0
            array.push(_bLows, _bv)
        _bi += 1
    _bCnt = 0
    float _bCand = na
    if array.size(_bLows) > 0
        for _bc = 0 to array.size(_bLows) - 1
            _cand = array.get(_bLows, _bc)
            _tpC = na(watr) ? _cand * base_tol : math.min(_cand * base_tol, base_atr * watr)
            _cnt = 0
            for _bj = 0 to array.size(_bLows) - 1
                if math.abs(array.get(_bLows, _bj) - _cand) <= _tpC
                    _cnt += 1
            if _cnt > _bCnt or (_cnt == _bCnt and (na(_bCand) or _cand < _bCand))
                _bCnt := _cnt
                _bCand := _cand
    if _bCnt >= base_k and not na(_bCand)
        _tpB = na(watr) ? _bCand * base_tol : math.min(_bCand * base_tol, base_atr * watr)
        _bmin = _bCand
        for _bj = 0 to array.size(_bLows) - 1
            _lj = array.get(_bLows, _bj)
            if math.abs(_lj - _bCand) <= _tpB
                _bmin := math.min(_bmin, _lj)
        base_line := line.new(bar_index, _bmin, bar_index + tag_x, _bmin, xloc = xloc.bar_index, extend = extend.left, color = base_col, width = 2, style = line.style_solid)
        base_lab  := label.new(bar_index + tag_x, _bmin, "BASE " + str.tostring(_bmin, format.mintick) + " (" + str.tostring(_bCnt) + "x/" + str.tostring(array.size(_bLows)) + "w)", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(base_col, 80), textcolor = base_col, size = size.tiny)

// Markers — the weekly value repeats across LTF bars, so fire once with "and not [1]".
plotshape(show_sig and buy_sig and not buy_sig[1], title = "entry", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.small, text = "BUY")
plotshape(show_sig and exit_sig and not exit_sig[1], title = "exit", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small, text = "EXIT")
// ADD / RC kept as small, text-free dots so the chart stays clean — the COLOR
// says which average (aqua = 8w, blue = 21w, teal = 30w); yellow/gray ◆ = RC.
plotshape(add8  and not add8[1],  title = "add 8w",  style = shape.circle, location = location.belowbar, color = color.new(color.aqua, 0),  size = size.tiny)
plotshape(add21 and not add21[1], title = "add 21w", style = shape.circle, location = location.belowbar, color = color.new(#2962ff, 0),     size = size.tiny)
plotshape(add30 and not add30[1], title = "add 30w", style = shape.circle, location = location.belowbar, color = color.new(color.teal, 0),  size = size.tiny)
plotshape(rc_below and not rc_below[1], title = "RC below", style = shape.diamond, location = location.belowbar, color = color.new(color.yellow, 0), size = size.tiny)
plotshape(rc_above and not rc_above[1], title = "rc above", style = shape.diamond, location = location.belowbar, color = color.new(color.gray, 30), size = size.tiny)

// ── Stage HUD — fixed corner, never covers price ──────────────────────────────
stage_name = stage == 2 ? "STAGE 2 · Advancing — HOLD / add" : stage == 4 ? "STAGE 4 · Declining — OUT / avoid" : stage == 3 ? "STAGE 3 · Topping — tighten / trim" : stage == 1 ? "STAGE 1 · Basing — watch for breakout" : "—"
_hudPos = hud_pos_s == "top_left" ? position.top_left : hud_pos_s == "bottom_right" ? position.bottom_right : hud_pos_s == "bottom_left" ? position.bottom_left : position.top_right
var table hud = table.new(_hudPos, 1, 1, border_width = 1, border_color = color.new(color.gray, 55))
if barstate.islast
    if show_hud
        dist = (not na(ma)) and ma != 0 ? (close - ma) / ma * 100.0 : 0.0
        a8  = e8_up  ? "↑" : "↓"
        a21 = e21_up ? "↑" : "↓"
        txt = stage_name +
              "\n30w " + str.tostring(ma, format.mintick) + "  · slope " + str.tostring(wslope, "#.##") + "%  · price " + (dist >= 0 ? "+" : "") + str.tostring(dist, "#.#") + "% vs 30w" +
              "\n8w " + str.tostring(e8, format.mintick) + " " + a8 + "   ·   21w " + str.tostring(e21, format.mintick) + " " + a21
        table.set_position(hud, _hudPos)
        table.cell(hud, 0, 0, txt, text_color = stage_col, bgcolor = color.new(color.black, 15), text_size = size.normal, text_halign = text.align_left)
    else
        table.cell(hud, 0, 0, "")
