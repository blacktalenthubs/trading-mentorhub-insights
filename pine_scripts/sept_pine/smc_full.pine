//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// SMC · FULL — a home-grown Smart Money Concepts suite (our own, fully controllable)
// ─────────────────────────────────────────────────────────────────────────────
// Built from the public price-action concepts (not LuxAlgo's code) so every layer
// is ours to tune and, later, feed into the scanner. Layers, each independent:
//   • MARKET STRUCTURE — swing + internal BOS (break with trend) / CHoCH (against it)
//   • STRONG / WEAK high & low — which swing holds vs which is set to break
//   • ORDER BLOCKS — last opposite candle before an impulse, ATR-filtered, mitigated
//   • FAIR VALUE GAPS — 3-candle imbalances, auto/manual threshold, extended
//   • EQUAL HIGHS / LOWS — liquidity pools (EQH / EQL)
//   • PREMIUM / DISCOUNT — the dealing range split into premium / EQ / discount
//   • MTF LEVELS — previous day / week / month high & low
// Non-repainting: pivots confirm `len` bars back; breaks judged on the CLOSE.
// ─────────────────────────────────────────────────────────────────────────────
indicator("SMC · Full", "SMC", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═══ INPUTS ══════════════════════════════════════════════════════════════════
gStr   = "Market structure"
swLen  = input.int(50, "Swing length", minval = 3, maxval = 250, group = gStr, tooltip = "Pivot strength for the SWING (major) structure — bars on each side.")
showSw = input.bool(true,  "Swing BOS / CHoCH", group = gStr)
inLen  = input.int(5,  "Internal length", minval = 2, maxval = 100, group = gStr, tooltip = "Pivot strength for the INTERNAL (minor) structure.")
showIn = input.bool(true,  "Internal BOS / CHoCH", group = gStr)
showSWk= input.bool(true,  "Strong / Weak high & low", group = gStr)
showPts= input.bool(false, "Swing points (HH / HL / LH / LL)", group = gStr)
cBull  = input.color(#26A69A, "Bullish", inline = "cs", group = gStr)
cBear  = input.color(#EF5350, "Bearish", inline = "cs", group = gStr)
lblSz  = input.string("small", "Label size", options = ["tiny", "small", "normal"], group = gStr)

gOB      = "Order blocks"
showOB   = input.bool(true, "Show order blocks", group = gOB)
obCount  = input.int(3, "How many to keep (each side)", minval = 1, maxval = 20, group = gOB)
obAtrMult= input.float(0.0, "Min block size (× ATR, 0 = off)", minval = 0, step = 0.1, group = gOB)
obMitig  = input.string("Wick", "Mitigation", options = ["Close", "Wick"], group = gOB, tooltip = "Remove a block once price WICKS through it (Wick — clears faster, fewer stale boxes) or only when it CLOSES through (Close).")
obNoOverlap = input.bool(true, "Skip a new block that overlaps the last one (declutter)", group = gOB, tooltip = "In a strong trend, back-to-back breaks stack near-identical blocks. On = a fresh block that overlaps the most recent same-side block is skipped, so you see distinct zones only.")
obBullCol= input.color(color.new(#26A69A, 80), "Bull OB", inline = "ob", group = gOB)
obBearCol= input.color(color.new(#EF5350, 80), "Bear OB", inline = "ob", group = gOB)

gFvg      = "Fair value gaps"
showFvg   = input.bool(false, "Show FVG (3-candle gaps — off by default; separate from order blocks)", group = gFvg)
fvgAuto   = input.bool(true, "Auto threshold", group = gFvg, tooltip = "Auto: only gaps larger than a fraction of ATR draw (filters noise). Off: use the manual × ATR below.")
fvgThr    = input.float(0.25, "Min gap (× ATR, manual)", minval = 0, step = 0.05, group = gFvg)
fvgExtend = input.int(12, "Extend (bars)", minval = 0, maxval = 200, group = gFvg)
fvgKeep   = input.int(12, "How many to keep (each side)", minval = 1, maxval = 40, group = gFvg)
fvgBullCol= input.color(color.new(#26A69A, 82), "Bull FVG", inline = "f", group = gFvg)
fvgBearCol= input.color(color.new(#EF5350, 82), "Bear FVG", inline = "f", group = gFvg)

gEq    = "Equal highs / lows"
showEq = input.bool(true, "Show EQH / EQL", group = gEq)
eqThr  = input.float(0.1, "Threshold (× ATR)", minval = 0.01, step = 0.05, group = gEq)
eqCol  = input.color(color.new(#787B86, 0), "Color", group = gEq)

gPd    = "Premium / discount zones"
showPd = input.bool(false, "Show premium / discount", group = gPd)

gMtf   = "MTF levels (prev high / low)"
mtfD   = input.bool(false, "Daily",   inline = "d", group = gMtf)
mtfW   = input.bool(false, "Weekly",  inline = "d", group = gMtf)
mtfM   = input.bool(false, "Monthly", inline = "d", group = gMtf)
mtfCol = input.color(color.new(#787B86, 20), "Color", group = gMtf)

_sz = lblSz == "tiny" ? size.tiny : lblSz == "normal" ? size.normal : size.small
atr = ta.atr(200)

// ═══ INTERNAL STRUCTURE (function — var state persists per call-site) ═════════
f_struct(int plen, bool show, color cb, color cbr) =>
    _ph = ta.pivothigh(plen, plen)
    _pl = ta.pivotlow(plen, plen)
    var float shp = na
    var int   shb = na
    var float slp = na
    var int   slb = na
    var int   tr  = 0
    if not na(_ph)
        shp := _ph
        shb := bar_index - plen
    if not na(_pl)
        slp := _pl
        slb := bar_index - plen
    if not na(shp) and close > shp
        if show
            line.new(shb, shp, bar_index, shp, xloc = xloc.bar_index, color = cb, style = line.style_dashed)
            label.new(int(math.avg(shb, bar_index)), shp, tr < 0 ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(cb, 90), textcolor = cb, size = size.tiny)
        tr  := 1
        shp := na
    if not na(slp) and close < slp
        if show
            line.new(slb, slp, bar_index, slp, xloc = xloc.bar_index, color = cbr, style = line.style_dashed)
            label.new(int(math.avg(slb, bar_index)), slp, tr > 0 ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(cbr, 90), textcolor = cbr, size = size.tiny)
        tr  := -1
        slp := na
    tr

inTrend = f_struct(inLen, showIn, color.new(cBull, 45), color.new(cBear, 45))

// ═══ SWING STRUCTURE (inline — feeds order blocks, strong/weak, premium/discount) ═
sph = ta.pivothigh(swLen, swLen)
spl = ta.pivotlow(swLen, swLen)
var float SHp = na
var int   SHb = na
var float SLp = na
var int   SLb = na
var int   Str = 0
var float rngHigh = na          // last confirmed swing high (kept for zones/strong-weak)
var float rngLow  = na          // last confirmed swing low
// order-block ORIGIN = the last opposite-color candle before the impulse (LuxAlgo-style,
// a tight box near the break), tracked rolling: last DOWN candle → bullish OB, last UP
// candle → bearish OB.
var int   lastDnBar  = na
var float lastDnHigh = na
var float lastDnLow  = na
var int   lastUpBar  = na
var float lastUpHigh = na
var float lastUpLow  = na
if close < open
    lastDnBar  := bar_index
    lastDnHigh := high
    lastDnLow  := low
if close > open
    lastUpBar  := bar_index
    lastUpHigh := high
    lastUpLow  := low

if not na(sph)
    SHp := sph
    SHb := bar_index - swLen
    rngHigh := sph
if not na(spl)
    SLp := spl
    SLb := bar_index - swLen
    rngLow := spl

// swing-point tags
var float prevPH = na
var float prevPL = na
if not na(sph)
    _t = na(prevPH) ? "" : (sph > prevPH ? "HH" : "LH")
    if showPts and _t != ""
        label.new(bar_index - swLen, sph, _t, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(color.gray, 100), textcolor = color.gray, size = size.tiny)
    prevPH := sph
if not na(spl)
    _t = na(prevPL) ? "" : (spl > prevPL ? "HL" : "LL")
    if showPts and _t != ""
        label.new(bar_index - swLen, spl, _t, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(color.gray, 100), textcolor = color.gray, size = size.tiny)
    prevPL := spl

// ── order-block storage ──
var box[] obBull = array.new_box()
var box[] obBear = array.new_box()

f_capOB(box[] arr) =>
    while array.size(arr) > obCount
        box.delete(array.shift(arr))

// SWING break UP → bullish BOS/CHoCH + bullish order block from the leg's low candle
if not na(SHp) and close > SHp
    _c = Str < 0
    if showSw
        line.new(SHb, SHp, bar_index, SHp, xloc = xloc.bar_index, color = cBull, width = 1, style = line.style_dashed)
        label.new(int(math.avg(SHb, bar_index)), SHp, _c ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(cBull, 90), textcolor = cBull, size = _sz)
    if showOB and not na(lastDnBar) and (obAtrMult <= 0 or (lastDnHigh - lastDnLow) >= obAtrMult * atr)
        _ov = false
        if obNoOverlap and array.size(obBull) > 0
            _p = array.get(obBull, array.size(obBull) - 1)
            _ov := lastDnHigh >= box.get_bottom(_p) and lastDnLow <= box.get_top(_p)
        if not _ov
            array.push(obBull, box.new(lastDnBar, lastDnHigh, bar_index + 2, lastDnLow, xloc = xloc.bar_index, border_width = 0, bgcolor = obBullCol))
            f_capOB(obBull)
    Str := 1
    SHp := na

// SWING break DOWN → bearish BOS/CHoCH + bearish order block from the last UP candle
if not na(SLp) and close < SLp
    _c = Str > 0
    if showSw
        line.new(SLb, SLp, bar_index, SLp, xloc = xloc.bar_index, color = cBear, width = 1, style = line.style_dashed)
        label.new(int(math.avg(SLb, bar_index)), SLp, _c ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(cBear, 90), textcolor = cBear, size = _sz)
    if showOB and not na(lastUpBar) and (obAtrMult <= 0 or (lastUpHigh - lastUpLow) >= obAtrMult * atr)
        _ov = false
        if obNoOverlap and array.size(obBear) > 0
            _p = array.get(obBear, array.size(obBear) - 1)
            _ov := lastUpHigh >= box.get_bottom(_p) and lastUpLow <= box.get_top(_p)
        if not _ov
            array.push(obBear, box.new(lastUpBar, lastUpHigh, bar_index + 2, lastUpLow, xloc = xloc.bar_index, border_width = 0, bgcolor = obBearCol))
            f_capOB(obBear)
    Str := -1
    SLp := na

// extend live order blocks to the right + mitigate (remove once price closes/wicks through)
if array.size(obBull) > 0
    for i = array.size(obBull) - 1 to 0
        b = array.get(obBull, i)
        box.set_right(b, bar_index + 2)
        _mit = obMitig == "Wick" ? low < box.get_bottom(b) : close < box.get_bottom(b)
        if _mit
            box.delete(b)
            array.remove(obBull, i)
if array.size(obBear) > 0
    for i = array.size(obBear) - 1 to 0
        b = array.get(obBear, i)
        box.set_right(b, bar_index + 2)
        _mit = obMitig == "Wick" ? high > box.get_top(b) : close > box.get_top(b)
        if _mit
            box.delete(b)
            array.remove(obBear, i)

// ═══ FAIR VALUE GAPS ═════════════════════════════════════════════════════════
var box[] fvgBull = array.new_box()
var box[] fvgBear = array.new_box()
_fvgMin = fvgAuto ? atr * 0.25 : fvgThr * atr
if showFvg and bar_index > 3
    // bullish FVG: current low above the high of two bars back (gap in between)
    if low > high[2] and (low - high[2]) >= _fvgMin
        array.push(fvgBull, box.new(bar_index - 1, low, bar_index + fvgExtend, high[2], xloc = xloc.bar_index, border_width = 0, bgcolor = fvgBullCol))
        while array.size(fvgBull) > fvgKeep
            box.delete(array.shift(fvgBull))
    // bearish FVG: current high below the low of two bars back
    if high < low[2] and (low[2] - high) >= _fvgMin
        array.push(fvgBear, box.new(bar_index - 1, low[2], bar_index + fvgExtend, high, xloc = xloc.bar_index, border_width = 0, bgcolor = fvgBearCol))
        while array.size(fvgBear) > fvgKeep
            box.delete(array.shift(fvgBear))
// mitigate FVGs (price fills the gap)
if array.size(fvgBull) > 0
    for i = array.size(fvgBull) - 1 to 0
        b = array.get(fvgBull, i)
        if close < box.get_bottom(b)
            box.delete(b)
            array.remove(fvgBull, i)
if array.size(fvgBear) > 0
    for i = array.size(fvgBear) - 1 to 0
        b = array.get(fvgBear, i)
        if close > box.get_top(b)
            box.delete(b)
            array.remove(fvgBear, i)

// ═══ EQUAL HIGHS / LOWS ══════════════════════════════════════════════════════
var float eqPH = na
var int   eqPHb = na
var float eqPL = na
var int   eqPLb = na
if not na(sph)
    if showEq and not na(eqPH) and math.abs(sph - eqPH) <= eqThr * atr
        line.new(eqPHb, eqPH, bar_index - swLen, sph, xloc = xloc.bar_index, color = eqCol, style = line.style_dotted)
        label.new(bar_index - swLen, sph, "EQH", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(eqCol, 100), textcolor = eqCol, size = size.tiny)
    eqPH := sph
    eqPHb := bar_index - swLen
if not na(spl)
    if showEq and not na(eqPL) and math.abs(spl - eqPL) <= eqThr * atr
        line.new(eqPLb, eqPL, bar_index - swLen, spl, xloc = xloc.bar_index, color = eqCol, style = line.style_dotted)
        label.new(bar_index - swLen, spl, "EQL", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(eqCol, 100), textcolor = eqCol, size = size.tiny)
    eqPL := spl
    eqPLb := bar_index - swLen

// ═══ STRONG / WEAK HIGH & LOW + PREMIUM / DISCOUNT (last-bar overlays) ═════════
var label swkHiLab = na
var label swkLoLab = na
var box   pdPrem = na
var box   pdEq   = na
var box   pdDisc = na
if barstate.islast
    // strong/weak: in an uptrend the swing LOW is strong (support), the high is weak
    // (set to break); in a downtrend the swing HIGH is strong, the low is weak.
    if showSWk and not na(rngHigh) and not na(rngLow)
        label.delete(swkHiLab)
        label.delete(swkLoLab)
        _hiTxt = Str < 0 ? "Strong High" : "Weak High"
        _loTxt = Str > 0 ? "Strong Low"  : "Weak Low"
        _hiCol = Str < 0 ? cBear : color.new(cBear, 45)
        _loCol = Str > 0 ? cBull : color.new(cBull, 45)
        swkHiLab := label.new(bar_index + 3, rngHigh, _hiTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(_hiCol, 90), textcolor = _hiCol, size = size.small)
        swkLoLab := label.new(bar_index + 3, rngLow,  _loTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(_loCol, 90), textcolor = _loCol, size = size.small)
    // premium / discount: split [rngLow, rngHigh] into top-25% premium, mid EQ, bottom-25% discount
    if showPd and not na(rngHigh) and not na(rngLow) and rngHigh > rngLow
        box.delete(pdPrem)
        box.delete(pdEq)
        box.delete(pdDisc)
        _rng = rngHigh - rngLow
        _l = bar_index - 20
        _r = bar_index + 5
        pdPrem := box.new(_l, rngHigh,             _r, rngHigh - _rng * 0.25, xloc = xloc.bar_index, border_width = 0, bgcolor = color.new(cBear, 88))
        pdEq   := box.new(_l, rngLow + _rng * 0.55, _r, rngLow + _rng * 0.45, xloc = xloc.bar_index, border_width = 0, bgcolor = color.new(color.gray, 85))
        pdDisc := box.new(_l, rngLow + _rng * 0.25, _r, rngLow,               xloc = xloc.bar_index, border_width = 0, bgcolor = color.new(cBull, 88))

// ═══ MTF LEVELS — previous day / week / month high & low ═════════════════════
[dH, dL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wH, wL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mH, mL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
var line ldH = na
var line ldL = na
var line lwH = na
var line lwL = na
var line lmH = na
var line lmL = na
f_mtfLine(line ln, bool on, float px, string tag) =>
    line _r = ln
    if on and not na(px)
        if na(_r)
            _r := line.new(bar_index - 1, px, bar_index, px, xloc = xloc.bar_index, color = mtfCol, style = line.style_dotted, extend = extend.right)
        else
            line.set_xy1(_r, bar_index - 1, px)
            line.set_xy2(_r, bar_index, px)
    else if not na(_r)
        line.delete(_r)
        _r := na
    _r
if barstate.islast
    ldH := f_mtfLine(ldH, mtfD, dH, "PDH")
    ldL := f_mtfLine(ldL, mtfD, dL, "PDL")
    lwH := f_mtfLine(lwH, mtfW, wH, "PWH")
    lwL := f_mtfLine(lwL, mtfW, wL, "PWL")
    lmH := f_mtfLine(lmH, mtfM, mH, "PMH")
    lmL := f_mtfLine(lmL, mtfM, mL, "PML")
