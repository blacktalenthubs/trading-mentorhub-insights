//@version=5
// RSI Put-Seller Backtest — sell cash-secured puts ONLY at oversold reversal / support
// points, never into a falling knife. Fires a ~30-DTE put when ANY enabled trigger hits:
//   • Daily RSI reversal  — RSI dips under the oversold zone (default 40) and turns back up
//   • Weekly RSI reversal — the WEEKLY RSI turns up from under the zone (bigger-picture turn)
//   • 50 SMA bounce       — price wicks down to the 50-day SMA and closes back above it (green)
//   • 200 SMA bounce      — same, at the 200-day SMA
// No EMA cloud, no fixed % drop — those don't time a reversal.
// Options can't run in Pine's Strategy Tester, so this tracks each signal to expiry:
// WIN = close held ABOVE the strike (put expires worthless / you'd hit the 50% exit);
// LOSS = close below the strike (assigned). Hold-to-expiry is CONSERVATIVE — the 50%
// profit exit only improves it. One put at a time, re-armed after each expiry.
indicator("RSI Put-Seller Backtest", "RSI-puts", overlay = true, max_labels_count = 500)

// ── Triggers (any enabled one fires a put) ───────────────────────────────────
gS = "Signal — oversold reversals (any fires a put)"
tRsiD = input.bool(true, "Daily RSI reversal (turn up from oversold)", group = gS)
tRsiW = input.bool(true, "Weekly RSI reversal (weekly turn up from oversold)", group = gS)
t50   = input.bool(true, "50 SMA bounce", group = gS)
t200  = input.bool(true, "200 SMA bounce", group = gS)
rsiLen  = input.int(14, "RSI length", minval = 2, group = gS)
rsiZone = input.float(40, "Oversold zone — RSI must dip under this", minval = 1, maxval = 100, group = gS, tooltip = "Arms the RSI triggers. 40 catches both the ~33 deep bounces and the ~40 shallow ones. Daily fires when RSI turns up from under it; weekly fires when the WEEKLY RSI turns up from under it.")
maTol   = input.float(1.0, "SMA bounce tolerance %", minval = 0, maxval = 5, step = 0.1, group = gS, tooltip = "How close the bar's low must get to the SMA to count as tagging it. A bounce = wick tags the SMA, close holds ABOVE it, green bar.")

// ── The put (for the backtest) ───────────────────────────────────────────────
gPut = "Put model"
dte       = input.int(30, "Days to expiry (bars held)", minval = 1, maxval = 365, group = gPut)
otmPct    = input.float(5.0, "Strike % out-of-the-money", minval = 0, maxval = 30, step = 0.5, group = gPut)
creditPct = input.float(3.0, "Est. credit (% of strike)", minval = 0.1, maxval = 30, step = 0.1, group = gPut, tooltip = "Rough premium for a ~5% OTM 30-day put on a high-IV name — the return per WIN on the cash-secured amount. Verify against real IV; this is a proxy, not live option data.")
oneAtTime = input.bool(true, "One open put at a time", group = gPut)

gV = "Visuals"
showMAs = input.bool(true, "Show 50/200 SMA + signals", group = gV)
hudPos  = input.string("top_right", "Stats position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = gV)

// ── Weekly RSI helpers (evaluated in the weekly context) ─────────────────────
f_wRev(simple int len, simple float zone) =>
    r = ta.rsi(close, len)
    r > r[1] and r[1] <= r[2] and r[1] < zone   // weekly RSI turned up from under the zone
f_wRsi(simple int len) => ta.rsi(close, len)

// ── Compute the triggers ─────────────────────────────────────────────────────
_rsi    = ta.rsi(close, rsiLen)
_sma50  = ta.sma(close, 50)
_sma200 = ta.sma(close, 200)

// Daily RSI reversal: RSI[1] a local trough inside the zone, RSI now turning up.
_rsiTrough = _rsi[1] < _rsi and _rsi[1] <= _rsi[2]
_dRev = _rsiTrough and _rsi[1] < rsiZone

// Weekly RSI reversal + current weekly RSI value (surfaced from the weekly timeframe).
_wRev = request.security(syminfo.tickerid, "W", f_wRev(rsiLen, rsiZone), lookahead = barmerge.lookahead_off)
_rsiW = request.security(syminfo.tickerid, "W", f_wRsi(rsiLen), lookahead = barmerge.lookahead_off)

// SMA bounce: wick tags the SMA, close holds above it, green bar (turning up off support).
_bounce50  = low <= _sma50  * (1 + maTol / 100.0) and close > _sma50  and close > open
_bounce200 = low <= _sma200 * (1 + maTol / 100.0) and close > _sma200 and close > open

// Any enabled trigger fires a put; _why names the one that did (priority order).
_fD   = tRsiD and _dRev
_fW   = tRsiW and _wRev
_f50  = t50  and _bounce50
_f200 = t200 and _bounce200
signal = _fD or _fW or _f50 or _f200
_why = _f200 ? "200 bounce" : _f50 ? "50 bounce" : _fD ? "RSI rev" : _fW ? "Wk RSI" : ""

// ── Plot the SMAs + signal marker ────────────────────────────────────────────
plot(showMAs ? _sma50  : na, "50 SMA",  color = color.new(#42A5F5, 0), linewidth = 1)
plot(showMAs ? _sma200 : na, "200 SMA", color = color.new(#FB8C00, 0), linewidth = 2)

// ── Backtest: track each signalled put to expiry ─────────────────────────────
var array<float> posK   = array.new_float()
var array<int>   posExp = array.new_int()
var int   nSig  = 0
var int   nWin  = 0
var int   nLoss = 0
var float pnl   = 0.0   // cumulative % return on the cash-secured amount

_canEnter = signal and (not oneAtTime or array.size(posK) == 0)
if _canEnter and barstate.isconfirmed
    _k = close * (1 - otmPct / 100.0)
    array.push(posK, _k)
    array.push(posExp, bar_index + dte)
    nSig += 1
    if showMAs
        label.new(bar_index, low, _why + " · PUT ≤ " + str.tostring(_k, format.mintick), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(#26A69A, 15), textcolor = color.white, size = size.tiny)

// Resolve any position that reached expiry (iterate backwards so removals are safe).
if array.size(posExp) > 0
    _i = array.size(posExp) - 1
    while _i >= 0
        if bar_index >= array.get(posExp, _i)
            _k = array.get(posK, _i)
            if close >= _k
                nWin += 1
                pnl += creditPct
            else
                nLoss += 1
                pnl += creditPct - (_k - close) / _k * 100.0
            array.remove(posK, _i)
            array.remove(posExp, _i)
        _i := _i - 1

// ── Stats table ──────────────────────────────────────────────────────────────
_pos = hudPos == "top_left" ? position.top_left : hudPos == "bottom_right" ? position.bottom_right : hudPos == "bottom_left" ? position.bottom_left : position.top_right
var table t = na
if barstate.islast
    _closed = nWin + nLoss
    _wr  = _closed > 0 ? nWin / _closed * 100.0 : 0.0
    _avg = _closed > 0 ? pnl / _closed : 0.0
    _trg = (tRsiD ? "RSI " : "") + (tRsiW ? "Wk " : "") + (t50 ? "50 " : "") + (t200 ? "200" : "")
    _armed = _rsi < rsiZone or _rsiW < rsiZone
    _rsiTxt = str.tostring(_rsi, "#") + " / W" + str.tostring(_rsiW, "#") + (_armed ? " ·armed" : "")
    // What to actually trade: the put strike at current price, and whether a signal is live now.
    _sellK  = close * (1 - otmPct / 100.0)
    _sigTxt = signal ? _why + " ✓ FIRED" : _armed ? "armed — watch for the turn" : "—"
    _sigCol = signal ? #26A69A : _armed ? #F5A623 : color.new(color.gray, 0)
    if na(t)
        t := table.new(_pos, 2, 10, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))
    _hb = color.new(#0f1420, 8)
    _lc = color.new(color.gray, 0)
    _tc = color.new(color.white, 0)
    table.cell(t, 0, 0, "PUT-SELL BACKTEST", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 0, syminfo.ticker, bgcolor = _hb, text_color = _tc, text_size = size.small)
    table.cell(t, 0, 1, "Triggers", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 1, _trg, bgcolor = _hb, text_color = _tc, text_size = size.small)
    table.cell(t, 0, 2, "Signals", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(nSig), bgcolor = _hb, text_color = _tc, text_size = size.small)
    table.cell(t, 0, 3, "Closed", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(_closed) + "  (" + str.tostring(array.size(posK)) + " open)", bgcolor = _hb, text_color = _tc, text_size = size.small)
    table.cell(t, 0, 4, "Win rate", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 4, str.tostring(_wr, "#.#") + "%  (" + str.tostring(nWin) + "W/" + str.tostring(nLoss) + "L)", bgcolor = _hb, text_color = _wr >= 70 ? #26A69A : _wr >= 50 ? #F5A623 : #EF5350, text_size = size.small)
    table.cell(t, 0, 5, "Avg / trade", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(_avg, "#.##") + "%", bgcolor = _hb, text_color = _avg >= 0 ? #26A69A : #EF5350, text_size = size.small)
    table.cell(t, 0, 6, "Total return", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 6, str.tostring(pnl, "#.#") + "%", bgcolor = _hb, text_color = pnl >= 0 ? #26A69A : #EF5350, text_size = size.small)
    table.cell(t, 0, 7, "RSI D/W", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 7, _rsiTxt, bgcolor = _hb, text_color = _armed ? #F5A623 : _tc, text_size = size.small)
    table.cell(t, 0, 8, "Signal now", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 8, _sigTxt, bgcolor = _hb, text_color = _sigCol, text_size = size.small)
    table.cell(t, 0, 9, "Sell PUT ≤", bgcolor = _hb, text_color = _lc, text_size = size.small)
    table.cell(t, 1, 9, str.tostring(_sellK, format.mintick) + "  (~" + str.tostring(dte) + "d · " + str.tostring(otmPct, "#.#") + "% OTM)", bgcolor = _hb, text_color = signal ? #26A69A : _tc, text_size = size.small)

// Alert when a fresh signal fires (sell a put).
alertcondition(signal, "Sell-put signal", "{{ticker}}: oversold-reversal put signal → sell a ~30d put (RSI / weekly RSI / 50-200 SMA bounce)")
