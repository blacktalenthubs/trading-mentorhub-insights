//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 20 MA · DIRECTION & SLOPE — a NORMAL (curved) moving average, colored & scored by
// the STRENGTH its slope implies. After the T3 Live "20MA is my #1 indicator" idea:
//   • Rising 20MA = strength · Falling = weakness.
//   • The ANGLE of the 20MA gauges how strong: ~45° is ideal, steeper is not
//     sustainable (parabolic), shallower is too weak / lacks momentum, flat = chop.
//
// A true on-screen "degree" depends on your zoom/price-scale, so it can't be read
// directly. Instead the angle here is SCALE-FREE: it measures the MA's rise in
// ATRs per bar and converts that to degrees. Set "ATR/bar that reads as 45°" to
// match how 45° looks on your own chart, and it's then comparable across symbols.
//
// It also reads the stock's EXTENSION (how far price is stretched from the 20MA in
// ATRs — beyond a threshold = EXTENDED, snap-back likely), flags COILING (flat MA +
// contracting ATR → volatility expansion), and shows the 200 SMA for long-term
// trend context. From all that it builds a SETUP on the 20: LONG only when the MA
// is RISING and price is at/above it (reclaim/hold of support); SHORT when the MA
// is FALLING and price rallies to it and rejects (resistance), or when price is
// very EXTENDED ABOVE the MA (fade the snap-back down). Extended BELOW a falling MA
// is NOT a long — you wait for the rally to the MA to short. Each carries an
// Entry / Stop (beyond the MA) / Target (extension) and
// a Risk:Reward that flags whether it's WITH or COUNTER the 200 trend. A clean
// labeled HUD lays it out; angle, %-slope, extension, and R:R go to the Data Window.
// ─────────────────────────────────────────────────────────────────────────────
indicator("20 MA · Direction & Slope", "20MA-dir", overlay = true)

// ── moving average ────────────────────────────────────────────────────────────
gM     = "Moving average"
maLen  = input.int(20, "Length", minval = 2, group = gM)
maType = input.string("SMA", "Type", options = ["SMA", "EMA"], group = gM)
lockTf = input.timeframe("D", "Lock to timeframe", group = gM, tooltip = "Compute the MA, slope, 200 SMA and ATR on THIS timeframe (default Daily) via request.security — so on a LOWER chart TF the read still REFLECTS the daily 20-MA (drawn stepped/flat within each day). Non-repainting (lookahead off).")
maW    = input.int(2, "Line width", minval = 1, maxval = 6, group = gM)

// ── long-term trend (200 SMA) — CONTEXT only; entries stay on the 20 ──────────
gL      = "Long-term trend (200 SMA)"
en200   = input.bool(true, "Show the 200 SMA (context)", group = gL, tooltip = "The 200 is drawn for long-term trend context — above it = long-term uptrend, below = downtrend, and the R:R row flags whether the 20 setup is WITH or COUNTER that trend. The entry read stays on the 20.")
len200  = input.int(200, "Length", minval = 20, group = gL)
// Distinct hue (orange/gold) so the 200 never blends into the green/red 20 & blue 50.
col200U = input.color(#FB8C00, "Rising", inline = "c2", group = gL)
col200D = input.color(#FFB74D, "Falling", inline = "c2", group = gL)
w200    = input.int(3, "Width", minval = 1, maxval = 6, group = gL)

// ── mid-term trend (50 SMA) — CONTEXT only; entries stay on the 20 ─────────────
gL50    = "Mid-term trend (50 SMA)"
en50    = input.bool(true, "Show the 50 SMA (context)", group = gL50, tooltip = "The 50 is drawn for mid-term trend context between the 20 and the 200. Colored by its own direction. Locked to the same timeframe as the 20. The entry read stays on the 20.")
len50   = input.int(50, "Length", minval = 5, group = gL50)
// Distinct hue (blue) so the 50 never blends into the green/red 20 & orange 200.
col50U  = input.color(#1E88E5, "Rising", inline = "c50", group = gL50)
col50D  = input.color(#90CAF9, "Falling", inline = "c50", group = gL50)
w50     = input.int(2, "Width", minval = 1, maxval = 6, group = gL50)

// ── swing trend (150 SMA ≈ the 30-week MA) — the Weinstein Stage-2 line ─────────
// 150 trading days ≈ 30 weeks, so the daily 150 SMA is the day-chart proxy of the
// 30-week MA institutions defend. Own hue (purple) so it never blends with 50/200.
gL150   = "Swing trend (150 SMA ≈ 30-week)"
en150   = input.bool(true, "Show the 150 SMA (swing)", group = gL150, tooltip = "150 trading days ≈ 30 weeks — the daily proxy of the 30-week MA (Weinstein Stage-2 support). Used in the SWING set. Locked to the same timeframe as the 20.")
len150  = input.int(150, "Length", minval = 20, group = gL150)
col150U = input.color(#7E57C2, "Rising", inline = "c150", group = gL150)
col150D = input.color(#B39DDB, "Falling", inline = "c150", group = gL150)
w150    = input.int(2, "Width", minval = 1, maxval = 6, group = gL150)

// ── MA SET — one switch to flip the visible stack ──────────────────────────────
// Day = 20·50·200 (works for day AND swing). Swing = 50·150·200 (the 150 replaces
// the 20 for a multi-day hold). All = every line. The 50 & 200 are in BOTH sets.
// This only drives VISIBILITY — each line's own Show toggle can still hide it, and
// the 20-MA HUD (angle/state) always reads regardless of which set is drawn.
gSet    = "MA set (Day / Swing)"
maSet   = input.string("Day (20·50·200)", "Show set", options = ["Day (20·50·200)", "Swing (50·150·200)", "All (20·50·150·200)"], group = gSet, tooltip = "Day = 20·50·200 (both day & swing). Swing = 50·150·200 (150 ≈ 30-week). All = show every line. 50 and 200 are shown in every set.")
setShow20  = maSet != "Swing (50·150·200)"       // 20 in Day + All
setShow150 = maSet != "Day (20·50·200)"          // 150 in Swing + All

// ── slope / angle ─────────────────────────────────────────────────────────────
gS      = "Slope / angle"
slopeLb = input.int(5, "Slope lookback (bars)", minval = 1, group = gS, tooltip = "Measure the MA's rise over this many bars — smooths out single-bar noise so the angle isn't jumpy.")
atrLen  = input.int(14, "ATR length (normaliser)", minval = 1, group = gS)
scale45 = input.float(0.15, "ATR/bar that reads as 45°", minval = 0.02, maxval = 3, step = 0.01, group = gS, tooltip = "The angle measures the MA's rise in ATRs PER BAR, then converts to degrees. A rise of THIS many ATRs per bar = 45°. Lower it if healthy trends read too shallow; raise it if everything looks steep. Tune once to match how 45° looks on your chart.")
flatThr = input.float(12, "Flat threshold (°) — |angle| below = chop", minval = 0, maxval = 45, group = gS)
idealLo = input.float(30, "Ideal band — from (°)", minval = 0, maxval = 90, group = gS)
idealHi = input.float(55, "Ideal band — to (°)",   minval = 0, maxval = 90, group = gS)

// ── extension + coiling (T3 Live: "determine the stock's extension" / "anticipate a rise in vol") ──
gE     = "Extension / volatility"
extThr = input.float(3.0, "Extended when |price − MA| ≥ (× ATR)", minval = 0.5, maxval = 10, step = 0.25, group = gE, tooltip = "How far price is stretched from the 20MA, in ATRs. Beyond this = EXTENDED — a snap-back / pause toward the MA becomes likely (mean reversion). The MA is the magnet.")
coilPct = input.float(0.85, "Coiling when ATR < (× its 20-bar avg)", minval = 0.3, maxval = 1, step = 0.05, group = gE, tooltip = "When the MA is FLAT and ATR is below this fraction of its own 20-bar average, the stock is coiling — a rise in volatility (expansion) tends to follow.")

// ── setup / risk-reward (the tradeable read) ──────────────────────────────────
gT      = "Setup / risk-reward"
stopBuf = input.float(0.5, "Stop buffer beyond the MA / entry (× ATR)", minval = 0.1, maxval = 3, step = 0.1, group = gT, tooltip = "How far past the moving average (trend pullback) or past the entry (extended fade) the stop sits, in ATRs. The MA is the line you're wrong below/above.")
tgtExt  = input.float(3.0, "Trend target — extension from the MA (× ATR)", minval = 0.5, maxval = 10, step = 0.25, group = gT, tooltip = "For a trend pullback (long a rising MA / short a falling MA), the target is this many ATRs of EXTENSION away from the MA — how far the move tends to stretch. For an EXTENDED fade, the target is the MA itself (the magnet).")
sideTol = input.float(0.2, "Pullback side tolerance (× ATR)", minval = 0.0, maxval = 1, step = 0.05, group = gT, tooltip = "A pullback must be on the RIGHT side of the MA: a long only when price is at/above the rising MA (holding support), a short only when price is at/below the falling MA (rejecting resistance). This allows price to be this many ATRs the wrong side (a wick) before the setup is voided.")
nearMA  = input.float(1.5, "Hold zone — price within N × ATR above the 20", minval = 0.25, maxval = 5, step = 0.25, group = gT, tooltip = "The ACTION says 'LONG ✓ holding' ONLY when price is within this many ATRs above the rising 20 (a genuine pullback/hold of support). Farther above (but not yet EXTENDED) reads 'LONG (extended) — wait for a pullback', so a run far from the 20 never shows as a fresh buy. Raise to allow more room, lower to demand price hug the 20.")

// ── colors ────────────────────────────────────────────────────────────────────
gV      = "Colors by state"
colUpI  = input.color(#26A69A, "Rising · ideal (~45°)",             group = gV)
colUpW  = input.color(#80CBC4, "Rising · shallow (weak)",           group = gV)
colUpS  = input.color(#F59E0B, "Rising · steep (unsustainable)",    group = gV)
colDnI  = input.color(#EF5350, "Falling · ideal",                   group = gV)
colDnW  = input.color(#EF9A9A, "Falling · shallow",                 group = gV)
colDnS  = input.color(#AB47BC, "Falling · steep",                   group = gV)
colFlat = input.color(#9E9E9E, "Flat / chop",                       group = gV)

// ── HUD ───────────────────────────────────────────────────────────────────────
gH     = "Readout (HUD)"
enHud  = input.bool(true, "Show HUD", group = gH)
hudPos = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = gH)
hudSz  = input.string("normal", "Text size", options = ["small", "normal", "large"], group = gH)

// ── prior levels — PDH / PDL / PMH / PML ────────────────────────────────────────
gLv    = "Prior levels"
enPdh  = input.bool(true, "PDH", inline = "pd", group = gLv)
enPdl  = input.bool(true, "PDL", inline = "pd", group = gLv)
enPwh  = input.bool(true, "PWH", inline = "pw", group = gLv)
enPwl  = input.bool(true, "PWL", inline = "pw", group = gLv)
enPmh  = input.bool(true, "PMH", inline = "pm", group = gLv)
enPml  = input.bool(true, "PML", inline = "pm", group = gLv)
lvHiCol= input.color(color.new(#EF5350, 0), "High color", group = gLv)
lvLoCol= input.color(color.new(#26A69A, 0), "Low color",  group = gLv)
lvTagOff = input.int(10, "Tag column — bars right of the last bar", minval = 2, maxval = 40, group = gLv, tooltip = "The level lines extend LEFT across history and END at this column right of the last bar, where the tag sits — so labels land in clear space, not on the candles (same idiom as the other level pines).")

// ── compute — LOCKED to `lockTf` (default Daily). One request.security pulls the MA,
//    its value `slopeLb` bars back, ATR, ATR's own average, the 200 SMA and its lag —
//    so on a lower chart TF the whole read still reflects the daily 20-MA. Non-repainting.
f_ma20() =>
    _m  = maType == "EMA" ? ta.ema(close, maLen) : ta.sma(close, maLen)
    _a  = ta.atr(atrLen)
    _m2 = ta.sma(close, len200)
    _m5 = ta.sma(close, len50)
    _m15 = ta.sma(close, len150)
    [_m, _m[slopeLb], _a, ta.sma(_a, 20), _m2, _m2[slopeLb], _m5, _m5[slopeLb], _m15, _m15[slopeLb]]
[ma, maLb, atr, atrAvg, ma200, ma200Lb, ma50, ma50Lb, ma150, ma150Lb] = request.security(syminfo.tickerid, lockTf, f_ma20(), lookahead = barmerge.lookahead_off)
// rise per bar over the lookback, normalised to ATRs/bar, then to a degree angle.
perBar = (ma - maLb) / slopeLb
angle  = na(atr) or atr == 0 or na(ma) or na(maLb) ? 0.0 : math.todegrees(math.atan(perBar / (atr * scale45)))
pctLb  = na(ma) or ma == 0 ? 0.0 : (ma - maLb) / ma * 100.0   // % move of the MA over the lookback

// ── classify ──────────────────────────────────────────────────────────────────
_absA = math.abs(angle)
_up   = angle >  flatThr
_dn   = angle < -flatThr
state = _absA <= flatThr ? "FLAT · chop" :
         _up ? (_absA < idealLo ? "RISING · shallow (weak)" : _absA <= idealHi ? "RISING · IDEAL" : "RISING · steep (unsustainable)") :
               (_absA < idealLo ? "FALLING · shallow"        : _absA <= idealHi ? "FALLING · IDEAL" : "FALLING · steep")
maCol = _absA <= flatThr ? colFlat :
         _up ? (_absA < idealLo ? colUpW : _absA <= idealHi ? colUpI : colUpS) :
               (_absA < idealLo ? colDnW : _absA <= idealHi ? colDnI : colDnS)

// extension — how far price is stretched from the MA, in ATRs and %
extAtr = na(atr) or atr == 0 ? 0.0 : (close - ma) / atr
extPct = na(ma) or ma == 0 ? 0.0 : (close - ma) / ma * 100.0
_extended = math.abs(extAtr) >= extThr
// coiling — flat MA + ATR below its own average → volatility expansion likely
_coiling = _absA <= flatThr and not na(atrAvg) and atrAvg > 0 and atr < atrAvg * coilPct

// ── long-term trend context (200 SMA — also locked to lockTf) ──
_200up  = not na(ma200) and not na(ma200Lb) and ma200 > ma200Lb
col200  = _200up ? col200U : col200D
_50up   = not na(ma50) and not na(ma50Lb) and ma50 > ma50Lb
col50   = _50up ? col50U : col50D
_150up  = not na(ma150) and not na(ma150Lb) and ma150 > ma150Lb
col150  = _150up ? col150U : col150D
ltTrend = na(ma200) ? "—" : (close >= ma200 ? "UP · above 200" : "DOWN · below 200")

// ── per-MA slope in DEGREES — same scale-free ATR normalisation as the 20, so the
//    50 / 150 / 200 are judged on the SAME 45°=ATR/bar ruler. Lets you confirm each
//    MA is ACTUALLY rising (not just where price sits) before taking a swing entry.
f_ang(_m, _mLb) => na(atr) or atr == 0 or na(_m) or na(_mLb) ? na : math.todegrees(math.atan(((_m - _mLb) / slopeLb) / (atr * scale45)))
angle50  = f_ang(ma50,  ma50Lb)
angle150 = f_ang(ma150, ma150Lb)
angle200 = f_ang(ma200, ma200Lb)
// arrow + degree + band, and a rising/falling/flat color, reusing the 20's thresholds.
f_slopeTxt(_a) =>
    _aa = math.abs(_a)
    _ar = na(_a) ? "—" : _a > flatThr ? "↑" : _a < -flatThr ? "↓" : "→"
    _wd = na(_a) ? "" : _aa <= flatThr ? " flat" : _aa < idealLo ? " shallow" : _aa <= idealHi ? " ideal" : " steep"
    na(_a) ? "—" : _ar + " " + str.tostring(_a, "#.#") + "°" + _wd
f_slopeCol(_a) => na(_a) ? color.new(color.gray, 35) : _a > flatThr ? color.new(#26A69A, 0) : _a < -flatThr ? color.new(#EF5350, 0) : color.new(color.gray, 20)
// the MA's value + where price sits vs it (Minervini-style detail column).
f_maDet(_m) => na(_m) ? "" : "  ·  " + str.tostring(_m, format.mintick) + (close >= _m ? " · above" : " · below")

// ── SETUP + risk-reward. Entry is on the 20: pull back to it in a trend, or fade
//    to it when extended. Stop beyond the MA/entry; trend target = extension out.
_stopBuf = stopBuf * atr
_tgtExt  = tgtExt * atr
sdir  = ""
setup = "—"
float entry = na
float stop  = na
float tgt   = na
if _extended and extAtr > 0
    // very extended ABOVE the MA → fade the snap-back down to the MA
    sdir  := "SHORT"
    setup := "extended above → fade to the MA"
    entry := close
    stop  := close + _stopBuf
    tgt   := ma
else if (not _extended) and _dn and extAtr <= sideTol
    // falling MA → SHORT the rejection AT the MA (resistance). Only when price is at/below
    // the MA — price above a falling MA is a reclaim, not a short. (Extended BELOW a falling
    // MA is NOT a long — it matches no branch, so no setup; you wait for the rally to short.)
    sdir  := "SHORT"
    setup := "rejection at the falling MA (resistance)"
    entry := ma
    stop  := ma + _stopBuf
    tgt   := ma - _tgtExt
else if (not _extended) and _up and extAtr >= -sideTol
    // rising MA → LONG the reclaim/hold AT the MA (support). Only when price is at/above it —
    // price below a rising MA is broken support, not a long.
    sdir  := "LONG"
    setup := "reclaim / hold of the rising MA (support)"
    entry := ma
    stop  := ma - _stopBuf
    tgt   := ma + _tgtExt
_risk = na(entry) or na(stop) ? na : math.abs(entry - stop)
_rew  = na(entry) or na(tgt)  ? na : math.abs(tgt - entry)
rr    = na(_risk) or _risk == 0 or na(_rew) ? na : _rew / _risk
// % risk (entry→stop) and % target (entry→target), from the entry.
_riskPct = na(_risk) or na(entry) or entry == 0 ? na : _risk / entry * 100.0
_tgtPct  = na(_rew) or na(entry) or entry == 0 ? na : _rew / entry * 100.0
align = sdir == "" ? "" : ((sdir == "LONG" and close >= ma200) or (sdir == "SHORT" and close < ma200) ? "with 200-trend ✓" : "counter 200-trend ⚠")

// ── ACTION — the plain "act now / wait" call, keyed on the 20's slope BAND ──────
// Rising in the IDEAL band (idealLo..idealHi) with price holding the 20 = LONG, act.
// Shallow-rising = weak lean. Steep = strong but chase-risk. Flat = chop. Falling =
// no longs. Extended above = wait for the pullback to the 20.
_actGrn = color.new(#1B5E20, 0)
_actAmb = color.new(#7C5E10, 0)
_actRed = color.new(#8E1D1D, 0)
_actGry = color.new(color.gray, 35)
actTxt = "WAIT"
actBg  = _actGry
if _extended and extAtr > 0
    actTxt := "WAIT — extended above; buy the pullback to the 20"
    actBg  := _actAmb
else if _absA <= flatThr
    actTxt := "WAIT — 20 flat (chop), no trend"
    actBg  := _actGry
else if _up and _absA >= idealLo and _absA <= idealHi
    if extAtr < -sideTol
        actTxt := "LONG — 20 rising ideal; buy the RECLAIM of the 20"
        actBg  := _actGrn
    else if extAtr <= nearMA
        actTxt := "LONG ✓ — 20 rising IDEAL, price holding the 20"
        actBg  := _actGrn
    else
        actTxt := "LONG (extended +" + str.tostring(extPct, "#.#") + "%) — trend intact; WAIT for a pullback to the 20, don't chase"
        actBg  := _actAmb
else if _up and _absA < idealLo
    actTxt := "LONG-lean (weak) — 20 rising but shallow"
    actBg  := _actAmb
else if _up
    actTxt := "LONG (steep) — strong but chase-risk; wait for a pullback"
    actBg  := _actAmb
else
    actTxt := "AVOID longs — 20 falling (short-side only)"
    actBg  := _actRed

// Alert the moment it turns actionable-LONG (20 rising in the ideal band, price holding).
_longNow = _up and _absA >= idealLo and _absA <= idealHi and extAtr >= -sideTol and extAtr <= nearMA
alertcondition(_longNow and not _longNow[1], "20MA · LONG (rising ideal + holding)", "{{ticker}} — 20 MA rising in the ideal band and price HOLDING the 20 (not extended): LONG")

// Visibility = the line's own Show toggle AND the active MA set. 50 & 200 are in
// every set; the 20 shows in Day/All, the 150 shows in Swing/All.
plot(en200 ? ma200 : na, "200 SMA", color = col200, linewidth = w200)
plot(en150 and setShow150 ? ma150 : na, "150 SMA", color = col150, linewidth = w150)
plot(en50 ? ma50 : na, "50 SMA", color = col50, linewidth = w50)
plot(setShow20 ? ma : na, "20 MA", color = maCol, linewidth = maW)
// queryable data (Data Window / data_get_study_values), no chart clutter
plot(angle,  "MA angle (deg)",     display = display.data_window)
plot(pctLb,  "MA % over lookback", display = display.data_window)
plot(extAtr, "Extension (ATR)",    display = display.data_window)
plot(extPct, "Extension (%)",      display = display.data_window)
plot(na(rr) ? na : rr, "Setup R:R", display = display.data_window)
plot(angle50,  "50 SMA angle (deg)",  display = display.data_window)
plot(angle150, "150 SMA angle (deg)", display = display.data_window)
plot(angle200, "200 SMA angle (deg)", display = display.data_window)

// ── HUD ───────────────────────────────────────────────────────────────────────
_pos = hudPos == "top_left" ? position.top_left : hudPos == "bottom_right" ? position.bottom_right : hudPos == "bottom_left" ? position.bottom_left : position.top_right
_sz  = hudSz == "small" ? size.small : hudSz == "large" ? size.large : size.normal
var table hud = table.new(_pos, 2, 12, border_width = 1, border_color = color.new(color.gray, 55))
_cell(int col, int row, string txt, color bg, color tc, bool right) => table.cell(hud, col, row, txt, text_color = tc, bgcolor = bg, text_size = _sz, text_halign = right ? text.align_right : text.align_left)
if barstate.islast
    if enHud
        _lblBg = color.new(#0B0B12, 0)
        _lblTx = color.new(#C7C9D9, 0)
        _white = color.new(color.white, 0)
        _arrow = _up ? "↑" : _dn ? "↓" : "→"
        // header — 20 MA: angle + the 20's value + price
        _cell(0, 0, str.tostring(maLen) + (maType == "EMA" ? " EMA " : " SMA ") + _arrow, color.new(maCol, 12), _white, false)
        _cell(1, 0, str.tostring(angle, "#.#") + "°  ·  20@" + str.tostring(ma, format.mintick) + "  ·  px " + str.tostring(close, format.mintick), color.new(maCol, 12), _white, true)
        // ACTION — the plain go/wait call (keyed on the 20's slope band)
        _cell(0, 1, "Action", actBg, _white, false)
        _cell(1, 1, actTxt, actBg, _white, true)
        // trend (20 slope state) + the % the 20 rose over the slope lookback
        _cell(0, 2, "Trend", _lblBg, _lblTx, false)
        _cell(1, 2, state + "  ·  " + (pctLb >= 0 ? "+" : "") + str.tostring(pctLb, "#.#") + "% / " + str.tostring(slopeLb) + "d", _lblBg, _white, true)
        // ── per-MA slope (°) + the MA's value + above/below price ──
        _cell(0, 3, "50 SMA", _lblBg, _lblTx, false)
        _cell(1, 3, f_slopeTxt(angle50) + f_maDet(ma50), _lblBg, f_slopeCol(angle50), true)
        _cell(0, 4, "150 SMA", _lblBg, _lblTx, false)
        _cell(1, 4, f_slopeTxt(angle150) + f_maDet(ma150), _lblBg, f_slopeCol(angle150), true)
        _cell(0, 5, "200 SMA", _lblBg, _lblTx, false)
        _cell(1, 5, f_slopeTxt(angle200) + f_maDet(ma200), _lblBg, f_slopeCol(angle200), true)
        // extension
        _extBg = _extended ? color.new(#F59E0B, 20) : _coiling ? color.new(#42A5F5, 28) : _lblBg
        _extV  = (extAtr >= 0 ? "+" : "") + str.tostring(extAtr, "#.#") + " ATR (" + (extPct >= 0 ? "+" : "") + str.tostring(extPct, "#.#") + "%)" + (_extended ? " · EXTENDED" : _coiling ? " · COILING" : "")
        _cell(0, 6, "Extension", _lblBg, _lblTx, false)
        _cell(1, 6, _extV, _extBg, _white, true)
        // setup
        _sBg = sdir == "LONG" ? color.new(#1B5E20, 0) : sdir == "SHORT" ? color.new(#8E1D1D, 0) : color.new(color.gray, 35)
        _cell(0, 7, "Setup", _lblBg, _lblTx, false)
        _cell(1, 7, sdir == "" ? "— none (chop)" : sdir + " · " + setup, _sBg, _white, true)
        // entry / stop / target
        _cell(0, 8, "Entry", _lblBg, _lblTx, false)
        _cell(1, 8, na(entry) ? "—" : str.tostring(entry, format.mintick), _lblBg, _white, true)
        _cell(0, 9, "Stop", _lblBg, _lblTx, false)
        _cell(1, 9, na(stop) ? "—" : str.tostring(stop, format.mintick) + (na(_riskPct) ? "" : "  (−" + str.tostring(_riskPct, "#.#") + "%)"), _lblBg, color.new(#EF5350, 0), true)
        _cell(0, 10, "Target", _lblBg, _lblTx, false)
        _cell(1, 10, na(tgt) ? "—" : str.tostring(tgt, format.mintick) + (na(_tgtPct) ? "" : "  (+" + str.tostring(_tgtPct, "#.#") + "%)"), _lblBg, color.new(#26A69A, 0), true)
        // risk : reward + trend alignment
        _rrBg = na(rr) ? color.new(color.gray, 35) : rr >= 2 ? color.new(#1B5E20, 0) : rr >= 1 ? color.new(#F59E0B, 15) : color.new(#8E1D1D, 0)
        _cell(0, 11, "R : R", _lblBg, _lblTx, false)
        _cell(1, 11, na(rr) ? "—" : str.tostring(rr, "#.#") + " : 1" + (align == "" ? "" : "  ·  " + align), _rrBg, _white, true)
    else
        for _r = 0 to 11
            table.cell(hud, 0, _r, "", bgcolor = color.new(color.gray, 100))
            table.cell(hud, 1, _r, "", bgcolor = color.new(color.gray, 100))

// ═══ PRIOR LEVELS — PDH / PDL / PMH / PML (settled, non-repainting) ═══════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
var line  lnPdh = na
var label lbPdh = na
var line  lnPdl = na
var label lbPdl = na
var line  lnPwh = na
var label lbPwh = na
var line  lnPwl = na
var label lbPwl = na
var line  lnPmh = na
var label lbPmh = na
var line  lnPml = na
var label lbPml = na
f_lvl(line ln, label lb, bool on, float px, string txt, color col) =>
    line  _l = ln
    label _b = lb
    if on and not na(px)
        // house idiom: extend LEFT across history, terminate at a tag column on the right
        // where the label sits (like pdh_pdl_8d / weekly_stage) — tag never covers price.
        if na(_l)
            _l := line.new(bar_index, px, bar_index + lvTagOff, px, xloc = xloc.bar_index, color = col, width = 1, style = line.style_dotted, extend = extend.left)
            _b := label.new(bar_index + lvTagOff, px, txt + " " + str.tostring(px, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(col, 90), textcolor = col, size = size.tiny)
        else
            line.set_xy1(_l, bar_index, px)
            line.set_xy2(_l, bar_index + lvTagOff, px)
            label.set_xy(_b, bar_index + lvTagOff, px)
            label.set_text(_b, txt + " " + str.tostring(px, format.mintick))
    else
        if not na(_l)
            line.delete(_l)
            _l := na
        if not na(_b)
            label.delete(_b)
            _b := na
    [_l, _b]
if barstate.islast
    [_a, _b] = f_lvl(lnPdh, lbPdh, enPdh, pdh, "PDH", lvHiCol)
    lnPdh := _a
    lbPdh := _b
    [_c, _d] = f_lvl(lnPdl, lbPdl, enPdl, pdl, "PDL", lvLoCol)
    lnPdl := _c
    lbPdl := _d
    [_wa, _wb] = f_lvl(lnPwh, lbPwh, enPwh, pwh, "PWH", lvHiCol)
    lnPwh := _wa
    lbPwh := _wb
    [_wc, _wd] = f_lvl(lnPwl, lbPwl, enPwl, pwl, "PWL", lvLoCol)
    lnPwl := _wc
    lbPwl := _wd
    [_e, _f] = f_lvl(lnPmh, lbPmh, enPmh, pmh, "PMH", lvHiCol)
    lnPmh := _e
    lbPmh := _f
    [_g, _h] = f_lvl(lnPml, lbPml, enPml, pml, "PML", lvLoCol)
    lnPml := _g
    lbPml := _h
