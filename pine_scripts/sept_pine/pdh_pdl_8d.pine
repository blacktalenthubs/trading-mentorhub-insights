//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// PDH / PDL · 8 Days — STRICTLY the daily High & Low of the last N sessions.
// ─────────────────────────────────────────────────────────────────────────────
// Nothing but the prior-day highs & lows for the last N days (default 8) as FLAT
// horizontal lines, tagged D-1 … D-8. No W/M/Q, no SMAs/EMAs, no open line, no
// confluence merge — just the raw daily rails. RTH-accurate (regular session, so
// extended-hours prints never leak into the daily H/L) and non-repainting
// (settled offsets + lookahead_on).
//
// EVERY one of the last N days' PDH/PDL ALWAYS draws — this is a clean "last 8
// sessions' rails" tool. An OPTIONAL ± % cap (off by default) hides only a day
// whose H/L is very far from price, so a far day can't squash the scale; it never
// drops a nearer day for a farther one. Colored by ROLE vs price (green = support
// below · red = resistance above), faded by age. Bind on any timeframe.
// ─────────────────────────────────────────────────────────────────────────────
indicator("PDH/PDL · 8 Days", "pdh-pdl-8d", overlay = true, max_lines_count = 30, max_labels_count = 30)

// ── inputs ───────────────────────────────────────────────────────────────────
nDays     = input.int(8, "Prior days (PDH/PDL)", minval = 1, maxval = 8)
inclToday = input.bool(false, "Include today's developing H/L", tooltip = "Also draw the CURRENT session's high & low so far (tagged 'today'). Off = prior days only (D-1..D-N).")
roleCol   = input.bool(true, "Color by role vs price", tooltip = "On: a level BELOW price draws green (support), ABOVE draws red (resistance). Off: PDH always red, PDL always green.")
colHi     = input.color(#EF5350, "High / resistance", inline = "c")
colLo     = input.color(#26A69A, "Low / support",    inline = "c")
wLine     = input.int(2, "Line thickness", minval = 1, maxval = 6)
lineLen   = input.int(80, "Line length (bars back)", minval = 10, maxval = 500)
tagOff    = input.int(8, "Label offset (bars right)", minval = 0, maxval = 50)
lblSide   = input.string("Right", "Label side", options = ["Left", "Right"])
showLbl   = input.bool(true, "Show labels")
fadeOld   = input.bool(true, "Fade older days")

// ── proximity — optional far-distance cap (all recent days draw by default) ───
gP      = "Proximity (anti-compression — optional)"
proxPct = input.float(0, "Hide a day level beyond ± % of price (0 = show all N days)", group = gP, minval = 0, maxval = 50, step = 0.5, tooltip = "By default EVERY one of the last N days' PDH/PDL draws. Set this above 0 to hide any day's H/L farther than this % from price, so a far day can't squash the scale. It NEVER drops a nearer day for a farther one — it's a distance cutoff, not a count.") / 100.0

// ── RTH-accurate daily H/L for today + the last 8 sessions (settled, non-repainting) ──
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[dh0, dh1, dh2, dh3, dh4, dh5, dh6, dh7, dh8] = request.security(rthTid, "D", [high, high[1], high[2], high[3], high[4], high[5], high[6], high[7], high[8]], lookahead = barmerge.lookahead_on)
[dl0, dl1, dl2, dl3, dl4, dl5, dl6, dl7, dl8] = request.security(rthTid, "D", [low,  low[1],  low[2],  low[3],  low[4],  low[5],  low[6],  low[7],  low[8]],  lookahead = barmerge.lookahead_on)

// ── draw (rebuilt on the last bar) ────────────────────────────────────────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()

f_draw(float v, string nm, int age, bool isHigh) =>
    if not na(v)
        _base = roleCol ? (v >= close ? colHi : colLo) : (isHigh ? colHi : colLo)
        _fade = fadeOld ? math.min(70, age * 8) : 0        // today/D-1 solid, each older day fainter
        _col  = color.new(_base, _fade)
        array.push(_ln, line.new(bar_index - lineLen, v, bar_index + tagOff, v, color = _col, width = wLine, extend = extend.left))
        if showLbl
            _lx = lblSide == "Left" ? bar_index - lineLen : bar_index + tagOff
            _ls = lblSide == "Left" ? label.style_label_right : label.style_label_left
            array.push(_lb, label.new(_lx, v, nm + "  " + str.tostring(v, format.mintick), style = _ls, color = color.new(_base, 82), textcolor = _base, size = size.small))

if barstate.islast
    for x in _ln
        line.delete(x)
    for y in _lb
        label.delete(y)
    array.clear(_ln)
    array.clear(_lb)
    // gather each in-window daily H/L with a compact tag + age (0 = today, 1 = D-1 …)
    _hs = array.from(dh0, dh1, dh2, dh3, dh4, dh5, dh6, dh7, dh8)
    _ls = array.from(dl0, dl1, dl2, dl3, dl4, dl5, dl6, dl7, dl8)
    _V  = array.new_float()
    _T  = array.new_string()
    _G  = array.new_int()
    _IH = array.new_bool()
    _start = inclToday ? 0 : 1
    for _a = _start to nDays
        _lab = _a == 0 ? "today" : "D-" + str.tostring(_a)
        _hv  = array.get(_hs, _a)
        _lv  = array.get(_ls, _a)
        if not na(_hv)
            array.push(_V, _hv)
            array.push(_T, "PDH " + _lab)
            array.push(_G, _a)
            array.push(_IH, true)
        if not na(_lv)
            array.push(_V, _lv)
            array.push(_T, "PDL " + _lab)
            array.push(_G, _a)
            array.push(_IH, false)
    // ── draw EVERY gathered day level (all N recent days always show); an optional
    //    ± % cap hides only the truly-far ones so they can't squash the scale.
    if array.size(_V) > 0
        for _i = 0 to array.size(_V) - 1
            _v   = array.get(_V, _i)
            _cap = proxPct <= 0 or math.abs(close - _v) / close <= proxPct
            if _cap
                f_draw(_v, array.get(_T, _i), array.get(_G, _i), array.get(_IH, _i))
