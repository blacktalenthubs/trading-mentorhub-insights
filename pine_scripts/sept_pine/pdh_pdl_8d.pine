//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// PDH / PDL · 8 Days — STRICTLY the daily High & Low of the last N sessions.
// ─────────────────────────────────────────────────────────────────────────────
// Nothing but the prior-day highs & lows for the last N days (default 8) as FLAT
// horizontal lines, plus today's open. Each is tagged by ROLE, not day number:
// "PDH · RESISTANCE" when it's above price, "PDL · SUPPORT" when below — the day
// count is dropped EXCEPT the recent day (D-1) / today, which are marked and drawn
// crisp+thick since they matter most. No W/M/Q, no SMAs/EMAs — just the raw daily
// rails. Coincident levels within the confluence % merge into one thicker "CONF
// ×N" line. RTH-accurate and non-repainting (settled + lookahead_on).
//
// EVERY one of the last N days' PDH/PDL ALWAYS draws — this is a clean "last 8
// sessions' rails" tool. An OPTIONAL ± % cap (off by default) hides only a day
// whose H/L is very far from price, so a far day can't squash the scale; it never
// drops a nearer day for a farther one. Colored by ROLE vs price (green = support
// below · red = resistance above), faded by age. Bind on any timeframe.
// ─────────────────────────────────────────────────────────────────────────────
indicator("PDH/PDL · 8 Days", "pdh-pdl-8d", overlay = true, max_lines_count = 30, max_labels_count = 30)

// ── inputs ───────────────────────────────────────────────────────────────────
nDays     = input.int(8, "Prior days (PDH/PDL)", minval = 1, maxval = 8)
inclToday = input.bool(false, "Include today's developing H/L", tooltip = "Also draw the CURRENT session's high & low so far (tagged 'today'). Off = prior days only (D-1..D-N).")
roleCol   = input.bool(true, "Color by role vs price", tooltip = "On: a level BELOW price draws green (support), ABOVE draws red (resistance). Off: PDH always red, PDL always green.")
colHi     = input.color(#EF5350, "High / resistance", inline = "c")
colLo     = input.color(#26A69A, "Low / support",    inline = "c")
wLine     = input.int(2, "Line thickness", minval = 1, maxval = 6)
lineLen   = input.int(80, "Line length (bars back)", minval = 10, maxval = 500)
tagOff    = input.int(8, "Label offset (bars right)", minval = 0, maxval = 50)
lblSide   = input.string("Right", "Label side", options = ["Left", "Right"])
showLbl   = input.bool(true, "Show labels")
fadeOld   = input.bool(true, "Fade older days")
mergePct  = input.float(0.09, "Confluence — merge levels within (%) into one", minval = 0, maxval = 5, step = 0.01, tooltip = "Two day levels within this % of EACH OTHER collapse into ONE thicker line tagged 'CONF ×N · …'. Default 0.09%. 0 = never merge.") / 100.0

// ── proximity — how to choose which day levels draw (default: all N days) ─────
gP       = "Proximity"
proxMode = input.string("All (every day)", "Proximity mode", options = ["All (every day)", "Percent band", "Nearest N neighbors"], group = gP, tooltip = "All = draw every one of the last N days (default — the clean 'last 8 sessions' rails'). Percent band = only day levels within ± base % of price (anti-compression, keeps all that are near). Nearest N neighbors = the N closest levels above price and N below (a count).")
basePct  = input.float(2.0, "  Percent band — ± % of price", group = gP, minval = 0.1, maxval = 30, step = 0.1, tooltip = "Percent-band mode: only day levels within this % of price draw.") / 100.0
nUp      = input.int(3, "  Nearest N — ABOVE", group = gP, minval = 0, maxval = 16, inline = "n", tooltip = "Nearest-N mode: N closest levels above price and N below.")
nDn      = input.int(3, "  BELOW", group = gP, minval = 0, maxval = 16, inline = "n")

// ── today's open ──────────────────────────────────────────────────────────────
gO      = "Day open"
enOpen  = input.bool(true, "Mark today's open (subtle dotted) + tag vs D-1 PDH/PDL", group = gO)
openCol = input.color(color.new(#EAB308, 0), "Open line", group = gO)

// ── RTH-accurate daily H/L for today + the last 8 sessions (settled, non-repainting) ──
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[dh0, dh1, dh2, dh3, dh4, dh5, dh6, dh7, dh8] = request.security(rthTid, "D", [high, high[1], high[2], high[3], high[4], high[5], high[6], high[7], high[8]], lookahead = barmerge.lookahead_on)
[dl0, dl1, dl2, dl3, dl4, dl5, dl6, dl7, dl8] = request.security(rthTid, "D", [low,  low[1],  low[2],  low[3],  low[4],  low[5],  low[6],  low[7],  low[8]],  lookahead = barmerge.lookahead_on)
dayOpen = request.security(rthTid, "D", open, lookahead = barmerge.lookahead_on)

// ── draw (rebuilt on the last bar) ────────────────────────────────────────────
var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()

f_draw(float v, string nm, int age, bool isHigh, bool conf, bool imp) =>
    if not na(v)
        _base = roleCol ? (v >= close ? colHi : colLo) : (isHigh ? colHi : colLo)
        _fade = fadeOld ? (age <= 1 ? 0 : math.min(78, (age - 1) * 12)) : 0   // today/D-1 crisp, older days fainter
        _col  = color.new(_base, _fade)
        _w    = (conf or imp) ? wLine + 1 : wLine                             // D-1/today + confluences drawn thicker
        array.push(_ln, line.new(bar_index - lineLen, v, bar_index + tagOff, v, color = _col, width = _w, extend = extend.left))
        if showLbl
            _lx = lblSide == "Left" ? bar_index - lineLen : bar_index + tagOff
            _ls = lblSide == "Left" ? label.style_label_right : label.style_label_left
            array.push(_lb, label.new(_lx, v, nm + "  " + str.tostring(v, format.mintick), style = _ls, color = color.new(_base, 82), textcolor = _base, size = size.small))

if barstate.islast
    for x in _ln
        line.delete(x)
    for y in _lb
        label.delete(y)
    array.clear(_ln)
    array.clear(_lb)
    // gather each in-window daily H/L with a compact tag + age (0 = today, 1 = D-1 …)
    _hs = array.from(dh0, dh1, dh2, dh3, dh4, dh5, dh6, dh7, dh8)
    _ls = array.from(dl0, dl1, dl2, dl3, dl4, dl5, dl6, dl7, dl8)
    _V  = array.new_float()
    _T  = array.new_string()
    _G  = array.new_int()
    _IH = array.new_bool()
    _start = inclToday ? 0 : 1
    for _a = _start to nDays
        _hv  = array.get(_hs, _a)
        _lv  = array.get(_ls, _a)
        if not na(_hv)
            array.push(_V, _hv)
            array.push(_T, "PDH")
            array.push(_G, _a)
            array.push(_IH, true)
        if not na(_lv)
            array.push(_V, _lv)
            array.push(_T, "PDL")
            array.push(_G, _a)
            array.push(_IH, false)
    // ── nearest-N brackets (only used in "Nearest N neighbors" mode) ──
    _ab = array.new_float()
    _bl = array.new_float()
    if array.size(_V) > 0
        for _i = 0 to array.size(_V) - 1
            _v = array.get(_V, _i)
            if _v > close
                array.push(_ab, _v)
            else if _v < close
                array.push(_bl, _v)
    array.sort(_ab, order.ascending)     // nearest-above first
    array.sort(_bl, order.descending)    // nearest-below first
    _brkHi = nUp <= 0 or array.size(_ab) == 0 ? (nUp <= 0 ? -1.0 : 1.0e18) : array.get(_ab, math.min(nUp, array.size(_ab)) - 1)
    _brkLo = nDn <= 0 or array.size(_bl) == 0 ? (nDn <= 0 ? 1.0e18 : -1.0) : array.get(_bl, math.min(nDn, array.size(_bl)) - 1)
    // ── merge coincident levels within mergePct into ONE thicker CONF line, then draw ──
    _U = array.new_bool(array.size(_V), false)
    if array.size(_V) > 0
        for _i = 0 to array.size(_V) - 1
            if not array.get(_U, _i)
                _v    = array.get(_V, _i)
                _nm   = array.get(_T, _i)
                _age  = array.get(_G, _i)
                _high = array.get(_IH, _i)
                _cnt  = 1
                if mergePct > 0 and _i < array.size(_V) - 1
                    for _j = _i + 1 to array.size(_V) - 1
                        _vj = array.get(_V, _j)
                        if not array.get(_U, _j) and math.abs(_vj - _v) / _v <= mergePct
                            array.set(_U, _j, true)
                            _nm  := _nm + " + " + array.get(_T, _j)
                            _cnt := _cnt + 1
                            _age := math.min(_age, array.get(_G, _j))
                array.set(_U, _i, true)
                // proximity gate per the chosen mode
                _pass = proxMode == "Percent band" ? (math.abs(close - _v) / close <= basePct) : proxMode == "Nearest N neighbors" ? (_v <= _brkHi and _v >= _brkLo) : true
                if _pass
                    // ROLE tag by price position — a level ABOVE price is RESISTANCE, below is SUPPORT.
                    // Day number is dropped EXCEPT the recent day (D-1) / today, which are called out.
                    _role = _v >= close ? "RESISTANCE" : "SUPPORT"
                    _dm   = _age == 0 ? " (today)" : _age == 1 ? " D-1" : ""
                    _fnm  = _cnt > 1 ? "CONF ×" + str.tostring(_cnt) + _dm + " · " + _role : _nm + _dm + " · " + _role
                    f_draw(_v, _fnm, _age, _high, _cnt > 1, _age <= 1)

    // ── subtle dotted OPEN line — today's open, tagged vs yesterday's (D-1) PDH / PDL ──
    if enOpen and not na(dayOpen)
        _oc = not na(dh1) and dayOpen > dh1 ? "  · above PDH ▲" : not na(dl1) and dayOpen < dl1 ? "  · below PDL ▼" : (not na(dh1) and not na(dl1) ? "  · inside PDH–PDL" : "")
        array.push(_ln, line.new(bar_index - lineLen, dayOpen, bar_index + tagOff, dayOpen, color = color.new(openCol, 20), width = 1, style = line.style_dotted, extend = extend.left))
        if showLbl
            array.push(_lb, label.new(bar_index + tagOff, dayOpen, "Open " + str.tostring(dayOpen, format.mintick) + _oc, style = label.style_label_left, color = color.new(openCol, 15), textcolor = color.black, size = size.small))
