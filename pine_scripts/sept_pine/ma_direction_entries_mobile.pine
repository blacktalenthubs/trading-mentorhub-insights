//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// MA · DIRECTION & ENTRIES — the 20-MA Direction indicator and the Minervini
// swing MAs folded into ONE daily tool. Four moving averages (20 / 50 / 150 / 200),
// each a VALID entry: the tool scores every MA's SLOPE as a scale-free degree angle
// (~45° ideal), and treats each as support/resistance — LONG when a RISING MA is
// holding as support (price at/just above it), SHORT when a FALLING MA is rejecting
// (price rallies to it and stalls). The NEAREST MA price is interacting with becomes
// the active Entry / Stop (beyond the MA) / Target (extension) / R:R.
//
//   • Every MA is independent: uncheck it, set its colour (rising/falling) and width.
//   • The angle is SCALE-FREE — it measures the MA's rise in ATRs/bar and converts
//     to degrees, so 45° means the same thing on every symbol. Tune "ATR/bar = 45°".
//   • Also a MINERVINI qualification (> 150/200 · 200 rising · > 50 = a buyable trend)
//     and an RSI reclaim entry (RSI 30-35 turning up = oversold bounce), both surfaced
//     as first-class entries alongside the MA support/resistance ones.
// MOBILE VERSION — the fundamentals panel is removed and the HUD is rebuilt as a
// SINGLE-COLUMN table pinned top-right, so it stacks TALL & NARROW instead of the wide
// two-column desktop spread: one item per row — action, the WEINSTEIN STAGE (1 basing /
// 2 uptrend / 3 topping / 4 downtrend, from price vs the 200 + the 200's slope), each MA's
// slope (5/20/50/150/200), RSI, the Trend-Template/Minervini score, extension, then
// entry / stop / target / R:R / base.
// The day's OPEN is drawn as a line with a bold "Open <px>" chip, plus a bold GREEN(S)/RED(R)
// chip AT each MA's price — open ABOVE a MA = support (S), below = resistance (R) — shown for
// ALL five MAs regardless of which lines you hide, so you can keep only 20 & 200 drawn and
// still read where price opened vs any MA. The 5 SMA is the short-term trend-protection line.
// The MAs, the VCP base box + pivot/stop/breakout, prior levels (PDH/PDL/PWH/PWL/PMH/
// PML, W/M gated by proximity) and the recent gap S/R zone all stay. Unlike the desktop
// pine, the MAs FOLLOW THE CHART timeframe by default so you can read 15m/1h MA levels
// intraday — flip "Lock MAs to a fixed timeframe" (Daily by default) to lock them. For the full
// tabular read + reported fundamentals, use the desktop "MA · Direction & Entries" pine.
// ─────────────────────────────────────────────────────────────────────────────
indicator("MA · Entries (mobile)", "MA-entries·m", overlay = true, max_lines_count = 100, max_labels_count = 150)

// ── the four moving averages — each independent (uncheck / colour / width) ──────
gTf    = "Timeframe"
lockOn     = input.bool(false, "Lock MAs to a fixed timeframe", group = gTf, tooltip = "OFF (default) = the MAs, slopes, RSI and the entry engine FOLLOW THE CHART timeframe — so on a 15m/1h chart you get 15m/1h MA levels. ON = LOCK them to the timeframe below (Daily by default) regardless of the chart TF. Flip this here in settings to switch. Non-repainting (lookahead off).")
lockTfPick = input.timeframe("D", "…locked timeframe", group = gTf, tooltip = "Which timeframe to lock to when 'Lock MAs' is ON. Daily by default. Note: the Trend-Template 52-week / RS reads and the VCP base are bar-count based (so they mean 'daily' only on a daily chart); the PDH/PDL/PWH/PWL/PMH/PML levels are always day/week/month.")
lockTf     = lockOn ? lockTfPick : timeframe.period
maType = input.string("SMA", "MA type", options = ["SMA", "EMA"], group = gTf, tooltip = "SMA (Minervini / Weinstein convention) or EMA. Applies to all four lines.")

// ── open line + MA roles ────────────────────────────────────────────────────────
gOpen  = "Open line & MA roles"
enOpen = input.bool(true, "Show the open line + S/R context", group = gOpen, tooltip = "Draws the day's OPEN as a line. The label reads WHERE the open sits: 'between 20 & 50 SMA' (the two MAs bracketing it), or 'above all SMA · res PDH …' (nearest upside level when the open is above every MA), or 'below all SMA · sup PDL …'. Plus a bold green(S)/red(R) chip on each MA (open above = support, below = resistance), shown for all five MAs whether or not their lines are drawn.")
colOpen = input.color(#B0BEC5, "Open colour", group = gOpen)
wOpen   = input.int(1, "Open width", minval = 1, maxval = 4, group = gOpen)
enWkOpen = input.bool(true, "Weekly open line",  inline = "wm", group = gOpen, tooltip = "Separate faint lines at the WEEKLY and MONTHLY open — the higher-timeframe reference: holding above the weekly/monthly open = the week/month is bullish from its open.")
enMoOpen = input.bool(true, "Monthly open line", inline = "wm", group = gOpen)
colWkOpen = input.color(#5C6BC0, "Weekly",  inline = "wmc", group = gOpen)
colMoOpen = input.color(#8E24AA, "Monthly", inline = "wmc", group = gOpen)
openSz  = input.string("normal", "Open + S/R chip size", options = ["small", "normal", "large"], group = gOpen, tooltip = "Sizes the 'Open' chip and (if shown) the green(S)/red(R) role chips.")
enRoleChips = input.bool(false, "Show S/R chip at each MA (open-relative)", group = gOpen, tooltip = "OFF by default — the little green(S)/red(R) chip sitting at each MA's price clutters the chart and the MAs are already identifiable by colour. Turn ON only if you want the open-relative S/R chip on every MA.")

// 5 — short-term trend protection (the fast line: price above it = very short-term uptrend intact).
g5    = "5 SMA (short-term protection)"
en5   = input.bool(true, "Show the 5", group = g5)
len5  = input.int(5, "Length", minval = 2, group = g5)
col5  = input.color(#00ACC1, "Colour", group = g5)
w5    = input.int(1, "Width", minval = 1, maxval = 6, group = g5)

// 20 — the primary. Fixed DEEP GREEN line (slope direction still shows in the HUD row).
g20   = "20 MA (primary)"
en20  = input.bool(true, "Show the 20", group = g20)
len20 = input.int(20, "Length", minval = 2, group = g20)
col20 = input.color(#1B5E20, "Colour", group = g20)
w20   = input.int(2, "Width", minval = 1, maxval = 6, group = g20)

// 50 — mid-term. Blue.
g50   = "50 SMA"
en50  = input.bool(true, "Show the 50", group = g50)
len50 = input.int(50, "Length", minval = 5, group = g50)
col50c = input.color(#1565C0, "Colour", group = g50)
w50    = input.int(2, "Width", minval = 1, maxval = 6, group = g50)

// 150 ≈ the 30-week line (Weinstein Stage-2 support). Deep yellow.
g150   = "150 SMA (≈ 30-week)"
en150  = input.bool(true, "Show the 150", group = g150, tooltip = "150 trading days ≈ 30 weeks — the daily proxy of the 30-week MA institutions defend on a swing pullback.")
len150 = input.int(150, "Length", minval = 20, group = g150)
col150c = input.color(#F9A825, "Colour", group = g150)
w150    = input.int(2, "Width", minval = 1, maxval = 6, group = g150)

// 200 — long-term trend. Deep black.
g200   = "200 SMA"
en200  = input.bool(true, "Show the 200", group = g200)
len200 = input.int(200, "Length", minval = 20, group = g200)
col200c = input.color(#000000, "Colour", group = g200)
w200    = input.int(3, "Width", minval = 1, maxval = 6, group = g200)

// ── MA identity tags — a small faint tag at each MA's price so you can tell which is
//    which EVEN WHEN its line is toggled off. Keep the chart clean (just the 20 & 50
//    lines on) and still read where the 5/150/200 sit from their tags. Lines unchanged.
gMaTag  = "MA tags"
enMaTag = input.bool(true, "Show a small MA tag (even when the line is off)", group = gMaTag, tooltip = "A faint tag at each MA's price naming it (5 / 20 / 50 / 150 / 200), in the MA's own colour, whether or not its line is drawn. So you can hide most lines for a clean chart and still know where every MA sits.")
maTagSz = input.string("small", "Tag size", options = ["tiny", "small", "normal"], group = gMaTag)
enFaint = input.bool(true, "Faint line for a MA when its full line is off", group = gMaTag, tooltip = "When a MA's 'Show' toggle is OFF, draw a FAINT version of its line instead of nothing — so you keep the clean chart (only the MAs you turned on are bold) but still see the curve of the others. Adjust the faintness below. Turn this off to leave OFF MAs as tag-only (no line).")
faintTransp = input.int(75, "Faint line transparency (0 = solid, 100 = invisible)", minval = 0, maxval = 100, group = gMaTag)

// ── slope / angle (the same ruler judges all four MAs) ─────────────────────────
gS      = "Slope / angle"
slopeLb = input.int(5, "Slope lookback (bars)", minval = 1, group = gS, tooltip = "Measure each MA's rise over this many bars — smooths single-bar noise so the angle isn't jumpy.")
atrLen  = input.int(14, "ATR length (normaliser)", minval = 1, group = gS)
scale45 = input.float(0.15, "ATR/bar that reads as 45°", minval = 0.02, maxval = 3, step = 0.01, group = gS, tooltip = "The angle measures a MA's rise in ATRs PER BAR, then converts to degrees. A rise of THIS many ATRs/bar = 45°. Lower it if healthy trends read too shallow; raise it if everything looks steep. Tune once to match how 45° looks on your chart.")
flatThr = input.float(12, "Flat threshold (°) — |angle| below = chop", minval = 0, maxval = 45, group = gS)
idealLo = input.float(30, "Ideal band — from (°)", minval = 0, maxval = 90, group = gS)
idealHi = input.float(55, "Ideal band — to (°)",   minval = 0, maxval = 90, group = gS)

// ── extension + coiling (read on the 20) ───────────────────────────────────────
gE     = "Extension / volatility (on the 20)"
extThr = input.float(3.0, "Extended when |price − 20| ≥ (× ATR)", minval = 0.5, maxval = 10, step = 0.25, group = gE, tooltip = "How far price is stretched from the 20, in ATRs. Beyond this = EXTENDED — a snap-back / pause toward a MA becomes likely (mean reversion).")
coilPct = input.float(0.85, "Coiling when ATR < (× its 20-bar avg)", minval = 0.3, maxval = 1, step = 0.05, group = gE, tooltip = "When the 20 is FLAT and ATR is below this fraction of its own 20-bar average, the stock is coiling — a rise in volatility (expansion) tends to follow.")

// ── setup / risk-reward (applies to whichever MA price is at) ───────────────────
gT      = "Setup / risk-reward"
stopBuf = input.float(0.5, "Stop buffer beyond the MA / entry (× ATR)", minval = 0.1, maxval = 3, step = 0.1, group = gT, tooltip = "How far past the moving average (trend pullback) or past the entry (extended fade) the stop sits, in ATRs. The MA is the line you're wrong below/above.")
tgtExt  = input.float(3.0, "Trend target — extension from the MA (× ATR)", minval = 0.5, maxval = 10, step = 0.25, group = gT, tooltip = "For a trend pullback (long a rising MA / short a falling MA) the target is this many ATRs of EXTENSION away from the MA. For an EXTENDED fade the target is the 20 itself (the magnet).")
sideTol = input.float(0.2, "Pullback side tolerance (× ATR)", minval = 0.0, maxval = 1, step = 0.05, group = gT, tooltip = "A pullback must be on the RIGHT side of the MA: a long only when price is at/above the rising MA (holding support), a short only when price is at/below the falling MA (rejecting resistance). This allows price to be this many ATRs the wrong side (a wick) before the setup is voided.")
nearMA  = input.float(1.5, "Hold zone — price within N × ATR of the MA", minval = 0.25, maxval = 5, step = 0.25, group = gT, tooltip = "An entry is 'holding' only when price is within this many ATRs of the MA (a genuine pullback/hold). Farther than this and there is no fresh entry at that MA — price must come back to it. Raise to allow more room, lower to demand price hug the MA.")

// ── RSI oversold-reclaim entry ──────────────────────────────────────────────────
gR     = "RSI entry"
enRsi  = input.bool(true, "RSI reclaim entry (oversold bounce)", group = gR, tooltip = "A LONG when daily RSI is inside the reclaim band and turning UP — an oversold bounce. Entry at the close, stop under the recent swing low, target the nearest MA above (else 2R). Ranks below a MA support entry, above nothing.")
rsiLen = input.int(14, "RSI length", minval = 2, group = gR)
rsiLo  = input.float(30.0, "Reclaim band — from", minval = 1, maxval = 50, group = gR)
rsiHi  = input.float(35.0, "Reclaim band — to",   minval = 1, maxval = 60, group = gR)
rsiStopLb = input.int(10, "Swing-low lookback for the stop (bars)", minval = 2, maxval = 60, group = gR)
showRsi = input.bool(true, "Show the RSI row", group = gR)

// ── Minervini Trend Template (compact score line) ──────────────────────────────
gTT       = "Trend Template (Minervini)"
showTT    = input.bool(true, "Show the Trend Template score", group = gTT, tooltip = "The 8-rule Stage-2 screen scored X/8 on one HUD line: price > 150 & 200, 150 > 200, 200 rising ~1m, 50 > 150 & 200, price > 50, ≥30% above the 52-wk low, within 25% of the 52-wk high, RS leading the benchmark.")
benchSym  = input.symbol("SPY", "RS benchmark", group = gTT)
riseBars  = input.int(21, "200 rising over N bars (≈ 1m)", minval = 1, group = gTT)
lookback  = input.int(252, "52-week lookback (bars)", minval = 20, group = gTT)
minAboveLow = input.float(30.0, "Rule 6 — min % above 52-wk low", minval = 0, group = gTT)
maxBelowHi  = input.float(25.0, "Rule 7 — max % below 52-wk high", minval = 0, group = gTT)

// ── HUD ───────────────────────────────────────────────────────────────────────
gH     = "HUD"
enHud  = input.bool(true, "Show the HUD", group = gH)
hudCollapse = input.bool(false, "Collapse HUD (Action + Stage only)", group = gH, tooltip = "Collapsed = just the Action + Stage rows (a small footprint that won't cover the chart). Expanded = the full read (MA degrees, RSI, TT, extension, entry/stop/target/R:R, base). Flip here to expand/collapse.")
hudSz  = input.string("normal", "Text size", options = ["small", "normal", "large"], group = gH)

// ── prior levels — PDH / PDL / PWH / PWL / PMH / PML ─────────────────────────────
gLv    = "Prior levels"
enPdh  = input.bool(true, "PDH", inline = "pd", group = gLv)
enPdl  = input.bool(true, "PDL", inline = "pd", group = gLv)
enPwh  = input.bool(true, "PWH", inline = "pw", group = gLv)
enPwl  = input.bool(true, "PWL", inline = "pw", group = gLv)
enPmh  = input.bool(true, "PMH", inline = "pm", group = gLv)
enPml  = input.bool(true, "PML", inline = "pm", group = gLv)
lvHiCol= input.color(color.new(#EF5350, 0), "High color", group = gLv)
lvLoCol= input.color(color.new(#26A69A, 0), "Low color",  group = gLv)
lvTagOff = input.int(10, "Tag column — bars right of the last bar", minval = 2, maxval = 40, group = gLv)
lvTagSz = input.string("normal", "Level tag size", options = ["small", "normal", "large"], group = gLv, tooltip = "Sizes the PDH/PDL/PWH/PWL/PMH/PML tag chips. The line stays faint (dotted) — only the label is bold, so a level is easy to read even when the line is subtle.")
gateWM = input.bool(true, "Gate weekly/monthly by proximity", group = gLv, tooltip = "Only draw the weekly (PWH/PWL) and monthly (PMH/PML) levels when price is within the % below — far ones are hidden so the chart stays clean. Daily levels (PDH/PDL) are always shown.")
lvProx = input.float(5.0, "…within N% of price", minval = 0.5, maxval = 50, step = 0.5, group = gLv)

// ── volume profile (POC/VAH/VAL flat) + rolling VWAP (curve) — for pattern testing ──
gVP      = "Volume profile + VWAP"
enVP     = input.bool(true, "Show POC / VAH / VAL (flat levels)", group = gVP, tooltip = "Volume-by-price over the last N chart bars: POC (peak-volume price), VAH/VAL (value-area edges). Drawn as flat horizontal levels. Follows the CHART timeframe.")
vpBars   = input.int(150, "Bars back", minval = 10, maxval = 5000, group = gVP)
vpCols   = input.int(35,  "Price rows", minval = 5, maxval = 200, group = gVP)
vpVaPct  = input.float(70, "Value area %", minval = 1, maxval = 100, group = gVP)
vpLineLen = input.int(120, "Level line length (bars left)", minval = 5, maxval = 5000, group = gVP)
colPOC   = input.color(color.red, "POC", inline = "vc", group = gVP)
colVA    = input.color(color.orange, "VAH/VAL", inline = "vc", group = gVP)
enAVWAP  = input.bool(true, "Show rolling VWAP (curve)", group = gVP)
colAVWAP = input.color(color.blue, "VWAP colour", group = gVP)
wAVWAP   = input.int(2, "VWAP width", minval = 1, maxval = 6, group = gVP)

// Rolling VWAP over the same window — a CURVE (like the MAs), not a flat line.
_vpHlc  = (high + low + close) / 3.0
_vpSv   = math.sum(volume, vpBars)
avwapV  = _vpSv > 0 ? math.sum(_vpHlc * volume, vpBars) / _vpSv : na
plot(enAVWAP ? avwapV : na, "Rolling VWAP", color = colAVWAP, linewidth = wAVWAP)

// ── compute — on `lockTf` (chart TF by default, or a locked one). One request.security pulls each MA, its value
//    `slopeLb` bars back, ATR and ATR's own average — so a lower chart TF still
//    reflects the daily MAs. Non-repainting.
f_mas() =>
    _m5   = maType == "EMA" ? ta.ema(close, len5)  : ta.sma(close, len5)
    _m20  = maType == "EMA" ? ta.ema(close, len20) : ta.sma(close, len20)
    _m50  = maType == "EMA" ? ta.ema(close, len50) : ta.sma(close, len50)
    _m150 = maType == "EMA" ? ta.ema(close, len150) : ta.sma(close, len150)
    _m200 = maType == "EMA" ? ta.ema(close, len200) : ta.sma(close, len200)
    _a    = ta.atr(atrLen)
    _rsi  = ta.rsi(close, rsiLen)
    _sl   = ta.lowest(low, rsiStopLb)
    [_m5, _m5[slopeLb], _m20, _m20[slopeLb], _m50, _m50[slopeLb], _m150, _m150[slopeLb], _m200, _m200[slopeLb], _a, ta.sma(_a, 20), _rsi, _rsi[1], _sl]
[ma5, ma5Lb, ma, maLb, ma50, ma50Lb, ma150, ma150Lb, ma200, ma200Lb, atr, atrAvg, rsi14, rsi14Prev, swingLow] = request.security(syminfo.tickerid, lockTf, f_mas(), lookahead = barmerge.lookahead_off)

// per-MA angle in DEGREES — same scale-free ATR normalisation for every MA.
f_ang(_m, _mLb) => na(atr) or atr == 0 or na(_m) or na(_mLb) ? na : math.todegrees(math.atan(((_m - _mLb) / slopeLb) / (atr * scale45)))
angle5   = f_ang(ma5,   ma5Lb)
angle    = f_ang(ma,    maLb)
angle50  = f_ang(ma50,  ma50Lb)
angle150 = f_ang(ma150, ma150Lb)
angle200 = f_ang(ma200, ma200Lb)
pctLb  = na(ma) or ma == 0 ? 0.0 : (ma - maLb) / ma * 100.0   // % move of the 20 over the lookback

// ── classify the 20's slope (rising / falling — drives the action + HUD row text) ─
_absA = math.abs(angle)
_up   = angle >  flatThr
_dn   = angle < -flatThr

// extension of price from the 20 (the magnet), in ATRs and %
extAtr = na(atr) or atr == 0 ? 0.0 : (close - ma) / atr
extPct = na(ma) or ma == 0 ? 0.0 : (close - ma) / ma * 100.0
_extended = math.abs(extAtr) >= extThr
_coiling  = _absA <= flatThr and not na(atrAvg) and atrAvg > 0 and atr < atrAvg * coilPct

// fixed per-MA colours (slope direction still reads in the HUD rows)
col50  = col50c
col150 = col150c
col200 = col200c

// ── OPEN vs the MAs — the day's OPEN sets each MA's role: open ABOVE a MA = that MA is
//    SUPPORT, open BELOW = RESISTANCE. Read on EVERY MA regardless of whether its line is
//    shown — so you can hide most lines (keep just 20 & 200) and still see, from the open
//    line's little S/R tags, where price opened relative to ANY MA. Open above all = the
//    closest MA below is the support entry. dayOpen = today's daily open (non-repainting).
dayOpen = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_off)
// weekly & monthly open — the current week's / month's opening print (live, updates
// through the period), for a higher-timeframe open reference.
wkOpen = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_off)
moOpen = request.security(syminfo.tickerid, "M", open, lookahead = barmerge.lookahead_off)
// prior levels — computed up here so the open-line context can name the nearest
// upside (PDH/PWH/PMH) or downside (PDL/PWL/PML) level when the open is beyond all MAs.
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ── OPEN CONTEXT — where the open sits: "between 20 & 50 SMA", or "above all SMA"
//    with the nearest upside level (PDH/PWH/PMH), or "below all SMA" with the nearest
//    downside level (PDL/PWL/PML). Uses every SMA that has a value (skips NaN).
_ctxNames = array.from("5", "20", "50", "150", "200")
_ctxVals  = array.from(ma5, ma, ma50, ma150, ma200)
string _belowN = ""
float  _belowV = na
string _aboveN = ""
float  _aboveV = na
if not na(dayOpen)
    for _c = 0 to 4
        _cv = array.get(_ctxVals, _c)
        if not na(_cv)
            if _cv <= dayOpen and (na(_belowV) or _cv > _belowV)
                _belowV := _cv
                _belowN := array.get(_ctxNames, _c)
            if _cv >= dayOpen and (na(_aboveV) or _cv < _aboveV)
                _aboveV := _cv
                _aboveN := array.get(_ctxNames, _c)
f_nearestAbove(float _px) =>
    float _lv = na
    string _ln = ""
    if not na(_px)
        if not na(pdh) and pdh > _px and (na(_lv) or pdh < _lv)
            _lv := pdh
            _ln := "PDH"
        if not na(pwh) and pwh > _px and (na(_lv) or pwh < _lv)
            _lv := pwh
            _ln := "PWH"
        if not na(pmh) and pmh > _px and (na(_lv) or pmh < _lv)
            _lv := pmh
            _ln := "PMH"
    [_ln, _lv]
f_nearestBelow(float _px) =>
    float _lv = na
    string _ln = ""
    if not na(_px)
        if not na(pdl) and pdl < _px and (na(_lv) or pdl > _lv)
            _lv := pdl
            _ln := "PDL"
        if not na(pwl) and pwl < _px and (na(_lv) or pwl > _lv)
            _lv := pwl
            _ln := "PWL"
        if not na(pml) and pml < _px and (na(_lv) or pml > _lv)
            _lv := pml
            _ln := "PML"
    [_ln, _lv]
string _openCtx = ""
if not na(dayOpen)
    if _belowN != "" and _aboveN != ""
        _openCtx := "between " + _belowN + " & " + _aboveN + " SMA"
    else if _aboveN == ""
        [_un, _uv] = f_nearestAbove(dayOpen)
        _openCtx := "above all SMA" + (_un == "" ? "" : " · res " + _un + " " + str.tostring(_uv, format.mintick))
    else
        [_dn2, _dv2] = f_nearestBelow(dayOpen)
        _openCtx := "below all SMA" + (_dn2 == "" ? "" : " · sup " + _dn2 + " " + str.tostring(_dv2, format.mintick))

// ── Minervini trend skeleton (structural qualification: > 150/200, 200 rising, > 50) ─
// The 5 structural rules of the Trend Template (the buyable-trend check; rules 6/7/8
// about 52-wk range + RS are scored separately below). Defined here so the entry/
// action can flag a qualified LONG. r1-r5 are reused by the Trend Template score.
r1 = not na(ma150) and not na(ma200) and close > ma150 and close > ma200
r2 = not na(ma150) and not na(ma200) and ma150 > ma200
r3 = not na(angle200) and angle200 > flatThr
r4 = not na(ma50) and not na(ma150) and not na(ma200) and ma50 > ma150 and ma50 > ma200
r5 = not na(ma50) and close > ma50
mrvOk  = r1 and r2 and r3 and r4 and r5
mrvTxt = mrvOk ? "QUALIFIED ✓" : not r3 ? "no · 200 not rising" : not r1 ? "no · < 150/200" : not r5 ? "no · < 50" : not r2 ? "no · 150 < 200" : "no · 50 < 150/200"

// ── WEINSTEIN STAGE (1 basing / 2 uptrend / 3 topping / 4 downtrend) ─────────────
// From price vs the 200 and the 200's own slope (angle200, same degree ruler):
//   above 200 + 200 rising  → STAGE 2 (uptrend)      · above 200 + 200 flat/falling → STAGE 1 (basing)
//   below 200 + 200 falling → STAGE 4 (downtrend)    · below 200 + 200 rising       → STAGE 3 (topping)
_p200   = not na(ma200) and close >= ma200      // price above the 200
_200rise = not na(angle200) and angle200 > flatThr
_200fall = not na(angle200) and angle200 < -flatThr
stageTxt = na(ma200) or na(angle200) ? "—" :
             _p200 and _200rise  ? "2 · UPTREND" :
             _p200               ? "1 · BASING" :
             (not _p200) and _200fall ? "4 · DOWNTREND" :
                                   "3 · TOPPING"
stageBg  = na(ma200) or na(angle200) ? color.new(color.gray, 35) :
             _p200 and _200rise  ? color.new(#1B5E20, 0) :
             _p200               ? color.new(#7C5E10, 0) :
             (not _p200) and _200fall ? color.new(#8E1D1D, 0) :
                                   color.new(#7C5E10, 0)

// ── RSI oversold-reclaim: inside the band AND turning up = a LONG bounce ──────────
rsiBuy   = enRsi and not na(rsi14) and not na(rsi14Prev) and rsi14 >= rsiLo and rsi14 <= rsiHi and rsi14 > rsi14Prev
rsiEntry = rsiBuy

// per-MA slope text + colour (reuse the 20's bands), and value + above/below.
f_slopeTxt(_a) =>
    _aa = math.abs(_a)
    _ar = na(_a) ? "—" : _a > flatThr ? "↑" : _a < -flatThr ? "↓" : "→"
    _wd = na(_a) ? "" : _aa <= flatThr ? " flat" : _aa < idealLo ? " shallow" : _aa <= idealHi ? " ideal" : " steep"
    na(_a) ? "—" : _ar + " " + str.tostring(_a, "#.#") + "°" + _wd
f_slopeCol(_a) => na(_a) ? color.new(color.gray, 35) : _a > flatThr ? color.new(#26A69A, 0) : _a < -flatThr ? color.new(#EF5350, 0) : color.new(color.gray, 20)
f_maDet(_m) => na(_m) ? "" : "  ·  " + str.tostring(_m, format.mintick) + (close >= _m ? " · above" : " · below")

// ── MULTI-MA ENTRY ENGINE — every MA is a valid entry ───────────────────────────
// For each enabled MA: a RISING MA that price is holding (from a hair below to the
// hold zone above) = LONG at that MA; a FALLING MA that price is rejecting (from a
// hair above to the hold zone below) = SHORT at it. Entry = the MA, stop a buffer
// beyond it, target an ATR-extension away. Returns the |extension| as the distance
// used to pick the NEAREST actionable MA.
_stopBuf = stopBuf * atr
_tgtExt  = tgtExt * atr
f_maEntry(_m, _ang, _en) =>
    string _dir = ""
    string _tag = ""
    float _entry = na
    float _stop  = na
    float _tgt   = na
    float _dist  = na
    if _en and not na(_m) and not na(_ang) and not na(atr) and atr > 0
        _ext = (close - _m) / atr
        if _ang > flatThr and _ext >= -sideTol and _ext <= nearMA
            _dir  := "LONG"
            _tag  := "◀ LONG · holding"
            _entry := _m
            _stop  := _m - _stopBuf
            _tgt   := _m + _tgtExt
            _dist  := math.abs(_ext)
        else if _ang < -flatThr and _ext <= sideTol and _ext >= -nearMA
            _dir  := "SHORT"
            _tag  := "◀ SHORT · rejecting"
            _entry := _m
            _stop  := _m + _stopBuf
            _tgt   := _m - _tgtExt
            _dist  := math.abs(_ext)
    [_dir, _tag, _entry, _stop, _tgt, _dist]
[d20,  tag20,  e20,  s20,  t20,  dist20]  = f_maEntry(ma,    angle,    en20)
[d50,  tag50,  e50,  s50,  t50,  dist50]  = f_maEntry(ma50,  angle50,  en50)
[d150, tag150, e150, s150, t150, dist150] = f_maEntry(ma150, angle150, en150)
[d200, tag200, e200, s200, t200, dist200] = f_maEntry(ma200, angle200, en200)

// pick the NEAREST actionable MA (smallest |extension|).
_dists = array.from(dist20, dist50, dist150, dist200)
_dirs  = array.from(d20,  d50,  d150,  d200)
_ents  = array.from(e20,  e50,  e150,  e200)
_stps  = array.from(s20,  s50,  s150,  s200)
_tgts  = array.from(t20,  t50,  t150,  t200)
_names = array.from("20", "50", "150", "200")
_best  = -1
float _bestD = na
for _i = 0 to 3
    _dv = array.get(_dists, _i)
    if not na(_dv) and (na(_bestD) or _dv < _bestD)
        _bestD := _dv
        _best  := _i

// EXTENDED-ABOVE fade (of the 20) takes priority — no MA entry when price is stretched.
string sdir  = ""
string setup = "—"
string aMA   = ""
bool   isFade = false
float entry = na
float stop  = na
float tgt   = na
if _extended and extAtr > 0
    sdir  := "SHORT"
    isFade := true
    aMA   := "20"
    setup := "fade extension → 20"
    entry := close
    stop  := close + _stopBuf
    tgt   := ma
else if _best >= 0
    sdir  := array.get(_dirs, _best)
    aMA   := array.get(_names, _best)
    entry := array.get(_ents, _best)
    stop  := array.get(_stps, _best)
    tgt   := array.get(_tgts, _best)
    setup := (sdir == "LONG" ? "hold rising " : "reject falling ") + aMA + (sdir == "LONG" and mrvOk ? " ✓Mnv" : "")
else if rsiEntry
    // oversold-reclaim bounce — the MAs missed it (price below them); RSI catches it.
    sdir  := "LONG"
    aMA   := "RSI"
    setup := "RSI " + str.tostring(rsi14, "#.#") + " reclaim"
    entry := close
    stop  := (not na(swingLow) and swingLow < close) ? swingLow : close * 0.97
    _mavals = array.from(ma, ma50, ma150, ma200)
    float _tAbove = na
    for _j = 0 to 3
        _mv2 = array.get(_mavals, _j)
        if not na(_mv2) and _mv2 > entry and (na(_tAbove) or _mv2 < _tAbove)
            _tAbove := _mv2
    tgt := not na(_tAbove) ? _tAbove : entry + 2.0 * (entry - stop)

_risk = na(entry) or na(stop) ? na : math.abs(entry - stop)
_rew  = na(entry) or na(tgt)  ? na : math.abs(tgt - entry)
rr    = na(_risk) or _risk == 0 or na(_rew) ? na : _rew / _risk
_riskPct = na(_risk) or na(entry) or entry == 0 ? na : _risk / entry * 100.0
_tgtPct  = na(_rew)  or na(entry) or entry == 0 ? na : _rew / entry * 100.0
align = sdir == "" ? "" : ((sdir == "LONG" and close >= ma200) or (sdir == "SHORT" and close < ma200) ? "with 200-trend ✓" : "counter 200-trend ⚠")

// ── ACTION — the plain "act now / wait" call, keyed on the ACTIVE setup ─────────
_actGrn = color.new(#1B5E20, 0)
_actAmb = color.new(#7C5E10, 0)
_actRed = color.new(#8E1D1D, 0)
_actGry = color.new(color.gray, 35)
string actTxt = "WAIT"
color  actBg  = _actGry
if isFade
    actTxt := "FADE · +" + str.tostring(extPct, "#.#") + "% ext — short snap-back"
    actBg  := _actAmb
else if sdir == "LONG" and aMA == "RSI"
    actTxt := "LONG · RSI " + str.tostring(rsi14, "#.#") + " reclaim (bounce)"
    actBg  := _actGrn
else if sdir == "LONG"
    actTxt := "LONG · rising " + aMA + " support" + (mrvOk ? " ✓Mnv" : "")
    actBg  := _actGrn
else if sdir == "SHORT"
    actTxt := "SHORT · falling " + aMA + " reject"
    actBg  := _actRed
else if _absA <= flatThr
    actTxt := "WAIT · 20 flat (chop)"
    actBg  := _actGry
else if _up
    actTxt := "WAIT · rising; price off the MAs"
    actBg  := _actAmb
else
    actTxt := "AVOID longs · 20 falling"
    actBg  := _actRed

// ── Minervini Trend Template (8 rules) ─────────────────────────────────────────
benchClose = request.security(benchSym, lockTf, close, lookahead = barmerge.lookahead_off)
f_relRet(_bars) => na(close[_bars]) or na(benchClose[_bars]) or close[_bars] == 0 or benchClose[_bars] == 0 ? na : (close / close[_bars] - 1) - (benchClose / benchClose[_bars] - 1)
_rs3  = f_relRet(63)
_rs6  = f_relRet(126)
_rs9  = f_relRet(189)
_rs12 = f_relRet(252)
rsScore = (na(_rs3) ? 0.0 : 0.4 * _rs3) + (na(_rs6) ? 0.0 : 0.2 * _rs6) + (na(_rs9) ? 0.0 : 0.2 * _rs9) + (na(_rs12) ? 0.0 : 0.2 * _rs12)
[hi52, lo52] = request.security(syminfo.tickerid, lockTf, [ta.highest(high, lookback), ta.lowest(low, lookback)], lookahead = barmerge.lookahead_off)
// r1-r5 (the trend skeleton) are computed early; here add the 52-week + RS rules.
r6 = not na(lo52) and close >= lo52 * (1 + minAboveLow / 100)
r7 = not na(hi52) and close >= hi52 * (1 - maxBelowHi / 100)
r8 = rsScore > 0.0
ttCount = (r1 ? 1 : 0) + (r2 ? 1 : 0) + (r3 ? 1 : 0) + (r4 ? 1 : 0) + (r5 ? 1 : 0) + (r6 ? 1 : 0) + (r7 ? 1 : 0) + (r8 ? 1 : 0)

// ── ENTRY PIVOT + VCP BASE ENGINE ──────────────────────────────────────────────
// The base ceiling (highest high over `baseLen` COMPLETED bars) is the pivot you buy
// the breakout of. The VCP engine shades the base BOX only when a tight base actually
// exists (green = ready / contracting + dry-up + coiling, blue = contracting), draws
// the STOP (recent contraction low), and fires a BREAKOUT on a volume surge. Base
// detection gates on the trend skeleton (rules 1-5), so a near-miss (e.g. fails only
// rule 7) still shows its base. All computed on `lockTf` (daily), like everything else.
gEntry   = "Entry pivot"
baseLen  = input.int(40, "Base lookback for the pivot (bars)", minval = 5, maxval = 250, group = gEntry, tooltip = "The pivot = highest high over this many completed bars (the base ceiling / buy trigger). 40 ≈ a two-month base.")
nearPct  = input.float(7.0, "Actionable within N% below the pivot", minval = 1, maxval = 30, step = 0.5, group = gEntry, tooltip = "A pivot only counts as a real ENTRY when price is coiling just under it. Farther than this below = a deep pullback with no tight base yet — the pivot reads amber, not a buy.")
showEntry = input.bool(true, "Draw the entry (pivot) line", group = gEntry)
colEntry = input.color(#26A69A, "Entry line", group = gEntry)

gVCP     = "VCP base & breakout"
showBox  = input.bool(true, "Shade the base box (only when a tight base exists)", group = gVCP, tooltip = "Green = ready setup (contracting + dry-up + coiling). Blue = contracting. No tight base → no box.")
maxDepth = input.float(35.0, "Max base depth %", minval = 5, maxval = 80, group = gVCP, tooltip = "Reject bases deeper than this. Depth = (pivot − floor) / pivot.")
contractRatio = input.float(0.6, "Contraction: recent third ≤ N × base range", minval = 0.1, maxval = 1.0, step = 0.05, group = gVCP, tooltip = "Volatility contraction — the recent third of the base must be at most this fraction of the whole base's range.")
volAvgLen = input.int(50, "Volume average length", minval = 5, group = gVCP)
volDryPct = input.float(0.85, "Dry-up: recent vol ≤ N × average", minval = 0.2, maxval = 1.5, step = 0.05, group = gVCP)
brkVolMult = input.float(1.4, "Breakout volume ≥ N × average", minval = 1.0, maxval = 5, step = 0.1, group = gVCP)
colStp   = input.color(#EF5350, "Stop line", group = gVCP)

f_vcp() =>
    _piv   = ta.highest(high[1], baseLen)
    _floor = ta.lowest(low[1], baseLen)
    _third = int(math.max(3, math.floor(baseLen / 3.0)))
    _rB    = ta.highest(high, baseLen) - ta.lowest(low, baseLen)
    _rR    = ta.highest(high, _third) - ta.lowest(low, _third)
    _stop  = ta.lowest(low, _third)
    _vAvg  = ta.sma(volume, volAvgLen)
    _vRec  = ta.sma(volume, 5)
    _brk   = ta.crossover(close, _piv)
    [_piv, _floor, _rB, _rR, _stop, _vAvg, _vRec, volume, _brk]
[pivot, baseFloor, rangeBase, rangeRecent, stopLevel, volAvg, volRecent, volNow, brkRaw] = request.security(syminfo.tickerid, lockTf, f_vcp(), lookahead = barmerge.lookahead_off)

pctEntry  = na(pivot) or pivot == 0 ? na : (close / pivot - 1) * 100.0
_far      = not na(pctEntry) and pctEntry < -nearPct
baseDepth = na(pivot) or pivot == 0 ? na : (pivot - baseFloor) / pivot * 100.0
contracting = not na(rangeBase) and rangeBase > 0 and rangeRecent <= rangeBase * contractRatio
dryUp     = not na(volAvg) and volAvg > 0 and volRecent <= volAvg * volDryPct
volRatio  = na(volAvg) or volAvg == 0 ? na : volNow / volAvg
riskPct   = na(pivot) or na(stopLevel) or pivot == 0 ? na : (pivot - stopLevel) / pivot * 100.0
_trendOk  = r1 and r2 and r3 and r4 and r5
depthOk   = not na(baseDepth) and baseDepth <= maxDepth
nearPivot = not na(pctEntry) and pctEntry >= -nearPct and pctEntry < 0
hasBase     = _trendOk and depthOk and contracting and nearPivot
formingVCP  = hasBase and dryUp
breakoutVCP = _trendOk and depthOk and brkRaw and not na(volRatio) and volRatio >= brkVolMult

// ── Alerts ─────────────────────────────────────────────────────────────────────
_longNow  = sdir == "LONG"
_shortNow = sdir == "SHORT" and not isFade
alertcondition(_longNow  and not _longNow[1],  "MA · LONG entry",  "{{ticker}} — price holding a rising MA (support): LONG entry")
alertcondition(_shortNow and not _shortNow[1], "MA · SHORT entry", "{{ticker}} — price rejecting a falling MA (resistance): SHORT entry")
alertcondition(rsiEntry and not rsiEntry[1], "RSI reclaim entry", "{{ticker}} — RSI in the reclaim zone (30-35), turning up: LONG bounce")
alertcondition(mrvOk and not mrvOk[1], "Minervini qualified", "{{ticker}} — Minervini trend skeleton qualified (> 150/200, 200 rising, > 50)")
alertcondition(ttCount == 8 and ttCount[1] < 8, "Trend Template: newly qualified", "{{ticker}} now passes all 8 Trend Template rules")

// ── plots — each line gated ONLY on its own Show toggle ────────────────────────
// full-strength line when the MA is ON
plot(en200 ? ma200 : na, "200 SMA", color = col200, linewidth = w200)
plot(en150 ? ma150 : na, "150 SMA", color = col150, linewidth = w150)
plot(en50  ? ma50  : na, "50 SMA",  color = col50,  linewidth = w50)
plot(en20  ? ma    : na, "20 MA",   color = col20,  linewidth = w20)
plot(en5   ? ma5   : na, "5 SMA",   color = col5,   linewidth = w5)
// FAINT line when the MA is OFF (adjustable transparency) — see the curve without clutter
plot((not en200 and enFaint) ? ma200 : na, "200 faint", color = color.new(col200, faintTransp), linewidth = 1)
plot((not en150 and enFaint) ? ma150 : na, "150 faint", color = color.new(col150, faintTransp), linewidth = 1)
plot((not en50  and enFaint) ? ma50  : na, "50 faint",  color = color.new(col50,  faintTransp), linewidth = 1)
plot((not en20  and enFaint) ? ma    : na, "20 faint",  color = color.new(col20,  faintTransp), linewidth = 1)
plot((not en5   and enFaint) ? ma5   : na, "5 faint",   color = color.new(col5,   faintTransp), linewidth = 1)

// ── MA identity tags (small, faint, always — even when the line is off) ──────────
_mtSz = maTagSz == "tiny" ? size.tiny : maTagSz == "normal" ? size.normal : size.small
// The tag is INDEPENDENT of the line toggle — it shows whether or not the MA's line is
// drawn, so you can hide the line for a clean chart and still see where the MA sits.
f_matag(label lb, float v, string nm, color col) =>
    label _b = lb
    if enMaTag and not na(v)
        if na(_b)
            _b := label.new(bar_index + lvTagOff, v, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = col, size = _mtSz)
        else
            label.set_xy(_b, bar_index + lvTagOff, v)
            label.set_text(_b, nm)
            label.set_textcolor(_b, col)
            label.set_size(_b, _mtSz)
    else
        if not na(_b)
            label.delete(_b)
            _b := na
    _b
var label lbT5   = na
var label lbT20  = na
var label lbT50  = na
var label lbT150 = na
var label lbT200 = na
if barstate.islast
    lbT5   := f_matag(lbT5,   ma5,   "5",   col5)
    lbT20  := f_matag(lbT20,  ma,    "20",  col20)
    lbT50  := f_matag(lbT50,  ma50,  "50",  col50)
    lbT150 := f_matag(lbT150, ma150, "150", col150)
    lbT200 := f_matag(lbT200, ma200, "200", col200)
// queryable (Data Window / data_get_study_values)
plot(angle,    "20 angle (deg)",     display = display.data_window)
plot(angle50,  "50 angle (deg)",     display = display.data_window)
plot(angle150, "150 angle (deg)",    display = display.data_window)
plot(angle200, "200 angle (deg)",    display = display.data_window)
plot(extAtr,   "Extension (ATR)",    display = display.data_window)
plot(extPct,   "Extension (%)",      display = display.data_window)
plot(na(rr) ? na : rr, "Setup R:R",  display = display.data_window)
plot(ttCount,  "Trend Template /8",  display = display.data_window)
plot(rsi14,    "RSI(14)",            display = display.data_window)
plot(pivot,    "Entry pivot",        display = display.data_window)
plot(pctEntry, "% from pivot",       display = display.data_window)
plot(baseDepth,"Base depth %",       display = display.data_window)
plot(volRatio, "Volume × average",   display = display.data_window)
plot(riskPct,  "Pivot→stop risk %",  display = display.data_window)
plotshape(breakoutVCP, "Breakout", style = shape.triangleup, location = location.belowbar, color = colEntry, size = size.small, text = "BRK")
alertcondition(formingVCP and not formingVCP[1], "VCP base forming", "{{ticker}} — VCP base forming, coiling under the pivot")
alertcondition(breakoutVCP, "VCP breakout", "{{ticker}} — VCP breakout: cleared the pivot on volume")

// ── HUD (mobile) — top-right, SINGLE COLUMN so it stacks TALL & NARROW ──────────
// One item per row (no wide 2-column spread): action, each MA's slope, RSI, the
// Trend-Template/Minervini score, extension, then entry / stop / target / R:R / base.
_sz  = hudSz == "small" ? size.small : hudSz == "large" ? size.large : size.normal
_hb  = color.new(#0B0B12, 0)
_hw  = color.new(color.white, 0)
var table hud = table.new(position.top_right, 1, 15, border_width = 1, border_color = color.new(color.gray, 55))
_row(int r, string txt, color bg, color tc) => table.cell(hud, 0, r, txt, text_color = tc, bgcolor = bg, text_size = _sz, text_halign = text.align_left)
if barstate.islast
    if enHud
        _row(0, actTxt, actBg, _hw)
        _row(1, "Stage " + stageTxt, stageBg, _hw)
        if hudCollapse
            // collapsed — blank every row below Stage (small footprint)
            for _r = 2 to 14
                table.cell(hud, 0, _r, "", bgcolor = color.new(color.gray, 100))
        else
            _row(2, "5   " + f_slopeTxt(angle5),   _hb, f_slopeCol(angle5))
            _row(3, "20  " + f_slopeTxt(angle),    _hb, f_slopeCol(angle))
            _row(4, "50  " + f_slopeTxt(angle50),  _hb, f_slopeCol(angle50))
            _row(5, "150 " + f_slopeTxt(angle150), _hb, f_slopeCol(angle150))
            _row(6, "200 " + f_slopeTxt(angle200), _hb, f_slopeCol(angle200))
            _rArr = (not na(rsi14) and not na(rsi14Prev) and rsi14 > rsi14Prev) ? " ↑" : (not na(rsi14) and not na(rsi14Prev) and rsi14 < rsi14Prev) ? " ↓" : ""
            _row(7, "RSI " + (na(rsi14) ? "—" : str.tostring(rsi14, "#.#")) + _rArr + (rsiBuy ? " · BUY" : ""), rsiBuy ? _actGrn : _hb, _hw)
            _row(8, "TT " + str.tostring(ttCount) + "/8 · Mnv " + (mrvOk ? "✓" : "✗"), mrvOk ? _actGrn : _hb, _hw)
            _row(9, "Ext " + (extAtr >= 0 ? "+" : "") + str.tostring(extAtr, "#.#") + " ATR" + (_extended ? " · EXT" : _coiling ? " · COIL" : ""), _extended ? color.new(#F59E0B, 20) : _hb, _hw)
            _row(10, "E  " + (na(entry) ? "—" : str.tostring(entry, format.mintick)), _hb, _hw)
            _row(11, "S  " + (na(stop) ? "—" : str.tostring(stop, format.mintick) + (na(_riskPct) ? "" : "  −" + str.tostring(_riskPct, "#.#") + "%")), _hb, color.new(#EF5350, 0))
            _row(12, "T  " + (na(tgt) ? "—" : str.tostring(tgt, format.mintick) + (na(_tgtPct) ? "" : "  +" + str.tostring(_tgtPct, "#.#") + "%")), _hb, color.new(#26A69A, 0))
            _row(13, "R:R " + (na(rr) ? "—" : str.tostring(rr, "#.#") + (align == "" ? "" : " · " + align)), _hb, _hw)
            _bs = breakoutVCP ? "BREAKOUT ▲" : formingVCP ? "READY" : hasBase ? "forming" : _trendOk ? "await base" : "no base"
            _row(14, "Base " + _bs, (breakoutVCP or formingVCP) ? _actGrn : _hb, _hw)
    else
        for _r = 0 to 14
            table.cell(hud, 0, _r, "", bgcolor = color.new(color.gray, 100))


// ── OPEN LINE + BOLD S/R CHIPS — the day's open as a line, a bold "Open <px>" chip, and a
//    bold GREEN(S)/RED(R) chip AT each MA's price (all five, regardless of line visibility):
//    open ABOVE a MA → S (support), below → R (resistance). "Open label size" sizes them all.
_oSz = openSz == "small" ? size.small : openSz == "large" ? size.large : size.normal
var line  lnOpen = na
var label lbOpen = na
if barstate.islast
    if enOpen and not na(dayOpen)
        _ox2  = bar_index + lvTagOff
        _otxt = "Open " + str.tostring(dayOpen, format.mintick) + (_openCtx == "" ? "" : " · " + _openCtx)
        if na(lnOpen)
            lnOpen := line.new(bar_index, dayOpen, _ox2, dayOpen, xloc = xloc.bar_index, color = colOpen, width = wOpen, extend = extend.left)
            lbOpen := label.new(_ox2, dayOpen, _otxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(colOpen, 10), textcolor = color.new(#0B0B12, 0), size = _oSz)
        else
            line.set_xy1(lnOpen, bar_index, dayOpen)
            line.set_xy2(lnOpen, _ox2, dayOpen)
            line.set_color(lnOpen, colOpen)
            line.set_width(lnOpen, wOpen)
            label.set_xy(lbOpen, _ox2, dayOpen)
            label.set_text(lbOpen, _otxt)
            label.set_size(lbOpen, _oSz)
    else if not na(lnOpen)
        line.delete(lnOpen)
        label.delete(lbOpen)
        lnOpen := na
        lbOpen := na

// ── WEEKLY / MONTHLY OPEN — separate faint lines with a small tag ────────────────
f_htfOpen(line ln, label lb, bool en, float v, string nm, color col) =>
    line  _l = ln
    label _b = lb
    if en and not na(v)
        _x2 = bar_index + lvTagOff
        if na(_l)
            _l := line.new(bar_index, v, _x2, v, xloc = xloc.bar_index, color = color.new(col, 25), width = wOpen, style = line.style_dashed, extend = extend.left)
            _b := label.new(_x2, v, nm + " " + str.tostring(v, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(col, 0), textcolor = color.new(color.white, 0), size = _oSz)
        else
            line.set_xy1(_l, bar_index, v)
            line.set_xy2(_l, _x2, v)
            line.set_color(_l, color.new(col, 25))
            label.set_xy(_b, _x2, v)
            label.set_text(_b, nm + " " + str.tostring(v, format.mintick))
            label.set_size(_b, _oSz)
    else
        if not na(_l)
            line.delete(_l)
            _l := na
        if not na(_b)
            label.delete(_b)
            _b := na
    [_l, _b]
var line  lnWkO = na
var label lbWkO = na
var line  lnMoO = na
var label lbMoO = na
if barstate.islast
    [_lwo, _bwo] = f_htfOpen(lnWkO, lbWkO, enWkOpen, wkOpen, "W Open", colWkOpen)
    lnWkO := _lwo
    lbWkO := _bwo
    [_lmo, _bmo] = f_htfOpen(lnMoO, lbMoO, enMoOpen, moOpen, "M Open", colMoOpen)
    lnMoO := _lmo
    lbMoO := _bmo

// bold S/R chip at each MA's price — solid green (S) / red (R) with white text
f_roletag(label lb, float _m, string nm) =>
    label _b = lb
    if enRoleChips and enOpen and not na(_m) and not na(dayOpen)
        _sup = dayOpen >= _m
        _bg  = _sup ? color.new(#1B5E20, 0) : color.new(#B71C1C, 0)
        if na(_b)
            _b := label.new(bar_index + 2, _m, nm + (_sup ? " S" : " R"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = _bg, textcolor = color.new(color.white, 0), size = _oSz)
        else
            label.set_xy(_b, bar_index + 2, _m)
            label.set_text(_b, nm + (_sup ? " S" : " R"))
            label.set_color(_b, _bg)
            label.set_size(_b, _oSz)
    else
        if not na(_b)
            label.delete(_b)
            _b := na
    _b
var label lbR5   = na
var label lbR20  = na
var label lbR50  = na
var label lbR150 = na
var label lbR200 = na
if barstate.islast
    lbR5   := f_roletag(lbR5,   ma5,   "5")
    lbR20  := f_roletag(lbR20,  ma,    "20")
    lbR50  := f_roletag(lbR50,  ma50,  "50")
    lbR150 := f_roletag(lbR150, ma150, "150")
    lbR200 := f_roletag(lbR200, ma200, "200")

// ═══ PRIOR LEVELS — PDH / PDL / PWH / PWL / PMH / PML (computed up top, near dayOpen) ═══
var line  lnPdh = na
var label lbPdh = na
var line  lnPdl = na
var label lbPdl = na
var line  lnPwh = na
var label lbPwh = na
var line  lnPwl = na
var label lbPwl = na
var line  lnPmh = na
var label lbPmh = na
var line  lnPml = na
var label lbPml = na
// proximity gate — a level counts as "near" when price is within lvProx% of it.
f_near(float _px) => not na(_px) and _px != 0 and math.abs(close - _px) / close * 100.0 <= lvProx
_lvSz = lvTagSz == "small" ? size.small : lvTagSz == "large" ? size.large : size.normal
f_lvl(line ln, label lb, bool on, float px, string txt, color col) =>
    line  _l = ln
    label _b = lb
    if on and not na(px)
        // faint dotted line, but a BOLD chip — solid colour fill + white text — so the
        // level reads clearly even when the line is subtle.
        if na(_l)
            _l := line.new(bar_index, px, bar_index + lvTagOff, px, xloc = xloc.bar_index, color = color.new(col, 45), width = 1, style = line.style_dotted, extend = extend.left)
            _b := label.new(bar_index + lvTagOff, px, txt + " " + str.tostring(px, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(col, 0), textcolor = color.new(color.white, 0), size = _lvSz)
        else
            line.set_xy1(_l, bar_index, px)
            line.set_xy2(_l, bar_index + lvTagOff, px)
            label.set_xy(_b, bar_index + lvTagOff, px)
            label.set_text(_b, txt + " " + str.tostring(px, format.mintick))
            label.set_color(_b, color.new(col, 0))
            label.set_size(_b, _lvSz)
    else
        if not na(_l)
            line.delete(_l)
            _l := na
        if not na(_b)
            label.delete(_b)
            _b := na
    [_l, _b]
if barstate.islast
    [_a, _b] = f_lvl(lnPdh, lbPdh, enPdh, pdh, "PDH", lvHiCol)
    lnPdh := _a
    lbPdh := _b
    [_c, _d] = f_lvl(lnPdl, lbPdl, enPdl, pdl, "PDL", lvLoCol)
    lnPdl := _c
    lbPdl := _d
    [_wa, _wb] = f_lvl(lnPwh, lbPwh, enPwh and (not gateWM or f_near(pwh)), pwh, "PWH", lvHiCol)
    lnPwh := _wa
    lbPwh := _wb
    [_wc, _wd] = f_lvl(lnPwl, lbPwl, enPwl and (not gateWM or f_near(pwl)), pwl, "PWL", lvLoCol)
    lnPwl := _wc
    lbPwl := _wd
    [_e, _f] = f_lvl(lnPmh, lbPmh, enPmh and (not gateWM or f_near(pmh)), pmh, "PMH", lvHiCol)
    lnPmh := _e
    lbPmh := _f
    [_g, _h] = f_lvl(lnPml, lbPml, enPml and (not gateWM or f_near(pml)), pml, "PML", lvLoCol)
    lnPml := _g
    lbPml := _h

// ═══ RECENT GAP ZONE (S/R) ═══════════════════════════════════════════════════════
// The gap window = between the prior close and the gap-day OPEN (the gap's HIGH & LOW
// edges). A gap UP leaves that zone below as SUPPORT; a gap DOWN leaves it overhead as
// RESISTANCE. Most recent of each, shaded. Chart-timeframe (daily gaps on a daily chart).
gGap   = "Recent gap zone"
enGap  = input.bool(true, "Show recent gap zone (S/R)", group = gGap)
gapThr = input.float(4.0, "Gap ≥ N% (open vs prior close)", minval = 0.5, maxval = 30, step = 0.5, group = gGap, tooltip = "Best on a DAILY chart. Draws the gap window — prior close to the gap-day open (its high & low edges).")
gapProx = input.float(15.0, "Only draw when price is within N% of the gap", minval = 0, maxval = 100, step = 1, group = gGap, tooltip = "Hide the gap zone when price has run far from it — a far gap only compresses the chart's price scale and isn't in play. 0 = always draw. Measured from the gap edge nearest price.")
colGapS = input.color(#26A69A, "Gap-up support", inline = "gsr", group = gGap)
colGapR = input.color(#EF5350, "Gap-down resistance", inline = "gsr", group = gGap)
maxGaps = input.int(12, "Max unfilled gaps to keep", minval = 1, maxval = 50, group = gGap, tooltip = "Track this many recent unfilled gaps at once; the oldest drops off beyond it.")

// EVERY qualifying gap is tracked and PERSISTS until FILLED (price closes back through
// it), so an older still-unfilled overhead gap stays instead of being overwritten.
_gp = not na(close[1]) and close[1] != 0 ? (open - close[1]) / close[1] * 100.0 : na
var array<float> gHi  = array.new_float()
var array<float> gLo  = array.new_float()
var array<int>   gBar = array.new_int()
var array<int>   gDir = array.new_int()   // +1 gap up (support below), -1 gap down (resistance above)

if not na(_gp) and _gp >= gapThr
    array.push(gHi, open)
    array.push(gLo, close[1])
    array.push(gBar, bar_index)
    array.push(gDir, 1)
if not na(_gp) and _gp <= -gapThr
    array.push(gHi, close[1])
    array.push(gLo, open)
    array.push(gBar, bar_index)
    array.push(gDir, -1)

// Drop filled gaps (price closed back through). Iterate backwards so removals are safe.
if array.size(gDir) > 0
    _i = array.size(gDir) - 1
    while _i >= 0
        _d  = array.get(gDir, _i)
        _hi = array.get(gHi, _i)
        _lo = array.get(gLo, _i)
        _filled = (_d == 1 and close < _lo) or (_d == -1 and close > _hi)
        if _filled
            array.remove(gHi, _i)
            array.remove(gLo, _i)
            array.remove(gBar, _i)
            array.remove(gDir, _i)
        _i := _i - 1

while array.size(gDir) > maxGaps
    array.shift(gHi)
    array.shift(gLo)
    array.shift(gBar)
    array.shift(gDir)

// Gap zones are drawn as shaded BOXES only — no text label. proximity gate: draw a gap
// only when price is within gapProx% of its nearest edge (up = its high, down = its low).
f_gapNear(float _edge) => gapProx <= 0 or (not na(_edge) and _edge != 0 and math.abs(close - _edge) / close * 100.0 <= gapProx)
var array<box> gBox = array.new_box()
if barstate.islast
    if array.size(gBox) > 0
        for _i = 0 to array.size(gBox) - 1
            box.delete(array.get(gBox, _i))
    array.clear(gBox)
    if enGap and array.size(gDir) > 0
        _x2 = bar_index + lvTagOff
        for _i = 0 to array.size(gDir) - 1
            _d    = array.get(gDir, _i)
            _hi   = array.get(gHi, _i)
            _lo   = array.get(gLo, _i)
            _bar  = array.get(gBar, _i)
            _edge = _d == 1 ? _hi : _lo
            if f_gapNear(_edge)
                _col  = _d == 1 ? colGapS : colGapR
                _left = math.max(_bar, bar_index - 9000)
                _bx   = box.new(_left, _hi, _x2, _lo, border_width = 0, bgcolor = color.new(_col, 82))
                array.push(gBox, _bx)

// ═══ ENTRY PIVOT LINE + VCP STOP + BASE BOX ══════════════════════════════════════
var line  enLn = na
var label enLb = na
// Only draw the entry pivot when a REAL base exists (or a breakout) — otherwise the
// "pivot" is just the highest high over baseLen, which on a name with no base is an
// all-time high far above price. No base → no pivot line (the HUD Base row still says so).
if barstate.islast
    if showEntry and (hasBase or breakoutVCP) and not na(pivot)
        _x1 = bar_index - baseLen
        _x2 = bar_index + 8
        _enCol = colEntry
        if na(enLn)
            enLn := line.new(_x1, pivot, _x2, pivot, color = _enCol, width = 2, style = line.style_dashed)
            enLb := label.new(_x2, pivot, "", style = label.style_label_left, color = _enCol, textcolor = color.white, size = size.small)
        else
            line.set_xy1(enLn, _x1, pivot)
            line.set_xy2(enLn, _x2, pivot)
            line.set_color(enLn, _enCol)
            label.set_xy(enLb, _x2, pivot)
            label.set_color(enLb, _enCol)
        label.set_text(enLb, "ENTRY " + str.tostring(pivot, format.mintick) + (na(pctEntry) ? "" : "  (" + str.tostring(pctEntry, "+#.#;-#.#") + "%)"))
    else if not na(enLn)
        line.delete(enLn)
        label.delete(enLb)
        enLn := na
        enLb := na

var line  stLn = na
var label stLb = na
if barstate.islast
    if (hasBase or breakoutVCP) and not na(stopLevel)
        _sx1 = bar_index - baseLen
        _sx2 = bar_index + 8
        if na(stLn)
            stLn := line.new(_sx1, stopLevel, _sx2, stopLevel, color = colStp, width = 1, style = line.style_dashed)
            stLb := label.new(_sx2, stopLevel, "", style = label.style_label_left, color = colStp, textcolor = color.white, size = size.small)
        else
            line.set_xy1(stLn, _sx1, stopLevel)
            line.set_xy2(stLn, _sx2, stopLevel)
            label.set_xy(stLb, _sx2, stopLevel)
        label.set_text(stLb, "STOP " + str.tostring(stopLevel, format.mintick) + (na(riskPct) ? "" : "  (" + str.tostring(riskPct, "#.#") + "%)"))
    else if not na(stLn)
        line.delete(stLn)
        label.delete(stLb)
        stLn := na
        stLb := na

var box baseBox = na
if barstate.islast
    if showBox and (hasBase or breakoutVCP) and not na(pivot) and not na(baseFloor)
        _bx1   = bar_index - baseLen
        _bxCol = (formingVCP or breakoutVCP) ? color.new(#26A69A, 82) : color.new(#42A5F5, 85)
        _bdCol = (formingVCP or breakoutVCP) ? color.new(#26A69A, 30) : color.new(#42A5F5, 35)
        if na(baseBox)
            baseBox := box.new(_bx1, pivot, bar_index, baseFloor, border_color = _bdCol, border_width = 1, bgcolor = _bxCol)
        else
            box.set_lefttop(baseBox, _bx1, pivot)
            box.set_rightbottom(baseBox, bar_index, baseFloor)
            box.set_border_color(baseBox, _bdCol)
            box.set_bgcolor(baseBox, _bxCol)
    else if not na(baseBox)
        box.delete(baseBox)
        baseBox := na

// ── Volume profile POC / VAH / VAL — FLAT levels (curves are the MAs + VWAP above) ──
var array<line>  _vpLnA = array.new_line()
var array<label> _vpLbA = array.new_label()
if barstate.islast
    if array.size(_vpLnA) > 0
        for _i = 0 to array.size(_vpLnA) - 1
            line.delete(array.get(_vpLnA, _i))
    if array.size(_vpLbA) > 0
        for _i = 0 to array.size(_vpLbA) - 1
            label.delete(array.get(_vpLbA, _i))
    array.clear(_vpLnA)
    array.clear(_vpLbA)
    if enVP
        _vn = math.min(vpBars, bar_index)
        if _vn >= 2
            _vhi = high
            _vlo = low
            for _b = 0 to _vn - 1
                _vhi := math.max(_vhi, high[_b])
                _vlo := math.min(_vlo, low[_b])
            _vrng = _vhi - _vlo
            if _vrng > 0
                _vbs = _vrng / vpCols
                _vvol = array.new_float(vpCols, 0.0)
                for _b = 0 to _vn - 1
                    _vloI = int(math.floor((low[_b]  - _vlo) / _vbs))
                    _vhiI = int(math.floor((high[_b] - _vlo) / _vbs))
                    _vloI := math.max(0, math.min(vpCols - 1, _vloI))
                    _vhiI := math.max(0, math.min(vpCols - 1, _vhiI))
                    _vspan = _vhiI - _vloI + 1
                    _vper  = volume[_b] / _vspan
                    for _k = _vloI to _vhiI
                        array.set(_vvol, _k, array.get(_vvol, _k) + _vper)
                _vtot = 0.0
                _vmax = 0.0
                _vpoc = 0
                for _k = 0 to vpCols - 1
                    _vv = array.get(_vvol, _k)
                    _vtot += _vv
                    if _vv > _vmax
                        _vmax := _vv
                        _vpoc := _k
                _vaV  = array.get(_vvol, _vpoc)
                _vup  = _vpoc
                _vdn  = _vpoc
                _vtgt = _vtot * vpVaPct / 100.0
                _vgo  = _vtot > 0
                while _vgo
                    if _vaV >= _vtgt
                        _vgo := false
                    else
                        _vupV = _vup < vpCols - 1 ? array.get(_vvol, _vup + 1) : -1.0
                        _vdnV = _vdn > 0 ? array.get(_vvol, _vdn - 1) : -1.0
                        if _vupV < 0 and _vdnV < 0
                            _vgo := false
                        else if _vupV >= _vdnV
                            _vup := _vup + 1
                            _vaV := _vaV + _vupV
                        else
                            _vdn := _vdn - 1
                            _vaV := _vaV + _vdnV
                _vah    = _vlo + (_vup + 1) * _vbs
                _val    = _vlo + _vdn * _vbs
                _vpocPx = _vlo + (_vpoc + 0.5) * _vbs
                _vxL = math.max(bar_index - vpLineLen, bar_index - 9000)
                _vxR = bar_index + lvTagOff
                _vsz = lvTagSz == "small" ? size.small : lvTagSz == "large" ? size.large : size.normal
                array.push(_vpLnA, line.new(_vxL, _vpocPx, _vxR, _vpocPx, color = colPOC, width = 2))
                array.push(_vpLbA, label.new(_vxR, _vpocPx, "POC " + str.tostring(_vpocPx, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(colPOC, 0), textcolor = color.new(color.white, 0), size = _vsz))
                array.push(_vpLnA, line.new(_vxL, _vah, _vxR, _vah, color = colVA, width = 2))
                array.push(_vpLbA, label.new(_vxR, _vah, "VAH " + str.tostring(_vah, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(colVA, 0), textcolor = color.new(color.white, 0), size = _vsz))
                array.push(_vpLnA, line.new(_vxL, _val, _vxR, _val, color = colVA, width = 2))
                array.push(_vpLbA, label.new(_vxR, _val, "VAL " + str.tostring(_val, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(colVA, 0), textcolor = color.new(color.white, 0), size = _vsz))
