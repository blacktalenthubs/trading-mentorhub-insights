//@version=5
// Volume Profile · Lines — the value LEVELS only (POC / VAH / VAL + HVN shelves / LVN
// fast-zones + rolling VWAP), NO histogram bars. Same profile math as VP-pro, but draws
// only horizontal lines that sit within the existing price range, so it never extends
// the axis / compresses the candles the way the right-margin volume blocks do. Overlay.
indicator("Volume Profile · Lines", "VP-lines", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ── Profile ──────────────────────────────────────────────────────────────────
gP = "Profile"
barsBack = input.int(150, "Bars Back", minval = 10, maxval = 5000, group = gP)
columns  = input.int(35,  "Price rows", minval = 5, maxval = 200, group = gP)
vaPct    = input.float(70, "Value Area %", minval = 1, maxval = 100, group = gP)
lineLen  = input.int(120, "Line length (bars left)", minval = 5, maxval = 5000, group = gP)
rightPad = input.int(10, "Label offset (bars right)", minval = 0, maxval = 100, group = gP)

// ── Core levels (POC / VAH / VAL / VWAP) ─────────────────────────────────────
gL = "Core levels"
showPOC   = input.bool(true, "POC", inline = "poc", group = gL)
pocColor  = input.color(color.red, "", inline = "poc", group = gL)
pocWidth  = input.int(3, "w", minval = 1, maxval = 8, inline = "poc", group = gL)
showVA    = input.bool(true, "VAH / VAL", inline = "va", group = gL)
vaColor   = input.color(color.orange, "", inline = "va", group = gL)
vaWidth   = input.int(2, "w", minval = 1, maxval = 8, inline = "va", group = gL)
showAVWAP = input.bool(true, "VWAP", inline = "av", group = gL)
avColor   = input.color(color.blue, "", inline = "av", group = gL)
avWidth   = input.int(2, "w", minval = 1, maxval = 8, inline = "av", group = gL)
showLbls  = input.bool(true, "Show labels", group = gL)
lblSize   = input.string("small", "Label size", options = ["tiny", "small", "normal"], group = gL)

// ── Volume nodes (HVN shelves / LVN fast-zones) ──────────────────────────────
gN = "Volume nodes"
showHVN   = input.bool(true, "HVN shelves (S/R)", inline = "hvn", group = gN)
hvnColor  = input.color(#26A69A, "", inline = "hvn", group = gN)
showLVN   = input.bool(true, "LVN fast-zones", inline = "lvn", group = gN)
lvnColor  = input.color(#EF5350, "", inline = "lvn", group = gN)
hvnPct    = input.float(55, "HVN ≥ % of the peak row", minval = 10, maxval = 100, group = gN)
lvnPct    = input.float(25, "LVN ≤ % of the peak row", minval = 1,  maxval = 90,  group = gN)
nodeWidth = input.int(1, "Node line width", minval = 1, maxval = 6, group = gN)

// ── Weekly / Monthly high & low (prior period) ───────────────────────────────
gWM = "Weekly / Monthly levels"
enWk    = input.bool(true, "Prior week high / low (PWH / PWL)", inline = "wk", group = gWM)
wkColor = input.color(#26C6DA, "", inline = "wk", group = gWM)
enMo    = input.bool(true, "Prior month high / low (PMH / PML)", inline = "mo", group = gWM)
moColor = input.color(#AB47BC, "", inline = "mo", group = gWM)
wmWidth = input.int(2, "W/M line width", minval = 1, maxval = 8, group = gWM)

// ── Premium-selling HUD ──────────────────────────────────────────────────────
gHUD     = "Premium HUD"
enHUD    = input.bool(true, "Show premium-selling HUD", group = gHUD)
hudPos   = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = gHUD)
hudSize  = input.string("small", "Size", options = ["tiny", "small", "normal"], group = gHUD)
sellCalls = input.bool(true, "Also flag SELL CALLS at resistance", group = gHUD)
hudProx  = input.float(2.0, "'Near a level' within N%", minval = 0.1, maxval = 10, step = 0.1, group = gHUD)
hudRsiLen = input.int(14, "RSI length", minval = 2, group = gHUD)

f_lblSize(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal

// ── Rolling VWAP (the one dynamic line) ──────────────────────────────────────
_hlc  = (high + low + close) / 3.0
_sv   = math.sum(volume, barsBack)
avwap = _sv > 0 ? math.sum(_hlc * volume, barsBack) / _sv : na
plot(showAVWAP ? avwap : na, "VWAP", color = avColor, linewidth = avWidth)

// Prior week / month high & low (non-repainting — completed prior period).
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// HUD inputs (global — computed every bar). RSI turn + a realized-vol PROXY for premium
// richness (ATR% percentile). NOT option IV — Pine can't see it — so verify IV rank in
// your broker; this only flags the TECHNICAL "at a defended bottom" timing.
_rsiV    = ta.rsi(close, hudRsiLen)
_rsiUp   = _rsiV > _rsiV[1]
_atrp    = ta.atr(14) / close * 100.0
_atrRank = ta.percentrank(_atrp, 100)
_volTxt  = _atrRank >= 66 ? "rich" : _atrRank >= 33 ? "normal" : "thin"
_hudPosC = hudPos == "top_left" ? position.top_left : hudPos == "bottom_right" ? position.bottom_right : hudPos == "bottom_left" ? position.bottom_left : position.top_right
_hudSz   = hudSize == "tiny" ? size.tiny : hudSize == "normal" ? size.normal : size.small
var table hud = na

// ── Build the profile + draw the lines on the last bar ───────────────────────
var array<line>  vpLines = array.new_line()
var array<label> vpLbls  = array.new_label()
var float pocLevel = na
var float vahLevel = na
var float valLevel = na

if barstate.islast
    if array.size(vpLines) > 0
        for _i = 0 to array.size(vpLines) - 1
            line.delete(array.get(vpLines, _i))
    if array.size(vpLbls) > 0
        for _i = 0 to array.size(vpLbls) - 1
            label.delete(array.get(vpLbls, _i))
    array.clear(vpLines)
    array.clear(vpLbls)
    if not enHUD and not na(hud)
        table.delete(hud)
        hud := na

    _n = math.min(barsBack, bar_index)
    if _n >= 2
        _hi = high
        _lo = low
        for _b = 0 to _n - 1
            _hi := math.max(_hi, high[_b])
            _lo := math.min(_lo, low[_b])
        _rng = _hi - _lo
        if _rng > 0
            _bs = _rng / columns
            vol = array.new_float(columns, 0.0)
            for _b = 0 to _n - 1
                _loI = int(math.floor((low[_b]  - _lo) / _bs))
                _hiI = int(math.floor((high[_b] - _lo) / _bs))
                _loI := math.max(0, math.min(columns - 1, _loI))
                _hiI := math.max(0, math.min(columns - 1, _hiI))
                _span = _hiI - _loI + 1
                _per  = volume[_b] / _span
                for _k = _loI to _hiI
                    array.set(vol, _k, array.get(vol, _k) + _per)

            _total = 0.0
            _maxV  = 0.0
            _poc   = 0
            for _k = 0 to columns - 1
                _v = array.get(vol, _k)
                _total += _v
                if _v > _maxV
                    _maxV := _v
                    _poc  := _k

            _vaVol  = array.get(vol, _poc)
            _up     = _poc
            _dn     = _poc
            _target = _total * vaPct / 100.0
            _go     = _total > 0
            while _go
                if _vaVol >= _target
                    _go := false
                else
                    _upV = _up < columns - 1 ? array.get(vol, _up + 1) : -1.0
                    _dnV = _dn > 0 ? array.get(vol, _dn - 1) : -1.0
                    if _upV < 0 and _dnV < 0
                        _go := false
                    else if _upV >= _dnV
                        _up    := _up + 1
                        _vaVol := _vaVol + _upV
                    else
                        _dn    := _dn - 1
                        _vaVol := _vaVol + _dnV

            _vah      = _lo + (_up + 1) * _bs
            _val      = _lo + _dn * _bs
            _pocPrice = _lo + (_poc + 0.5) * _bs
            pocLevel := _pocPrice
            vahLevel := _vah
            valLevel := _val

            _xL = math.max(bar_index - lineLen, bar_index - 9000)
            _xR = bar_index + rightPad
            _sz = f_lblSize(lblSize)

            // HVN shelves (local peaks) + LVN fast-zones (local valleys).
            if showHVN or showLVN
                _hmin = _maxV * hvnPct / 100.0
                _lmax = _maxV * lvnPct / 100.0
                for _k = 1 to columns - 2
                    _vk    = array.get(vol, _k)
                    _vp    = array.get(vol, _k - 1)
                    _vn    = array.get(vol, _k + 1)
                    _price = _lo + (_k + 0.5) * _bs
                    _isH = _vk >= _vp and _vk >= _vn and _vk >= _hmin
                    _isL = _vk <= _vp and _vk <= _vn and _vk <= _lmax and _vk > 0
                    if showHVN and _isH
                        array.push(vpLines, line.new(_xL, _price, _xR, _price, color = hvnColor, width = nodeWidth, style = line.style_solid))
                        if showLbls
                            array.push(vpLbls, label.new(_xR, _price, "HVN " + str.tostring(_price, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(hvnColor, 0), textcolor = color.new(color.white, 0), size = _sz))
                    else if showLVN and _isL
                        array.push(vpLines, line.new(_xL, _price, _xR, _price, color = lvnColor, width = nodeWidth, style = line.style_dotted))
                        if showLbls
                            array.push(vpLbls, label.new(_xR, _price, "LVN " + str.tostring(_price, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lvnColor, 0), textcolor = color.new(color.white, 0), size = _sz))

            // POC / VAH / VAL.
            if showPOC
                array.push(vpLines, line.new(_xL, _pocPrice, _xR, _pocPrice, color = pocColor, width = pocWidth))
                if showLbls
                    array.push(vpLbls, label.new(_xR, _pocPrice, "POC " + str.tostring(_pocPrice, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(pocColor, 0), textcolor = color.new(color.white, 0), size = _sz))
            if showVA
                array.push(vpLines, line.new(_xL, _vah, _xR, _vah, color = vaColor, width = vaWidth))
                array.push(vpLines, line.new(_xL, _val, _xR, _val, color = vaColor, width = vaWidth))
                if showLbls
                    array.push(vpLbls, label.new(_xR, _vah, "VAH " + str.tostring(_vah, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(vaColor, 0), textcolor = color.new(color.white, 0), size = _sz))
                    array.push(vpLbls, label.new(_xR, _val, "VAL " + str.tostring(_val, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(vaColor, 0), textcolor = color.new(color.white, 0), size = _sz))

            // Weekly / monthly prior high & low.
            if enWk and not na(pwh)
                array.push(vpLines, line.new(_xL, pwh, _xR, pwh, color = wkColor, width = wmWidth))
                array.push(vpLines, line.new(_xL, pwl, _xR, pwl, color = wkColor, width = wmWidth))
                if showLbls
                    array.push(vpLbls, label.new(_xR, pwh, "PWH " + str.tostring(pwh, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(wkColor, 0), textcolor = color.new(color.white, 0), size = _sz))
                    array.push(vpLbls, label.new(_xR, pwl, "PWL " + str.tostring(pwl, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(wkColor, 0), textcolor = color.new(color.white, 0), size = _sz))
            if enMo and not na(pmh)
                array.push(vpLines, line.new(_xL, pmh, _xR, pmh, color = moColor, width = wmWidth))
                array.push(vpLines, line.new(_xL, pml, _xR, pml, color = moColor, width = wmWidth))
                if showLbls
                    array.push(vpLbls, label.new(_xR, pmh, "PMH " + str.tostring(pmh, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(moColor, 0), textcolor = color.new(color.white, 0), size = _sz))
                    array.push(vpLbls, label.new(_xR, pml, "PML " + str.tostring(pml, "#.##"), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(moColor, 0), textcolor = color.new(color.white, 0), size = _sz))

            // ── Premium-selling HUD ──────────────────────────────────────────
            if enHUD
                // Nearest support (level ≤ price) and resistance (level ≥ price) across
                // POC / VAH / VAL / prior week & month H-L.
                _cand = array.new_float()
                _cnm  = array.new_string()
                array.push(_cand, _pocPrice)
                array.push(_cnm, "POC")
                array.push(_cand, _vah)
                array.push(_cnm, "VAH")
                array.push(_cand, _val)
                array.push(_cnm, "VAL")
                if not na(pwh)
                    array.push(_cand, pwh)
                    array.push(_cnm, "PWH")
                    array.push(_cand, pwl)
                    array.push(_cnm, "PWL")
                if not na(pmh)
                    array.push(_cand, pmh)
                    array.push(_cnm, "PMH")
                    array.push(_cand, pml)
                    array.push(_cnm, "PML")
                _sup = float(na)
                _supNm = ""
                _res = float(na)
                _resNm = ""
                for _j = 0 to array.size(_cand) - 1
                    _lv = array.get(_cand, _j)
                    _nm = array.get(_cnm, _j)
                    if not na(_lv) and _lv > 0
                        if _lv <= close and (na(_sup) or _lv > _sup)
                            _sup := _lv
                            _supNm := _nm
                        if _lv >= close and (na(_res) or _lv < _res)
                            _res := _lv
                            _resNm := _nm
                _supD = not na(_sup) ? (close - _sup) / close * 100.0 : float(na)
                _resD = not na(_res) ? (_res - close) / close * 100.0 : float(na)
                _nearSup = not na(_supD) and _supD <= hudProx
                _nearRes = not na(_resD) and _resD <= hudProx
                _putsGood  = _nearSup and _rsiV < 45 and _rsiUp
                _knife     = _rsiV < 35 and not _rsiUp
                _callsGood = sellCalls and _nearRes and _rsiV > 55 and not _rsiUp
                _verdict = _knife ? "WAIT · knife" : _putsGood ? "SELL PUTS" : _callsGood ? "SELL CALLS" : "WAIT"
                _vCol = _putsGood or _callsGood ? #26A69A : _knife ? #EF5350 : #F5A623
                _loc = close < _val ? "below value" : math.abs(close - _pocPrice) / close * 100.0 <= hudProx ? "at POC" : close > _vah ? "above value" : "inside value"
                _strike = _putsGood and not na(_sup) ? "puts ≤ " + str.tostring(_sup, "#.##") : _callsGood and not na(_res) ? "calls ≥ " + str.tostring(_res, "#.##") : "—"
                _supTxt = not na(_sup) ? _supNm + " " + str.tostring(_sup, "#.##") + " · " + str.tostring(_supD, "#.#") + "%" : "—"
                _rsiTxt = str.tostring(_rsiV, "#") + (_rsiUp ? " ↑" : " ↓")
                if na(hud)
                    hud := table.new(_hudPosC, 2, 6, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))
                _hb  = color.new(#0f1420, 8)
                _lblC = color.new(color.gray, 0)
                _txtC = color.new(color.white, 0)
                table.cell(hud, 0, 0, "PREMIUM", bgcolor = _hb, text_color = _lblC, text_size = _hudSz)
                table.cell(hud, 1, 0, _verdict, bgcolor = _hb, text_color = _vCol, text_size = _hudSz)
                table.cell(hud, 0, 1, "Location", bgcolor = _hb, text_color = _lblC, text_size = _hudSz)
                table.cell(hud, 1, 1, _loc, bgcolor = _hb, text_color = _txtC, text_size = _hudSz)
                table.cell(hud, 0, 2, "Support", bgcolor = _hb, text_color = _lblC, text_size = _hudSz)
                table.cell(hud, 1, 2, _supTxt, bgcolor = _hb, text_color = _txtC, text_size = _hudSz)
                table.cell(hud, 0, 3, "Strike", bgcolor = _hb, text_color = _lblC, text_size = _hudSz)
                table.cell(hud, 1, 3, _strike, bgcolor = _hb, text_color = _txtC, text_size = _hudSz)
                table.cell(hud, 0, 4, "RSI", bgcolor = _hb, text_color = _lblC, text_size = _hudSz)
                table.cell(hud, 1, 4, _rsiTxt, bgcolor = _hb, text_color = _txtC, text_size = _hudSz)
                table.cell(hud, 0, 5, "Premium~", bgcolor = _hb, text_color = _lblC, text_size = _hudSz)
                table.cell(hud, 1, 5, _volTxt + " (proxy)", bgcolor = _hb, text_color = _txtC, text_size = _hudSz)

// ── Alerts: price trading into a key level ───────────────────────────────────
alertcondition(not na(pocLevel) and low <= pocLevel and high >= pocLevel, "Price at POC", "{{ticker}} is trading at the Volume Profile POC")
alertcondition(not na(vahLevel) and low <= vahLevel and high >= vahLevel, "Price at VAH", "{{ticker}} is trading at the Value Area High")
alertcondition(not na(valLevel) and low <= valLevel and high >= valLevel, "Price at VAL", "{{ticker}} is trading at the Value Area Low")

// ── Unfilled gaps — every gap tracked, persists until price closes back through ──
// A bar opening beyond the prior range (open > PDH = gap up, open < PDL = gap down)
// leaves an unfilled zone; it stays drawn (faint box) until filled, and is proximity-
// gated so far gaps don't clutter or stretch the axis.
gG = "Unfilled gaps"
enGap     = input.bool(true, "Show unfilled gaps", group = gG)
gapProx   = input.float(15.0, "Only draw within N% of price (0 = always)", minval = 0, maxval = 100, group = gG)
gapTransp = input.int(88, "Gap box faintness (100 = invisible)", minval = 60, maxval = 100, group = gG)
maxGaps   = input.int(12, "Max unfilled gaps to keep", minval = 1, maxval = 50, group = gG)
colGapUp  = input.color(#26A69A, "Gap-up (support)", inline = "gc", group = gG)
colGapDn  = input.color(#EF5350, "Gap-down (resistance)", inline = "gc", group = gG)

_pdh = high[1]
_pdl = low[1]
var array<float> gHi  = array.new_float()
var array<float> gLo  = array.new_float()
var array<int>   gBar = array.new_int()
var array<int>   gDir = array.new_int()   // +1 gap up (support below), -1 gap down (resistance above)

if not na(_pdh) and open > _pdh
    array.push(gHi, open)
    array.push(gLo, _pdh)
    array.push(gBar, bar_index)
    array.push(gDir, 1)
if not na(_pdl) and open < _pdl
    array.push(gHi, _pdl)
    array.push(gLo, open)
    array.push(gBar, bar_index)
    array.push(gDir, -1)

// Drop filled gaps (price closed back through). Iterate backwards so removals are safe.
if array.size(gDir) > 0
    _gi = array.size(gDir) - 1
    while _gi >= 0
        _gd = array.get(gDir, _gi)
        _gh = array.get(gHi, _gi)
        _gl = array.get(gLo, _gi)
        _gfilled = (_gd == 1 and close < _gl) or (_gd == -1 and close > _gh)
        if _gfilled
            array.remove(gHi, _gi)
            array.remove(gLo, _gi)
            array.remove(gBar, _gi)
            array.remove(gDir, _gi)
        _gi := _gi - 1

while array.size(gDir) > maxGaps
    array.shift(gHi)
    array.shift(gLo)
    array.shift(gBar)
    array.shift(gDir)

f_gapNear(float _edge) => gapProx <= 0 or (not na(_edge) and _edge != 0 and math.abs(close - _edge) / close * 100.0 <= gapProx)

var array<box> gBox = array.new_box()
if barstate.islast
    if array.size(gBox) > 0
        for _i = 0 to array.size(gBox) - 1
            box.delete(array.get(gBox, _i))
    array.clear(gBox)
    if enGap and array.size(gDir) > 0
        _gx2 = bar_index + rightPad
        for _i = 0 to array.size(gDir) - 1
            _d    = array.get(gDir, _i)
            _h    = array.get(gHi, _i)
            _l    = array.get(gLo, _i)
            _bar  = array.get(gBar, _i)
            _edge = _d == 1 ? _h : _l
            if f_gapNear(_edge)
                _col  = _d == 1 ? colGapUp : colGapDn
                _left = math.max(_bar, bar_index - 9000)
                array.push(gBox, box.new(_left, _h, _gx2, _l, border_width = 0, bgcolor = color.new(_col, gapTransp)))
