//@version=5
// Volume Profile · Lines — the value LEVELS only (POC / VAH / VAL + HVN shelves / LVN
// fast-zones + rolling VWAP), NO histogram bars, LOCKABLE to any timeframe (like MA-flat)
// so the levels don't shift when you change chart TF. Horizontal lines only, so it never
// stretches the axis / compresses candles the way right-margin volume blocks do. Overlay.
indicator("Volume Profile · Lines", "VP-lines", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ── Profile ──────────────────────────────────────────────────────────────────
gP = "Profile"
vpLock   = input.bool(true, "Lock to a fixed timeframe (off = follow chart)", group = gP, tooltip = "ON = the profile is computed on the timeframe below and stays put on any chart, like the MA-flat SMAs. OFF = follows the chart timeframe.")
vpTfPick = input.timeframe("D", "…locked timeframe", group = gP)
barsBack = input.int(150, "Bars Back", minval = 10, maxval = 5000, group = gP)
columns  = input.int(35,  "Price rows", minval = 5, maxval = 200, group = gP)
vaPct    = input.float(70, "Value Area %", minval = 1, maxval = 100, group = gP)
lineLen  = input.int(120, "Line length (bars left)", minval = 5, maxval = 5000, group = gP)
rightPad = input.int(10, "Label offset (bars right)", minval = 0, maxval = 100, group = gP)
drawProx = input.float(20.0, "Only draw levels within N% of price (0 = all)", minval = 0, maxval = 100, group = gP, tooltip = "Hides levels far from price so a wide-range locked profile doesn't compress the chart. 0 = draw every level.")
vpTf = vpLock ? vpTfPick : timeframe.period

// ── Core levels (POC / VAH / VAL / VWAP) ─────────────────────────────────────
gL = "Core levels"
showPOC   = input.bool(true, "POC", inline = "poc", group = gL)
pocColor  = input.color(color.red, "", inline = "poc", group = gL)
pocWidth  = input.int(3, "w", minval = 1, maxval = 8, inline = "poc", group = gL)
showVA    = input.bool(true, "VAH / VAL", inline = "va", group = gL)
vaColor   = input.color(color.orange, "", inline = "va", group = gL)
vaWidth   = input.int(2, "w", minval = 1, maxval = 8, inline = "va", group = gL)
showAVWAP = input.bool(true, "VWAP", inline = "av", group = gL)
avColor   = input.color(color.blue, "", inline = "av", group = gL)
avWidth   = input.int(2, "w", minval = 1, maxval = 8, inline = "av", group = gL)
showLbls  = input.bool(true, "Show labels", group = gL)
lblSize   = input.string("small", "Label size", options = ["tiny", "small", "normal"], group = gL)

// ── Volume nodes (HVN shelves / LVN fast-zones) ──────────────────────────────
gN = "Volume nodes"
showHVN   = input.bool(true, "HVN shelves (S/R)", inline = "hvn", group = gN)
hvnColor  = input.color(#26A69A, "", inline = "hvn", group = gN)
showLVN   = input.bool(true, "LVN fast-zones", inline = "lvn", group = gN)
lvnColor  = input.color(#EF5350, "", inline = "lvn", group = gN)
hvnPct    = input.float(55, "HVN ≥ % of the peak row", minval = 10, maxval = 100, group = gN)
lvnPct    = input.float(25, "LVN ≤ % of the peak row", minval = 1,  maxval = 90,  group = gN)
nodeWidth = input.int(1, "Node line width", minval = 1, maxval = 6, group = gN)

// ── Weekly / Monthly high & low (prior period) ───────────────────────────────
gWM = "Weekly / Monthly levels"
enWk    = input.bool(true, "Prior week high / low (PWH / PWL)", inline = "wk", group = gWM)
wkColor = input.color(#26C6DA, "", inline = "wk", group = gWM)
enMo    = input.bool(true, "Prior month high / low (PMH / PML)", inline = "mo", group = gWM)
moColor = input.color(#AB47BC, "", inline = "mo", group = gWM)
wmWidth = input.int(2, "W/M line width", minval = 1, maxval = 8, group = gWM)

// ── Premium-selling HUD ──────────────────────────────────────────────────────
gHUD      = "Premium HUD"
enHUD     = input.bool(true, "Show premium-selling HUD", group = gHUD)
hudPos    = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = gHUD)
hudSize   = input.string("small", "Size", options = ["tiny", "small", "normal"], group = gHUD)
sellCalls = input.bool(true, "Also flag SELL CALLS at resistance", group = gHUD)
hudProx   = input.float(2.0, "'Near a level' within N%", minval = 0.1, maxval = 10, step = 0.1, group = gHUD)
hudRsiLen = input.int(14, "RSI length", minval = 2, group = gHUD)

f_lblSize(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : size.normal

// ── The whole profile, computed IN-CONTEXT so request.security runs it on the ──
// locked timeframe. Returns POC / VAH / VAL / rolling-VWAP + up to 6 HVN and 6 LVN
// node prices (na-padded, price order). Lines only, so we only need the price levels.
f_vp(int _bars, int _cols, float _vapct, float _hpct, float _lpct) =>
    _n = math.min(_bars, bar_index)
    float _poc = na
    float _vah = na
    float _val = na
    float _vw  = na
    _h = array.new_float()
    _l = array.new_float()
    if _n >= 2
        _hi = high
        _lo = low
        for _b = 0 to _n - 1
            _hi := math.max(_hi, high[_b])
            _lo := math.min(_lo, low[_b])
        _rng = _hi - _lo
        if _rng > 0
            _bs = _rng / _cols
            _vv = array.new_float(_cols, 0.0)
            _pv = 0.0
            _pvol = 0.0
            for _b = 0 to _n - 1
                _loI = int(math.floor((low[_b]  - _lo) / _bs))
                _hiI = int(math.floor((high[_b] - _lo) / _bs))
                _loI := math.max(0, math.min(_cols - 1, _loI))
                _hiI := math.max(0, math.min(_cols - 1, _hiI))
                _span = _hiI - _loI + 1
                _per  = volume[_b] / _span
                for _k = _loI to _hiI
                    array.set(_vv, _k, array.get(_vv, _k) + _per)
                _pv   := _pv + (high[_b] + low[_b] + close[_b]) / 3.0 * volume[_b]
                _pvol := _pvol + volume[_b]
            _tot = 0.0
            _mx  = 0.0
            _pi  = 0
            for _k = 0 to _cols - 1
                _v = array.get(_vv, _k)
                _tot += _v
                if _v > _mx
                    _mx := _v
                    _pi := _k
            _va = array.get(_vv, _pi)
            _up = _pi
            _dn = _pi
            _tg = _tot * _vapct / 100.0
            _go = _tot > 0
            while _go
                if _va >= _tg
                    _go := false
                else
                    _uV = _up < _cols - 1 ? array.get(_vv, _up + 1) : -1.0
                    _dV = _dn > 0 ? array.get(_vv, _dn - 1) : -1.0
                    if _uV < 0 and _dV < 0
                        _go := false
                    else if _uV >= _dV
                        _up := _up + 1
                        _va := _va + _uV
                    else
                        _dn := _dn - 1
                        _va := _va + _dV
            _poc := _lo + (_pi + 0.5) * _bs
            _vah := _lo + (_up + 1) * _bs
            _val := _lo + _dn * _bs
            _vw  := _pvol > 0 ? _pv / _pvol : na
            // HVN / LVN local extrema (price order).
            _hmin = _mx * _hpct / 100.0
            _lmax = _mx * _lpct / 100.0
            for _k = 1 to _cols - 2
                _vk = array.get(_vv, _k)
                _vp = array.get(_vv, _k - 1)
                _vn = array.get(_vv, _k + 1)
                _pr = _lo + (_k + 0.5) * _bs
                if _vk >= _vp and _vk >= _vn and _vk >= _hmin
                    if array.size(_h) < 6
                        array.push(_h, _pr)
                else if _vk <= _vp and _vk <= _vn and _vk <= _lmax and _vk > 0
                    if array.size(_l) < 6
                        array.push(_l, _pr)
    while array.size(_h) < 6
        array.push(_h, na)
    while array.size(_l) < 6
        array.push(_l, na)
    [_poc, _vah, _val, _vw, array.get(_h, 0), array.get(_h, 1), array.get(_h, 2), array.get(_h, 3), array.get(_h, 4), array.get(_h, 5), array.get(_l, 0), array.get(_l, 1), array.get(_l, 2), array.get(_l, 3), array.get(_l, 4), array.get(_l, 5)]

[vpPoc, vpVah, vpVal, vpVwap, vpH0, vpH1, vpH2, vpH3, vpH4, vpH5, vpL0, vpL1, vpL2, vpL3, vpL4, vpL5] = request.security(syminfo.tickerid, vpTf, f_vp(barsBack, columns, vaPct, hvnPct, lvnPct), lookahead = barmerge.lookahead_off)

// HUD momentum, computed on the SAME (locked) timeframe so the read matches the profile.
_rsiV    = request.security(syminfo.tickerid, vpTf, ta.rsi(close, hudRsiLen), lookahead = barmerge.lookahead_off)
_rsiPrev = request.security(syminfo.tickerid, vpTf, ta.rsi(close, hudRsiLen)[1], lookahead = barmerge.lookahead_off)
_rsiUp   = _rsiV > _rsiPrev
_ma200   = request.security(syminfo.tickerid, vpTf, ta.sma(close, 200), lookahead = barmerge.lookahead_off)
_rsiLo10 = request.security(syminfo.tickerid, vpTf, ta.lowest(ta.rsi(close, hudRsiLen), 10), lookahead = barmerge.lookahead_off)
_rsiHi10 = request.security(syminfo.tickerid, vpTf, ta.highest(ta.rsi(close, hudRsiLen), 10), lookahead = barmerge.lookahead_off)
_clLo10  = request.security(syminfo.tickerid, vpTf, ta.lowest(close, 10), lookahead = barmerge.lookahead_off)
_clHi10  = request.security(syminfo.tickerid, vpTf, ta.highest(close, 10), lookahead = barmerge.lookahead_off)
_lc      = request.security(syminfo.tickerid, vpTf, close, lookahead = barmerge.lookahead_off)   // locked-TF close for the HUD read
_lpc     = request.security(syminfo.tickerid, vpTf, close[1], lookahead = barmerge.lookahead_off)
_atrp    = ta.atr(14) / close * 100.0
_atrRank = ta.percentrank(_atrp, 100)
_volTxt  = _atrRank >= 66 ? "rich" : _atrRank >= 33 ? "normal" : "thin"
_hudPosC = hudPos == "top_left" ? position.top_left : hudPos == "bottom_right" ? position.bottom_right : hudPos == "bottom_left" ? position.bottom_left : position.top_right
_hudSz   = hudSize == "tiny" ? size.tiny : hudSize == "normal" ? size.normal : size.small
var table hud = na

// Prior week / month high & low (non-repainting).
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ── Draw all the flat lines on the last bar ──────────────────────────────────
var array<line>  vpLines = array.new_line()
var array<label> vpLbls  = array.new_label()

f_line(float _y, color _c, int _w, string _sty) =>
    line.new(math.max(bar_index - lineLen, bar_index - 9000), _y, bar_index + rightPad, _y, xloc = xloc.bar_index, color = _c, width = _w, style = _sty)
f_tag(float _y, string _t, color _c) =>
    label.new(bar_index + rightPad, _y, _t, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(_c, 0), textcolor = color.new(color.white, 0), size = f_lblSize(lblSize))
// Draw a level only when it's real and within drawProx% of price (so a wide-range locked
// profile doesn't drag far levels onto the axis and compress the candles). na → false.
f_near(float _lv) => not na(_lv) and _lv != 0 and (drawProx <= 0 or math.abs(close - _lv) / close * 100.0 <= drawProx)

if barstate.islast
    if array.size(vpLines) > 0
        for _i = 0 to array.size(vpLines) - 1
            line.delete(array.get(vpLines, _i))
    if array.size(vpLbls) > 0
        for _i = 0 to array.size(vpLbls) - 1
            label.delete(array.get(vpLbls, _i))
    array.clear(vpLines)
    array.clear(vpLbls)
    if not enHUD and not na(hud)
        table.delete(hud)
        hud := na

    // HVN / LVN nodes — drawn only when near price (proximity-gated) so far shelves in a
    // wide locked profile don't compress the chart.
    if showHVN
        for _v in array.from(vpH0, vpH1, vpH2, vpH3, vpH4, vpH5)
            if f_near(_v)
                array.push(vpLines, f_line(_v, hvnColor, nodeWidth, line.style_solid))
                if showLbls
                    array.push(vpLbls, f_tag(_v, "HVN " + str.tostring(_v, "#.##"), hvnColor))
    if showLVN
        for _v in array.from(vpL0, vpL1, vpL2, vpL3, vpL4, vpL5)
            if f_near(_v)
                array.push(vpLines, f_line(_v, lvnColor, nodeWidth, line.style_dotted))
                if showLbls
                    array.push(vpLbls, f_tag(_v, "LVN " + str.tostring(_v, "#.##"), lvnColor))

    // POC / VAH / VAL / VWAP — each gated individually.
    if showPOC and f_near(vpPoc)
        array.push(vpLines, f_line(vpPoc, pocColor, pocWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(vpPoc, "POC " + str.tostring(vpPoc, "#.##"), pocColor))
    if showVA and f_near(vpVah)
        array.push(vpLines, f_line(vpVah, vaColor, vaWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(vpVah, "VAH " + str.tostring(vpVah, "#.##"), vaColor))
    if showVA and f_near(vpVal)
        array.push(vpLines, f_line(vpVal, vaColor, vaWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(vpVal, "VAL " + str.tostring(vpVal, "#.##"), vaColor))
    if showAVWAP and f_near(vpVwap)
        array.push(vpLines, f_line(vpVwap, avColor, avWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(vpVwap, "VWAP " + str.tostring(vpVwap, "#.##"), avColor))

    // Weekly / monthly prior high & low — each gated individually.
    if enWk and f_near(pwh)
        array.push(vpLines, f_line(pwh, wkColor, wmWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(pwh, "PWH " + str.tostring(pwh, "#.##"), wkColor))
    if enWk and f_near(pwl)
        array.push(vpLines, f_line(pwl, wkColor, wmWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(pwl, "PWL " + str.tostring(pwl, "#.##"), wkColor))
    if enMo and f_near(pmh)
        array.push(vpLines, f_line(pmh, moColor, wmWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(pmh, "PMH " + str.tostring(pmh, "#.##"), moColor))
    if enMo and f_near(pml)
        array.push(vpLines, f_line(pml, moColor, wmWidth, line.style_solid))
        if showLbls
            array.push(vpLbls, f_tag(pml, "PML " + str.tostring(pml, "#.##"), moColor))

    // ── Premium-selling HUD (volume levels + RSI, on the locked timeframe) ──
    if enHUD and not na(vpPoc)
        c = _lc
        pc = _lpc
        _prox = hudProx / 100.0
        _nearVal = math.abs(c - vpVal) / vpVal <= _prox
        _nearVah = math.abs(c - vpVah) / vpVah <= _prox
        near200 = not na(_ma200) and math.abs(c - _ma200) / c <= _prox
        _lowerV = vpVal * (1 - _prox) <= c and c <= vpPoc * (1 + _prox)
        _upperV = vpPoc * (1 - _prox) <= c and c <= vpVah * (1 + _prox)
        _valB = (_nearVal or (c > vpVal and pc <= vpVal)) and _rsiUp
        _r30  = _rsiV >= 30 and _rsiV <= 42 and _rsiUp and _rsiLo10 < 33 and _lowerV
        _mRec = near200 and c > _ma200 and _clLo10 < _ma200
        _puts = _valB or _r30 or _mRec
        _pWhy = _valB ? "VAL bounce" : _r30 ? "RSI-30 reclaim" : "200SMA reclaim"
        _vahR = (_nearVah or (c < vpVah and pc >= vpVah)) and not _rsiUp
        _r70  = _rsiV >= 58 and not _rsiUp and _rsiHi10 > 68 and _upperV
        _mLos = near200 and c < _ma200 and _clHi10 > _ma200
        _calls = sellCalls and (_vahR or _r70 or _mLos)
        _cWhy = _vahR ? "VAH reject" : _r70 ? "RSI-70 roll" : "200SMA loss"
        _knife = _rsiV < 30 and not _rsiUp
        _verdict = _knife ? "WAIT · knife" : _puts ? "SELL PUTS · " + _pWhy : _calls ? "SELL CALLS · " + _cWhy : "WAIT"
        _vCol = _puts or _calls ? #26A69A : _knife ? #EF5350 : #F5A623
        _loc = c < vpVal ? "below value" : math.abs(c - vpPoc) / c * 100.0 <= hudProx ? "at POC" : c > vpVah ? "above value" : "inside value"
        _lvl = _puts ? (_mRec ? _ma200 : vpVal) : _calls ? (_mLos ? _ma200 : vpVah) : na
        _strike = _puts and not na(_lvl) ? "puts ≤ " + str.tostring(_lvl, "#.##") : _calls and not na(_lvl) ? "calls ≥ " + str.tostring(_lvl, "#.##") : "—"
        _rsiTxt = str.tostring(_rsiV, "#") + (_rsiUp ? " ↑" : " ↓")
        if na(hud)
            hud := table.new(_hudPosC, 2, 6, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))
        _hb = color.new(#0f1420, 8)
        _lc2 = color.new(color.gray, 0)
        _tc = color.new(color.white, 0)
        table.cell(hud, 0, 0, "PREMIUM", bgcolor = _hb, text_color = _lc2, text_size = _hudSz)
        table.cell(hud, 1, 0, _verdict, bgcolor = _hb, text_color = _vCol, text_size = _hudSz)
        table.cell(hud, 0, 1, "Location", bgcolor = _hb, text_color = _lc2, text_size = _hudSz)
        table.cell(hud, 1, 1, _loc, bgcolor = _hb, text_color = _tc, text_size = _hudSz)
        table.cell(hud, 0, 2, "Strike", bgcolor = _hb, text_color = _lc2, text_size = _hudSz)
        table.cell(hud, 1, 2, _strike, bgcolor = _hb, text_color = _tc, text_size = _hudSz)
        table.cell(hud, 0, 3, "RSI", bgcolor = _hb, text_color = _lc2, text_size = _hudSz)
        table.cell(hud, 1, 3, _rsiTxt, bgcolor = _hb, text_color = _tc, text_size = _hudSz)
        table.cell(hud, 0, 4, "TF", bgcolor = _hb, text_color = _lc2, text_size = _hudSz)
        table.cell(hud, 1, 4, vpTf, bgcolor = _hb, text_color = _tc, text_size = _hudSz)
        table.cell(hud, 0, 5, "Premium~", bgcolor = _hb, text_color = _lc2, text_size = _hudSz)
        table.cell(hud, 1, 5, _volTxt + " (proxy)", bgcolor = _hb, text_color = _tc, text_size = _hudSz)

// ── Unfilled gaps — chart timeframe (persist until filled, proximity-gated) ───
gG = "Unfilled gaps"
enGap     = input.bool(true, "Show unfilled gaps", group = gG)
gapProx   = input.float(15.0, "Only draw within N% of price (0 = always)", minval = 0, maxval = 100, group = gG)
gapTransp = input.int(88, "Gap box faintness (100 = invisible)", minval = 60, maxval = 100, group = gG)
maxGaps   = input.int(12, "Max unfilled gaps to keep", minval = 1, maxval = 50, group = gG)
colGapUp  = input.color(#26A69A, "Gap-up (support)", inline = "gc", group = gG)
colGapDn  = input.color(#EF5350, "Gap-down (resistance)", inline = "gc", group = gG)

_pdh = high[1]
_pdl = low[1]
var array<float> gHi  = array.new_float()
var array<float> gLo  = array.new_float()
var array<int>   gBar = array.new_int()
var array<int>   gDir = array.new_int()

if not na(_pdh) and open > _pdh
    array.push(gHi, open)
    array.push(gLo, _pdh)
    array.push(gBar, bar_index)
    array.push(gDir, 1)
if not na(_pdl) and open < _pdl
    array.push(gHi, _pdl)
    array.push(gLo, open)
    array.push(gBar, bar_index)
    array.push(gDir, -1)

if array.size(gDir) > 0
    _gi = array.size(gDir) - 1
    while _gi >= 0
        _gd = array.get(gDir, _gi)
        _gh = array.get(gHi, _gi)
        _gl = array.get(gLo, _gi)
        _gfilled = (_gd == 1 and close < _gl) or (_gd == -1 and close > _gh)
        if _gfilled
            array.remove(gHi, _gi)
            array.remove(gLo, _gi)
            array.remove(gBar, _gi)
            array.remove(gDir, _gi)
        _gi := _gi - 1

while array.size(gDir) > maxGaps
    array.shift(gHi)
    array.shift(gLo)
    array.shift(gBar)
    array.shift(gDir)

f_gapNear(float _edge) => gapProx <= 0 or (not na(_edge) and _edge != 0 and math.abs(close - _edge) / close * 100.0 <= gapProx)

var array<box> gBox = array.new_box()
if barstate.islast
    if array.size(gBox) > 0
        for _i = 0 to array.size(gBox) - 1
            box.delete(array.get(gBox, _i))
    array.clear(gBox)
    if enGap and array.size(gDir) > 0
        _gx2 = bar_index + rightPad
        for _i = 0 to array.size(gDir) - 1
            _d    = array.get(gDir, _i)
            _h    = array.get(gHi, _i)
            _l    = array.get(gLo, _i)
            _bar  = array.get(gBar, _i)
            _edge = _d == 1 ? _h : _l
            if f_gapNear(_edge)
                _col  = _d == 1 ? colGapUp : colGapDn
                _left = math.max(_bar, bar_index - 9000)
                array.push(gBox, box.new(_left, _h, _gx2, _l, border_width = 0, bgcolor = color.new(_col, gapTransp)))

// ── Alerts: price trading into a key level ───────────────────────────────────
alertcondition(not na(vpPoc) and low <= vpPoc and high >= vpPoc, "Price at POC", "{{ticker}} is trading at the Volume Profile POC")
alertcondition(not na(vpVah) and low <= vpVah and high >= vpVah, "Price at VAH", "{{ticker}} is trading at the Value Area High")
alertcondition(not na(vpVal) and low <= vpVal and high >= vpVal, "Price at VAL", "{{ticker}} is trading at the Value Area Low")
