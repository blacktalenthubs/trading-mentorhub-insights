//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// GAP · SHOCK-GAP SETUPS — mark big (≥N%) gaps and the two trades off them.
//   • Gap bar   — open ≥ N% from the prior close (up or down). Labelled with the %.
//   • 3-2-1     — after the gap, price levels off and its swings TIGHTEN (a mini-VCP)
//                 under the post-gap HIGH (the ceiling). A break of the ceiling is the
//                 long entry; stop = the recent contraction low. Same-day or days later.
//   • Opening range (intraday charts) — the first N minutes of each session; a break of
//                 the OR high = long, of the OR low = short (the day-of gap trade).
// Works on any timeframe: DAILY = multi-day gaps + 3-2-1; intraday = same-day + the OR.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Gap · Shock-Gap Setups", "GAP", overlay = true)

// ── gap + 3-2-1 ────────────────────────────────────────────────────────────────
gGap    = "Gap & 3-2-1"
gapPct  = input.float(4.0, "Big gap ≥ N% (open vs prior close)", minval = 0.5, maxval = 30, step = 0.5, group = gGap)
contractRatio = input.float(0.6, "Contraction: recent 5-bar range ≤ N × the post-gap range", minval = 0.1, maxval = 1.0, step = 0.05, group = gGap)
nearCeil = input.float(6.0, "Coiling — within N% below the ceiling", minval = 1, maxval = 25, group = gGap)
colUp   = input.color(#26A69A, "Gap up",   inline = "gc", group = gGap)
colDn   = input.color(#EF5350, "Gap down", inline = "gc", group = gGap)
colCeil = input.color(#FB8C00, "Ceiling / entry", group = gGap)

// ── opening range (intraday only) ──────────────────────────────────────────────
gOR     = "Opening range (intraday)"
showOR  = input.bool(true, "Mark the opening range on intraday charts", group = gOR)
orMin   = input.int(10, "Opening-range minutes", minval = 1, maxval = 120, group = gOR)
colOR   = input.color(#42A5F5, "OR box", group = gOR)

enHud   = input.bool(true, "Show the HUD", group = "HUD")

// ── gap detection (this timeframe) ─────────────────────────────────────────────
gap   = close[1] != 0 and not na(close[1]) ? (open - close[1]) / close[1] * 100.0 : na
isGap = not na(gap) and math.abs(gap) >= gapPct

// running ceiling / floor since the most recent gap bar (reset on each new gap)
var int   gapBarIdx = na
var float gapVal    = na
var float ceiling   = na
var float gfloor    = na
if isGap
    gapBarIdx := bar_index
    gapVal    := gap
    ceiling   := high
    gfloor    := low
else if not na(ceiling)
    ceiling := math.max(ceiling, high)
    gfloor  := math.min(gfloor, low)
_since = na(gapBarIdx) ? na : bar_index - gapBarIdx

// 3-2-1: recent 5-bar range tight vs the whole post-gap range, coiling under the ceiling
_recRange  = ta.highest(high, 5) - ta.lowest(low, 5)
_baseRange = na(ceiling) or na(gfloor) ? na : ceiling - gfloor
contracting = not na(_baseRange) and _baseRange > 0 and _recRange <= _baseRange * contractRatio
nearC   = not na(ceiling) and ceiling > 0 and close < ceiling and (ceiling - close) / ceiling * 100.0 <= nearCeil
hasSetup = not na(gapBarIdx) and not na(_since) and _since >= 2 and contracting and nearC
brkOut  = not na(ceiling) and ta.crossover(close, ceiling)
_stop   = ta.lowest(low, 5)

// gap markers (every gap bar, historical too — for study)
plotshape(isGap and gap > 0, "Gap up",   style = shape.triangleup,   location = location.belowbar, color = colUp, size = size.tiny)
plotshape(isGap and gap < 0, "Gap down", style = shape.triangledown, location = location.abovebar, color = colDn, size = size.tiny)
plotshape(brkOut, "Ceiling break", style = shape.diamond, location = location.abovebar, color = colCeil, size = size.tiny, text = "BRK")

// ── ceiling (entry) + stop lines — only while a 3-2-1 is building ───────────────
var line  ceLn = na
var label ceLb = na
var line  stLn = na
var label stLb = na
if barstate.islast
    if hasSetup and not na(ceiling)
        _x1 = na(gapBarIdx) ? bar_index - 10 : gapBarIdx
        _x2 = bar_index + 8
        if na(ceLn)
            ceLn := line.new(_x1, ceiling, _x2, ceiling, color = colCeil, width = 2)
            ceLb := label.new(_x2, ceiling, "", style = label.style_label_left, color = colCeil, textcolor = color.white, size = size.small)
            stLn := line.new(_x1, _stop, _x2, _stop, color = colDn, width = 1, style = line.style_dashed)
            stLb := label.new(_x2, _stop, "", style = label.style_label_left, color = colDn, textcolor = color.white, size = size.small)
        else
            line.set_xy1(ceLn, _x1, ceiling)
            line.set_xy2(ceLn, _x2, ceiling)
            label.set_xy(ceLb, _x2, ceiling)
            line.set_xy1(stLn, _x1, _stop)
            line.set_xy2(stLn, _x2, _stop)
            label.set_xy(stLb, _x2, _stop)
        label.set_text(ceLb, "CEILING (buy) " + str.tostring(ceiling, format.mintick))
        label.set_text(stLb, "STOP " + str.tostring(_stop, format.mintick))
    else if not na(ceLn)
        line.delete(ceLn)
        label.delete(ceLb)
        line.delete(stLn)
        label.delete(stLb)
        ceLn := na
        ceLb := na
        stLn := na
        stLb := na

// ── opening range (intraday) ───────────────────────────────────────────────────
_newDay = timeframe.isintraday and ta.change(time("D")) != 0
var float orH = na
var float orL = na
var int   orStart = na
if timeframe.isintraday
    if _newDay
        orStart := time
        orH := high
        orL := low
    else if not na(orStart) and (time - orStart) <= orMin * 60 * 1000
        orH := math.max(orH, high)
        orL := math.min(orL, low)
plot(showOR and timeframe.isintraday ? orH : na, "OR high", color = colOR, style = plot.style_linebr, linewidth = 1)
plot(showOR and timeframe.isintraday ? orL : na, "OR low",  color = colOR, style = plot.style_linebr, linewidth = 1)

// ── HUD ────────────────────────────────────────────────────────────────────────
var table hud = table.new(position.top_right, 2, 5, border_width = 1, border_color = color.new(color.gray, 55))
_hb = color.new(#0B0B12, 0)
_ht = color.new(#C7C9D9, 0)
_hw = color.new(color.white, 0)
if barstate.islast and enHud
    _dir = na(gapVal) ? "—" : (gapVal > 0 ? "UP +" : "DOWN ") + str.tostring(gapVal, "#.#") + "%"
    _state = brkOut ? "BREAKOUT ▲ — ceiling cleared" : hasSetup ? "3-2-1 forming — coiling under ceiling" : na(gapBarIdx) ? "no recent gap" : "post-gap — no tight base yet"
    table.cell(hud, 0, 0, "Gap", _hb, _hw, text_halign = text.align_left)
    table.cell(hud, 1, 0, _dir + (na(_since) ? "" : "  · " + str.tostring(_since) + " bars ago"), _hb, _hw, text_halign = text.align_right)
    table.cell(hud, 0, 1, "Read", _hb, _ht, text_halign = text.align_left)
    table.cell(hud, 1, 1, _state, brkOut ? color.new(#1B5E20, 0) : hasSetup ? color.new(#1565C0, 0) : _hb, _hw, text_halign = text.align_right)
    table.cell(hud, 0, 2, "Ceiling (buy)", _hb, _ht, text_halign = text.align_left)
    table.cell(hud, 1, 2, na(ceiling) ? "—" : str.tostring(ceiling, format.mintick), _hb, color.new(#FB8C00, 0), text_halign = text.align_right)
    table.cell(hud, 0, 3, "Stop", _hb, _ht, text_halign = text.align_left)
    table.cell(hud, 1, 3, na(_stop) ? "—" : str.tostring(_stop, format.mintick), _hb, color.new(#EF5350, 0), text_halign = text.align_right)
    _toC = na(ceiling) or ceiling == 0 ? na : (close / ceiling - 1) * 100.0
    table.cell(hud, 0, 4, "To ceiling", _hb, _ht, text_halign = text.align_left)
    table.cell(hud, 1, 4, na(_toC) ? "—" : str.tostring(_toC, "+#.#;-#.#") + "%", _hb, _hw, text_halign = text.align_right)

// ── alerts ─────────────────────────────────────────────────────────────────────
alertcondition(isGap and gap > 0, "Big gap UP",   "{{ticker}} gapped UP ≥ threshold")
alertcondition(isGap and gap < 0, "Big gap DOWN", "{{ticker}} gapped DOWN ≥ threshold")
alertcondition(hasSetup and not hasSetup[1], "3-2-1 forming", "{{ticker}} — 3-2-1 coiling under the post-gap ceiling")
alertcondition(brkOut, "Ceiling breakout", "{{ticker}} — broke the post-gap ceiling (long trigger)")
