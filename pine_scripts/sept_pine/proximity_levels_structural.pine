//@version=5
// =============================================================================
// PROXIMITY LEVELS · STRUCTURAL + FLAT SMAs — the horizontal battle lines.
// =============================================================================
// The structural prices a level trader reacts to: PDH/PDL · PWH/PWL/PWC · PMH/PML/PMC · PQH/PQL/PQC ·
// 6M H/L/C · the current period's TO-DATE highs/lows (WTD/MTD/QTD/HTD, forming) · the last confirmed
// daily SWING H/L (pivot 5,5) · the daily volume-profile POC/VAH/VAL · the last two 4h candles (each
// H/L) · the O'Neil base pivot · plus the daily flat 8/21/50/200 SMA + rolling VWAP. Two tiers: an ALWAYS-ON frame
// (the last two 4h candles, + the 8 SMA anchor) that never hides, and a PROXIMITY-GATED set
// (everything else) that draws only when price is near it — all of it merges in confluence.
//
// EVERYTHING is a FLAT line, role-colored by where price is NOW: green ▲ = SUPPORT (price above it),
// red ▼ = RESISTANCE (price below it). RTH-accurate (regular-session ticker, so extended-hours
// prints never leak into the H/L) and non-repainting (settled [1] + lookahead).
//
// Three show-rules keep it clean but never blind:
//   1. PROXIMITY MODE picks which levels draw:
//        • Nearest N (neighbors) — DEFAULT. The N closest ABOVE and N closest BELOW price (a count, so
//          a $1000 stock and a $30 stock both show the same-size near-price set, never a wall of lines).
//        • Percent band — only levels within ± base % of price (on a $750 name a few % is a wide net).
//        • Both — the union of the two.
//      A FAR CAP (default ±8%) trims whatever mode you pick: a level farther than the cap is dropped
//      even if it's a Nearest-N neighbor — if the closest level is 12% away it isn't in play, so it's
//      hidden rather than allowed to compress the axis. Set the cap to 0 to let the count stand alone.
//   2. ALWAYS-ON (ignore mode/distance): the last two 4h candles (each H/L) — the frame price
//      trades inside now — PLUS the 8 SMA (its anchor toggle, default on), so a strongly trending
//      name that has run far from every MA still keeps its nearest-SMA reference instead of showing
//      only 4h lines. Everything else (daily / weekly / monthly / quarterly / pivot / 21·50·200 SMA)
//      stays gated so a far level can't compress the axis.
//   3. CONFLUENCE: levels stacked within ±0.4% merge into ONE thicker line whose label names every
//      member + a ·×N count ("PWH + PMH ·×2") — a wall reads at a glance.
//
// VISUAL ONLY — no alertcondition, nothing emitted to the platform webhook. Safe to run next to
// the emitting pines without double-firing anything.
indicator("proximity-pine-daysignal", overlay = true, max_lines_count = 60, max_labels_count = 100)

// ── proximity + confluence ──────────────────────────────────────────────────────
gN        = "Proximity"
proxMode  = input.string("Nearest N (neighbors)", "Proximity mode", options = ["Nearest N (neighbors)", "Percent band", "Both — union"], group = gN, tooltip = "How to choose which GATED levels draw (everything except the two 4h candles). Nearest N (default) = just the N closest levels ABOVE and N closest BELOW price — a hard count, so the chart never fills with far lines and every symbol shows the same-size near-price set. Percent band = levels within ± base % of price instead (on a $750 name a few % is a wide net). Both = the union. The far cap below trims whatever mode you pick.")
nBracket  = input.int(3, "  Nearest N — levels above & below price", group = gN, minval = 1, maxval = 8, tooltip = "Nearest-N mode: draw the N closest levels ABOVE price and the N closest BELOW, so every symbol shows the same-size near-price set. A % band can't do that (5% is $50 on a $1000 stock and $1.50 on a $30 one).")
basePct   = input.float(3.0, "  Percent band — draw levels within ± % of price", group = gN, minval = 0.1, maxval = 30, step = 0.1, tooltip = "Percent-band / Both mode: only levels within ± this % of the CURRENT price draw. This is the anti-compression control — a neighbor 15% away is skipped rather than squeezing the whole chart to fit it. PDH/PDL still always draw.") / 100.0
farCapPct = input.float(8, "  Far cap — never show anything farther than ± % (0 = off)", group = gN, minval = 0, maxval = 30, step = 0.5, tooltip = "Anti-compression trim applied on TOP of the mode above: drop any level farther than ± this % from price, even if it's one of the Nearest-N neighbors. So if the closest level above is 12% away it's simply hidden (a level that far isn't in play and would squeeze the axis). Default 8%. Set 0 to turn the trim off and let Nearest-N show its count regardless of distance.") / 100.0
confPct   = input.float(0.4, "Confluence — merge levels within ± % into one", group = gN, minval = 0.05, maxval = 3, step = 0.05) / 100.0
showAll   = input.bool(false, "Show ALL levels (ignore proximity — will compress the scale)", group = gN)

// ── which structural levels ─────────────────────────────────────────────────────
gC    = "Levels (uncheck any one to hide it)"
enPDH = input.bool(false, "PDH", group = gC, inline = "pd")
enPDL = input.bool(false, "PDL", group = gC, inline = "pd")
enPWH = input.bool(true,  "PWH", group = gC, inline = "pw")
enPWL = input.bool(true,  "PWL", group = gC, inline = "pw")
enPWC = input.bool(false, "PWC", group = gC, inline = "pw")
enPMH = input.bool(false, "PMH", group = gC, inline = "pm")
enPML = input.bool(false, "PML", group = gC, inline = "pm")
enPMC = input.bool(false, "PMC", group = gC, inline = "pm")
enPQH = input.bool(false, "PQH", group = gC, inline = "pq")
enPQL = input.bool(false, "PQL", group = gC, inline = "pq")
enPQC = input.bool(false, "PQC", group = gC, inline = "pq")
en6H  = input.bool(false, "6M H", group = gC, inline = "p6")
en6L  = input.bool(false, "6M L", group = gC, inline = "p6")
en6C  = input.bool(false, "6M C", group = gC, inline = "p6")
en4h  = input.bool(true, "Last 4h candle — high / low", group = gC, tooltip = "The most recent completed RTH 4h candle's own high and low (named '4H H / 4H L'). Always drawn (exempt from proximity). An edge is skipped only if PDH/PDL is enabled AND equals it — the day rail already draws it.")
en4h2 = input.bool(true, "Second-prior 4h candle — high / low", group = gC, tooltip = "The 4h candle before that one — its own high and low (named '2ND 4H H / 2ND 4H L'). Together the two toggles draw the last TWO 4h candles. Always drawn (exempt from proximity); an edge equal to an enabled PDH/PDL is skipped as a dup.")

// ── extra levels — to-date (current forming period) + last confirmed daily swing ─────────────────
gX    = "More levels (to-date + swing · proximity-gated)"
enTD  = input.bool(true, "To-date highs / lows (current period, forming)", group = gX, tooltip = "The CURRENT week's / month's / quarter's / half's running high & low — the newer levels price makes INSIDE the period, before it settles. Tagged WTD / MTD / QTD / HTD. Each follows its period's H/L toggle above, so with default settings you only get WTD (weekly on). Proximity-gated like everything else.")
enSwing = input.bool(true, "Last confirmed daily SWING high / low (pivot 5,5)", group = gX, tooltip = "The most recent daily pivot high and pivot low — the price where the market last actually reversed. A pivot confirms 5 daily bars after its extreme, so it updates late by design. Proximity-gated.")

// ── volume profile — daily POC / VAH / VAL (VP Pro v2 math, TradingView data) ─────────────────────
gVP    = "Volume profile (daily POC / VAH / VAL · proximity-gated)"
enVP   = input.bool(true, "Daily POC / VAH / VAL", group = gVP, tooltip = "The daily volume profile's point of control and value-area high/low, computed with VP Pro v2's math (overlap-distributed, two-row 70% value-area expansion) over the last N daily bars. Role-coloured and mergeable like the levels; proximity-gated (NOT pinned) so they draw only when near price.")
vpBars = input.int(150, "Profile bars back (daily)", group = gVP, minval = 10, maxval = 500)
vpCols = input.int(35, "Profile rows", group = gVP, minval = 5, maxval = 200)
vpVA   = input.float(70.0, "Value area %", group = gVP, minval = 1, maxval = 100)
vpLTF  = input.timeframe("30", "Profile sub-bars (lower timeframe)", group = gVP)

// ── rolling VWAP — flat, daily-locked, proximity-gated ────────────────────────────────────────────
gVW    = "Rolling VWAP (flat · daily-locked · gated)"
enVWAP = input.bool(true, "Rolling VWAP level", group = gVW, tooltip = "An N-day rolling volume-weighted average price — sum(hlc3·vol) / sum(vol) over the last N DAILY bars. Locked to the daily and drawn FLAT at yesterday's settled value (non-repainting, same on any chart TF), exactly like the SMAs. A volume-weighted fair-value anchor; role-coloured and mergeable, proximity-gated like the rest.")
vwapLen = input.int(20, "  Rolling length (daily bars)", group = gVW, minval = 5, maxval = 300, tooltip = "How many daily bars the VWAP rolls over. 20 ≈ a month of value, a close-tracking dynamic mean; 50 ≈ a quarter; 150 ≈ the long-term value line (matches the profile window).")

// ── moving averages — flat 8/21/50/200 SMA, daily-locked. Gated by the % proximity band. ────────
gS    = "SMAs (flat 8 / 21 / 50 / 200 · daily — 8 is the always-on anchor, 21/50/200 proximity-gated)"
enS8   = input.bool(true, "8 SMA",   inline = "sma", group = gS, tooltip = "Daily 8/21/50/200 SMA, locked to the daily and drawn FLAT at yesterday's settled value (non-repainting). Role-coloured and mergeable like the levels. The 21/50/200 obey the proximity gate; the 8 is handled by the anchor toggle below.")
enS21  = input.bool(true, "21 SMA",  inline = "sma", group = gS)
enS50  = input.bool(true,  "50 SMA",  inline = "sma", group = gS)
enS200 = input.bool(false, "200 SMA", inline = "sma", group = gS)
s8Anchor = input.bool(true, "Always show the 8 SMA (trend anchor — ignore proximity + far cap)", group = gS, tooltip = "In a strong trend price can run far from every MA, so the proximity gate / far cap hide them all and you're left with only the 4h levels. The 8 SMA is ALWAYS the nearest SMA to price (above all of them in an uptrend, below all in a downtrend), so it's the right single anchor to keep. ON = the 8 SMA always draws (when 8 SMA is enabled above), regardless of distance. OFF = the 8 SMA is proximity-gated like the others.")

// ── pivot (O'Neil base high) ────────────────────────────────────────────────────
gPV     = "Pivot (O'Neil base high)"
enPivot = input.bool(false, "Base-high pivot as a level", group = gPV, tooltip = "The highest high of the last N pivot-TF bars, drawn flat. Weekly = the O'Neil base high.")
pivotTf = input.timeframe("W", "Pivot timeframe", group = gPV)
baseLen = input.int(7, "Base length (bars of the pivot TF)", group = gPV, minval = 3, maxval = 40)

// ── style ───────────────────────────────────────────────────────────────────────
gV        = "Style"
supCol    = input.color(#26A69A, "Support (price above)",    group = gV)
resCol    = input.color(#EF5350, "Resistance (price below)", group = gV)
wLine     = input.int(2,  "Line width", group = gV, minval = 1, maxval = 5)
lineLen   = input.int(80, "Line length (bars back, when NOT extended)", group = gV, minval = 10, maxval = 500)
extendAll = input.bool(false, "Extend lines across the whole chart (infinite)", group = gV)
labelX    = input.int(8, "Tag column — bars right of the last bar", group = gV, minval = 2, maxval = 40)
lblGap    = input.float(0.5, "Fan tags apart when levels are within ± % of each other", group = gV, minval = 0.05, maxval = 5, step = 0.05) / 100.0
lblStep   = input.int(4, "  Fan step (bars per collision)", group = gV, minval = 1, maxval = 40)

// ── day open + take-profit nudge ────────────────────────────────────────────────
gO        = "Day open"
enOpen    = input.bool(true, "Mark the day's open + tag the levels it bracketed", group = gO, tooltip = "Where price OPENED sets each level's role for the session: nearest level BELOW the open = today's support, nearest ABOVE = today's resistance.")
openCol   = input.color(color.new(#EAB308, 0), "Open line", group = gO)
enPdlStop = input.bool(true, "Flag PDL as the 🛑 STOP in its label (Redler: lose it, you're out)", group = gO)
gTP       = "Take-profit into resistance"
enTp      = input.bool(true, "Warn when price reaches the nearest resistance above", group = gTP, tooltip = "When price rallies to within the band below the nearest drawn level above it, a subtle amber tag says 'into <level> — take profit'.")
tpBand    = input.float(0.30, "Warn within this % below the resistance", group = gTP, minval = 0.05, maxval = 3, step = 0.05) / 100.0
tpCol     = input.color(color.new(#F59E0B, 0), "Warning tag", group = gTP)

// ── values — RTH-accurate, settled, non-repainting ──────────────────────────────
rthTid = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
f_rth(string tf, float expr) => request.security(rthTid, tf, expr, lookahead = barmerge.lookahead_on)
// Per-period tuples: settled H/L/C ([1], prior period) PLUS the to-date forming H/L (no [1],
// the current period's running extreme). One request.security per TF covers both tiers.
[pdh, pdl, dayOpen]              = request.security(rthTid, "D",  [high[1], low[1], open],                 lookahead = barmerge.lookahead_on)
[pwh, pwl, pwc, wtdH, wtdL]      = request.security(rthTid, "W",  [high[1], low[1], close[1], high, low],  lookahead = barmerge.lookahead_on)
[pmh, pml, pmc, mtdH, mtdL]      = request.security(rthTid, "M",  [high[1], low[1], close[1], high, low],  lookahead = barmerge.lookahead_on)
[pqh, pql, pqc, qtdH, qtdL]      = request.security(rthTid, "3M", [high[1], low[1], close[1], high, low],  lookahead = barmerge.lookahead_on)
[h6,  l6,  c6,  htdH, htdL]      = request.security(rthTid, "6M", [high[1], low[1], close[1], high, low],  lookahead = barmerge.lookahead_on)
pivot   = f_rth(pivotTf, ta.highest(high, baseLen)[1])
// last CONFIRMED daily swing high / low (pivot 5,5) — confirms 5 bars after the extreme, so it's
// the last swing the market has actually proven. Evaluated inside the daily security context.
f_swh() =>
    _ph = ta.pivothigh(5, 5)
    ta.valuewhen(not na(_ph), _ph, 0)
f_swl() =>
    _pl = ta.pivotlow(5, 5)
    ta.valuewhen(not na(_pl), _pl, 0)
[swHraw, swLraw] = request.security(rthTid, "D", [f_swh(), f_swl()], lookahead = barmerge.lookahead_on)
// yesterday's last TWO 4h candles (RTH), frozen at each new session so they stay YESTERDAY's all day
_isEq4h   = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
_newBlk4h = ta.change(time(_isEq4h ? "D" : "480")) != 0
[_ph1, _pl1, _ph2, _pl2] = request.security(rthTid, "240", [high[1], low[1], high[2], low[2]], lookahead = barmerge.lookahead_on)
var float _yh1 = na
var float _yl1 = na
var float _yh2 = na
var float _yl2 = na
if na(_yh1) or _newBlk4h
    _yh1 := _ph1
    _yl1 := _pl1
    _yh2 := _ph2
    _yl2 := _pl2
// Draw the TWO actual 4h candles, each as its own high + low — NOT a derived min/max.
// (The old "inner" model collapsed both candles into a single min/max pair built from the
// SAME prices as the 2nd candle, so "2ND 4H" could never render as a distinct line — it
// always either equalled the inner pair or the day rail.) Skip a candle edge only when the
// corresponding day rail is ENABLED and the edge equals it (the rail already draws it); if
// the rail is toggled off, always draw the edge so no level is left as an empty hole.
f_offRail(float v, float rail, bool railOn) => not railOn or na(rail) or math.abs(v - rail) / rail > 0.0005
// candle 1 = yesterday's LAST completed 4h candle
_show4hH  = en4h  and not na(_yh1) and f_offRail(_yh1, pdh, enPDH)
_show4hL  = en4h  and not na(_yl1) and f_offRail(_yl1, pdl, enPDL)
// candle 2 = the SECOND-prior 4h candle
_show4h2H = en4h2 and not na(_yh2) and f_offRail(_yh2, pdh, enPDH)
_show4h2L = en4h2 and not na(_yl2) and f_offRail(_yl2, pdl, enPDL)
// Daily 8/21/50/200 SMA — locked to the daily, SETTLED [1] + lookahead_on (the ma_only_proximity idiom):
// yesterday's closed daily SMA, flat all session, non-repainting, identical on any chart TF.
[sma8, sma21, sma50, sma200] = request.security(syminfo.tickerid, "D", [ta.sma(close, 8)[1], ta.sma(close, 21)[1], ta.sma(close, 50)[1], ta.sma(close, 200)[1]], lookahead = barmerge.lookahead_on)
// Rolling N-day VWAP — same daily-locked / settled[1] / lookahead_on idiom as the SMAs: yesterday's
// closed rolling VWAP, flat all session, non-repainting, identical on any chart TF. sum(hlc3·vol)/sum(vol).
// A helper so the [1] history-reference lands on a function-call result (as ta.sma(...)[1] does), not a
// parenthesized expression — the latter can be rejected at compile.
f_rvwap(int n) => math.sum(hlc3 * volume, n) / math.max(math.sum(volume, n), 1e-10)
rvwap = request.security(syminfo.tickerid, "D", f_rvwap(vwapLen)[1], lookahead = barmerge.lookahead_on)

// ── daily volume profile — VP Pro v2's math (overlap-distributed rows, two-row 70% value-area
//    growth), collected through VP Pro's f_dailyFlat pattern so the values match VP Pro on the
//    same chart. LTF guard (RE10066): never request sub-bars on a TF not lower than the chart TF;
//    on sub-2-minute charts fall back to the daily bars. The flat-array length goes through a
//    na-safe read (na daily series on bar 0 → length 0, skip). Ported from LEVES_POC v2026.11.10.2.
tid = syminfo.tickerid
vpLtfSecs   = timeframe.in_seconds(vpLTF)
vpChartSecs = timeframe.in_seconds(timeframe.period)
effVpLTF    = vpLtfSecs < vpChartSecs ? vpLTF : timeframe.period
vpUseSub    = vpChartSecs >= 120
f_vpFlat() =>
    var float[] aH = array.new_float(0)
    var float[] aL = array.new_float(0)
    var float[] aV = array.new_float(0)
    var float[] dH = array.new_float(0)
    var float[] dL = array.new_float(0)
    var float[] dV = array.new_float(0)
    var int lastDay = na
    var float wStart = na
    _h = request.security_lower_tf(tid, effVpLTF, high)
    _l = request.security_lower_tf(tid, effVpLTF, low)
    _v = request.security_lower_tf(tid, effVpLTF, volume)
    if enVP and bar_index >= last_bar_index - vpBars + 1 and (na(lastDay) or bar_index != lastDay)
        lastDay := bar_index
        if na(wStart)
            wStart := time
        array.push(dH, high)
        array.push(dL, low)
        array.push(dV, nz(volume))
        if vpUseSub and timeframe.in_seconds(effVpLTF) < 86400
            _nn = na(_h) ? 0 : array.size(_h)
            if _nn > 0
                for _s = 0 to _nn - 1
                    array.push(aH, array.get(_h, _s))
                    array.push(aL, array.get(_l, _s))
                    array.push(aV, nz(array.get(_v, _s)))
    _out = array.new_float(0)
    if barstate.islast and array.size(dH) > 0
        array.push(_out, wStart)
        array.push(_out, array.size(aH))
        if array.size(aH) > 0
            for _s = 0 to array.size(aH) - 1
                array.push(_out, array.get(aH, _s))
            for _s = 0 to array.size(aH) - 1
                array.push(_out, array.get(aL, _s))
            for _s = 0 to array.size(aH) - 1
                array.push(_out, array.get(aV, _s))
        array.push(_out, array.size(dH))
        for _s = 0 to array.size(dH) - 1
            array.push(_out, array.get(dH, _s))
        for _s = 0 to array.size(dH) - 1
            array.push(_out, array.get(dL, _s))
        for _s = 0 to array.size(dH) - 1
            array.push(_out, array.get(dV, _s))
    _out
dFlat = request.security(tid, "D", f_vpFlat())
_dLen = na(dFlat) ? 0 : array.size(dFlat)   // na where the daily series has not started yet — never array.size() a possibly-na array
var float vpPOC = na
var float vpVAH = na
var float vpVAL = na
if barstate.islast and enVP and _dLen > 6
    _nSub = int(array.get(dFlat, 1))
    _dayOff = 2 + 3 * _nSub
    _nDay = int(array.get(dFlat, _dayOff))
    dataH = array.new_float(0)
    dataL = array.new_float(0)
    dataV = array.new_float(0)
    float _winHi = na
    float _winLo = na
    for _d = 0 to _nDay - 1
        _dH = array.get(dFlat, _dayOff + 1 + _d)
        _dL = array.get(dFlat, _dayOff + 1 + _nDay + _d)
        _winHi := na(_winHi) ? _dH : math.max(_winHi, _dH)
        _winLo := na(_winLo) ? _dL : math.min(_winLo, _dL)
    if _nSub > 0
        for _s = 0 to _nSub - 1
            array.push(dataH, array.get(dFlat, 2 + _s))
            array.push(dataL, array.get(dFlat, 2 + _nSub + _s))
            array.push(dataV, array.get(dFlat, 2 + 2 * _nSub + _s))
    else if _nDay > 0
        for _d = 0 to _nDay - 1
            array.push(dataH, array.get(dFlat, _dayOff + 1 + _d))
            array.push(dataL, array.get(dFlat, _dayOff + 1 + _nDay + _d))
            array.push(dataV, array.get(dFlat, _dayOff + 1 + 2 * _nDay + _d))
    if not na(_winHi) and not na(_winLo) and array.size(dataH) > 0
        _rng = _winHi - _winLo
        if _rng > 0
            _bs = _rng / vpCols
            vol = array.new_float(vpCols, 0.0)
            for _b = 0 to array.size(dataH) - 1
                _bLo = array.get(dataL, _b)
                _bHi = array.get(dataH, _b)
                _bV = nz(array.get(dataV, _b))
                _loI = int(math.floor((_bLo - _winLo) / _bs))
                _hiI = int(math.floor((_bHi - _winLo) / _bs))
                _loI := math.max(0, math.min(vpCols - 1, _loI))
                _hiI := math.max(0, math.min(vpCols - 1, _hiI))
                if _bHi <= _bLo
                    array.set(vol, _loI, array.get(vol, _loI) + _bV)
                else
                    for _k = _loI to _hiI
                        _rBot = _winLo + _k * _bs
                        _rTop = _rBot + _bs
                        _ov = math.min(_bHi, _rTop) - math.max(_bLo, _rBot)
                        if _ov > 0
                            array.set(vol, _k, array.get(vol, _k) + _bV * _ov / (_bHi - _bLo))
            _total = 0.0
            _maxV  = 0.0
            _poc   = 0
            for _k = 0 to vpCols - 1
                _vv = array.get(vol, _k)
                _total += _vv
                if _vv > _maxV
                    _maxV := _vv
                    _poc  := _k
            _vaVol  = array.get(vol, _poc)
            _up     = _poc
            _dn     = _poc
            _target = _total * vpVA / 100.0
            _go     = _total > 0
            while _go
                if _vaVol >= _target
                    _go := false
                else
                    _upN = math.min(2, vpCols - 1 - _up)
                    _dnN = math.min(2, _dn)
                    if _upN <= 0 and _dnN <= 0
                        _go := false
                    else
                        _upS = (_upN >= 1 ? array.get(vol, _up + 1) : 0.0) + (_upN >= 2 ? array.get(vol, _up + 2) : 0.0)
                        _dnS = (_dnN >= 1 ? array.get(vol, _dn - 1) : 0.0) + (_dnN >= 2 ? array.get(vol, _dn - 2) : 0.0)
                        if _upN > 0 and (_dnN <= 0 or _upS >= _dnS)
                            for _j = 1 to _upN
                                _up := _up + 1
                                _vaVol := _vaVol + array.get(vol, _up)
                        else
                            for _j = 1 to _dnN
                                _dn := _dn - 1
                                _vaVol := _vaVol + array.get(vol, _dn)
            vpVAH := _winLo + (_up + 1) * _bs
            vpVAL := _winLo + _dn * _bs
            vpPOC := _winLo + (_poc + 0.5) * _bs

// ── collection + flat-line drawing (with confluence clustering) ─────────────────
var line[]   _ln = array.new_line()
var label[]  _lb = array.new_label()
var float[]  _cv = array.new_float()      // ALL candidates (bracket calc + draw filter)
var string[] _cn = array.new_string()
var bool[]   _ca = array.new_bool()       // always-draw? (PDH/PDL — never proximity-filtered)
var float[]  _dv = array.new_float()      // what will actually be drawn
var string[] _dn = array.new_string()
var float[]  _drawnY = array.new_float()  // prices already tagged this bar (collision fan)
var float    _brkHi = 1.0e18              // Nth-nearest ABOVE price — bracket top
var float    _brkLo = -1.0                // Nth-nearest BELOW price — bracket bottom
f_xoff(float price) =>
    _cnt = 0
    if array.size(_drawnY) > 0
        for _k = 0 to array.size(_drawnY) - 1
            if math.abs(array.get(_drawnY, _k) - price) / price <= lblGap
                _cnt := _cnt + 1
    array.push(_drawnY, price)
    labelX + math.min(_cnt, 6) * lblStep
f_draw(float lvl, string nm, int w) =>
    sup = close > lvl
    col = sup ? supCol : resCol
    _xo = f_xoff(lvl)
    array.push(_ln, line.new(bar_index - lineLen, lvl, bar_index + _xo, lvl, color = col, width = w, extend = extendAll ? extend.both : extend.none))
    array.push(_lb, label.new(bar_index + _xo, lvl, nm + (sup ? "  ▲ " : "  ▼ ") + str.tostring(lvl, format.mintick), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
f_cand(float v, string nm, bool show, bool always) =>
    if show and not na(v) and v > 0
        array.push(_cv, v)
        array.push(_cn, nm)
        array.push(_ca, always)
f_add(float v, string nm) =>
    if not na(v) and v > 0
        array.push(_dv, v)
        array.push(_dn, nm)

if barstate.islast
    for _l in _ln
        line.delete(_l)
    for _b in _lb
        label.delete(_b)
    array.clear(_ln)
    array.clear(_lb)
    array.clear(_cv)
    array.clear(_cn)
    array.clear(_ca)
    array.clear(_dv)
    array.clear(_dn)
    array.clear(_drawnY)
    // candidates — ONLY the two 4h candles are always-on (the immediate frame price works
    // inside right now). EVERYTHING else — the day rails, the weekly / monthly / quarterly
    // levels, the pivot and the SMAs — obeys the proximity gate, so a far level draws only
    // when price is near it and can never compress the axis.
    f_cand(_yh1,      "4H H",     _show4hH,  true)
    f_cand(_yl1,      "4H L",     _show4hL,  true)
    f_cand(_yh2,      "2ND 4H H", _show4h2H, true)
    f_cand(_yl2,      "2ND 4H L", _show4h2L, true)
    // GATED by the proximity mode / % band: daily, weekly, monthly, quarterly, pivot, SMAs.
    f_cand(pdh, "PDH", enPDH, false)
    f_cand(pdl, "PDL", enPDL, false)
    f_cand(pwh, "PWH", enPWH, false)
    f_cand(pwl, "PWL", enPWL, false)
    f_cand(pwc, "PWC", enPWC, false)
    f_cand(pmh, "PMH", enPMH, false)
    f_cand(pml, "PML", enPML, false)
    f_cand(pmc, "PMC", enPMC, false)
    f_cand(pqh, "PQH", enPQH, false)
    f_cand(pql, "PQL", enPQL, false)
    f_cand(pqc, "PQC", enPQC, false)
    f_cand(pivot, "PIVOT", enPivot, false)
    f_cand(sma8,   "8 SMA",   enS8,   s8Anchor)   // trend anchor — always-on when toggled, so a far-trending name keeps ≥1 SMA
    f_cand(sma21,  "21 SMA",  enS21,  false)
    f_cand(sma50,  "50 SMA",  enS50,  false)
    f_cand(sma200, "200 SMA", enS200, false)
    f_cand(rvwap,  "VWAP",    enVWAP, false)   // rolling N-day VWAP, flat + daily-locked, gated
    // 6M (half-year) prior frame — gated like monthly/quarterly
    f_cand(h6, "6M High",  en6H, false)
    f_cand(l6, "6M Low",   en6L, false)
    f_cand(c6, "6M Close", en6C, false)
    // TO-DATE forming extremes — each follows its period's H/L toggle (so default = WTD only)
    f_cand(wtdH, "WTD High", enTD and enPWH, false)
    f_cand(wtdL, "WTD Low",  enTD and enPWL, false)
    f_cand(mtdH, "MTD High", enTD and enPMH, false)
    f_cand(mtdL, "MTD Low",  enTD and enPML, false)
    f_cand(qtdH, "QTD High", enTD and enPQH, false)
    f_cand(qtdL, "QTD Low",  enTD and enPQL, false)
    f_cand(htdH, "HTD High", enTD and en6H,  false)
    f_cand(htdL, "HTD Low",  enTD and en6L,  false)
    // last confirmed daily swing high / low
    f_cand(swHraw, "Swing High", enSwing, false)
    f_cand(swLraw, "Swing Low",  enSwing, false)
    // daily volume-profile levels — gated (not pinned)
    f_cand(vpPOC, "POC", enVP, false)
    f_cand(vpVAH, "VAH", enVP, false)
    f_cand(vpVAL, "VAL", enVP, false)
    // ── NEAREST-N bracket — the N closest DISTINCT prices above and below. Distinct matters: when
    //    the week's / month's / quarter's to-date lows (or a VAL and a settled low) are the SAME
    //    print, that is ONE level wearing several names, not several levels — counting the copies
    //    would starve a real distinct level out of the near-price set. Dedup within confPct. ──
    _ab = array.new_float()
    _bl = array.new_float()
    if array.size(_cv) > 0
        for _i = 0 to array.size(_cv) - 1
            v = array.get(_cv, _i)
            if v > close
                _dupA = false
                if array.size(_ab) > 0
                    for _k = 0 to array.size(_ab) - 1
                        if math.abs(array.get(_ab, _k) - v) / v <= confPct
                            _dupA := true
                if not _dupA
                    array.push(_ab, v)
            else if v < close
                _dupB = false
                if array.size(_bl) > 0
                    for _k = 0 to array.size(_bl) - 1
                        if math.abs(array.get(_bl, _k) - v) / v <= confPct
                            _dupB := true
                if not _dupB
                    array.push(_bl, v)
    array.sort(_ab, order.ascending)     // nearest-above first
    array.sort(_bl, order.descending)    // nearest-below first
    _brkHi := array.size(_ab) > 0 ? array.get(_ab, math.min(nBracket, array.size(_ab)) - 1) : 1.0e18
    _brkLo := array.size(_bl) > 0 ? array.get(_bl, math.min(nBracket, array.size(_bl)) - 1) : -1.0
    if array.size(_cv) > 0
        for _i = 0 to array.size(_cv) - 1
            v = array.get(_cv, _i)
            // neighbors (nearest-N) vs percent-band — the two proximity filters, unioned per mode
            _inBr   = (v > close and v <= _brkHi) or (v < close and v >= _brkLo)
            _inBand = math.abs(close - v) / close <= basePct
            _pass   = proxMode == "Percent band" ? _inBand : (proxMode == "Both — union" ? (_inBr or _inBand) : _inBr)
            _cap    = farCapPct <= 0 or math.abs(close - v) / close <= farCapPct
            if showAll or array.get(_ca, _i) or (_pass and _cap)
                f_add(v, array.get(_cn, _i))
    // day-open bracket — the drawn level nearest BELOW the open (day support) & nearest ABOVE (day resistance)
    oSupV = -1.0
    oResV = 1.0e18
    if enOpen and not na(dayOpen) and array.size(_dv) > 0
        for _i = 0 to array.size(_dv) - 1
            v = array.get(_dv, _i)
            if v < dayOpen and v > oSupV
                oSupV := v
            if v > dayOpen and v < oResV
                oResV := v
    // ── CONFLUENCE — group levels within confPct into ONE thicker line naming every member ──
    if array.size(_dv) > 0
        _used = array.new_bool(array.size(_dv), false)
        for _i = 0 to array.size(_dv) - 1
            if not array.get(_used, _i)
                vi    = array.get(_dv, _i)
                nm    = array.get(_dn, _i)
                _isPd = str.contains(nm, "PDH") or str.contains(nm, "PDL")   // day rails never merge — keep the EXACT price
                cnt   = 1
                isOS  = vi == oSupV
                isOR  = vi == oResV
                _near  = vi                       // the merged line sits on the REAL member nearest price,
                _nearD = math.abs(close - vi)     //   never a fabricated average that lands on none of them
                array.set(_used, _i, true)
                if not _isPd and _i < array.size(_dv) - 1
                    for _j = _i + 1 to array.size(_dv) - 1
                        _vj  = array.get(_dv, _j)
                        _nmj = array.get(_dn, _j)
                        _jPd = str.contains(_nmj, "PDH") or str.contains(_nmj, "PDL")
                        if not array.get(_used, _j) and not _jPd and math.abs(_vj - vi) / vi <= confPct
                            nm   := nm + " + " + _nmj
                            cnt  := cnt + 1
                            isOS := isOS or _vj == oSupV
                            isOR := isOR or _vj == oResV
                            if math.abs(close - _vj) < _nearD
                                _near  := _vj
                                _nearD := math.abs(close - _vj)
                            array.set(_used, _j, true)
                base = cnt > 1 ? nm + "  ·×" + str.tostring(cnt) : nm
                tag  = isOS ? "  ⊙ opened ABOVE (day support)" : isOR ? "  ⊙ opened BELOW (day resist)" : ""
                tag  := (enPdlStop and str.contains(nm, "PDL")) ? tag + "  · 🛑 STOP" : tag
                f_draw(_near, base + tag, cnt > 1 or isOS or isOR ? wLine + 2 : wLine)
    // ── the day's OPEN — drawn LAST so its tag is never hidden ──
    if enOpen and not na(dayOpen)
        _bias = not na(pdh) and dayOpen > pdh ? " ▲ strong" : not na(pdl) and dayOpen < pdl ? " ▼ weak" : ""
        _nbDn = oSupV > 0      ? str.tostring(oSupV, format.mintick) : "—"
        _nbUp = oResV < 1.0e17 ? str.tostring(oResV, format.mintick) : "—"
        _oxo  = f_xoff(dayOpen)
        array.push(_ln, line.new(bar_index - lineLen, dayOpen, bar_index + _oxo, dayOpen, color = openCol, width = 1, style = line.style_dotted, extend = extendAll ? extend.both : extend.none))
        array.push(_lb, label.new(bar_index + _oxo, dayOpen, "Open " + str.tostring(dayOpen, format.mintick) + _bias + "  ·  between  S " + _nbDn + "  ↔  R " + _nbUp, style = label.style_label_left, color = color.new(openCol, 15), textcolor = color.black, size = size.small))
    // ── TAKE-PROFIT nudge — nearest DRAWN level above price ──
    if enTp and array.size(_dv) > 0
        _rUp = 1.0e18
        _rNm = ""
        for _i = 0 to array.size(_dv) - 1
            _vv = array.get(_dv, _i)
            if _vv > close and _vv < _rUp
                _rUp := _vv
                _rNm := array.get(_dn, _i)
        if _rUp < 1.0e17 and close >= _rUp * (1 - tpBand)
            array.push(_lb, label.new(bar_index, high, "⚠ into " + _rNm + " " + str.tostring(_rUp, format.mintick) + " — take profit", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(tpCol, 10), textcolor = color.white, size = size.small))
