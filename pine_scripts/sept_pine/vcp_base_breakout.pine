//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// VCP · BASE BREAKOUT — the ENTRY companion to the Trend Template. The template
// says a stock is in Stage 2 (buyable); THIS says WHEN — it finds the base the
// stock is coiling in, marks the PIVOT (buy trigger) and the STOP, and fires when
// price clears the pivot on a volume surge.
//
// Minervini's VCP = Volatility Contraction Pattern: after an advance the stock
// pauses and its swings get PROGRESSIVELY TIGHTER while volume DRIES UP — supply
// exhausting under a ceiling. When almost no supply is left, a little buying
// launches it. We detect that as:
//   • BASE      — a contained consolidation (depth ≤ maxBaseDepth), price near its
//                 recent high (coiling under resistance, not basing at the lows).
//   • CONTRACTION — the RECENT third of the base is much tighter than the whole
//                 base (volatility contracting).
//   • DRY-UP    — recent volume below its longer average (sellers gone quiet).
//   • PIVOT     — the base ceiling (highest high of the base). The buy trigger.
//   • STOP      — the low of the last (tightest) contraction. Tight risk by design.
//   • BREAKOUT  — close clears the pivot on volume ≥ brkVolMult × average.
//
// Only flags bases in an uptrend (price > 50 & > 200, 150 > 200) unless you turn
// Stage-2-only off. A labeled HUD reads the setup; alerts fire on FORMING + BREAKOUT.
// ─────────────────────────────────────────────────────────────────────────────
indicator("VCP · Base Breakout", "VCP", overlay = true)

// ── base / contraction ────────────────────────────────────────────────────────
gBase       = "Base & contraction"
baseLen     = input.int(40, "Base lookback (bars)", minval = 10, maxval = 250, group = gBase, tooltip = "How far back the base ceiling (pivot) and floor are measured. 40 ≈ a two-month base; shorten for tighter/faster bases.")
maxBaseDepth = input.float(35.0, "Max base depth %", minval = 5, maxval = 80, group = gBase, tooltip = "Reject bases deeper than this (a 50%+ correction isn't a tight base). Base depth = (ceiling − floor) / ceiling.")
contractRatio = input.float(0.6, "Contraction: recent third ≤ N × base range", minval = 0.1, maxval = 1.0, step = 0.05, group = gBase, tooltip = "Volatility contraction — the recent third of the base must be at most this fraction of the whole base's range. Lower = demands a tighter coil.")
nearPivotPct = input.float(6.0, "Coiling when price within N% under pivot", minval = 1, maxval = 25, group = gBase, tooltip = "The setup is 'forming' only when price is coiling just under the pivot — within this % below the ceiling.")

// ── volume ────────────────────────────────────────────────────────────────────
gVol      = "Volume"
volAvgLen = input.int(50, "Volume average length", minval = 5, group = gVol)
volDryPct = input.float(0.85, "Dry-up: recent vol ≤ N × average", minval = 0.2, maxval = 1.5, step = 0.05, group = gVol, tooltip = "Supply dry-up — the recent 5-bar average volume must be at most this fraction of the longer average.")
brkVolMult = input.float(1.4, "Breakout volume ≥ N × average", minval = 1.0, maxval = 5, step = 0.1, group = gVol, tooltip = "The breakout bar must trade at least this multiple of average volume — institutions stepping in. No volume = suspect breakout.")

// ── trend gate ────────────────────────────────────────────────────────────────
gTrend     = "Trend gate"
stage2Only = input.bool(true, "Only flag bases in a Stage-2 uptrend", group = gTrend, tooltip = "Require price > 50 & > 200 SMA and 150 > 200 (the Trend Template's core) — no basing in a downtrend.")

// ── drawing / HUD ─────────────────────────────────────────────────────────────
gDraw  = "Drawing & HUD"
tagOff = input.int(8, "Line tag column (bars right of last)", minval = 2, maxval = 40, group = gDraw)
showBox = input.bool(true, "Shade the base box", group = gDraw, tooltip = "Frame the consolidation (floor→ceiling) as a box — ONLY when a tight base is actually present (contained + contracting + coiling under the pivot). Green = ready setup, blue = contracting. No tight base → no box.")
colPiv = input.color(#26A69A, "Pivot (buy) line", group = gDraw)
colStp = input.color(#EF5350, "Stop line", group = gDraw)
enHud  = input.bool(true, "Show the HUD", group = gDraw)
hudPos = input.string("top_right", "HUD position", options = ["top_left", "top_right", "bottom_left", "bottom_right"], group = gDraw)

// ── compute ───────────────────────────────────────────────────────────────────
ma50  = ta.sma(close, 50)
ma150 = ta.sma(close, 150)
ma200 = ta.sma(close, 200)
uptrend = close > ma50 and close > ma200 and ma150 > ma200

// PIVOT = the base ceiling from COMPLETED bars (excludes today, so a close above it
// is a genuine breakout). FLOOR = the base's low over the same window.
pivot     = ta.highest(high[1], baseLen)
baseFloor = ta.lowest(low[1], baseLen)
baseDepth = na(pivot) or pivot == 0 ? na : (pivot - baseFloor) / pivot * 100.0

// CONTRACTION — the recent third of the base vs the whole base (volatility drop).
_third      = int(math.max(3, math.floor(baseLen / 3.0)))
rangeBase   = ta.highest(high, baseLen) - ta.lowest(low, baseLen)
rangeRecent = ta.highest(high, _third) - ta.lowest(low, _third)
contracting = not na(rangeBase) and rangeBase > 0 and rangeRecent <= rangeBase * contractRatio
// STOP = the low of that tight recent contraction.
stopLevel = ta.lowest(low, _third)

// VOLUME dry-up + breakout surge
volAvg    = ta.sma(volume, volAvgLen)
volRecent = ta.sma(volume, 5)
dryUp     = not na(volAvg) and volAvg > 0 and volRecent <= volAvg * volDryPct
volRatio  = na(volAvg) or volAvg == 0 ? na : volume / volAvg

// STATE
depthOk   = not na(baseDepth) and baseDepth <= maxBaseDepth
nearPivot = not na(pivot) and close < pivot and close >= pivot * (1 - nearPivotPct / 100)
trendOk   = not stage2Only or uptrend
forming   = trendOk and depthOk and contracting and dryUp and nearPivot
breakout  = trendOk and depthOk and ta.crossover(close, pivot) and not na(volRatio) and volRatio >= brkVolMult
// A real, drawable base = contained + tightening + price coiling under the pivot.
// (forming also needs volume dry-up.) No tight base → no box, so the box never
// contradicts a "no tight base yet" read.
hasBase   = trendOk and depthOk and contracting and nearPivot

distPivot = na(pivot) or pivot == 0 ? na : (close / pivot - 1) * 100.0
riskPct   = na(pivot) or na(stopLevel) or pivot == 0 ? na : (pivot - stopLevel) / pivot * 100.0

// ── draw pivot + stop lines (house idiom — update on the last bar) ─────────────
var line  pvLn  = na
var label pvLb  = na
var line  stLn  = na
var label stLb  = na
_drawOn = forming or breakout
if barstate.islast
    if _drawOn and not na(pivot)
        _x1 = bar_index - baseLen
        _x2 = bar_index + tagOff
        if na(pvLn)
            pvLn := line.new(_x1, pivot, _x2, pivot, color = colPiv, width = 2)
            pvLb := label.new(_x2, pivot, "", style = label.style_label_left, color = colPiv, textcolor = color.white, size = size.small)
            stLn := line.new(_x1, stopLevel, _x2, stopLevel, color = colStp, width = 1, style = line.style_dashed)
            stLb := label.new(_x2, stopLevel, "", style = label.style_label_left, color = colStp, textcolor = color.white, size = size.small)
        else
            line.set_xy1(pvLn, _x1, pivot)
            line.set_xy2(pvLn, _x2, pivot)
            label.set_xy(pvLb, _x2, pivot)
            line.set_xy1(stLn, _x1, stopLevel)
            line.set_xy2(stLn, _x2, stopLevel)
            label.set_xy(stLb, _x2, stopLevel)
        label.set_text(pvLb, "PIVOT (buy) " + str.tostring(pivot, format.mintick))
        label.set_text(stLb, "STOP " + str.tostring(stopLevel, format.mintick))
    else if not na(pvLn)
        // no active setup — hide the old lines
        line.delete(pvLn)
        label.delete(pvLb)
        line.delete(stLn)
        label.delete(stLb)
        pvLn := na
        pvLb := na
        stLn := na
        stLb := na

// ── base BOX — frame the consolidation so the base is UNMISTAKABLE ─────────────
// The rectangle spans the base's floor→ceiling over the lookback. Colour = quality:
// green when it's a ready VCP setup, blue while it's contracting, gray when loose.
var box baseBox = na
if barstate.islast
    if showBox and (hasBase or breakout) and not na(pivot) and not na(baseFloor)
        _bx1   = bar_index - baseLen
        _bxCol = (forming or breakout) ? color.new(#26A69A, 82) : color.new(#42A5F5, 85)
        _bdCol = (forming or breakout) ? color.new(#26A69A, 30) : color.new(#42A5F5, 35)
        if na(baseBox)
            baseBox := box.new(_bx1, pivot, bar_index, baseFloor, border_color = _bdCol, border_width = 1, bgcolor = _bxCol)
        else
            box.set_lefttop(baseBox, _bx1, pivot)
            box.set_rightbottom(baseBox, bar_index, baseFloor)
            box.set_border_color(baseBox, _bdCol)
            box.set_bgcolor(baseBox, _bxCol)
    else if not na(baseBox)
        box.delete(baseBox)
        baseBox := na

// breakout marker + coil wash
plotshape(breakout, "Breakout", style = shape.triangleup, location = location.belowbar, color = colPiv, size = size.small, text = "BRK")
bgcolor(forming ? color.new(#42A5F5, 90) : na)
// queryable (Data Window)
plot(baseDepth,  "Base depth %",       display = display.data_window)
plot(distPivot,  "Dist to pivot %",    display = display.data_window)
plot(volRatio,   "Volume × average",   display = display.data_window)
plot(riskPct,    "Pivot→stop risk %",  display = display.data_window)

// ── HUD ───────────────────────────────────────────────────────────────────────
_pos = hudPos == "top_left" ? position.top_left : hudPos == "bottom_left" ? position.bottom_left : hudPos == "bottom_right" ? position.bottom_right : position.top_right
var table hud = table.new(_pos, 2, 8, border_width = 1, border_color = color.new(color.gray, 55))
_lblBg = color.new(#0B0B12, 0)
_lblTx = color.new(#C7C9D9, 0)
_white = color.new(color.white, 0)
_okC   = color.new(#26A69A, 0)
_noC   = color.new(#EF5350, 0)
_cell(int col, int row, string txt, color bg, color tc, bool right) => table.cell(hud, col, row, txt, text_color = tc, bgcolor = bg, text_size = size.normal, text_halign = right ? text.align_right : text.align_left)
f_yn(bool ok) => ok ? "✔" : "✗"
if barstate.islast
    if enHud
        _statTxt = not trendOk ? "Not Stage 2 — skip" : breakout ? "BREAKOUT ▲ — pivot cleared on volume" : forming ? "Setup forming — coiling under pivot" : not depthOk ? "Base too deep / none" : not contracting ? "Not contracting yet" : not dryUp ? "Volume not dried up" : not nearPivot ? "Away from pivot" : "Watching"
        _statBg  = breakout ? _okC : forming ? color.new(#1565C0, 0) : color.new(color.gray, 35)
        _cell(0, 0, "VCP Base", _statBg, _white, false)
        _cell(1, 0, breakout ? "BREAKOUT" : forming ? "FORMING" : "—", _statBg, _white, true)
        _cell(0, 1, "Read", _lblBg, _lblTx, false)
        _cell(1, 1, _statTxt, _lblBg, _white, true)
        _cell(0, 2, "Pivot (buy)", _lblBg, _lblTx, false)
        _cell(1, 2, na(pivot) ? "—" : str.tostring(pivot, format.mintick), _lblBg, _okC, true)
        _cell(0, 3, "Stop", _lblBg, _lblTx, false)
        _cell(1, 3, na(stopLevel) ? "—" : str.tostring(stopLevel, format.mintick) + (na(riskPct) ? "" : "  (" + str.tostring(riskPct, "#.#") + "%)"), _lblBg, _noC, true)
        _cell(0, 4, "Base depth", _lblBg, _lblTx, false)
        _cell(1, 4, (na(baseDepth) ? "—" : str.tostring(baseDepth, "#.#") + "%") + "  " + f_yn(depthOk), _lblBg, depthOk ? _okC : _noC, true)
        _cell(0, 5, "Contracting", _lblBg, _lblTx, false)
        _cell(1, 5, f_yn(contracting) + "  (recent " + (na(rangeBase) or rangeBase == 0 ? "—" : str.tostring(rangeRecent / rangeBase * 100, "#") + "% of base)"), _lblBg, contracting ? _okC : _noC, true)
        _cell(0, 6, "Vol dry-up", _lblBg, _lblTx, false)
        _cell(1, 6, f_yn(dryUp) + (na(volRatio) ? "" : "  · now " + str.tostring(volRatio, "#.#") + "×"), _lblBg, dryUp ? _okC : _noC, true)
        _cell(0, 7, "Dist to pivot", _lblBg, _lblTx, false)
        _cell(1, 7, na(distPivot) ? "—" : str.tostring(distPivot, "+#.#;-#.#") + "%", _lblBg, _white, true)
    else
        for _r = 0 to 7
            table.cell(hud, 0, _r, "", bgcolor = color.new(color.gray, 100))
            table.cell(hud, 1, _r, "", bgcolor = color.new(color.gray, 100))

// ── alerts ────────────────────────────────────────────────────────────────────
alertcondition(forming and not forming[1], "VCP: setup forming", "{{ticker}} — VCP base forming, coiling under the pivot")
alertcondition(breakout, "VCP: breakout", "{{ticker}} — VCP breakout: cleared the pivot on volume")
